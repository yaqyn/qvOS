#!/bin/bash
set -euo pipefail

(($# >= 2)) || {
  echo "Usage: qv notification send <glyph> <headline> [description] [notify-send options]" >&2
  exit 2
}
glyph=$1
headline=$2
shift 2
description=""
if (($#)) && [[ $1 != -* ]]; then
  description=$1
  shift
fi
summary="$glyph    $headline"
if [[ -n $description ]]; then
  description="      ${description//$'\n'/$'\n      '}"
  exec notify-send "$@" "$summary" "$description"
fi
exec notify-send "$@" "$summary"
