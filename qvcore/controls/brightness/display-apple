#!/bin/bash
set -euo pipefail

(($# == 1)) || {
  echo "Usage: qv brightness display apple <+N%|N%-|N%>" >&2
  exit 2
}
step=$1
if [[ $step =~ ^\+([0-9]{1,3})%$ || $step =~ ^([0-9]{1,3})%-$ || $step =~ ^([0-9]{1,3})%$ ]]; then
  ((10#${BASH_REMATCH[1]} <= 100)) || {
    echo "Apple display brightness must be between 0 and 100 percent." >&2
    exit 2
  }
else
  echo "Usage: qv brightness display apple <+N%|N%-|N%>" >&2
  exit 2
fi
root_helper=${QVOS_APPLE_BRIGHTNESS_HELPER:-/usr/lib/qvos/controls/apple-display-brightness}
sudo_command=${QVOS_CONTROLS_SUDO:-/usr/bin/sudo}
if [[ $root_helper != "/usr/lib/qvos/controls/apple-display-brightness" &&
  ${QVOS_CONTROLS_TESTING:-} != "1" ]]; then
  echo "A custom Apple display helper is valid only in tests." >&2
  exit 2
fi
if [[ $sudo_command != "/usr/bin/sudo" && ${QVOS_CONTROLS_TESTING:-} != "1" ]]; then
  echo "A custom sudo command is valid only in tests." >&2
  exit 2
fi
[[ -x $root_helper && ! -L $root_helper ]] || {
  echo "The qvOS Apple display brightness helper is unavailable." >&2
  exit 1
}
[[ -x $sudo_command && ! -L $sudo_command ]] || {
  echo "The qvOS Apple display privilege boundary is unavailable." >&2
  exit 1
}

value=$("$sudo_command" -- "$root_helper" "$step")
if [[ ! $value =~ ^[0-9]+$ ]] || ((value > 60000)); then
  echo "Apple display returned an invalid brightness value." >&2
  exit 1
fi
controls_root=$(cd -- "$(/usr/bin/dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
exec "$controls_root/osd/brightness" "$((value * 100 / 60000))"
