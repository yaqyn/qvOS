#!/bin/bash
set -euo pipefail

(($# == 1)) || {
  echo "Usage: apple-display-brightness <+N%|N%-|N%>" >&2
  exit 2
}

step=$1
if [[ $step =~ ^\+([0-9]{1,3})%$ ||
  $step =~ ^([0-9]{1,3})%-$ ||
  $step =~ ^([0-9]{1,3})%$ ]]; then
  ((10#${BASH_REMATCH[1]} <= 100)) || {
    echo "Apple display brightness must be between 0 and 100 percent." >&2
    exit 2
  }
else
  echo "Usage: apple-display-brightness <+N%|N%-|N%>" >&2
  exit 2
fi
if [[ $step =~ ^([0-9]+)%-$ ]]; then
  step="-${BASH_REMATCH[1]}%"
fi

testing=${QVOS_CONTROLS_TESTING:-}
hid_root=${QVOS_HID_ROOT:-/dev}
asdcontrol=${QVOS_ASDCONTROL:-/usr/bin/asdcontrol}
self_path=$(/usr/bin/readlink -f -- "${BASH_SOURCE[0]}")
if [[ $testing == "1" &&
  $self_path != "/usr/lib/qvos/controls/apple-display-brightness" ]]; then
  [[ $hid_root == /tmp/* && -d $hid_root && ! -L $hid_root &&
    -x $asdcontrol && ! -L $asdcontrol ]] || {
    echo "Invalid Apple display brightness test boundary." >&2
    exit 2
  }
else
  [[ $EUID == 0 &&
    $self_path == "/usr/lib/qvos/controls/apple-display-brightness" &&
    $hid_root == "/dev" && $asdcontrol == "/usr/bin/asdcontrol" &&
    -x $asdcontrol && ! -L $asdcontrol ]] || {
    echo "Refusing an untrusted Apple display brightness helper." >&2
    exit 1
  }
fi

devices=()
shopt -s nullglob
for path in "$hid_root"/usb/hiddev* "$hid_root"/hiddev*; do
  [[ -e $path && ! -L $path ]] && devices+=("$path")
done
shopt -u nullglob
(( ${#devices[@]} > 0 && ${#devices[@]} <= 64 )) || {
  echo "No bounded Apple Display HID device set was found." >&2
  exit 1
}

device=$(
  "$asdcontrol" --detect "${devices[@]}" |
    /usr/bin/awk -F: 'NF && !found { print $1; found = 1 }'
)
[[ -n $device ]] || {
  echo "No Apple Display HID device was found." >&2
  exit 1
}
valid_device=false
for candidate in "${devices[@]}"; do
  if [[ $device == "$candidate" ]]; then
    valid_device=true
    break
  fi
done
[[ $valid_device == "true" ]] || {
  echo "Apple display detection returned an unexpected device path." >&2
  exit 1
}

"$asdcontrol" "$device" -- "$step" >/dev/null
value=$("$asdcontrol" "$device" |
  /usr/bin/awk -F= '/BRIGHTNESS=/ { print $2; exit }')
if [[ ! $value =~ ^[0-9]+$ ]] || ((value > 60000)); then
  echo "Apple display returned an invalid brightness value." >&2
  exit 1
fi
printf '%s\n' "$value"
