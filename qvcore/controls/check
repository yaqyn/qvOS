#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/controls/native-paths"
retired_manifest="$root/qvcore/controls/retired-paths"
apple_helper="$root/qvcore/controls/brightness/apple-display-helper"
root_installer="$root/qvcore/controls/install-root"

fail() {
  printf 'qvOS controls check: %s\n' "$1" >&2
  exit 1
}

declare -A owners=(
  [audio-input-mute]=audio/input-mute
  [audio-output-switch]=audio/output-switch
  [brightness-display]=brightness/display
  [brightness-display-apple]=brightness/display-apple
  [brightness-keyboard]=brightness/keyboard
  [brightness-keyboard-mute]=brightness/keyboard-mute
  [notification-dismiss]=notification/dismiss
  [notification-send]=notification/send
  [swayosd-brightness]=osd/brightness
  [swayosd-client]=osd/client
  [swayosd-kbd-brightness]=osd/keyboard-brightness
  [toggle-notification-silencing]=notification/toggle-silencing
)

mapfile -t native_paths < <(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest")
[[ $(printf '%s\n' "${native_paths[@]}" | sort -u) == $(printf '%s\n' "${native_paths[@]}") ]] ||
  fail "native control paths are not sorted and unique"
((${#native_paths[@]} == ${#owners[@]})) || fail "native control inventory is incomplete"

[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == \
  'default/mako/' ]] || fail "retired notification-default inventory"
[[ ! -e $root/default/mako && ! -L $root/default/mako ]] ||
  fail "inherited Mako defaults remain"

mako_policy="$root/qvcore/controls/notification/mako-core.ini"
[[ -f $mako_policy && ! -L $mako_policy ]] ||
  fail "native Mako policy source"
for route in \
  qv-launch-floating-terminal-with-presentation \
  qv-launch-update \
  qv-launch-wifi \
  qv-menu-keybindings \
  qv-notification-dismiss \
  qv-voxtype-install; do
  grep -Fq "$route" "$mako_policy" ||
    fail "native Mako policy route: $route"
done
if rg -n '(^|[^[:alnum:]_-])omarchy-[[:alnum:]_-]+' "$mako_policy"; then
  fail "native Mako policy calls a compatibility route"
fi
[[ -x $apple_helper && ! -L $apple_helper &&
  -x $root_installer && ! -L $root_installer ]] ||
  fail "bounded Apple display privilege owner"
grep -Fq '/usr/lib/qvos/controls/apple-display-brightness' \
  "$root/qvcore/controls/brightness/display-apple" "$root_installer" ||
  fail "Apple display control does not use its root-owned helper"
if rg -n 'NOPASSWD:.*asdcontrol|sudo[[:space:]]+asdcontrol' \
  "$root/qvcore/controls" \
  --glob '!AGENTS.md' --glob '!check' --glob '!install-root'; then
  fail "Apple display control exposes the package executable through sudo"
fi

for inherited_path in "${native_paths[@]}"; do
  stem=${inherited_path##*/omarchy-}
  owner=${owners[$stem]:-}
  [[ -n $owner ]] || fail "unknown native control route: $stem"
  native_adapter="$root/bin/qv-$stem"
  compatibility_adapter="$root/$inherited_path"
  [[ -x $root/qvcore/controls/$owner && -x $native_adapter && -x $compatibility_adapter ]] ||
    fail "control owner or adapter is unavailable: $stem"
  (($(wc -l <"$native_adapter") <= 14)) ||
    fail "native control adapter contains implementation: $stem"
  (($(wc -l <"$compatibility_adapter") <= 8)) ||
    fail "control compatibility adapter contains implementation: $stem"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native control adapter lacks metadata: $stem"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "control compatibility adapter duplicates metadata: $stem"
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    grep -Fqx "exec \"\$QVOS_PATH/qvcore/controls/$owner\" \"\$@\"" "$adapter" ||
      fail "control adapter does not delegate directly: $stem"
  done
done

if rg -n 'omarchy-(audio|brightness|notification|swayosd)-|omarchy-toggle-notification-silencing' \
  "$root/qvcore" "$root/qvcore/config/files" \
  --glob '!**/AGENTS.md' --glob '!**/README.md' \
  --glob '!**/check' \
  --glob '!**/native-paths' --glob '!**/owner-contracts.psv'; then
  fail "native qvOS source still calls a desktop-control compatibility command"
fi

printf 'qvOS desktop control ownership check passed.\n'
