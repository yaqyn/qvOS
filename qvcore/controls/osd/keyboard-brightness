#!/bin/bash
set -euo pipefail

if (($# != 1)) || [[ ! $1 =~ ^[0-9]{1,3}$ ]] || ((10#$1 > 100)); then
  echo "Usage: qv swayosd kbd brightness <0-100>" >&2
  exit 2
fi
percent=$((10#$1))
progress=$(awk -v percent="$percent" 'BEGIN { printf "%.2f", percent / 100 }')
[[ $progress != "0.00" ]] || progress=0.01
controls_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
exec "$controls_root/osd/client" \
  --custom-icon keyboard-brightness-symbolic \
  --custom-progress "$progress" \
  --custom-progress-text "${percent}%"
