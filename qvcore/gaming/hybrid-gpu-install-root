#!/bin/bash
set -euo pipefail

script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
source_dir=$(cd -- "$(dirname -- "$script_path")" && pwd)
system_root=${QVOS_HYBRID_GPU_SYSTEM_ROOT:-}
testing=${QVOS_HYBRID_GPU_TESTING:-}
target_dir="$system_root/usr/lib/qvos/gaming/hybrid-gpu"
expected_uid=0
expected_gid=0
temporary=""

cleanup() {
  [[ -z $temporary || ! -e $temporary ]] || rm -f -- "$temporary"
}
trap cleanup EXIT

if [[ -n $system_root ]]; then
  [[ $testing == "1" && $system_root == /tmp/* && -d $system_root &&
    ! -L $system_root && $(stat -c '%u' -- "$system_root") == "$UID" ]] || {
    echo "Invalid qvOS Hybrid GPU test root." >&2
    exit 2
  }
  expected_uid=$UID
  expected_gid=$(id -g)
elif [[ $target_dir != "/usr/lib/qvos/gaming/hybrid-gpu" ]]; then
  echo "Invalid qvOS Hybrid GPU helper destination." >&2
  exit 1
fi

declare -A source_by_target=(
  [apply]=hybrid-gpu-apply
  [default.json]=hybrid-gpu-default.json
  [delay-start.conf]=hybrid-gpu-delay.conf
  [force-igpu]=hybrid-gpu-force-igpu
)
declare -A mode_by_target=(
  [apply]=0755
  [default.json]=0644
  [delay-start.conf]=0644
  [force-igpu]=0755
)

for target_name in "${!source_by_target[@]}"; do
  source_file="$source_dir/${source_by_target[$target_name]}"
  [[ -f $source_file && ! -L $source_file ]] || {
    echo "Missing qvOS Hybrid GPU helper source: $source_file" >&2
    exit 1
  }
done

safe_directory() {
  local path=$1
  local mode

  [[ -d $path && ! -L $path ]] || return 1
  [[ $(stat -c '%u:%g' -- "$path") == "$expected_uid:$expected_gid" ]] ||
    return 1
  mode=$(stat -c '%a' -- "$path") || return 1
  (((8#$mode & 022) == 0))
}

ensure_directory() {
  local path=$1
  local parent=${path%/*}

  if [[ -e $path || -L $path ]]; then
    safe_directory "$path" || {
      echo "Refusing unsafe qvOS Hybrid GPU helper directory: $path" >&2
      return 1
    }
    return 0
  fi
  safe_directory "$parent" || {
    echo "Refusing unsafe qvOS Hybrid GPU helper parent: $parent" >&2
    return 1
  }
  install -d -o "$expected_uid" -g "$expected_gid" -m 0755 "$path"
}

payload_ready() {
  local target_name
  local source_file
  local target_file
  local mode

  safe_directory "$target_dir" || return 1
  for target_name in "${!source_by_target[@]}"; do
    source_file="$source_dir/${source_by_target[$target_name]}"
    target_file="$target_dir/$target_name"
    mode=${mode_by_target[$target_name]#0}
    [[ -f $target_file && ! -L $target_file ]] || return 1
    [[ $(stat -c '%u:%g:%a' -- "$target_file") == \
      "$expected_uid:$expected_gid:$mode" ]] || return 1
    cmp -s "$source_file" "$target_file" || return 1
  done
}

if payload_ready; then
  exit 0
fi

if [[ -z $system_root && $EUID != 0 ]]; then
  exec sudo -- "$script_path"
fi

ensure_directory "$system_root/usr"
ensure_directory "$system_root/usr/lib"
ensure_directory "$system_root/usr/lib/qvos"
ensure_directory "$system_root/usr/lib/qvos/gaming"
ensure_directory "$target_dir"

for target_name in "${!source_by_target[@]}"; do
  source_file="$source_dir/${source_by_target[$target_name]}"
  target_file="$target_dir/$target_name"
  mode=${mode_by_target[$target_name]}
  if [[ -e $target_file || -L $target_file ]]; then
    [[ -f $target_file && ! -L $target_file ]] || {
      echo "Refusing unsafe qvOS Hybrid GPU helper: $target_file" >&2
      exit 1
    }
    [[ $(stat -c '%u:%g' -- "$target_file") == \
      "$expected_uid:$expected_gid" ]] || {
      echo "Refusing foreign qvOS Hybrid GPU helper: $target_file" >&2
      exit 1
    }
    if [[ $(stat -c '%a' -- "$target_file") == "${mode#0}" ]] &&
      cmp -s "$source_file" "$target_file"; then
      continue
    fi
  fi

  temporary=$(mktemp "$target_dir/.$target_name.XXXXXX")
  install -o "$expected_uid" -g "$expected_gid" -m "$mode" \
    "$source_file" "$temporary"
  mv -f -- "$temporary" "$target_file"
  temporary=""
done

payload_ready || {
  echo "Could not install qvOS Hybrid GPU helpers safely." >&2
  exit 1
}
