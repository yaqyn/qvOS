#!/bin/bash
set -euo pipefail

manifest="$OMARCHY_PATH/qvcore/gaming/retroarch.packages"
declare -A seen=()
count=0

while IFS= read -r package; do
  [[ -n $package && $package != \#* ]] || continue
  [[ $package =~ ^[a-z0-9][a-z0-9@._+-]*$ ]] || {
    echo "Invalid RetroArch package entry: $package" >&2
    exit 1
  }
  [[ -z ${seen[$package]:-} ]] || {
    echo "Duplicate RetroArch package entry: $package" >&2
    exit 1
  }
  seen["$package"]=1
  printf '%s\n' "$package"
  ((count += 1))
done <"$manifest"

(( count > 0 )) || {
  echo "The qvOS RetroArch package manifest is empty." >&2
  exit 1
}
