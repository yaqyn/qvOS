#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/gaming/native-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

expected_paths=$'bin/omarchy-install-gaming-retroarch\nbin/omarchy-install-gaming-xbox-controllers\nbin/omarchy-remove-gaming-retroarch\nbin/omarchy-remove-gaming-xbox-controllers'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest") == "$expected_paths" ]] ||
  fail "native gaming inventory"

declare -A owner_by_route=(
  [bin/omarchy-install-gaming-retroarch]=qvcore/gaming/retroarch-install
  [bin/omarchy-install-gaming-xbox-controllers]=qvcore/gaming/xbox-install
  [bin/omarchy-remove-gaming-retroarch]=qvcore/gaming/retroarch-remove
  [bin/omarchy-remove-gaming-xbox-controllers]=qvcore/gaming/xbox-remove
)
for route in "${!owner_by_route[@]}"; do
  owner=${owner_by_route[$route]}
  [[ -x $root/$route && -x $root/$owner ]] ||
    fail "gaming adapter or owner mode: $route"
  (( $(wc -l <"$root/$route") <= 10 )) ||
    fail "gaming compatibility adapter contains implementation: $route"
  # shellcheck disable=SC2016
  grep -Fqx "exec \"\$OMARCHY_PATH/$owner\" \"\$@\"" "$root/$route" ||
    fail "gaming compatibility adapter: $route"
done

install_packages=$(OMARCHY_PATH="$root" "$root/qvcore/gaming/retroarch-packages")
[[ -z $(printf '%s\n' "$install_packages" | sort | uniq -d) ]] ||
  fail "RetroArch package inventory is not unique"
grep -Fqx 'libretro-database-git' <<<"$install_packages" ||
  fail "RetroArch database package coverage"
if rg -n 'rm[[:space:]]+-rf.*retroarch|\.config/retroarch|\.local/share/retroarch|\.cache/retroarch' \
  "$root/qvcore/gaming/retroarch-remove"; then
  fail "normal RetroArch removal deletes user data"
fi
grep -Fqx 'xbox-controller|package|xpadneo-dkms|tui|true|tui|true|omarchy-install-gaming-xbox-controllers --defer-reboot|omarchy-remove-gaming-xbox-controllers --defer-reboot' \
  "$root/qvcore/menu/software-actions.psv" ||
  fail "Xbox controller TUI reboot deferral"

printf 'ok - gaming owners preserve user data and exact driver state\n'
