#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/gaming/native-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

expected_paths=$'bin/omarchy-install-gaming-retroarch\nbin/omarchy-install-gaming-xbox-controllers\nbin/omarchy-remove-gaming-retroarch\nbin/omarchy-remove-gaming-xbox-controllers\nbin/omarchy-toggle-hybrid-gpu'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest") == "$expected_paths" ]] ||
  fail "native gaming inventory"
retired_manifest="$root/qvcore/gaming/retired-paths"
expected_retired=$'default/systemd/system-sleep/force-igpu\ndefault/systemd/system/supergfxd.service.d/delay-start.conf'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == \
  "$expected_retired" ]] || fail "retired gaming inventory"

declare -A owner_by_route=(
  [install-gaming-retroarch]=qvcore/gaming/retroarch-install
  [install-gaming-xbox-controllers]=qvcore/gaming/xbox-install
  [remove-gaming-retroarch]=qvcore/gaming/retroarch-remove
  [remove-gaming-xbox-controllers]=qvcore/gaming/xbox-remove
  [toggle-hybrid-gpu]=qvcore/gaming/hybrid-gpu-toggle
)
for route in "${!owner_by_route[@]}"; do
  owner=${owner_by_route[$route]}
  native_adapter="$root/bin/qv-$route"
  compatibility_adapter="$root/bin/omarchy-$route"
  [[ -x $native_adapter && -x $compatibility_adapter && -x $root/$owner ]] ||
    fail "gaming adapter or owner mode: $route"
  (( $(wc -l <"$native_adapter") <= 10 )) ||
    fail "native gaming adapter contains implementation: $route"
  (( $(wc -l <"$compatibility_adapter") <= 6 )) ||
    fail "gaming compatibility adapter contains implementation: $route"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native gaming adapter lacks metadata: $route"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "gaming compatibility adapter duplicates metadata: $route"
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    # shellcheck disable=SC2016
    grep -Fqx "exec \"\$QVOS_PATH/$owner\" \"\$@\"" "$adapter" ||
      fail "gaming adapter owner: $route"
  done
done

for helper in \
  hybrid-gpu-apply \
  hybrid-gpu-force-igpu \
  hybrid-gpu-install-root \
  hybrid-gpu-toggle; do
  [[ -x $root/qvcore/gaming/$helper ]] ||
    fail "Hybrid GPU owner mode: $helper"
done
for payload in hybrid-gpu-default.json hybrid-gpu-delay.conf; do
  [[ -f $root/qvcore/gaming/$payload && ! -x $root/qvcore/gaming/$payload ]] ||
    fail "Hybrid GPU payload mode: $payload"
done
for retired in \
  default/systemd/system-sleep/force-igpu \
  default/systemd/system/supergfxd.service.d/delay-start.conf; do
  [[ ! -e $root/$retired && ! -L $root/$retired ]] ||
    fail "retired Hybrid GPU source remains: $retired"
done
if rg -n 'sudo (tee|sed|cp|rm)|rm[[:space:]]+-rf[[:space:]]+/(etc|usr)' \
  "$root/qvcore/gaming/hybrid-gpu-"*; then
  fail "Hybrid GPU owner contains an unsafe direct root mutation"
fi

install_packages=$(QVOS_PATH="$root" "$root/qvcore/gaming/retroarch-packages")
[[ -z $(printf '%s\n' "$install_packages" | sort | uniq -d) ]] ||
  fail "RetroArch package inventory is not unique"
grep -Fqx 'libretro-database-git' <<<"$install_packages" ||
  fail "RetroArch database package coverage"
if rg -n 'rm[[:space:]]+-rf.*retroarch|\.config/retroarch|\.local/share/retroarch|\.cache/retroarch' \
  "$root/qvcore/gaming/retroarch-remove"; then
  fail "normal RetroArch removal deletes user data"
fi
grep -Fqx 'xbox-controller|package|xpadneo-dkms|tui|true|tui|true|qv-install-gaming-xbox-controllers --defer-reboot|qv-remove-gaming-xbox-controllers --defer-reboot' \
  "$root/qvcore/menu/software-actions.psv" ||
  fail "Xbox controller TUI reboot deferral"
# This intentionally matches the literal compatibility fallback expression.
# shellcheck disable=SC2016
compatibility_path_refs=$(
  rg -n 'OMARCHY_PATH' \
    "$root/qvcore/gaming" \
    --glob '!AGENTS.md' \
    --glob '!check' \
    --glob '!native-paths' |
    grep -Fv 'QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}' || true
)
if [[ -n $compatibility_path_refs ]]; then
  printf '%s\n' "$compatibility_path_refs" >&2
  fail "native gaming owner still dereferences the compatibility source root"
fi
if rg -n 'omarchy-(pkg|system)-(add|drop|reboot)' \
  "$root/qvcore/gaming" \
  --glob '!AGENTS.md' \
  --glob '!check' \
  --glob '!native-paths'; then
  fail "native gaming owner still calls a compatibility helper"
fi
if rg -n 'omarchy-(install|remove)-gaming-(retroarch|xbox-controllers)|omarchy-toggle-hybrid-gpu' \
  "$root/qvcore/menu" \
  "$root/qvcore/tui" \
  --glob '!owner-contracts.psv'; then
  fail "native qvOS surfaces still call gaming compatibility routes"
fi

printf 'ok - gaming owners preserve user data and transactional driver state\n'
