#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/gaming/native-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

expected_paths=$'bin/omarchy-install-gaming-geforce-now\nbin/omarchy-install-gaming-gpu-lib32\nbin/omarchy-install-gaming-heroic\nbin/omarchy-install-gaming-lutris\nbin/omarchy-install-gaming-moonlight\nbin/omarchy-install-gaming-retroarch\nbin/omarchy-install-gaming-steam\nbin/omarchy-install-gaming-xbox-cloud\nbin/omarchy-install-gaming-xbox-controllers\nbin/omarchy-remove-gaming-geforce-now\nbin/omarchy-remove-gaming-heroic\nbin/omarchy-remove-gaming-lutris\nbin/omarchy-remove-gaming-minecraft\nbin/omarchy-remove-gaming-moonlight\nbin/omarchy-remove-gaming-retroarch\nbin/omarchy-remove-gaming-steam\nbin/omarchy-remove-gaming-xbox-cloud\nbin/omarchy-remove-gaming-xbox-controllers\nbin/omarchy-toggle-hybrid-gpu'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest") == "$expected_paths" ]] ||
  fail "native gaming inventory"
retired_manifest="$root/qvcore/gaming/retired-paths"
expected_retired=$'default/systemd/system-sleep/force-igpu\ndefault/systemd/system/supergfxd.service.d/delay-start.conf'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == \
  "$expected_retired" ]] || fail "retired gaming inventory"

declare -A owner_by_route=(
  [install-gaming-geforce-now]=qvcore/gaming/geforce-now-install
  [install-gaming-gpu-lib32]=qvcore/gaming/gpu-lib32
  [install-gaming-heroic]=qvcore/gaming/app
  [install-gaming-lutris]=qvcore/gaming/app
  [install-gaming-minecraft]=qvcore/gaming/app
  [install-gaming-moonlight]=qvcore/gaming/app
  [install-gaming-retroarch]=qvcore/gaming/retroarch-install
  [install-gaming-steam]=qvcore/gaming/app
  [install-gaming-xbox-cloud]=qvcore/gaming/xbox-cloud-install
  [install-gaming-xbox-controllers]=qvcore/gaming/xbox-install
  [remove-gaming-geforce-now]=qvcore/gaming/geforce-now-remove
  [remove-gaming-heroic]=qvcore/gaming/app
  [remove-gaming-lutris]=qvcore/gaming/app
  [remove-gaming-minecraft]=qvcore/gaming/app
  [remove-gaming-moonlight]=qvcore/gaming/app
  [remove-gaming-retroarch]=qvcore/gaming/retroarch-remove
  [remove-gaming-steam]=qvcore/gaming/app
  [remove-gaming-xbox-cloud]=qvcore/gaming/xbox-cloud-remove
  [remove-gaming-xbox-controllers]=qvcore/gaming/xbox-remove
  [toggle-hybrid-gpu]=qvcore/gaming/hybrid-gpu-toggle
)
declare -A arguments_by_route=(
  [install-gaming-heroic]='install heroic'
  [install-gaming-lutris]='install lutris'
  [install-gaming-minecraft]='install minecraft'
  [install-gaming-moonlight]='install moonlight'
  [install-gaming-steam]='install steam'
  [remove-gaming-heroic]='remove heroic'
  [remove-gaming-lutris]='remove lutris'
  [remove-gaming-minecraft]='remove minecraft'
  [remove-gaming-moonlight]='remove moonlight'
  [remove-gaming-steam]='remove steam'
)
for route in "${!owner_by_route[@]}"; do
  owner=${owner_by_route[$route]}
  arguments=${arguments_by_route[$route]:-}
  native_adapter="$root/bin/qv-$route"
  compatibility_adapter="$root/bin/omarchy-$route"
  [[ -x $native_adapter && -x $compatibility_adapter && -x $root/$owner ]] ||
    fail "gaming adapter or owner mode: $route"
  (( $(wc -l <"$native_adapter") <= 10 )) ||
    fail "native gaming adapter contains implementation: $route"
  (( $(wc -l <"$compatibility_adapter") <= 6 )) ||
    fail "gaming compatibility adapter contains implementation: $route"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native gaming adapter lacks metadata: $route"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "gaming compatibility adapter duplicates metadata: $route"
  expected_exec="exec \"\$QVOS_PATH/$owner\""
  [[ -z $arguments ]] || expected_exec+=" $arguments"
  expected_exec+=' "$@"'
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    grep -Fqx "$expected_exec" "$adapter" ||
      fail "gaming adapter owner: $route"
  done
done

for owner in \
  app \
  geforce-now-install \
  geforce-now-remove \
  gpu-lib32 \
  steam-remove \
  xbox-cloud-install \
  xbox-cloud-remove; do
  [[ -x $root/qvcore/gaming/$owner ]] || fail "gaming lifecycle owner mode: $owner"
done
[[ -f $root/qvcore/gaming/apps.psv && ! -x $root/qvcore/gaming/apps.psv ]] ||
  fail "gaming app manifest mode"
expected_apps=$'heroic|Heroic Games Launcher|heroic-games-launcher-bin|true\nlutris|Lutris|lutris|true\nminecraft|Minecraft Launcher|minecraft-launcher|false\nmoonlight|Moonlight|moonlight-qt|false\nsteam|Steam|steam|true'
actual_apps=$(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' \
  "$root/qvcore/gaming/apps.psv")
[[ $actual_apps == "$expected_apps" ]] || fail "gaming app package boundary"
[[ -z $(cut -d '|' -f 1 <<<"$actual_apps" | sort | uniq -d) ]] ||
  fail "duplicate gaming app slug"
if rg -n 'setsid|gtk-launch|launch-(browser|webapp)|/usr/bin/lutris|wine-staging' \
  "$root/qvcore/gaming/app" \
  "$root/qvcore/gaming/apps.psv" \
  "$root/qvcore/gaming/geforce-now-install" \
  "$root/qvcore/gaming/xbox-cloud-install"; then
  fail "optional gaming owner launches automatically or modifies shared runtime"
fi
if rg -n 'rm[[:space:]]+-rf|--delete-data' \
  "$root/qvcore/gaming/app" \
  "$root/qvcore/gaming/geforce-now-remove" \
  "$root/qvcore/gaming/xbox-cloud-remove"; then
  fail "normal gaming removal deletes user data"
fi
for curl_option in \
  "--fail" \
  "--proto '=https'" \
  "--proto-redir '=https'" \
  "--connect-timeout 15" \
  "--max-time 1800" \
  "--max-filesize 2147483648"; do
  grep -Fq -- "$curl_option" "$root/qvcore/gaming/geforce-now-install" ||
    fail "GeForce NOW download policy: $curl_option"
done
grep -Fq "gum confirm" "$root/qvcore/gaming/geforce-now-install" ||
  fail "GeForce NOW explicit confirmation"
grep -Fqx '# qvOS intentionally has no bundled webapp desktop launchers.' \
  "$root/qvcore/install/packaging/webapps" || fail "empty bundled Web App policy"

for helper in \
  hybrid-gpu-apply \
  hybrid-gpu-force-igpu \
  hybrid-gpu-install-root \
  hybrid-gpu-toggle; do
  [[ -x $root/qvcore/gaming/$helper ]] ||
    fail "Hybrid GPU owner mode: $helper"
done
for payload in hybrid-gpu-default.json hybrid-gpu-delay.conf; do
  [[ -f $root/qvcore/gaming/$payload && ! -x $root/qvcore/gaming/$payload ]] ||
    fail "Hybrid GPU payload mode: $payload"
done
for retired in \
  default/systemd/system-sleep/force-igpu \
  default/systemd/system/supergfxd.service.d/delay-start.conf; do
  [[ ! -e $root/$retired && ! -L $root/$retired ]] ||
    fail "retired Hybrid GPU source remains: $retired"
done
if rg -n 'sudo (tee|sed|cp|rm)|rm[[:space:]]+-rf[[:space:]]+/(etc|usr)' \
  "$root/qvcore/gaming/hybrid-gpu-"*; then
  fail "Hybrid GPU owner contains an unsafe direct root mutation"
fi
if rg -n 'legacy_(sleep|delay)|validate_legacy|d604e7c490382956|29e4646cf5dcbeac|\$sleep_dir/force-igpu|\$delay_dir/delay-start\.conf' \
  "$root/qvcore/gaming/hybrid-gpu-apply"; then
  fail "retired Hybrid GPU convergence remains active"
fi

install_packages=$(QVOS_PATH="$root" "$root/qvcore/gaming/retroarch-packages")
[[ -z $(printf '%s\n' "$install_packages" | sort | uniq -d) ]] ||
  fail "RetroArch package inventory is not unique"
grep -Fqx 'libretro-database-git' <<<"$install_packages" ||
  fail "RetroArch database package coverage"
if rg -n 'rm[[:space:]]+-rf.*retroarch|\.config/retroarch|\.local/share/retroarch|\.cache/retroarch' \
  "$root/qvcore/gaming/retroarch-remove"; then
  fail "normal RetroArch removal deletes user data"
fi
grep -Fqx 'xbox-controller|package|xpadneo-dkms|tui|true|tui|true|qv-install-gaming-xbox-controllers --defer-reboot|qv-remove-gaming-xbox-controllers --defer-reboot' \
  "$root/qvcore/menu/software-actions.psv" ||
  fail "Xbox controller TUI reboot deferral"
compatibility_path_refs=$(
  rg -n 'OMARCHY_PATH' \
    "$root/qvcore/gaming" \
    --glob '!AGENTS.md' \
    --glob '!check' \
    --glob '!native-paths' || true
)
if [[ -n $compatibility_path_refs ]]; then
  printf '%s\n' "$compatibility_path_refs" >&2
  fail "native gaming owner still dereferences the compatibility source root"
fi
if rg -n 'omarchy-(pkg|system)-(add|drop|reboot)' \
  "$root/qvcore/gaming" \
  --glob '!AGENTS.md' \
  --glob '!check' \
  --glob '!native-paths'; then
  fail "native gaming owner still calls a compatibility helper"
fi
if rg -n 'omarchy-(install|remove)-gaming-|omarchy-toggle-hybrid-gpu' \
  "$root/qvcore/menu" \
  "$root/qvcore/tui" \
  --glob '!owner-contracts.psv'; then
  fail "native qvOS surfaces still call gaming compatibility routes"
fi

printf 'ok - gaming owners preserve user data and transactional driver state\n'
