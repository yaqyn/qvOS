#!/bin/bash
set -euo pipefail

# qvos:contract=qvcore/gaming/retroarch.packages
QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
(( $# == 0 )) || {
  echo "Usage: qv remove gaming retroarch" >&2
  exit 2
}

package_output=$("$QVOS_PATH/qvcore/gaming/retroarch-packages")
mapfile -t packages <<<"$package_output"
qv-pkg-drop "${packages[@]}"

echo
echo "RetroArch and its qvOS core packages were removed."
echo "Configuration, saves, cache, ROMs, and BIOS files were preserved."
