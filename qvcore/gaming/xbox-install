#!/bin/bash
set -euo pipefail

# qvos:contract=qvcore/gaming/xbox-files.psv
QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
defer_reboot=false
case $# in
0) ;;
1)
  [[ $1 == "--defer-reboot" ]] || {
    echo "Usage: qv install gaming xbox controllers [--defer-reboot]" >&2
    exit 2
  }
  defer_reboot=true
  ;;
*) exit 2 ;;
esac

files_owner="$QVOS_PATH/qvcore/gaming/xbox-files"
"$files_owner" check
echo "Installing Xbox controller Bluetooth support..."
qv-pkg-add linux-headers xpadneo-dkms
"$files_owner" write

needs_reboot=false
if ! id -nG "$USER" | grep -w input >/dev/null; then
  sudo usermod -aG input "$USER"
  needs_reboot=true
fi
if lsmod | grep '^xpad ' >/dev/null; then
  sudo modprobe -r xpad 2>/dev/null || needs_reboot=true
fi
if [[ $needs_reboot == "false" ]] && ! sudo modprobe hid_xpadneo; then
  needs_reboot=true
fi

if [[ $needs_reboot == "true" ]]; then
  if [[ $defer_reboot == "true" ]]; then
    echo "qvOS action: reboot required: Xbox controller setup needs a reboot"
  elif gum confirm "Reboot needed to finish Xbox controller setup. Reboot now?"; then
    qv-system-reboot
  fi
fi

echo
echo "Pair the controller from Bluetooth settings after any required reboot."
