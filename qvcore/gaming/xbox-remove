#!/bin/bash
set -euo pipefail

# qvos:contract=qvcore/gaming/xbox-files.psv
QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
defer_reboot=false
case $# in
0) ;;
1)
  [[ $1 == "--defer-reboot" ]] || {
    echo "Usage: qv remove gaming xbox controllers [--defer-reboot]" >&2
    exit 2
  }
  defer_reboot=true
  ;;
*) exit 2 ;;
esac

files_owner="$QVOS_PATH/qvcore/gaming/xbox-files"
"$files_owner" check
qv-pkg-drop xpadneo-dkms
"$files_owner" remove

needs_reboot=false
if lsmod | grep '^hid_xpadneo ' >/dev/null; then
  if sudo modprobe -r hid_xpadneo 2>/dev/null; then
    sudo modprobe xpad 2>/dev/null || needs_reboot=true
  else
    needs_reboot=true
  fi
fi

if [[ $needs_reboot == "true" ]]; then
  if [[ $defer_reboot == "true" ]]; then
    echo "qvOS action: reboot required: Xbox controller driver removal needs a reboot"
  elif gum confirm "Reboot needed to finish removing Xbox controller support. Reboot now?"; then
    qv-system-reboot
  fi
fi

echo
echo "qvOS Xbox controller driver support was removed."
