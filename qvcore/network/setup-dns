#!/bin/bash
set -euo pipefail

# qvos:contract=qvcore/network/dns-policy
# qvos:contract=qvcore/network/install
# qvos:contract=qvcore/network/warp-policy

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
policy_helper=/usr/lib/qvos/network/dns-policy
warp_policy_helper=/usr/lib/qvos/network/warp-policy
policy_install="$QVOS_PATH/qvcore/network/install"
networkctl_command=/usr/bin/networkctl
systemctl_command=/usr/bin/systemctl
sudo_command=/usr/bin/sudo

if [[ ${QVOS_NETWORK_TESTING:-} == "1" ]]; then
  policy_helper=${QVOS_NETWORK_POLICY_HELPER:-$policy_helper}
  warp_policy_helper=${QVOS_NETWORK_WARP_POLICY_HELPER:-$warp_policy_helper}
  policy_install=${QVOS_NETWORK_INSTALL:-$policy_install}
  networkctl_command=${QVOS_NETWORK_NETWORKCTL:-$networkctl_command}
  systemctl_command=${QVOS_NETWORK_SYSTEMCTL:-$systemctl_command}
  sudo_command=${QVOS_NETWORK_SUDO:-$sudo_command}
fi

usage() {
  echo "Usage: qv setup dns [WARP|Cloudflare|Quad9|DHCP|Custom [SERVER ...]]" >&2
}

reload_dns() {
  "$sudo_command" "$networkctl_command" reload
  "$sudo_command" "$systemctl_command" restart systemd-resolved
}

install_network_helpers() {
  [[ -x $policy_install && ! -L $policy_install ]] || {
    echo "The qvOS DNS installer is unavailable." >&2
    return 1
  }
  "$policy_install"
  [[ -x $policy_helper && ! -L $policy_helper ]] || {
    echo "The root-owned qvOS DNS helper is unavailable." >&2
    return 1
  }
  [[ -x $warp_policy_helper && ! -L $warp_policy_helper ]] || {
    echo "The root-owned qvOS WARP privacy helper is unavailable." >&2
    return 1
  }
}

apply_dns_policy() {
  local provider=$1
  shift

  install_network_helpers
  "$policy_helper" validate "$provider" "$@"
  "$sudo_command" "$policy_helper" apply "$provider" "$@"
  reload_dns
  "$policy_helper" check "$provider" "$@"
}

deactivate_warp() {
  qv-cmd-missing warp-cli && return

  if "$systemctl_command" is-active --quiet warp-svc.service; then
    warp-cli disconnect
  fi
  "$sudo_command" "$systemctl_command" disable --now warp-svc.service
}

ensure_warp_registration() {
  if warp-cli --json registration show </dev/null &>/dev/null; then
    return
  fi

  echo "Cloudflare WARP requires accepting its Terms of Service and Privacy Policy:"
  echo "- https://www.cloudflare.com/application/terms/"
  echo "- https://www.cloudflare.com/application/privacypolicy/"
  gum confirm "Accept Cloudflare WARP terms and register this device?" ||
    return 1

  if warp-cli --accept-tos --json registration show </dev/null &>/dev/null; then
    return
  fi

  echo "Registering this device with Cloudflare WARP..."
  warp-cli --accept-tos registration new >/dev/null
}

cleanup_warp_activation() {
  warp-cli disconnect >/dev/null 2>&1 || true
  "$sudo_command" "$systemctl_command" disable --now warp-svc.service || true
}

activate_warp() {
  if qv-cmd-missing warp-cli; then
    echo "Installing Cloudflare WARP..."
    qv-pkg-aur-add cloudflare-warp-nox-bin || return 1
  fi

  install_network_helpers || return 1
  "$sudo_command" "$warp_policy_helper" check || return 1
  "$sudo_command" "$systemctl_command" enable --now warp-svc.service || return 1
  "$sudo_command" "$warp_policy_helper" check || {
    cleanup_warp_activation
    return 1
  }
  if ! ensure_warp_registration; then
    cleanup_warp_activation
    return 1
  fi
  if ! warp-cli mode warp || ! apply_dns_policy DHCP || ! warp-cli connect; then
    cleanup_warp_activation
    return 1
  fi
  warp-cli status
}

if (($# == 0)); then
  dns=$(
    gum choose --height 7 --header "Select WARP or DNS provider" \
      WARP Cloudflare Quad9 DHCP Custom
  )
else
  dns=$1
  shift
fi

case $dns in
WARP | Cloudflare | Quad9 | DHCP | Custom) ;;
*)
  echo "Error: Unknown DNS provider '$dns'." >&2
  usage
  exit 2
  ;;
esac

dns_servers=()
if [[ $dns == "Custom" ]]; then
  if (($# > 0)); then
    dns_servers=("$@")
  else
    echo "Enter literal DNS server addresses separated by spaces:"
    read -r -a dns_servers
  fi
  ((${#dns_servers[@]} > 0)) || {
    echo "Error: No DNS servers provided." >&2
    exit 1
  }
elif (($# > 0)); then
  usage
  exit 2
fi

if [[ $dns == "WARP" ]]; then
  activate_warp
  exit $?
fi

install_network_helpers
"$policy_helper" validate "$dns" "${dns_servers[@]}"
deactivate_warp
"$sudo_command" "$policy_helper" apply "$dns" "${dns_servers[@]}"
reload_dns
"$policy_helper" check "$dns" "${dns_servers[@]}"
