#!/bin/bash
set -euo pipefail

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
branding_owner="$OMARCHY_PATH/qvcore/branding/show-logo"

(( $# > 0 )) || {
  echo "Usage: omarchy-launch-floating-terminal-with-presentation <command> [args...]" >&2
  exit 2
}
if (( $# == 1 )) && [[ $1 == *[[:space:]]* ]]; then
  set -- bash -c "$1"
fi

# shellcheck disable=SC2016
exec setsid uwsm-app -- \
  xdg-terminal-exec \
  --app-id=org.omarchy.terminal \
  --title=qvOS \
  -e bash -c \
  'branding_owner=$1
  shift
  "$branding_owner"
  "$@"
  status=$?
  if ((status == 0)); then
    omarchy-show-done
  elif ((status != 130)); then
    omarchy-show-failed "$status"
  fi
  exit "$status"' \
  _ "$branding_owner" "$@"
