#!/bin/bash
set -euo pipefail

(( $# <= 1 )) || {
  echo "Usage: qv show failed [exit-status]" >&2
  exit 2
}
status=${1:-1}
if [[ ! $status =~ ^[1-9][0-9]{0,2}$ ]] || (( status > 255 )); then
  echo "Invalid exit status: $status" >&2
  exit 2
fi

echo
gum spin \
  --spinner "globe" \
  --title "Failed (exit $status). Press any key to close..." \
  -- bash -c 'read -n 1 -s'
