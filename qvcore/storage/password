#!/bin/bash
set -euo pipefail

# qvos:contract=qvcore/storage/lib
# qvos:contract=qvcore/storage/select
# qvos:contract=qvcore/storage/info

storage_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=qvcore/storage/lib
source "$storage_root/lib"

(( $# == 0 )) || {
  echo "Usage: qv drive password" >&2
  exit 2
}

lsblk=$(qvos_storage_tool lsblk)
cryptsetup=$(qvos_storage_tool cryptsetup)
luks_output=$(qvos_storage_luks_devices)
encrypted_drives=()
[[ -z $luks_output ]] || mapfile -t encrypted_drives <<<"$luks_output"

case ${#encrypted_drives[@]} in
0)
  echo "No encrypted drives are available." >&2
  exit 1
  ;;
1)
  selected=${encrypted_drives[0]}
  ;;
*)
  selected=$("$storage_root/select" "${encrypted_drives[@]}") || exit $?
  ;;
esac

selected=$(qvos_storage_device "$selected")
fstype=$("$lsblk" -dn -o FSTYPE -- "$selected" 2>/dev/null)
fstype=$(qvos_storage_clean_field "$fstype")
[[ $fstype == "crypto_LUKS" ]] || {
  echo "The selected drive is no longer a LUKS device." >&2
  exit 1
}

printf 'Changing the encryption password for %s\n' "$selected"
if ((EUID == 0)); then
  "$cryptsetup" luksChangeKey --verify-passphrase "$selected"
else
  sudo=$(qvos_storage_tool sudo)
  "$sudo" -- "$cryptsetup" luksChangeKey --verify-passphrase "$selected"
fi
