#!/bin/bash
set -euo pipefail

source_file="$OMARCHY_PATH/qvcore/shell/aliases"
runtime_file="$HOME/.local/lib/qvos/shell/aliases"
bashrc="$HOME/.bashrc"
bashrc_existed=0
backup_done=0
staged_bashrc=""
# shellcheck disable=SC2016
runtime_source='source "$HOME/.local/lib/qvos/shell/aliases"'
# shellcheck disable=SC2016
legacy_runtime_source='source "$HOME/.local/share/qvos/shell/aliases"'

cleanup() {
  [[ -z $staged_bashrc ]] || rm -f -- "$staged_bashrc"
}
trap cleanup EXIT

backup_bashrc() {
  local backup_file
  local backup_suffix=0

  if ((bashrc_existed && backup_done == 0)); then
    backup_file="$bashrc.bak.$(date +%s)"
    while [[ -e $backup_file || -L $backup_file ]]; do
      ((backup_suffix += 1))
      backup_file="$bashrc.bak.$(date +%s).$backup_suffix"
    done
    cp -a "$bashrc" "$backup_file"
    backup_done=1
  fi
}

[[ -f $source_file ]] || {
  echo "Missing qvOS shell overlay: $source_file" >&2
  exit 1
}

install -d "$(dirname -- "$runtime_file")"
install -m 0644 "$source_file" "$runtime_file.tmp.$$"
mv -f -- "$runtime_file.tmp.$$" "$runtime_file"
if [[ -e $bashrc ]]; then
  bashrc_existed=1
else
  install -m 0644 /dev/null "$bashrc"
fi

if grep -Fqx "$legacy_runtime_source" "$bashrc"; then
  backup_bashrc
  staged_bashrc=$(mktemp "$(dirname -- "$bashrc")/.bashrc.XXXXXX")
  awk -v legacy="$legacy_runtime_source" '$0 != legacy' "$bashrc" >"$staged_bashrc"
  chmod --reference="$bashrc" "$staged_bashrc"
  mv -f -- "$staged_bashrc" "$bashrc"
  staged_bashrc=""
fi

if ! grep -Fqx "$runtime_source" "$bashrc"; then
  backup_bashrc
  printf '\n%s\n' "$runtime_source" >>"$bashrc"
fi
