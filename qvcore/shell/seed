#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
source_file="$QVOS_PATH/qvcore/shell/files/bashrc"
target_file="$HOME/.bashrc"
chroot_install=${QVOS_CHROOT_INSTALL:-}
testing=${QVOS_SHELL_SEED_TESTING:-}
skel_file=/etc/skel/.bashrc
replace_skeleton=false
staging=""

fail() {
  printf 'qvOS shell seed: %s\n' "$1" >&2
  exit 1
}

cleanup() {
  [[ -z $staging ]] || rm -f -- "$staging"
}
trap cleanup EXIT

(( $# == 0 )) || fail "this command accepts no arguments"
case $chroot_install in
"" | 1) ;;
*) fail "invalid chroot-install signal" ;;
esac
case $testing in
"" | 1) ;;
*) fail "invalid test signal" ;;
esac
if [[ $testing == "1" ]]; then
  [[ $chroot_install == "1" ]] ||
    fail "test mode requires the target-chroot signal"
  skel_file=${QVOS_SHELL_SEED_SKEL_FILE:-}
  [[ $skel_file == /tmp/* && -f $skel_file && ! -L $skel_file &&
    -O $skel_file ]] || fail "unsafe test skeleton Bash file"
elif [[ -n ${QVOS_SHELL_SEED_SKEL_FILE:-} ]]; then
  fail "test skeleton override requires test mode"
fi
[[ $HOME == /* && -d $HOME && ! -L $HOME && -O $HOME ]] ||
  fail "refusing unsafe home directory"
home_mode=$(stat -c '%a' -- "$HOME")
(( (8#$home_mode & 022) == 0 )) || fail "refusing writable home directory"
[[ -f $source_file && ! -L $source_file &&
  $(stat -c '%a' -- "$source_file") == "644" ]] ||
  fail "missing or unsafe Bash seed"

if [[ -e $target_file || -L $target_file ]]; then
  [[ -f $target_file && ! -L $target_file && -O $target_file ]] ||
    fail "refusing unsafe Bash configuration"
  target_mode=$(stat -c '%a' -- "$target_file")
  (( (8#$target_mode & 022) == 0 )) ||
    fail "refusing writable Bash configuration"
  [[ $chroot_install == "1" ]] || exit 0

  [[ -f $skel_file && ! -L $skel_file ]] ||
    fail "missing or unsafe skeleton Bash file"
  skel_mode=$(stat -c '%a' -- "$skel_file")
  (( (8#$skel_mode & 022) == 0 )) ||
    fail "refusing writable skeleton Bash file"
  if [[ $testing == "1" ]]; then
    [[ -O $skel_file ]] || fail "test skeleton Bash file has the wrong owner"
  else
    [[ $(stat -c '%u:%g' -- "$skel_file") == "0:0" ]] ||
      fail "skeleton Bash file has the wrong owner"
  fi
  cmp -s -- "$target_file" "$skel_file" || exit 0
  replace_skeleton=true
fi

staging=$(mktemp "$HOME/.bashrc.qvos.XXXXXX")
install -m 0644 -- "$source_file" "$staging"
if [[ $replace_skeleton == "true" ]]; then
  cmp -s -- "$target_file" "$skel_file" ||
    fail "skeleton Bash file changed during publication"
  mv -fT -- "$staging" "$target_file"
else
  mv -Tn -- "$staging" "$target_file"
fi
if [[ -e $staging || -L $staging ]]; then
  rm -f -- "$staging"
  staging=""
  [[ -f $target_file && ! -L $target_file && -O $target_file ]] ||
    fail "a concurrent process installed an unsafe Bash configuration"
  exit 0
fi
staging=""
