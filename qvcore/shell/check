#!/bin/bash
set -euo pipefail

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
files="$root/qvcore/shell/files"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

[[ ! -e $root/default/bash && ! -L $root/default/bash &&
  ! -e $root/default/bashrc && ! -L $root/default/bashrc ]] ||
  fail "retired inherited Bash source remains"
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' \
  "$root/qvcore/shell/retired-paths") == $'default/bash/\ndefault/bashrc' ]] ||
  fail "retired shell inventory"

expected_files=$'bashrc\ncompletions\nenvs\ninit\ninputrc\nrc\nsettings'
[[ $(find "$files" -maxdepth 1 -type f -printf '%f\n' | sort) == \
  "$expected_files" ]] || fail "native shell file inventory"
[[ -x $root/qvcore/shell/install && -x $root/qvcore/shell/check ]] ||
  fail "shell owner mode"
[[ $(find "$files" "$root/qvcore/shell/aliases" -type f \
  ! -perm 0644 -print -quit) == "" ]] || fail "shell source modes"

# shellcheck disable=SC2016
grep -Fqx 'source "$HOME/.local/share/qvos/qvcore/shell/files/rc"' \
  "$files/bashrc" || fail "native Bash entrypoint"
for component in envs settings init; do
  grep -Fqx \
    "source \"\$HOME/.local/share/qvos/qvcore/shell/files/$component\"" \
    "$files/rc" || fail "native shell component: $component"
done
# shellcheck disable=SC2016
grep -Fqx 'source "$QVOS_PATH/qvcore/shell/files/completions"' \
  "$files/init" || fail "native completion source"
grep -Fqx 'complete -o default -F _qvos_complete qv omarchy' \
  "$files/completions" || fail "qvOS frontend completion"

if rg -n '(default/bash|OMARCHY_PATH|_omarchy_complete)' \
  "$files" "$root/qvcore/shell/aliases"; then
  fail "retired shell implementation remains active"
fi
if rg -n '(default/bash/rc|\.local/share/(omarchy/default/bash|qvos/shell)/aliases?|legacy_(omarchy|qvos|runtime)|alias hx="helix")' \
  "$root/qvcore/shell/install"; then
  fail "retired shell reconciliation remains active"
fi
if rg -n '(^|[[:space:]])(format-drive|iso2sd|fip|dip|tdl|tdlm|tsl|ga|gd)[(=]' \
  "$root/qvcore/shell" --glob '!AGENTS.md' --glob '!check'; then
  fail "unsafe or duplicate legacy shell helper remains"
fi
if grep -Eq '^alias (c|cx|ic|ix|icx)=' "$root/qvcore/shell/aliases"; then
  fail "retired development alias remains"
fi

grep -Fq 'qvcore/shell/files/bashrc' \
  "$root/qvcore/install/config/config.sh" || fail "fresh Bash source"
grep -Fq 'qvcore/shell/files/bashrc' \
  "$root/qvcore/install/reinstall-configs" || fail "reset Bash source"

printf 'ok - qvOS shell is native, minimal, preserving, and source-independent\n'
