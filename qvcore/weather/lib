#!/bin/bash

qvos_weather_fetch() {
  local data

  data=$(curl -fsS --connect-timeout 2 --max-time 4 \
    --max-filesize 1048576 'https://wttr.in?format=j1') || return
  ((${#data} <= 1048576)) || return 1
  jq -e 'type == "object"' <<<"$data" >/dev/null || return
  printf '%s\n' "$data"
}

qvos_weather_icon_for() {
  local weather_code=$1
  local sunrise=$2
  local sunset=$3
  local now_epoch sunrise_epoch sunset_epoch
  local night=false
  local icon

  [[ $weather_code =~ ^[0-9]{3}$ &&
    $sunrise =~ ^[0-9]{1,2}:[0-9]{2}\ [AP]M$ &&
    $sunset =~ ^[0-9]{1,2}:[0-9]{2}\ [AP]M$ ]] || return 1
  now_epoch=${QVOS_WEATHER_NOW_EPOCH:-$(date +%s)}
  [[ $now_epoch =~ ^[0-9]+$ ]] || return 1
  sunrise_epoch=$(LC_ALL=C date -d "today $sunrise" +%s 2>/dev/null) || return
  sunset_epoch=$(LC_ALL=C date -d "today $sunset" +%s 2>/dev/null) || return
  if ((now_epoch < sunrise_epoch || now_epoch >= sunset_epoch)); then
    night=true
  fi

  case $weather_code in
  113)
    if [[ $night == "true" ]]; then
      icon=""
    else
      icon=""
    fi
    ;;
  116)
    if [[ $night == "true" ]]; then
      icon=""
    else
      icon=""
    fi
    ;;
  119 | 122) icon="" ;;
  143 | 248 | 260) icon="" ;;
  176 | 263 | 266 | 293 | 296 | 353)
    if [[ $night == "true" ]]; then
      icon=""
    else
      icon=""
    fi
    ;;
  179 | 227 | 230 | 323 | 326 | 368)
    if [[ $night == "true" ]]; then
      icon=""
    else
      icon=""
    fi
    ;;
  182 | 185 | 281 | 284 | 311 | 314 | 317 | 320 | 350 | 362 | 365 | 374 | 377)
    icon=""
    ;;
  200 | 386 | 389 | 392 | 395) icon="" ;;
  299 | 302 | 305 | 308 | 356 | 359) icon="" ;;
  329 | 332 | 335 | 338 | 371) icon="" ;;
  *) icon="" ;;
  esac
  printf '%s\n' "$icon"
}

qvos_weather_icon_fields() {
  jq -er '
    [
      .current_condition[0].weatherCode,
      .weather[0].astronomy[0].sunrise,
      .weather[0].astronomy[0].sunset
    ]
    | select(all(. != null and . != ""))
    | @tsv
  '
}

qvos_weather_status_fields() {
  jq -er '
    [
      (.nearest_area[0].areaName[0].value // .request[0].query),
      .current_condition[0].temp_C,
      .current_condition[0].winddir16Point,
      .current_condition[0].windspeedKmph,
      .current_condition[0].weatherCode,
      .weather[0].astronomy[0].sunrise,
      .weather[0].astronomy[0].sunset
    ]
    | select(all(. != null and . != ""))
    | @tsv
  '
}
