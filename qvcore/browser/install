#!/bin/bash
set -euo pipefail

# qvos:contract=bin/qv-theme-set-browser

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}

usage() {
  echo "Usage: qv install browser <chrome|brave|brave-origin|edge|firefox|zen>" >&2
}

(( $# == 1 )) || {
  usage
  exit 2
}
browser=$1

setup_policy_directory() {
  "$QVOS_PATH/qvcore/browser/setup-policy" "$1"
}

announce_browser_installed() {
  echo
  echo "$1 browser installed. Make it the default via Settings > Defaults > Browser."
}

copy_chromium_flags() {
  install -D -m 0644 \
    "$QVOS_PATH/config/chromium-flags.conf" \
    "$1"
}

setup_firefox_preferences() {
  local distribution_dir=$1

  setup_policy_directory "$distribution_dir"
  sudo install -m 0644 \
    "$QVOS_PATH/default/firefox/policies.json" \
    "$distribution_dir/policies.json"
}

setup_firefox_wayland() {
  "$QVOS_PATH/qvcore/browser/migrate-runtime-root"
  install -D -m 0644 /dev/stdin \
    "$HOME/.config/environment.d/qvos-firefox-wayland.conf" <<'WAYLAND'
MOZ_ENABLE_WAYLAND=1
WAYLAND
}

case $browser in
chrome)
  echo "Installing Chrome..."
  qv-pkg-aur-add google-chrome
  setup_policy_directory /etc/opt/chrome/policies/managed
  copy_chromium_flags "$HOME/.config/chrome-flags.conf"
  qv-theme-set-browser
  announce_browser_installed "Chrome"
  ;;
edge)
  echo "Installing Edge..."
  qv-pkg-aur-add microsoft-edge-stable-bin
  setup_policy_directory /etc/opt/edge/policies/managed
  copy_chromium_flags "$HOME/.config/microsoft-edge-stable-flags.conf"
  qv-theme-set-browser
  announce_browser_installed "Edge"
  ;;
brave)
  echo "Installing Brave..."
  qv-pkg-aur-add brave-bin
  setup_policy_directory /etc/brave/policies/managed
  copy_chromium_flags "$HOME/.config/brave-flags.conf"
  qv-theme-set-browser
  announce_browser_installed "Brave"
  ;;
brave-origin)
  echo "Installing Brave Origin..."
  qv-pkg-aur-add brave-origin-beta-bin
  setup_policy_directory /etc/brave/policies/managed
  install -D -m 0644 /dev/stdin \
    "$HOME/.config/brave-origin-beta-flags.conf" <<'FLAGS'
--load-extension=~/.local/share/qvos/default/chromium/extensions/copy-url
FLAGS
  qv-theme-set-browser
  announce_browser_installed "Brave Origin"
  ;;
firefox)
  echo "Installing Firefox..."
  qv-pkg-add firefox
  setup_firefox_preferences /usr/lib/firefox/distribution
  setup_firefox_wayland
  announce_browser_installed "Firefox"
  ;;
zen)
  echo "Installing Zen..."
  qv-pkg-aur-add zen-browser-bin
  setup_firefox_preferences /opt/zen-browser/distribution
  setup_firefox_wayland
  announce_browser_installed "Zen"
  ;;
*)
  usage
  exit 2
  ;;
esac
