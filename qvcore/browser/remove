#!/bin/bash
set -euo pipefail

# qvos:contract=bin/qv-default-browser

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}

usage() {
  echo "Usage: qv remove browser <chrome|brave|brave-origin|edge|firefox|zen>" >&2
}

(( $# == 1 )) || {
  usage
  exit 2
}
browser=$1

set_fallback_default_browser() {
  local removed_desktop=$1
  local current_browser
  current_browser=$(xdg-settings get default-web-browser)

  [[ $current_browser == "$removed_desktop" ]] || return 0
  qv-cmd-present chromium || {
    echo "Chromium is unavailable; refusing to remove the active default browser." >&2
    return 1
  }

  qv-default-browser chromium
}

remove_policy_files() {
  sudo rm -f -- "$@"
}

remove_firefox_wayland_if_unused() {
  local wayland_file="$HOME/.config/environment.d/qvos-firefox-wayland.conf"

  if qv-pkg-missing firefox && qv-pkg-missing zen-browser-bin; then
    [[ -e $wayland_file || -L $wayland_file ]] || return 0
    if [[ ! -L $wayland_file && -f $wayland_file && -O $wayland_file ]] &&
      [[ $(<"$wayland_file") == "MOZ_ENABLE_WAYLAND=1" ]]; then
      unlink -- "$wayland_file"
    else
      printf 'Preserving modified Firefox Wayland environment: %s\n' \
        "$wayland_file" >&2
    fi
  fi
}

case $browser in
chrome)
  echo "Removing Chrome..."
  set_fallback_default_browser google-chrome.desktop
  qv-pkg-drop google-chrome
  rm -f -- "$HOME/.config/chrome-flags.conf"
  remove_policy_files /etc/opt/chrome/policies/managed/color.json
  ;;
edge)
  echo "Removing Edge..."
  set_fallback_default_browser microsoft-edge.desktop
  qv-pkg-drop microsoft-edge-stable-bin
  rm -f -- "$HOME/.config/microsoft-edge-stable-flags.conf"
  remove_policy_files /etc/opt/edge/policies/managed/color.json
  ;;
brave)
  echo "Removing Brave..."
  set_fallback_default_browser brave-browser.desktop
  qv-pkg-drop brave-bin
  rm -f -- "$HOME/.config/brave-flags.conf"
  if qv-pkg-missing brave-origin-beta-bin; then
    remove_policy_files /etc/brave/policies/managed/color.json
  fi
  ;;
brave-origin)
  echo "Removing Brave Origin..."
  set_fallback_default_browser brave-origin-beta.desktop
  qv-pkg-drop brave-origin-beta-bin
  rm -f -- "$HOME/.config/brave-origin-beta-flags.conf"
  if qv-pkg-missing brave-bin; then
    remove_policy_files /etc/brave/policies/managed/color.json
  fi
  ;;
firefox)
  echo "Removing Firefox..."
  set_fallback_default_browser firefox.desktop
  qv-pkg-drop firefox
  remove_policy_files \
    /usr/lib/firefox/distribution/color.json \
    /usr/lib/firefox/distribution/policies.json
  remove_firefox_wayland_if_unused
  ;;
zen)
  echo "Removing Zen..."
  set_fallback_default_browser zen.desktop
  qv-pkg-drop zen-browser-bin
  remove_policy_files \
    /opt/zen-browser/distribution/color.json \
    /opt/zen-browser/distribution/policies.json
  remove_firefox_wayland_if_unused
  ;;
*)
  usage
  exit 2
  ;;
esac
