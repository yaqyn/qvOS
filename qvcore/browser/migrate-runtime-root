#!/bin/bash
set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
legacy_wayland="$config_home/environment.d/omarchy-firefox-wayland.conf"
native_wayland="$config_home/environment.d/qvos-firefox-wayland.conf"
expected_wayland='MOZ_ENABLE_WAYLAND=1'
legacy_extension_omarchy='--load-extension=~/.local/share/omarchy/default/chromium/extensions/copy-url'
legacy_extension_qvos='--load-extension=~/.local/share/qvos/default/chromium/extensions/copy-url'
native_extension='--load-extension=~/.local/share/qvos/qvcore/browser/extensions/copy-url'
temporary=""
mode=migrate

case ${1:-} in
"") ;;
--remove) mode=remove ;;
*)
  echo "Usage: migrate-runtime-root [--remove]" >&2
  exit 2
  ;;
esac
(($# <= 1)) || {
  echo "Usage: migrate-runtime-root [--remove]" >&2
  exit 2
}

cleanup() {
  [[ -z $temporary || ! -e $temporary ]] || unlink -- "$temporary"
}
trap cleanup EXIT

remove_exact_wayland() {
  local path=$1

  [[ -e $path || -L $path ]] || return 0
  if [[ ! -L $path && -f $path && -O $path ]] &&
    [[ $(<"$path") == "$expected_wayland" ]]; then
    unlink -- "$path"
  else
    echo "Preserving modified Firefox Wayland environment: $path" >&2
  fi
}

migrate_firefox_wayland() {
  [[ -e $legacy_wayland || -L $legacy_wayland ]] || return 0

  if [[ -L $legacy_wayland || ! -f $legacy_wayland ||
    ! -O $legacy_wayland ]] ||
    [[ $(<"$legacy_wayland") != "$expected_wayland" ]]; then
    echo "Preserving modified Firefox Wayland environment: $legacy_wayland" >&2
    return 0
  fi

  if [[ -e $native_wayland || -L $native_wayland ]]; then
    if [[ ! -L $native_wayland && -f $native_wayland &&
      -O $native_wayland ]] &&
      [[ $(<"$native_wayland") == "$expected_wayland" ]]; then
      unlink -- "$legacy_wayland"
    else
      echo "Preserving Firefox Wayland environment conflict: $legacy_wayland" >&2
    fi
    return 0
  fi

  mv -n -- "$legacy_wayland" "$native_wayland"
  if [[ -e $legacy_wayland || -L $legacy_wayland ]]; then
    echo "Preserving Firefox Wayland environment after a concurrent change: $legacy_wayland" >&2
    return 0
  fi
  chmod 0644 "$native_wayland"
}

migrate_copy_url_flag() {
  local path=$1
  local backup
  local changed=0
  local line
  local native_present=false

  [[ -e $path || -L $path ]] || return 0
  [[ -f $path && ! -L $path ]] || {
    printf 'Preserving unsafe browser flags file: %s\n' "$path" >&2
    return 0
  }
  [[ $(stat -c '%u' -- "$path") == "$EUID" ]] || {
    printf 'Preserving foreign browser flags file: %s\n' "$path" >&2
    return 0
  }
  (( $(stat -c '%s' -- "$path") <= 1048576 )) || {
    printf 'Preserving oversized browser flags file: %s\n' "$path" >&2
    return 0
  }

  grep -Fqx -- "$native_extension" "$path" && native_present=true
  temporary=$(mktemp "${path%/*}/.qvos-browser-flags.XXXXXX")
  while IFS= read -r line || [[ -n $line ]]; do
    case $line in
    "$legacy_extension_omarchy" | "$legacy_extension_qvos")
      ((changed += 1))
      if [[ $native_present == "false" ]]; then
        printf '%s\n' "$native_extension" >>"$temporary"
        native_present=true
      fi
      ;;
    *) printf '%s\n' "$line" >>"$temporary" ;;
    esac
  done <"$path"

  if ((changed == 0)); then
    unlink -- "$temporary"
    temporary=""
    return 0
  fi

  chmod --reference="$path" "$temporary"
  backup=$(mktemp "$path.qvos-backup.XXXXXX")
  if ! cp -p -- "$path" "$backup"; then
    unlink -- "$backup"
    return 1
  fi
  if ! mv -- "$temporary" "$path"; then
    unlink -- "$backup"
    return 1
  fi
  temporary=""
  printf 'Migrated qvOS Copy URL extension path; backup: %s\n' "$backup"
}

if [[ $mode == "remove" ]]; then
  remove_exact_wayland "$native_wayland"
  remove_exact_wayland "$legacy_wayland"
  exit 0
fi

migrate_firefox_wayland
for flags_file in \
  chromium-flags.conf \
  chrome-flags.conf \
  brave-flags.conf \
  brave-origin-beta-flags.conf \
  microsoft-edge-stable-flags.conf; do
  migrate_copy_url_flag "$config_home/$flags_file"
done
