#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}

if (($# != 0)); then
  printf 'Usage: qv refresh chromium\n' >&2
  exit 2
fi

"$QVOS_PATH/qvcore/browser/migrate-runtime-root"
"$QVOS_PATH/qvcore/browser/retire-google-oauth"
"$QVOS_PATH/qvcore/config/refresh" chromium-flags.conf
