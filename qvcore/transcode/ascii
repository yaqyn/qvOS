#!/bin/bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: qv transcode ascii <input-image> <output-path> [options]

Transcode an image into bounded Braille or block terminal art.

Options:
  -w, --width <columns>       Width from 1-400 (default: 80)
  -H, --height <rows>         Height from 1-200 (default: 26)
  -m, --mode <braille|block>  Output style (default: braille)
  -t, --threshold <percent>   Pixel threshold from 0-100 (default: 50)
      --invert                Treat light pixels as the logo
      --no-trim               Preserve surrounding whitespace
      --help                  Show this help
EOF
}

width=80
height=26
mode=braille
threshold=50
invert=false
trim=true
image_path=""
output_path=""
temporary_output=""
output_existed=false
output_identity=""
output_mode=""

cleanup() {
  [[ -z $temporary_output || ! -e $temporary_output ]] ||
    rm -f -- "$temporary_output"
}
trap cleanup EXIT

while (( $# > 0 )); do
  case $1 in
  --help)
    usage
    exit
    ;;
  -w | --width | -H | --height | -m | --mode | -t | --threshold)
    option=$1
    (( $# >= 2 )) || {
      echo "Missing value for $option" >&2
      exit 2
    }
    value=$2
    case $option in
    -w | --width) width=$value ;;
    -H | --height) height=$value ;;
    -m | --mode) mode=$value ;;
    -t | --threshold) threshold=$value ;;
    esac
    shift 2
    continue
    ;;
  --width=*) width=${1#*=} ;;
  --height=*) height=${1#*=} ;;
  --mode=*) mode=${1#*=} ;;
  --threshold=*) threshold=${1#*=} ;;
  --block | --blocks) mode=block ;;
  --braille) mode=braille ;;
  --invert) invert=true ;;
  --no-trim) trim=false ;;
  --)
    shift
    while (( $# > 0 )); do
      if [[ -z $image_path ]]; then
        image_path=$1
      elif [[ -z $output_path ]]; then
        output_path=$1
      else
        echo "Unexpected argument: $1" >&2
        exit 2
      fi
      shift
    done
    break
    ;;
  -*)
    echo "Unknown option: $1" >&2
    usage >&2
    exit 2
    ;;
  *)
    if [[ -z $image_path ]]; then
      image_path=$1
    elif [[ -z $output_path ]]; then
      output_path=$1
    else
      echo "Unexpected argument: $1" >&2
      usage >&2
      exit 2
    fi
    ;;
  esac
  shift
done

[[ -n $image_path && -n $output_path ]] || {
  usage >&2
  exit 2
}
if [[ ! $width =~ ^[1-9][0-9]*$ ]] || (( width > 400 )); then
  echo "Invalid width: $width (expected 1-400)" >&2
  exit 2
fi
if [[ ! $height =~ ^[1-9][0-9]*$ ]] || (( height > 200 )); then
  echo "Invalid height: $height (expected 1-200)" >&2
  exit 2
fi
[[ $mode == "braille" || $mode == "block" ]] || {
  echo "Invalid mode: $mode (expected braille or block)" >&2
  exit 2
}
[[ $threshold =~ ^(0|[1-9][0-9]?|100)$ ]] || {
  echo "Invalid threshold: $threshold (expected 0-100)" >&2
  exit 2
}
[[ ! $image_path =~ [[:cntrl:]] && ! $output_path =~ [[:cntrl:]] ]] || {
  echo "Image and output paths cannot contain control characters." >&2
  exit 2
}
[[ -f $image_path ]] || {
  echo "Image file not found: $image_path" >&2
  exit 1
}
image_path=$(realpath -e -- "$image_path")

output_parent=$(dirname -- "$output_path")
[[ -d $output_parent ]] || {
  echo "Output directory not found: $output_parent" >&2
  exit 1
}
output_parent=$(realpath -e -- "$output_parent")
output_path="$output_parent/$(basename -- "$output_path")"
if [[ -e $output_path || -L $output_path ]]; then
  [[ -f $output_path && ! -L $output_path && -O $output_path ]] || {
    echo "Refusing unsafe terminal-art output: $output_path" >&2
    exit 1
  }
  [[ ! $image_path -ef $output_path ]] || {
    echo "Refusing to replace the input image with terminal art." >&2
    exit 1
  }
  output_existed=true
  output_identity=$(stat -Lc '%d:%i' -- "$output_path")
  output_mode=$(stat -Lc '%a' -- "$output_path")
fi

if qv-cmd-missing magick; then
  echo "Terminal-art conversion requires ImageMagick." >&2
  exit 1
fi

case $mode in
braille)
  pixel_width=$((width * 2))
  pixel_height=$((height * 4))
  ;;
block)
  pixel_width=$width
  pixel_height=$((height * 2))
  ;;
esac

limits=(
  -limit memory 512MiB
  -limit map 1GiB
  -limit disk 2GiB
  -limit time 60
)
alpha_range=$(magick "${limits[@]}" -background none "$image_path" \
  -alpha extract -format '%[fx:minima] %[fx:maxima]' info: 2>/dev/null) || {
  echo "Unable to read image: $image_path" >&2
  exit 1
}
read -r alpha_min alpha_max extra <<<"$alpha_range"
[[ -n $alpha_min && -n $alpha_max && -z ${extra:-} ]] || {
  echo "ImageMagick returned invalid alpha data." >&2
  exit 1
}

use_alpha=false
if awk -v min="$alpha_min" -v max="$alpha_max" \
  'BEGIN { exit !(min < 0.999 && max > min) }'; then
  use_alpha=true
fi

magick_args=("${limits[@]}" -background none "$image_path" -auto-orient)
if [[ $use_alpha == "true" ]]; then
  magick_args+=(-alpha extract -alpha off)
  [[ $invert != "true" ]] || magick_args+=(-negate)
else
  magick_args+=(-alpha remove -alpha off -colorspace Gray)
  [[ $invert == "true" ]] || magick_args+=(-negate)
fi
[[ $trim != "true" ]] ||
  magick_args+=(-bordercolor black -border 1 -trim +repage)
magick_args+=(
  -resize "${pixel_width}x${pixel_height}"
  -threshold "${threshold}%"
  -negate
  -compress none
  pbm:-
)

temporary_output=$(mktemp -- "$output_parent/.qvos-terminal-art.XXXXXX")
if ! magick "${magick_args[@]}" | awk \
  -v render_mode="$mode" \
  -v maximum_width="$pixel_width" \
  -v maximum_height="$pixel_height" '
    BEGIN {
      braille_base = 10240
      dot[0,0] = 1
      dot[0,1] = 2
      dot[0,2] = 4
      dot[1,0] = 8
      dot[1,1] = 16
      dot[1,2] = 32
      dot[0,3] = 64
      dot[1,3] = 128
      block["11"] = "█"
      block["10"] = "▀"
      block["01"] = "▄"
      block["00"] = " "
    }
    {
      sub(/#.*/, "")
      for (field = 1; field <= NF; field++) {
        token[++token_count] = $field
      }
    }
    END {
      if (token[1] != "P1" || token[2] !~ /^[0-9]+$/ ||
          token[3] !~ /^[0-9]+$/) {
        exit 1
      }
      width = token[2]
      height = token[3]
      if (width < 1 || height < 1 || width > maximum_width ||
          height > maximum_height || token_count != 3 + (width * height)) {
        exit 1
      }

      pixel_offset = 4
      y_step = render_mode == "braille" ? 4 : 2
      x_step = render_mode == "braille" ? 2 : 1
      for (y = 0; y < height; y += y_step) {
        line = ""
        for (x = 0; x < width; x += x_step) {
          if (render_mode == "braille") {
            code = 0
            for (dy = 0; dy < 4; dy++) {
              for (dx = 0; dx < 2; dx++) {
                if (y + dy < height && x + dx < width) {
                  pixel = token[pixel_offset + ((y + dy) * width) + x + dx]
                  if (pixel == 1) {
                    code += dot[dx,dy]
                  }
                }
              }
            }
            line = line (code == 0 ? " " : sprintf("%c", braille_base + code))
          } else {
            top = token[pixel_offset + (y * width) + x]
            bottom = y + 1 < height ?
              token[pixel_offset + ((y + 1) * width) + x] : 0
            line = line block[top bottom]
          }
        }
        sub(/[ ]+$/, "", line)
        lines[++line_count] = line
      }

      first = 1
      while (first <= line_count && lines[first] ~ /^[ ]*$/) {
        first++
      }
      last = line_count
      while (last >= first && lines[last] ~ /^[ ]*$/) {
        last--
      }
      for (line_number = first; line_number <= last; line_number++) {
        print lines[line_number]
      }
    }
  ' >"$temporary_output"; then
  echo "Unable to convert image: $image_path" >&2
  exit 1
fi
[[ -s $temporary_output ]] || {
  echo "No terminal-art pixels found in: $image_path" >&2
  exit 1
}

if [[ $output_existed == "true" ]]; then
  [[ -f $output_path && ! -L $output_path && -O $output_path &&
    $(stat -Lc '%d:%i' -- "$output_path") == "$output_identity" ]] || {
    echo "Terminal-art destination changed during conversion: $output_path" >&2
    exit 1
  }
  chmod "$output_mode" "$temporary_output"
  mv -fT -- "$temporary_output" "$output_path"
else
  [[ ! -e $output_path && ! -L $output_path ]] || {
    echo "Terminal-art destination appeared during conversion: $output_path" >&2
    exit 1
  }
  ln -- "$temporary_output" "$output_path"
  rm -f -- "$temporary_output"
fi
temporary_output=""
printf 'Wrote terminal art to %q\n' "$output_path"
