#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}

stop_update_tree() {
  trap - HUP TERM
  trap '' INT
  kill -INT -- "-$$" 2>/dev/null || true
}

trap stop_update_tree HUP TERM

capture_update_log() {
  trap '' HUP INT TERM
  exec tee "$1"
}

case ${1:-} in
"")
  update_log=$("$QVOS_PATH/qvcore/update/log-path" prepare)
  set +e
  QVOS_UPDATE_CAPTURED=1 \
    QVOS_UPDATE_DEFER_REBOOT=1 \
    QVOS_UPDATE_LOG_PATH="$update_log" \
    qv-update -y 2>&1 |
    capture_update_log "$update_log"
  statuses=("${PIPESTATUS[@]}")
  if ((statuses[0] != 0)); then
    exit "${statuses[0]}"
  fi
  exit "${statuses[1]}"
  ;;
--check)
  exec qv-update --check
  ;;
*)
  echo "Usage: qvcore/tui/update/run [--check]" >&2
  exit 2
  ;;
esac
