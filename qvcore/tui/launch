#!/bin/bash
set -euo pipefail

if (($# < 2)); then
  echo "Usage: qvcore/tui/launch <title> <command> [args...]" >&2
  exit 2
fi

export QVOS_TUI_ROOT=${QVOS_TUI_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}
title=$1
shift

exec setsid uwsm-app -- \
  xdg-terminal-exec \
  --app-id=org.qvos.tui \
  --title="$title" \
  -e "$@"
