#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
tui_root=${QVOS_TUI_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}
# shellcheck source=qvcore/tui/selection-owner
source "$tui_root/selection-owner"
# shellcheck source=qvcore/tui/owner-resolver
source "$tui_root/owner-resolver"
# shellcheck source=qvcore/tui/action/rollback-owner
source "$tui_root/action/rollback-owner"
catalog="$QVOS_PATH/qvcore/menu/software-actions.psv"
rollback_catalog="$tui_root/action/rollbacks.psv"
state_owner="$QVOS_PATH/qvcore/menu/software-state"
slug=${QVOS_ACTION_SLUG:-}
operation=${QVOS_ACTION_OPERATION:-}
selection_mode=${QVOS_ACTION_SELECTION_MODE:-}
rollback_protocol=${QVOS_ACTION_ROLLBACK:-}
rollback_state=${QVOS_ACTION_ROLLBACK_STATE:-}
post_action=${QVOS_ACTION_POST_SUCCESS:-}
post_phase=${QVOS_ACTION_POST_PHASE:-0}

action_record() {
  awk -F '|' -v wanted="$slug" '
    $1 !~ /^#/ && NF == 9 && $1 == wanted {
      print
      found = 1
      exit
    }
    END { exit !found }
  ' "$catalog"
}

load_action() {
  local record

  [[ $operation == "install" || $operation == "uninstall" ]] || {
    echo "Invalid qvOS action operation." >&2
    return 2
  }
  record=$(action_record) || {
    echo "Unknown qvOS software action: $slug" >&2
    return 2
  }
  IFS='|' read -r \
    _ \
    _ \
    _ \
    install_presentation \
    _ \
    uninstall_presentation \
    _ \
    install_owner \
    uninstall_owner <<<"$record"

  if [[ $operation == "install" ]]; then
    presentation=$install_presentation
    owner_command=$install_owner
  else
    presentation=$uninstall_presentation
    owner_command=$uninstall_owner
  fi
  [[ $presentation == "tui" ]] || {
    echo "The $slug $operation owner requires its native interactive terminal." >&2
    return 2
  }
  read -r -a owner_args <<<"$owner_command"
  ((${#owner_args[@]} > 0)) || {
    echo "Missing qvOS action owner for $slug." >&2
    return 1
  }
  qvos_resolve_owner owner_args
  [[ -z $selection_mode || $selection_mode == "single" ||
    $selection_mode == "multi" || $selection_mode == "action" ]] || {
    echo "Invalid qvOS software selection mode: $selection_mode" >&2
    return 2
  }
}

preflight() {
  local current_state
  local state_message

  rollback_preflight
  qvos_owner_rollback_check "$rollback_protocol" "${owner_args[@]}"
  current_state=$("$state_owner" "$slug")
  [[ $current_state == "$operation" ]] || {
    if [[ $current_state == "uninstall" ]]; then
      state_message="already installed"
    else
      state_message="not installed"
    fi
    echo "$slug is $state_message; reopen Software to refresh its action." >&2
    return 1
  }
}

rollback_preflight() {
  [[ -f $catalog && -x $state_owner ]] || {
    echo "The qvOS software action source is incomplete." >&2
    return 1
  }
  [[ -x ${owner_args[0]} ]] || command -v "${owner_args[0]}" >/dev/null 2>&1 || {
    echo "The qvOS action owner is unavailable: ${owner_args[0]}" >&2
    return 1
  }
  qvos_owner_rollback_validate "$rollback_catalog" "$slug" "$operation" "$rollback_protocol"
}

show_form() {
  [[ ${QVOS_ACTION_FORM:-} == "owner-json-v1" ]] || {
    echo "The $slug action has no form contract." >&2
    return 2
  }
  "${owner_args[@]}" --qvos-form
}

verify_result() {
  local next_state

  next_state=$("$state_owner" "$slug")
  if [[ $operation == "install" && $next_state != "uninstall" ]]; then
    echo "The $slug installation owner finished without an installed result." >&2
    return 1
  fi
  if [[ $operation == "uninstall" && $next_state != "install" ]]; then
    echo "The $slug uninstall owner finished without removing the software." >&2
    return 1
  fi
}

cancel_status() {
  local current_state

  if ! current_state=$("$state_owner" "$slug" 2>/dev/null); then
    printf 'unknown\n'
  elif [[ $current_state == "$operation" ]]; then
    printf 'target-not-detected\n'
  else
    printf 'target-reached\n'
  fi
}

run_post_success() {
  local current_state

  [[ $operation == "install" && $post_action == "owner-v1" ]] || {
    echo "The $slug action has no post-success owner." >&2
    return 2
  }
  current_state=$("$state_owner" "$slug")
  [[ $current_state == "uninstall" ]] || {
    echo "$slug is not installed; refusing its post-success action." >&2
    return 1
  }
  [[ $rollback_protocol == "owner-state-v1" && -n $rollback_state ]] || {
    echo "The $slug post-success action has no safe Stop owner." >&2
    return 1
  }
  "${owner_args[@]}" --qvos-post-success-rollback-check
  "${owner_args[@]}" --qvos-post-success-rollback-snapshot "$rollback_state"
  echo "qvOS action: applying"
  "${owner_args[@]}" --qvos-post-success
  "${owner_args[@]}" --qvos-post-success-rollback-seal "$rollback_state"
  echo "qvOS action: complete"
}

post_preflight() {
  local current_state

  [[ $operation == "install" && $post_action == "owner-v1" &&
    $rollback_protocol == "owner-state-v1" ]] || {
    echo "The $slug post-success action contract is incomplete." >&2
    return 2
  }
  rollback_preflight
  current_state=$("$state_owner" "$slug")
  [[ $current_state == "uninstall" ]] || {
    echo "$slug is not installed; refusing its post-success action." >&2
    return 1
  }
  "${owner_args[@]}" --qvos-post-success-rollback-check
}

post_rollback_restore() {
  [[ $post_phase == "1" && $rollback_protocol == "owner-state-v1" && -n $rollback_state ]] || {
    echo "The $slug post-success rollback contract is incomplete." >&2
    return 1
  }
  "${owner_args[@]}" --qvos-post-success-rollback-restore "$rollback_state"
}

post_cancel_status() {
  [[ $post_phase == "1" && -n $rollback_state ]] || return 2
  "${owner_args[@]}" --qvos-post-success-cancel-status "$rollback_state"
}

list_options() {
  [[ -n $selection_mode ]] || {
    echo "The $slug action has no selection contract." >&2
    return 2
  }
  qvos_selection_list_owner owner_args
}

load_selections() {
  [[ -n $selection_mode ]] || return 0
  qvos_selection_apply_owner "$selection_mode" owner_args "$slug"
}

load_action

case ${1:-} in
--check)
  (($# == 1)) || exit 2
  preflight
  exit
  ;;
--options)
  (($# == 1)) || exit 2
  preflight
  list_options
  exit
  ;;
--form)
  (($# == 1)) || exit 2
  preflight
  show_form
  exit
  ;;
--rollback)
  (($# == 1)) || exit 2
  if [[ $post_phase == "1" ]]; then
    post_rollback_restore
    exit
  fi
  rollback_preflight
  qvos_owner_rollback_restore "$rollback_protocol" "$rollback_state" "${owner_args[@]}"
  exit
  ;;
--cancel-status)
  (($# == 1)) || exit 2
  if [[ $post_phase == "1" ]]; then
    post_cancel_status
    exit
  fi
  cancel_status
  exit
  ;;
--post-success)
  (($# == 1)) || exit 2
  run_post_success
  exit
  ;;
--post-success-check)
  (($# == 1)) || exit 2
  post_preflight
  exit
  ;;
"")
  ;;
*)
  echo "Usage: qvcore/tui/action/run [--check|--options|--form|--rollback|--cancel-status|--post-success|--post-success-check]" >&2
  exit 2
  ;;
esac

preflight
load_selections
qvos_owner_rollback_snapshot "$rollback_protocol" "$rollback_state" "${owner_args[@]}"
echo "qvOS action: preparing"
echo "qvOS action: applying"
"${owner_args[@]}"
qvos_owner_rollback_seal "$rollback_protocol" "$rollback_state" "${owner_args[@]}"
echo "qvOS action: verifying"
verify_result
echo "qvOS action: complete"
