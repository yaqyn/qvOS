#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
OMARCHY_PATH=$QVOS_PATH
tui_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=qvcore/tui/owner-resolver disable=SC1091
source "$tui_root/owner-resolver"
catalog="$OMARCHY_PATH/qvcore/menu/software-actions.psv"
installer_catalog="$OMARCHY_PATH/qvcore/menu/software-installers.psv"
guidance_catalog="$tui_root/success-guidance.psv"
rollback_catalog="$tui_root/action/rollbacks.psv"
choice_catalog="$tui_root/action/choices.psv"
form_catalog="$tui_root/action/forms.psv"
post_action_catalog="$tui_root/action/post-actions.psv"
concepts="$HOME/.local/lib/qvos/menu/concepts.psv"
state_owner="$OMARCHY_PATH/qvcore/menu/software-state"
tui_launch="$tui_root/launch"
mode=stateful
if [[ ${1:-} == "--installer" ]]; then
  mode=installer
  shift
elif [[ ${1:-} == "--post-success" ]]; then
  mode=post
  shift
fi
slug=${1:-}

usage() {
  echo "Usage: qvcore/tui/action/launch [--installer|--post-success] <software-slug>" >&2
}

action_record() {
  awk -F '|' -v wanted="$slug" '
    $1 !~ /^#/ && NF == 9 && $1 == wanted {
      print
      found = 1
      exit
    }
    END { exit !found }
  ' "$catalog"
}

installer_record() {
  awk -F '|' -v wanted="$slug" '
    $1 !~ /^#/ && NF == 11 && $1 == wanted {
      print
      found = 1
      exit
    }
    END { exit !found }
  ' "$installer_catalog"
}

success_guidance() {
  awk -F '|' -v wanted_slug="$slug" -v wanted_operation="$operation" '
    $1 !~ /^#/ && NF == 3 &&
      $1 == wanted_slug && $2 == wanted_operation {
      print $3
      found = 1
      exit
    }
    END { exit !found }
  ' "$guidance_catalog"
}

rollback_contract() {
  awk -F '|' -v wanted_slug="$slug" -v wanted_operation="$operation" '
    $1 !~ /^#/ && NF == 3 &&
      $1 == wanted_slug && $2 == wanted_operation {
      print $3
      found = 1
      exit
    }
    END { exit !found }
  ' "$rollback_catalog"
}

choice_contract() {
  awk -F '|' -v wanted_slug="$slug" -v wanted_operation="$operation" '
    $1 !~ /^#/ && NF == 8 &&
      $1 == wanted_slug && $2 == wanted_operation {
      print
      found = 1
      exit
    }
    END { exit !found }
  ' "$choice_catalog"
}

form_contract() {
  awk -F '|' -v wanted_slug="$slug" -v wanted_operation="$operation" '
    $1 !~ /^#/ && NF == 3 &&
      $1 == wanted_slug && $2 == wanted_operation {
      print $3
      found = 1
      exit
    }
    END { exit !found }
  ' "$form_catalog"
}

post_action_contract() {
  awk -F '|' -v wanted_slug="$slug" -v wanted_operation="$operation" '
    $1 !~ /^#/ && NF == 4 &&
      $1 == wanted_slug && $2 == wanted_operation {
      print $3 "|" $4
      found = 1
      exit
    }
    END { exit !found }
  ' "$post_action_catalog"
}

concept_name() {
  awk -F '|' -v wanted="$slug" '
    $1 !~ /^#/ && $1 == wanted && NF >= 5 {
      print $3
      found = 1
      exit
    }
    END { exit !found }
  ' "$concepts"
}

owner_metadata() {
  local key=$1
  local -a metadata_args=("${owner_args[@]}")
  local owner_path
  local owner_route

  qvos_resolve_owner metadata_args
  owner_route=${metadata_args[0]}
  if [[ -x $owner_route ]]; then
    owner_path=$owner_route
  elif [[ -x $OMARCHY_PATH/bin/$owner_route ]]; then
    owner_path="$OMARCHY_PATH/bin/$owner_route"
  else
    owner_path=$(command -v "$owner_route") || return 1
  fi
  sed -n "s/^# omarchy:${key}=//p" "$owner_path" | head -n 1
}

[[ -n $slug && $# == 1 ]] || {
  usage
  exit 2
}
[[ -x $tui_launch ]] || {
  echo "The qvOS TUI launch surface is incomplete." >&2
  exit 1
}

if [[ $mode == "installer" && ${QVOS_TERMINAL_STATEFUL:-0} != "1" ]]; then
  case $slug in
  alacritty | foot | ghostty | kitty)
    exec "$tui_root/action/terminal-launch" "$slug"
    ;;
  esac
fi

if [[ $mode == "installer" ]]; then
  [[ -f $installer_catalog ]] || {
    echo "Missing qvOS software installer catalog: $installer_catalog" >&2
    exit 1
  }
  record=$(installer_record) || {
    echo "Unknown qvOS software installer: $slug" >&2
    exit 2
  }
  IFS='|' read -r \
    _ \
    _ \
    title \
    _ \
    _ \
    presentation \
    requires_sudo \
    _ \
    _ \
    summary \
    owner_command <<<"$record"
  operation=install
else
  [[ -f $catalog && -f $concepts && -x $state_owner ]] || {
    echo "The qvOS state-aware software action surface is incomplete." >&2
    exit 1
  }
  record=$(action_record) || {
    echo "Unknown qvOS software action: $slug" >&2
    exit 2
  }
  IFS='|' read -r \
    _ \
    _ \
    _ \
    install_presentation \
    install_sudo \
    uninstall_presentation \
    uninstall_sudo \
    install_owner \
    uninstall_owner <<<"$record"

  title=$(concept_name) || {
    echo "Missing qvOS software concept: $slug" >&2
    exit 1
  }
  operation=$("$state_owner" "$slug")
  if [[ $mode == "post" ]]; then
    [[ $operation == "uninstall" ]] || {
      echo "$title must be configured before its post-success action." >&2
      exit 1
    }
    operation=install
  fi
  case $operation in
  install)
    owner_command=$install_owner
    presentation=$install_presentation
    requires_sudo=$install_sudo
    ;;
  uninstall)
    owner_command=$uninstall_owner
    presentation=$uninstall_presentation
    requires_sudo=$uninstall_sudo
    ;;
  *)
    echo "Invalid qvOS software action state: $operation" >&2
    exit 1
    ;;
  esac
  if [[ $mode == "post" ]]; then
    requires_sudo=false
  fi
fi
read -r -a owner_args <<<"$owner_command"
((${#owner_args[@]} > 0)) || {
  echo "Missing qvOS software owner for $slug." >&2
  exit 1
}
[[ -n ${summary:-} ]] || summary=$(owner_metadata "$operation-summary" || true)
[[ -n ${summary:-} ]] || summary=$(owner_metadata summary || true)
[[ -n $summary ]] || summary="${operation^} $title through its existing owner"
[[ $requires_sudo == "true" || $requires_sudo == "false" ]] || {
  echo "Invalid qvOS software sudo contract: $requires_sudo" >&2
  exit 1
}

if [[ $presentation == "native" ]]; then
  exec qv-launch-floating-terminal-with-presentation "${owner_args[@]}"
fi

[[ $presentation == "tui" ]] || {
  echo "Unsupported qvOS action presentation: $presentation" >&2
  exit 1
}
[[ -f $guidance_catalog ]] || {
  echo "The qvOS TUI success guidance catalog is unavailable." >&2
  exit 1
}
if [[ $operation == "install" && ! -f $rollback_catalog ]]; then
  echo "The qvOS TUI install rollback catalog is unavailable." >&2
  exit 1
fi
[[ -f $choice_catalog ]] || {
  echo "The qvOS TUI action-choice catalog is unavailable." >&2
  exit 1
}
[[ -f $form_catalog ]] || {
  echo "The qvOS TUI action-form catalog is unavailable." >&2
  exit 1
}
[[ -f $post_action_catalog ]] || {
  echo "The qvOS TUI post-success action catalog is unavailable." >&2
  exit 1
}

export QVOS_ACTION_SLUG="$slug"
export QVOS_ACTION_OPERATION="$operation"
export QVOS_ACTION_TITLE="$title"
export QVOS_ACTION_SUMMARY="$summary"
export QVOS_ACTION_RINGS=2
export QVOS_ACTION_BEHAVIOR=mutation
unset \
  QVOS_ACTION_PRIMARY \
  QVOS_ACTION_ACTIVE \
  QVOS_ACTION_COMPLETE \
  QVOS_ACTION_NEXT_STEP \
  QVOS_ACTION_ROLLBACK \
  QVOS_ACTION_SELECTION_MODE \
  QVOS_ACTION_SELECTION_TITLE \
  QVOS_ACTION_SELECTION_EMPTY \
  QVOS_ACTION_SUMMARY_SELECTION \
  QVOS_ACTION_SELECTION_SUMMARY \
  QVOS_ACTION_SELECTION_REQUIRES_SUDO \
  QVOS_ACTION_FORM \
  QVOS_ACTION_OWNER_SCRIPT \
  QVOS_ACTION_POST_LABEL \
  QVOS_ACTION_POST_SUCCESS \
  QVOS_ACTION_POST_RESUME
if [[ $mode != "post" ]] && next_step=$(success_guidance 2>/dev/null); then
  export QVOS_ACTION_NEXT_STEP="$next_step"
fi
if [[ $operation == "install" ]] && rollback=$(rollback_contract 2>/dev/null); then
  [[ $rollback == "owner-state-v1" ]] || {
    echo "Invalid qvOS TUI rollback contract for $slug." >&2
    exit 1
  }
  export QVOS_ACTION_ROLLBACK="$rollback"
fi
if [[ $mode != "post" ]] && choice=$(choice_contract 2>/dev/null); then
  IFS='|' read -r \
    _ \
    _ \
    selection_title \
    selection_mode \
    selection_empty \
    summary_selection \
    selection_summary \
    selection_sudo <<<"$choice"
  [[ $selection_mode == "single" || $selection_mode == "multi" ||
    $selection_mode == "action" ]] || {
    echo "Invalid qvOS software action-choice mode: $selection_mode" >&2
    exit 1
  }
  [[ -n $selection_title && -n $selection_empty ]] || {
    echo "Incomplete qvOS software action-choice copy for $slug." >&2
    exit 1
  }
  [[ -n $summary_selection && -n $selection_summary ]] || {
    echo "Incomplete qvOS software action-choice scope for $slug." >&2
    exit 1
  }
  [[ $selection_sudo == "true" || $selection_sudo == "false" ]] || {
    echo "Invalid qvOS software action-choice sudo scope for $slug." >&2
    exit 1
  }
  export QVOS_ACTION_SELECTION_MODE="$selection_mode"
  export QVOS_ACTION_SELECTION_TITLE="$selection_title"
  export QVOS_ACTION_SELECTION_EMPTY="$selection_empty"
  export QVOS_ACTION_SUMMARY_SELECTION="$summary_selection"
  export QVOS_ACTION_SELECTION_SUMMARY="$selection_summary"
  if [[ $selection_sudo == "true" ]]; then
    export QVOS_ACTION_SELECTION_REQUIRES_SUDO=1
  else
    export QVOS_ACTION_SELECTION_REQUIRES_SUDO=0
  fi
fi
if [[ $mode != "post" ]] && form_protocol=$(form_contract 2>/dev/null); then
  [[ $form_protocol == "owner-json-v1" ]] || {
    echo "Invalid qvOS software action-form contract for $slug." >&2
    exit 1
  }
  export QVOS_ACTION_FORM="$form_protocol"
fi
if post_action=$(post_action_contract 2>/dev/null); then
  IFS='|' read -r post_label post_protocol <<<"$post_action"
  [[ -n $post_label && $post_protocol == "owner-v1" ]] || {
    echo "Invalid qvOS post-success action contract for $slug." >&2
    exit 1
  }
  if [[ $mode == "post" ]]; then
    [[ $post_label == "launch" ]] || {
      echo "Unsupported qvOS post-success action for $slug." >&2
      exit 1
    }
    export QVOS_ACTION_POST_LABEL="$post_label"
    export QVOS_ACTION_POST_SUCCESS="$post_protocol"
    export QVOS_ACTION_POST_RESUME=1
  else
    export QVOS_ACTION_POST_LABEL="$post_label"
    export QVOS_ACTION_POST_SUCCESS="$post_protocol"
  fi
elif [[ $mode == "post" ]]; then
  echo "Missing qvOS post-success action contract for $slug." >&2
  exit 1
fi
if [[ $mode == "installer" ]]; then
  export QVOS_ACTION_SCRIPT="$tui_root/action/run-installer"
elif [[ $mode == "post" ]]; then
  export QVOS_ACTION_OWNER_SCRIPT="$tui_root/action/run"
  export QVOS_ACTION_SCRIPT="$tui_root/action/post-run"
else
  export QVOS_ACTION_SCRIPT="$tui_root/action/run"
fi
if [[ $requires_sudo == "true" ]]; then
  export QVOS_ACTION_REQUIRES_SUDO=1
else
  export QVOS_ACTION_REQUIRES_SUDO=0
fi

exec "$tui_launch" "$title" qvos-tui --action
