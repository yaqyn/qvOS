#!/bin/bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
checkout_root=$(cd -- "$script_dir/../../.." && pwd)

if [[ -x $checkout_root/release/iso/build ]]; then
  source_root="$checkout_root"
else
  source_root="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
fi

exec "$source_root/release/iso/build" "$@"
