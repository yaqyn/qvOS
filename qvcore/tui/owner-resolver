#!/bin/bash

qvos_resolve_owner() {
  local array_name=${1:-}
  local owner_route
  local runtime_owner
  local source_owner

  [[ $array_name =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || {
    echo "Invalid qvOS owner argument array." >&2
    return 2
  }
  local -n owner_arguments=$array_name
  ((${#owner_arguments[@]} > 0)) || {
    echo "Missing qvOS owner command." >&2
    return 1
  }

  owner_route=${owner_arguments[0]}
  if [[ $owner_route == qvcore/* ]]; then
    source_owner="$OMARCHY_PATH/$owner_route"
    runtime_owner="$HOME/.local/lib/qvos/${owner_route#qvcore/}"
    if [[ -x $source_owner ]]; then
      owner_arguments[0]=$source_owner
    elif [[ -x $runtime_owner ]]; then
      owner_arguments[0]=$runtime_owner
    else
      owner_arguments[0]=$source_owner
    fi
  elif [[ -x $OMARCHY_PATH/bin/$owner_route ]]; then
    owner_arguments[0]="$OMARCHY_PATH/bin/$owner_route"
  fi
}
