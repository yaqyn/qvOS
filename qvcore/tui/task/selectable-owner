#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
slug=${1:-}
if (($# > 0)); then
  shift
fi

usage() {
  echo "Usage: qvcore/tui/task/selectable-owner <theme-remove|timezone|webapp-remove> [--list|-- selection...]" >&2
}

list_extra_themes() {
  [[ -d $HOME/.config/omarchy/themes ]] || return 0
  find "$HOME/.config/omarchy/themes" \
    -mindepth 1 \
    -maxdepth 1 \
    \( -type d -o -type l \) \
    ! -iname 'yaqyn' \
    ! -name 'yaqyn.bak.*' \
    -printf '%f\n' |
    sort
}

list_options() {
  case $slug in
  theme-remove)
    list_extra_themes
    ;;
  timezone)
    timedatectl list-timezones
    ;;
  webapp-remove)
    "$QVOS_PATH/qvcore/desktop/webapp/remove" --list
    ;;
  *)
    usage
    return 2
    ;;
  esac
}

validate_selections() {
  local available
  local selection
  declare -A allowed=()

  while IFS= read -r available; do
    [[ -n $available ]] && allowed["$available"]=1
  done < <(list_options)

  for selection in "$@"; do
    [[ -n ${allowed[$selection]:-} ]] || {
      echo "Invalid selection for $slug: $selection" >&2
      return 2
    }
  done
}

[[ -n $slug ]] || {
  usage
  exit 2
}
if [[ ${1:-} == "--list" ]]; then
  (($# == 1)) || exit 2
  list_options
  exit
fi
[[ ${1:-} == "--" ]] || {
  usage
  exit 2
}
shift
(($# > 0)) || {
  echo "The $slug task requires a selection." >&2
  exit 2
}
if [[ $slug == "theme-remove" || $slug == "timezone" ]] && (($# != 1)); then
  echo "The $slug task requires exactly one selection." >&2
  exit 2
fi
validate_selections "$@"

case $slug in
theme-remove)
  "$QVOS_PATH/bin/qv-theme-remove" "$1"
  ;;
timezone)
  "$QVOS_PATH/bin/qv-tz-select" -- "$1"
  ;;
webapp-remove)
  "$QVOS_PATH/bin/qv-webapp-remove" "$@"
  ;;
esac
