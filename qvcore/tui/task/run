#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
OMARCHY_PATH=$QVOS_PATH
tui_root=${QVOS_TUI_ROOT:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}
# shellcheck source=qvcore/tui/selection-owner
source "$tui_root/selection-owner"
# shellcheck source=qvcore/tui/owner-resolver
source "$tui_root/owner-resolver"
catalog="$tui_root/task/actions.psv"
selection_catalog="$tui_root/task/selections.psv"
slug=${QVOS_ACTION_SLUG:-}
operation=${QVOS_ACTION_OPERATION:-}
presenter=
selection_mode=

task_record() {
  awk -F '|' -v wanted="$slug" '
    $1 !~ /^#/ && NF == 11 && $1 == wanted {
      print
      found = 1
      exit
    }
    END { exit !found }
  ' "$catalog"
}

selection_record() {
  awk -F '|' -v wanted="$slug" '
    $1 !~ /^#/ && NF == 4 && $1 == wanted {
      print
      found = 1
      exit
    }
    END { exit !found }
  ' "$selection_catalog"
}

load_task() {
  local record
  local selection

  [[ $operation == "task" ]] || {
    echo "Invalid qvOS TUI task operation." >&2
    return 2
  }
  record=$(task_record) || {
    echo "Unknown qvOS TUI task: $slug" >&2
    return 2
  }
  IFS='|' read -r \
    _ \
    _ \
    _ \
    rings \
    behavior \
    presentation \
    _ \
    _ \
    _ \
    _ \
    owner_command <<<"$record"
  [[ $presentation == "tui" ]] || {
    echo "The $slug task requires its native interactive terminal." >&2
    return 2
  }
  [[ $rings == "1" || $rings == "2" || $rings == "3" ]] || {
    echo "Invalid qvOS TUI task ring contract: $rings" >&2
    return 2
  }
  [[ $behavior == "information" || $behavior == "mutation" ]] || {
    echo "Invalid qvOS TUI task behavior contract: $behavior" >&2
    return 2
  }
  read -r -a owner_args <<<"$owner_command"
  ((${#owner_args[@]} > 0)) || {
    echo "Missing qvOS TUI task owner for $slug." >&2
    return 1
  }
  qvos_resolve_owner owner_args
  presenter="$tui_root/task/presenters/$slug"
  if selection=$(selection_record 2>/dev/null); then
    IFS='|' read -r _ _ selection_mode _ <<<"$selection"
    [[ $selection_mode == "single" || $selection_mode == "multi" ]] || {
      echo "Invalid qvOS TUI task selection mode: $selection_mode" >&2
      return 2
    }
  fi
}

preflight() {
  [[ -f $catalog && -f $selection_catalog ]] || {
    echo "The qvOS TUI task source is incomplete." >&2
    return 1
  }
  [[ -x ${owner_args[0]} ]] || command -v "${owner_args[0]}" >/dev/null 2>&1 || {
    echo "The qvOS TUI task owner is unavailable: ${owner_args[0]}" >&2
    return 1
  }
}

list_options() {
  [[ -n $selection_mode ]] || {
    echo "The $slug task has no selection contract." >&2
    return 2
  }
  qvos_selection_list_owner owner_args
}

load_selections() {
  [[ -n $selection_mode ]] || return 0
  qvos_selection_apply_owner "$selection_mode" owner_args "$slug"
}

load_task

case ${1:-} in
--check)
  (($# == 1)) || exit 2
  preflight
  exit
  ;;
--options)
  (($# == 1)) || exit 2
  preflight
  list_options
  exit
  ;;
--cancel-status)
  (($# == 1)) || exit 2
  printf 'unknown\n'
  exit
  ;;
"")
  ;;
*)
  echo "Usage: qvcore/tui/task/run [--check|--options|--cancel-status]" >&2
  exit 2
  ;;
esac

preflight
if [[ -n $selection_mode ]]; then
  load_selections
fi
if [[ $behavior == "mutation" ]]; then
  echo "qvOS action: preparing"
  echo "qvOS action: applying"
  if [[ -x $presenter ]]; then
    "$presenter" "${owner_args[@]}"
  else
    "${owner_args[@]}"
  fi
  echo "qvOS action: complete"
elif [[ -x $presenter ]]; then
  "$presenter" "${owner_args[@]}"
else
  "${owner_args[@]}"
fi
