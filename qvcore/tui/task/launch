#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
tui_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
catalog="$tui_root/task/actions.psv"
selection_catalog="$tui_root/task/selections.psv"
guidance_catalog="$tui_root/success-guidance.psv"
tui_launch="$tui_root/launch"
slug=${1:-}

usage() {
  echo "Usage: qvcore/tui/task/launch <task-slug>" >&2
}

task_record() {
  awk -F '|' -v wanted="$slug" '
    $1 !~ /^#/ && NF == 11 && $1 == wanted {
      print
      found = 1
      exit
    }
    END { exit !found }
  ' "$catalog"
}

selection_record() {
  awk -F '|' -v wanted="$slug" '
    $1 !~ /^#/ && NF == 4 && $1 == wanted {
      print
      found = 1
      exit
    }
    END { exit !found }
  ' "$selection_catalog"
}

success_guidance() {
  awk -F '|' -v wanted="$slug" '
    $1 !~ /^#/ && NF == 3 && $1 == wanted && $2 == "task" {
      print $3
      found = 1
      exit
    }
    END { exit !found }
  ' "$guidance_catalog"
}

[[ -n $slug && $# == 1 ]] || {
  usage
  exit 2
}
[[ -f $catalog && -f $selection_catalog ]] || {
  echo "Missing qvOS TUI task catalog." >&2
  exit 1
}

record=$(task_record) || {
  echo "Unknown qvOS TUI task: $slug" >&2
  exit 2
}
IFS='|' read -r \
  _ \
  title \
  summary \
  rings \
  behavior \
  presentation \
  requires_sudo \
  primary \
  active \
  complete \
  owner_command <<<"$record"

[[ $rings == "1" || $rings == "2" || $rings == "3" ]] || {
  echo "Invalid qvOS TUI task ring contract: $rings" >&2
  exit 1
}
[[ $behavior == "information" || $behavior == "mutation" ]] || {
  echo "Invalid qvOS TUI task behavior contract: $behavior" >&2
  exit 1
}
if [[ $behavior == "information" ]]; then
  [[ -z $primary && -z $active && -z $complete ]] || {
    echo "Information task cannot use transaction copy: $slug" >&2
    exit 1
  }
else
  [[ -n $primary && -n $active && -n $complete ]] || {
    echo "Missing qvOS TUI task transaction copy: $slug" >&2
    exit 1
  }
fi
[[ $requires_sudo == "true" || $requires_sudo == "false" ]] || {
  echo "Invalid qvOS TUI task sudo contract: $requires_sudo" >&2
  exit 1
}
read -r -a owner_args <<<"$owner_command"
((${#owner_args[@]} > 0)) || {
  echo "Missing qvOS TUI task owner for $slug." >&2
  exit 1
}

if [[ $presentation == "native" ]]; then
  exec qv-launch-floating-terminal-with-presentation "${owner_args[@]}"
fi
[[ $presentation == "tui" ]] || {
  echo "Invalid qvOS TUI task presentation: $presentation" >&2
  exit 1
}
[[ -x $tui_launch ]] || {
  echo "The qvOS TUI launch surface is incomplete." >&2
  exit 1
}
[[ -f $guidance_catalog ]] || {
  echo "Missing qvOS TUI success guidance catalog: $guidance_catalog" >&2
  exit 1
}

export QVOS_ACTION_SLUG="$slug"
export QVOS_ACTION_OPERATION=task
export QVOS_ACTION_TITLE="$title"
export QVOS_ACTION_SUMMARY="$summary"
export QVOS_ACTION_RINGS="$rings"
export QVOS_ACTION_BEHAVIOR="$behavior"
if [[ $behavior == "information" ]]; then
  unset QVOS_ACTION_PRIMARY QVOS_ACTION_ACTIVE QVOS_ACTION_COMPLETE
else
  export QVOS_ACTION_PRIMARY="$primary"
  export QVOS_ACTION_ACTIVE="$active"
  export QVOS_ACTION_COMPLETE="$complete"
fi
export QVOS_ACTION_SCRIPT="$tui_root/task/run"
unset \
  QVOS_ACTION_NEXT_STEP \
  QVOS_ACTION_SELECTION_MODE \
  QVOS_ACTION_SELECTION_TITLE \
  QVOS_ACTION_SELECTION_EMPTY
if next_step=$(success_guidance 2>/dev/null); then
  export QVOS_ACTION_NEXT_STEP="$next_step"
fi
if selection=$(selection_record 2>/dev/null); then
  IFS='|' read -r _ selection_title selection_mode selection_empty <<<"$selection"
  [[ $selection_mode == "single" || $selection_mode == "multi" ]] || {
    echo "Invalid qvOS TUI task selection mode: $selection_mode" >&2
    exit 1
  }
  [[ -n $selection_title ]] || {
    echo "Missing qvOS TUI task selection title." >&2
    exit 1
  }
  [[ -n $selection_empty ]] || {
    echo "Missing qvOS TUI task empty-selection message." >&2
    exit 1
  }
  export QVOS_ACTION_SELECTION_MODE="$selection_mode"
  export QVOS_ACTION_SELECTION_TITLE="$selection_title"
  export QVOS_ACTION_SELECTION_EMPTY="$selection_empty"
fi
if [[ $requires_sudo == "true" ]]; then
  export QVOS_ACTION_REQUIRES_SUDO=1
else
  export QVOS_ACTION_REQUIRES_SUDO=0
fi

exec "$tui_launch" "$title" qvos-tui --action
