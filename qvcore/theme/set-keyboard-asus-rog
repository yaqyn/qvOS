#!/bin/bash

set -euo pipefail

ASUSCTL_THEME="$HOME/.config/qvos/current/theme/keyboard.rgb"

if qv-cmd-present asusctl && [[ -f $ASUSCTL_THEME ]]; then
  color=$(<"$ASUSCTL_THEME")
  color=${color#\#}
  [[ $color =~ ^[0-9A-Fa-f]{6}$ ]] || {
    echo "Invalid ASUS keyboard color: $ASUSCTL_THEME" >&2
    exit 1
  }
  asusctl aura effect static -c "$color"
fi
