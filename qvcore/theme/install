#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
source_dir="$QVOS_PATH/qvcore/theme/yaqyn"
runtime_dir="$HOME/.local/lib/qvos/theme/yaqyn"
target="$HOME/.config/qvos/themes/yaqyn"
themes_dir="$HOME/.config/qvos/themes"
backup_dir="$HOME/.local/state/qvos/theme-backups"
retired_catalog=$(realpath -m -- "$QVOS_PATH/themes")

if [[ ! -d $source_dir ]]; then
  echo "Missing Yaqyn theme source: $source_dir" >&2
  exit 1
fi
[[ -x $QVOS_PATH/qvcore/theme/migrate-config-root ]] || {
  echo "Missing qvOS theme migration owner." >&2
  exit 1
}
"$QVOS_PATH/qvcore/theme/migrate-config-root"

mkdir -p "$themes_dir"
while IFS= read -r -d '' theme_link; do
  link_target=$(realpath -m -- "$theme_link")
  if [[ $link_target == "$retired_catalog/"* ]]; then
    rm -f -- "$theme_link"
  fi
done < <(find "$themes_dir" -mindepth 1 -maxdepth 1 -type l -print0)

if [[ -e $target || -L $target ]]; then
  target_link=""
  [[ -L $target ]] && target_link=$(readlink -- "$target")
  if [[ $target_link == "$runtime_dir" ]]; then
    rm -f -- "$target"
  else
    mkdir -p "$backup_dir"
    backup_target="$backup_dir/yaqyn.$(date +%s)"
    backup_index=0
    while [[ -e $backup_target || -L $backup_target ]]; do
      ((backup_index += 1))
      backup_target="$backup_dir/yaqyn.$(date +%s).$backup_index"
    done
    mv -- "$target" "$backup_target"
    printf 'Preserved the existing Yaqyn theme as %s.\n' "$backup_target"
  fi
fi

rm -rf -- "$runtime_dir"
mkdir -p \
  "$(dirname -- "$runtime_dir")" \
  "$themes_dir"
cp -a "$source_dir" "$runtime_dir"
ln -s "$runtime_dir" "$target"
