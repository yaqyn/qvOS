#!/bin/bash
set -euo pipefail

usage() {
  echo "Usage: qvcore/theme/validate [--colors <colors.toml>|<theme-dir>]" >&2
  exit 2
}

validate_single_line() {
  local path=$1
  local label=$2
  local pattern=$3
  local value

  [[ ! -e $path && ! -L $path ]] && return 0
  [[ -f $path && ! -L $path ]] || {
    echo "$label must be a regular file: $path" >&2
    return 1
  }
  IFS= read -r value <"$path" || [[ -n $value ]] || {
    echo "$label is empty: $path" >&2
    return 1
  }
  if (( $(awk 'END { print NR }' "$path") != 1 )) || [[ ! $value =~ $pattern ]]; then
    echo "Invalid $label: $path" >&2
    return 1
  fi
}

validate_vscode_theme() {
  local path=$1
  local name
  local extension

  [[ ! -e $path && ! -L $path ]] && return 0
  [[ -f $path && ! -L $path ]] || {
    echo "VS Code theme metadata must be a regular file: $path" >&2
    return 1
  }
  if ! name=$(jq -er '.name | select(type == "string")' "$path" 2>/dev/null) ||
    ! extension=$(jq -er '.extension | select(type == "string")' "$path" 2>/dev/null); then
    echo "Invalid VS Code theme metadata: $path" >&2
    return 1
  fi
  if [[ ! $name =~ ^[[:alnum:]][[:alnum:]._+():/\ -]{0,127}$ ]] ||
    [[ ! $extension =~ ^[[:alnum:]][[:alnum:]-]{0,63}\.[[:alnum:]][[:alnum:]_.-]{0,127}$ ]]; then
    echo "Unsafe VS Code theme metadata: $path" >&2
    return 1
  fi
}

emit_colors() {
  local colors_file=$1
  local line
  local trimmed
  local key
  local value
  local -A seen=()
  local required_key
  local -a required_keys=(
    accent
    cursor
    foreground
    background
    selection_foreground
    selection_background
    color0
    color1
    color2
    color3
    color4
    color5
    color6
    color7
    color8
    color9
    color10
    color11
    color12
    color13
    color14
    color15
  )

  [[ -f $colors_file && ! -L $colors_file ]] || {
    echo "Theme colors must be a regular file: $colors_file" >&2
    return 1
  }

  while IFS= read -r line || [[ -n $line ]]; do
    trimmed=${line#"${line%%[![:space:]]*}"}
    [[ -z $trimmed || ${trimmed:0:1} == "#" ]] && continue

    if [[ ! $line =~ ^[[:space:]]*([a-z][a-z0-9_]*)[[:space:]]*=[[:space:]]*\"(#[0-9A-Fa-f]{6})\"[[:space:]]*([#].*)?$ ]]; then
      echo "Invalid theme color entry in $colors_file: $line" >&2
      return 1
    fi
    key=${BASH_REMATCH[1]}
    value=${BASH_REMATCH[2],,}
    [[ -z ${seen[$key]:-} ]] || {
      echo "Duplicate theme color in $colors_file: $key" >&2
      return 1
    }
    seen[$key]=1
    printf '%s\t%s\n' "$key" "$value"
  done <"$colors_file"

  for required_key in "${required_keys[@]}"; do
    [[ -n ${seen[$required_key]:-} ]] || {
      echo "Missing required theme color in $colors_file: $required_key" >&2
      return 1
    }
  done
}

case ${1:-} in
  --colors)
    (($# == 2)) || usage
    emit_colors "$2"
    exit
    ;;
  "")
    usage
    ;;
esac
(($# == 1)) || usage

theme_path=$1
[[ -d $theme_path ]] || {
  echo "Theme is not a directory: $theme_path" >&2
  exit 1
}
resolved_theme=$(realpath -e -- "$theme_path")
[[ -d $resolved_theme ]] || {
  echo "Theme directory cannot be resolved: $theme_path" >&2
  exit 1
}

while IFS= read -r -d '' entry; do
  relative=${entry#"$resolved_theme/"}
  if [[ $relative == *$'\n'* || $relative == *$'\r'* || $relative == *$'\t'* ]]; then
    echo "Theme paths cannot contain control characters: $relative" >&2
    exit 1
  fi
  if [[ -L $entry ]]; then
    echo "Theme payloads cannot contain symbolic links: $relative" >&2
    exit 1
  fi
  if [[ ! -f $entry && ! -d $entry ]]; then
    echo "Theme payloads must contain only files and directories: $relative" >&2
    exit 1
  fi
done < <(
  find "$resolved_theme" \
    \( -path "$resolved_theme/.git" -type d -prune \) -o \
    -mindepth 1 -print0
)

colors_file="$resolved_theme/colors.toml"
alacritty_file="$resolved_theme/alacritty.toml"
if [[ -f $colors_file && ! -L $colors_file ]]; then
  emit_colors "$colors_file" >/dev/null
elif [[ -f $alacritty_file && ! -L $alacritty_file ]]; then
  :
else
  echo "Theme requires a regular colors.toml or alacritty.toml: $theme_path" >&2
  exit 1
fi

validate_single_line \
  "$resolved_theme/keyboard.rgb" \
  "keyboard color" \
  '^#?[0-9A-Fa-f]{6}$'
validate_single_line \
  "$resolved_theme/chromium.theme" \
  "browser color" \
  '^([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]),([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5]),([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$'
validate_single_line \
  "$resolved_theme/icons.theme" \
  "icon theme name" \
  '^[[:alnum:]][[:alnum:]_.+-]{0,127}$'
validate_vscode_theme "$resolved_theme/vscode.json"
