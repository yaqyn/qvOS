#!/bin/bash
set -euo pipefail

resolve_dir=""
if [[ ${1:-} == "--resolve" ]]; then
  (($# == 3)) || {
    echo "Usage: qvcore/theme/name [--resolve themes-dir] <theme-name>" >&2
    exit 2
  }
  resolve_dir=$2
  raw_name=$3
else
  (($# == 1)) || {
    echo "Usage: qvcore/theme/name [--resolve themes-dir] <theme-name>" >&2
    exit 2
  }
  raw_name=$1
fi

if [[ -n $resolve_dir ]] &&
  [[ $raw_name =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] &&
  [[ -e $resolve_dir/$raw_name || -L $resolve_dir/$raw_name ]]; then
  printf '%s\n' "$raw_name"
  exit 0
fi

name=$(
  printf '%s\n' "$raw_name" |
    sed -E 's/<[^>]+>//g' |
    tr '[:upper:]' '[:lower:]' |
    tr ' ' '-'
)

if [[ ! $name =~ ^[a-z0-9][a-z0-9._-]*$ ]]; then
  echo "Invalid theme name: $raw_name" >&2
  exit 2
fi

printf '%s\n' "$name"
