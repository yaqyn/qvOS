#!/bin/bash
set -euo pipefail

config_root="$HOME/.config"
legacy_root="$config_root/omarchy"
native_root="$config_root/qvos"
backup_root="$HOME/.local/state/qvos/theme-backups"
managed_entries=(themes current backgrounds themed)
integration_specs=(
  "$HOME/.config/btop/themes/current.theme|$HOME/.config/qvos/current/theme/btop.theme|$HOME/.config/omarchy/current/theme/btop.theme"
  "$HOME/.config/mako/config|$HOME/.config/qvos/current/theme/mako.ini|$HOME/.config/omarchy/current/theme/mako.ini"
)
integration_actions=()
legacy_backup_sources=()
legacy_backup_targets=()

fail() {
  printf 'Could not migrate qvOS theme state: %s\n' "$1" >&2
  exit 1
}

validate_owned_directory() {
  local label=$1
  local path=$2

  [[ -d $path && ! -L $path && -O $path ]] ||
    fail "$label is not a real user-owned directory: $path"
}

validate_link_parent() {
  local path=$1
  local current

  current=$(dirname -- "$path")
  while [[ $current != "$HOME" ]]; do
    if [[ -e $current || -L $current ]]; then
      validate_owned_directory "a managed theme-integration parent" "$current"
    fi
    current=$(dirname -- "$current")
  done
}

publish_link() {
  local target=$1
  local source=$2
  local parent
  local candidate

  parent=$(dirname -- "$target")
  install -d -m 0755 "$parent"
  candidate=$(mktemp "$parent/.qvos-theme-link.XXXXXX")
  rm -f -- "$candidate"
  if ! ln -s -- "$source" "$candidate" || ! mv -Tf -- "$candidate" "$target"; then
    rm -f -- "$candidate"
    fail "could not publish the native theme-integration link: $target"
  fi
}

validate_owned_directory "the home directory" "$HOME"
if [[ -e $config_root || -L $config_root ]]; then
  validate_owned_directory "the configuration root" "$config_root"
fi
if [[ -e $legacy_root || -L $legacy_root ]]; then
  validate_owned_directory "the compatibility root" "$legacy_root"
fi
if [[ -e $native_root || -L $native_root ]]; then
  validate_owned_directory "the native root" "$native_root"
fi
for backup_parent in \
  "$HOME/.local" \
  "$HOME/.local/state" \
  "$HOME/.local/state/qvos" \
  "$backup_root"; do
  if [[ -e $backup_parent || -L $backup_parent ]]; then
    validate_owned_directory "a qvOS theme-backup parent" "$backup_parent"
  fi
done

for entry in "${managed_entries[@]}"; do
  legacy_path="$legacy_root/$entry"
  native_path="$native_root/$entry"
  expected_link="../qvos/$entry"

  if [[ -e $native_path || -L $native_path ]]; then
    validate_owned_directory "the native $entry path" "$native_path"
  fi
  if [[ -L $legacy_path ]]; then
    [[ $(readlink -- "$legacy_path") == "$expected_link" ]] ||
      fail "the compatibility $entry path is an unrecognized link: $legacy_path"
  elif [[ -e $legacy_path ]]; then
    validate_owned_directory "the compatibility $entry path" "$legacy_path"
    [[ ! -e $native_path && ! -L $native_path ]] ||
      fail "both native and compatibility $entry directories contain state"
  fi
done

shopt -s nullglob
legacy_backup_candidates=("$legacy_root"/themes.bak.*)
shopt -u nullglob
for legacy_backup in "${legacy_backup_candidates[@]}"; do
  backup_name=${legacy_backup##*/}
  [[ $backup_name =~ ^themes\.bak\.[0-9]+$ ]] || continue
  validate_owned_directory "a historical theme backup" "$legacy_backup"
  backup_target="$backup_root/legacy-omarchy-$backup_name"
  [[ ! -e $backup_target && ! -L $backup_target ]] ||
    fail "the historical theme backup already has a conflicting archive: $backup_target"
  legacy_backup_sources+=("$legacy_backup")
  legacy_backup_targets+=("$backup_target")
done

# Preflight exact application-theme links before changing theme state. Foreign
# files and links are user configuration and remain untouched.
for spec in "${integration_specs[@]}"; do
  IFS='|' read -r target source legacy_source <<<"$spec"
  action=preserve
  if [[ -L $target ]]; then
    link_target=$(readlink -- "$target")
    if [[ $link_target == "$source" ]]; then
      action=none
    elif [[ $link_target == "$legacy_source" ]]; then
      validate_link_parent "$target"
      action=replace
    fi
  elif [[ ! -e $target ]]; then
    validate_link_parent "$target"
    action=create
  fi
  integration_actions+=("$action")
done

if [[ ! -e $config_root && ! -L $config_root ]]; then
  install -d -m 0755 "$config_root"
fi
if [[ ! -e $native_root && ! -L $native_root ]]; then
  install -d -m 0700 "$native_root"
fi
if [[ ! -e $legacy_root && ! -L $legacy_root ]]; then
  install -d -m 0755 "$legacy_root"
fi

for entry in "${managed_entries[@]}"; do
  legacy_path="$legacy_root/$entry"
  native_path="$native_root/$entry"
  expected_link="../qvos/$entry"

  if [[ -d $legacy_path && ! -L $legacy_path ]]; then
    mv -- "$legacy_path" "$native_path"
  fi
  if [[ ! -e $native_path && ! -L $native_path ]]; then
    install -d -m 0755 "$native_path"
  fi
  if [[ ! -e $legacy_path && ! -L $legacy_path ]]; then
    ln -s "$expected_link" "$legacy_path"
  fi
done

if ((${#legacy_backup_sources[@]} > 0)); then
  install -d -m 0700 "$backup_root"
  for index in "${!legacy_backup_sources[@]}"; do
    legacy_backup=${legacy_backup_sources[$index]}
    backup_target=${legacy_backup_targets[$index]}
    mv -T -- "$legacy_backup" "$backup_target"
    printf 'Preserved the historical theme backup as %s.\n' "$backup_target"
  done
fi


for index in "${!integration_specs[@]}"; do
  IFS='|' read -r target source _ <<<"${integration_specs[$index]}"
  case ${integration_actions[$index]} in
  create | replace) publish_link "$target" "$source" ;;
  preserve)
    printf 'Preserving custom theme integration: %s\n' "$target" >&2
    ;;
  esac
done
