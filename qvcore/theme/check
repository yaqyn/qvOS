#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
native_manifest="$root/qvcore/theme/native-paths"
retired_manifest="$root/qvcore/theme/retired-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

for owner in \
  apply-plymouth \
  background-restore \
  background-next \
  background-set \
  backgrounds \
  colors-from-alacritty \
  configure \
  current \
  install \
  install-external \
  list \
  migrate-config-root \
  name \
  refresh \
  remove \
  set \
  set-browser \
  set-foot \
  set-gnome \
  set-keyboard \
  set-keyboard-asus-rog \
  set-keyboard-f16 \
  set-obsidian \
  set-templates \
  set-vscode \
  set-zed \
  update \
  validate; do
  [[ -x $root/qvcore/theme/$owner ]] || fail "theme owner mode: $owner"
done

[[ -f $root/qvcore/theme/background-lib &&
  ! -L $root/qvcore/theme/background-lib &&
  $(stat -c '%a' "$root/qvcore/theme/background-lib") == "644" ]] ||
  fail "shared background library is unavailable or unsafe"
[[ -x $root/bin/qv-theme-bg-restore ]] ||
  fail "native background restore adapter is unavailable"
# shellcheck disable=SC2016
grep -Fqx 'exec "$QVOS_PATH/qvcore/theme/background-restore" "$@"' \
  "$root/bin/qv-theme-bg-restore" ||
  fail "native background restore adapter bypasses its owner"
rg -q '^# qv:summary=' "$root/bin/qv-theme-bg-restore" ||
  fail "native background restore adapter lacks metadata"

declare -A route_owners=(
  [plymouth-set-by-theme]=apply-plymouth
  [theme-bg-install]=backgrounds
  [theme-bg-next]=background-next
  [theme-bg-set]=background-set
  [theme-colors-from-alacritty]=colors-from-alacritty
  [theme-current]=current
  [theme-install]=install-external
  [theme-list]=list
  [theme-refresh]=refresh
  [theme-remove]=remove
  [theme-set]=set
  [theme-set-browser]=set-browser
  [theme-set-foot]=set-foot
  [theme-set-gnome]=set-gnome
  [theme-set-keyboard]=set-keyboard
  [theme-set-keyboard-asus-rog]=set-keyboard-asus-rog
  [theme-set-keyboard-f16]=set-keyboard-f16
  [theme-set-obsidian]=set-obsidian
  [theme-set-templates]=set-templates
  [theme-set-vscode]=set-vscode
  [theme-update]=update
)

for route in "${!route_owners[@]}"; do
  native_adapter="$root/bin/qv-$route"
  compatibility_adapter="$root/bin/omarchy-$route"
  owner="qvcore/theme/${route_owners[$route]}"
  [[ -x $native_adapter && -x $compatibility_adapter ]] ||
    fail "theme adapter mode: $route"
  (( $(wc -l <"$native_adapter") <= 10 )) ||
    fail "native theme adapter contains implementation: $route"
  (( $(wc -l <"$compatibility_adapter") <= 5 )) ||
    fail "theme compatibility adapter contains implementation: $route"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native theme adapter lacks metadata: $route"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "theme compatibility adapter duplicates metadata: $route"
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    grep -Fqx "exec \"\$QVOS_PATH/$owner\" \"\$@\"" "$adapter" ||
      fail "theme adapter owner: $route"
  done
done

[[ ! -e $root/themes ]] || fail "inherited theme catalog remains"
[[ ! -e $root/default/themed ]] || fail "inherited template source remains"
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == $'default/themed/\nthemes/' ]] ||
  fail "retired theme inventory differs from the reviewed source paths"

expected_templates=$(
  printf '%s\n' \
    alacritty.toml.tpl \
    btop.theme.tpl \
    chromium.theme.tpl \
    foot.ini.tpl \
    ghostty.conf.tpl \
    gum.env.conf.tpl \
    helix.toml.tpl \
    hyprland-preview-share-picker.css.tpl \
    hyprland.lua.tpl \
    hyprlock.conf.tpl \
    keyboard.rgb.tpl \
    kitty.conf.tpl \
    mako.ini.tpl \
    obsidian.css.tpl \
    qvos-neovim.lua.tpl \
    swayosd.css.tpl \
    walker.css.tpl \
    waybar.css.tpl
)
actual_templates=$(
  find "$root/qvcore/theme/templates" -mindepth 1 -maxdepth 1 \
    -type f -printf '%f\n' | sort
)
[[ $actual_templates == "$expected_templates" ]] ||
  fail "native template inventory differs from the reviewed built-ins"
while IFS= read -r template; do
  [[ -f $template && ! -L $template ]] ||
    fail "native template is not a regular file: ${template#"$root/"}"
done < <(find "$root/qvcore/theme/templates" -mindepth 1 -maxdepth 1 -print)

yaqyn_background="$root/qvcore/theme/yaqyn/backgrounds/yaqyn.png"
yaqyn_preview="$root/qvcore/theme/yaqyn/preview.png"
for artwork in "$yaqyn_background" "$yaqyn_preview"; do
  [[ -f $artwork && ! -L $artwork ]] ||
    fail "Yaqyn artwork must be a regular file: ${artwork#"$root/"}"
done
cmp -s "$yaqyn_background" "$yaqyn_preview" ||
  fail "Yaqyn background and preview differ"

mako_include='include=~/.local/share/qvos/qvcore/controls/notification/mako-core.ini'
grep -Fqx "$mako_include" "$root/qvcore/theme/yaqyn/mako.ini" ||
  fail "Yaqyn bypasses the native Mako policy"
grep -Fqx "$mako_include" "$root/qvcore/theme/templates/mako.ini.tpl" ||
  fail "compatible themes bypass the native Mako policy"

for inventory in "$native_manifest" "$retired_manifest"; do
  [[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$inventory") == $(
    sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$inventory" | sort -u
  ) ]] || fail "theme path inventory is not sorted and unique: $inventory"
done
for route in "${!route_owners[@]}"; do
  grep -Fqx "bin/omarchy-$route" "$native_manifest" ||
    fail "native theme inventory is missing: bin/omarchy-$route"
done

compatibility_path_refs=$(
  rg -n 'OMARCHY_PATH' "$root/qvcore/theme" \
    --glob '!AGENTS.md' --glob '!check' --glob '!native-paths' || true
)
if [[ -n $compatibility_path_refs ]]; then
  printf '%s\n' "$compatibility_path_refs" >&2
  fail "native theme owner dereferences the compatibility source root"
fi
if rg -n '\.config/omarchy/(themes|current|backgrounds|themed)|omarchy/current/theme' \
  "$root/qvcore" \
  --glob '!**/AGENTS.md' \
  --glob '!**/check' \
  --glob '!**/config/migrate-runtime-root' \
  --glob '!**/config/neovim' \
  --glob '!**/software/helix-install' \
  --glob '!**/theme/migrate-config-root'; then
  fail "native qvOS owner retains the compatibility theme-state root"
fi
if rg -n 'OMARCHY_THEME_' "$root/qvcore/theme" \
  --glob '!AGENTS.md' --glob '!check'; then
  fail "native theme owner accepts an inherited runtime environment"
fi
if rg -n '\b(pkill|killall)\b' "$root/qvcore/theme" \
  --glob '!AGENTS.md' --glob '!check'; then
  fail "theme owner bypasses exact process matching"
fi
grep -Fqx 'qv.autostart("qv-theme-bg-restore")' \
  "$root/qvcore/config/base/hypr/autostart.lua" ||
  fail "native autostart bypasses the background lifecycle owner"

if rg -n \
  'omarchy-(plymouth-set-by-theme|theme-(bg-(install|next|set)|colors-from-alacritty|current|install|list|refresh|remove|set|set-[a-z0-9-]+|update))([^[:alnum:]_-]|$)' \
  "$root/qvcore" "$root/qvcore/config/files" \
  --glob '!AGENTS.md' --glob '!check' --glob '!native-paths' \
  --glob '!owner-contracts.psv' --glob '!migrate-runtime-root'; then
  fail "native qvOS surface calls a theme compatibility route"
fi
theme_migration_compatibility=$(
  rg -o \
    'omarchy-(plymouth-set-by-theme|theme-(bg-(install|next|set)|colors-from-alacritty|current|install|list|refresh|remove|set|set-[a-z0-9-]+|update))' \
    "$root/qvcore/config/migrate-runtime-root" | sort -u
)
[[ $theme_migration_compatibility == "omarchy-theme-current" ]] ||
  fail "runtime migration retains an unexpected theme compatibility route"
grep -Fq "'omarchy-theme-current' 'qv-theme-current'" \
  "$root/qvcore/config/migrate-runtime-root" ||
  fail "runtime migration does not converge Fastfetch on the native theme route"

grep -Fq 'qvcore/theme/name' "$root/qvcore/theme/set" ||
  fail "theme renderer bypasses the shared name validator"
grep -Fq 'qvcore/theme/validate' "$root/qvcore/theme/install-external" ||
  fail "Git theme installation bypasses payload validation"
grep -Fq 'qvcore/theme/validate' "$root/qvcore/theme/set" ||
  fail "theme renderer bypasses payload validation"
grep -Fq 'QVOS_THEME_RETAIN_LEGACY_HYPRLAND' "$root/qvcore/config/migrate-hyprland-lua" ||
  fail "Hyprland Lua migration lacks a safe theme handoff"
# shellcheck disable=SC2016
grep -Fq 'rm -f -- "$NEXT_THEME_PATH/hyprland.conf"' \
  "$root/qvcore/theme/set" || fail "ordinary themes can retain legacy Hyprland code"
grep -Fq 'managed_entries=(themes current backgrounds themed)' \
  "$root/qvcore/theme/migrate-config-root" ||
  fail "native theme compatibility-link inventory"
# shellcheck disable=SC2016
grep -Fq 'expected_link="../qvos/$entry"' \
  "$root/qvcore/theme/migrate-config-root" ||
  fail "native theme compatibility-link target"
# shellcheck disable=SC2016
grep -Fq '"$QVOS_PATH/qvcore/theme/migrate-config-root"' \
  "$root/qvcore/theme/install" ||
  fail "theme install bypasses config-root migration"
grep -Fq '.config/qvos/current/theme/btop.theme' \
  "$root/qvcore/theme/migrate-config-root" ||
  fail "theme migration bypasses the native btop integration"
grep -Fq '.config/qvos/current/theme/mako.ini' \
  "$root/qvcore/theme/migrate-config-root" ||
  fail "theme migration bypasses the native Mako integration"
if rg -n 'ln -s(nf|fn|f)[[:space:]]' "$root/qvcore/theme/configure"; then
  fail "fresh theme configuration duplicates integration-link ownership"
fi
# shellcheck disable=SC2016
grep -Fq '"$QVOS_PATH/qvcore/theme/migrate-config-root"' \
  "$root/qvcore/install/post-update-hook" ||
  fail "post-update bypasses config-root migration"
grep -Fq 'source_dir/templates' "$root/qvcore/theme/set-templates" ||
  fail "theme renderer bypasses the native template owner"
if rg -n 'default/themed' "$root/qvcore/theme/set-templates"; then
  fail "theme renderer retains the inherited template source"
fi
grep -Fq 'cannot be replaced by a theme repository' "$root/qvcore/theme/install-external" ||
  fail "Yaqyn install protection"
grep -Fq 'cannot be removed' "$root/qvcore/theme/remove" ||
  fail "Yaqyn removal protection"
# shellcheck disable=SC2016
grep -Fq 'reset --hard "$previous_head"' "$root/qvcore/theme/update" ||
  fail "invalid Git theme update rollback"
if rg -n -- '--install-extension|int\('\''\$hex' \
  "$root/qvcore/theme/set-vscode" \
  "$root/qvcore/theme/set-keyboard-f16"; then
  fail "theme data can still install editor code or enter Python source"
fi
grep -Fq 'integrations=(browser vscode obsidian keyboard zed)' \
  "$root/qvcore/theme/set" ||
  fail "theme activation bypasses the native Zed integration"
grep -Fq 'https://zed.dev/schema/themes/v0.2.0.json' \
  "$root/qvcore/theme/set-zed" || fail "Zed theme schema"
grep -Fq 'qvcore/theme/validate' "$root/qvcore/theme/set-zed" ||
  fail "Zed integration bypasses validated colors"
if rg -n 'Omazed|omazed|omarchy\.json|setsid|gtk-launch' \
  "$root/qvcore/theme/set-zed" \
  "$root/qvcore/software/zed-install"; then
  fail "Zed integration retains the inherited helper or launch behavior"
fi
if rg -q 'mktemp.*policy_dir|mv .*color\.json' "$root/qvcore/theme/set-browser"; then
  fail "browser theme policy assumes write access to its root-owned directory"
fi
# shellcheck disable=SC2016
grep -Fq '$(/usr/bin/stat -c '\''%u:%a'\'' -- "$target") == "$EUID:644"' \
  "$root/qvcore/theme/set-browser" ||
  fail "browser theme policy bypasses exact leaf ownership"

[[ -f $root/qvcore/install/config/theme.sh &&
  ! -x $root/qvcore/install/config/theme.sh ]] ||
  fail "fresh install theme owner mode"
# shellcheck disable=SC2016
grep -Fqx '"$QVOS_PATH/qvcore/theme/configure"' "$root/qvcore/install/config/theme.sh" ||
  fail "fresh install does not delegate to the qvOS theme owner"
# shellcheck disable=SC2016
grep -Fq '[[ ${OMARCHY_CHROOT_INSTALL:-} == "1" ]]' \
  "$root/qvcore/theme/configure" ||
  fail "fresh theme configuration does not recognize the reviewed chroot boundary"
grep -Fq 'QVOS_THEME_SKIP_SESSION=1 qv-theme-set "Yaqyn"' \
  "$root/qvcore/theme/configure" ||
  fail "fresh theme configuration does not suppress target-chroot session work"
if rg -q 'qvcore/theme/install|qvcore/install/config/theme' "$root/qvcore/install/configure"; then
  fail "qvOS install duplicates the theme owner"
fi

grep -Fq 'present:qv-theme-install' "$root/qvcore/menu/concepts.psv" ||
  fail "compatible Git theme installation is not reachable"
grep -Fq 'present:qvcore/tui/task/selectable-owner theme-remove' "$root/qvcore/menu/concepts.psv" ||
  fail "custom theme removal is not reachable"
grep -Fq 'present:qv-theme-update' "$root/qvcore/menu/concepts.psv" ||
  fail "custom theme updates are not reachable"
grep -Fq 'activate = "qv-theme-set "' "$root/qvcore/menu/elephant/qvos_themes.lua" ||
  fail "theme provider bypasses the native qvOS command"
grep -Fq 'qv-plymouth-set-by-theme' "$root/qvcore/menu/elephant/qvos_unlocks.lua" ||
  fail "unlock provider bypasses the native qvOS command"
# shellcheck disable=SC2016
grep -Fq 'current_theme=$(<"$theme_name_path")' "$root/qvcore/install/post-update-hook" ||
  fail "post-update does not preserve the selected custom theme"
if rg -n 'Omarchy' \
  "$root/qvcore/theme/set-obsidian" \
  "$root/qvcore/theme/templates/obsidian.css.tpl"; then
  fail "Obsidian theme still exposes inherited branding"
fi

printf 'ok - qvOS owns one hardened Yaqyn and compatible-theme lifecycle\n'
