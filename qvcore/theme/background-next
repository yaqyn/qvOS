#!/bin/bash

set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
# shellcheck source=qvcore/theme/background-lib
source "$QVOS_PATH/qvcore/theme/background-lib"
THEMES_DIR="$HOME/.config/qvos/themes"
THEME_NAME_PATH="$HOME/.config/qvos/current/theme.name"
[[ -f $THEME_NAME_PATH ]] || {
  echo "No current qvOS theme is selected." >&2
  exit 1
}
THEME_NAME=$("$QVOS_PATH/qvcore/theme/name" --resolve "$THEMES_DIR" "$(<"$THEME_NAME_PATH")")
THEME_BACKGROUNDS_PATH="$HOME/.config/qvos/current/theme/backgrounds/"
USER_BACKGROUNDS_PATH="$HOME/.config/qvos/backgrounds/$THEME_NAME/"

mkdir -p -- "$USER_BACKGROUNDS_PATH" "$(dirname -- "$qvos_background_link")"

mapfile -d '' -t BACKGROUNDS < <(find -L "$USER_BACKGROUNDS_PATH" "$THEME_BACKGROUNDS_PATH" -maxdepth 1 -type f -print0 2>/dev/null | sort -z)
TOTAL=${#BACKGROUNDS[@]}

if (( TOTAL == 0 )); then
  notify-send "No background was found for theme" -t 2000
  qvos_background_run color '#000000'
else
  # Get current background from symlink
  if [[ -L $qvos_background_link ]]; then
    CURRENT_BACKGROUND=$(readlink "$qvos_background_link")
  else
    # Default to first background if no symlink exists
    CURRENT_BACKGROUND=""
  fi

  # Find current background index
  INDEX=-1
  for i in "${!BACKGROUNDS[@]}"; do
    if [[ ${BACKGROUNDS[$i]} == "$CURRENT_BACKGROUND" ]]; then
      INDEX=$i
      break
    fi
  done

  # Get next background (wrap around)
  if (( INDEX == -1 )); then
    # Use the first background when no match was found
    NEW_BACKGROUND="${BACKGROUNDS[0]}"
  else
    NEXT_INDEX=$(((INDEX + 1) % TOTAL))
    NEW_BACKGROUND="${BACKGROUNDS[$NEXT_INDEX]}"
  fi

  qvos_background_publish "$NEW_BACKGROUND"
  qvos_background_run image "$qvos_background_link"
fi
