#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
source_file="$QVOS_PATH/qvcore/security/60-qvos-security.conf"
dev_share_helper_source="$QVOS_PATH/qvcore/security/dev-share-firewall"
retire_passwordless_source="$QVOS_PATH/qvcore/security/retire-passwordless-sudo"
auth_policy_source="$QVOS_PATH/qvcore/security/auth-policy"
system_root=${QVOS_SECURITY_SYSTEM_ROOT:-}
target_file="$system_root/etc/sysctl.d/60-qvos-security.conf"
pacman_config="$system_root/etc/pacman.conf"
dev_share_helper="$system_root/usr/lib/qvos/dev-share-firewall"
retire_passwordless_helper="$system_root/usr/lib/qvos/retire-passwordless-sudo"
auth_policy_helper="$system_root/usr/lib/qvos/security/auth-policy"
system_install_tree="$system_root/usr/install"
system_owner_uid=0
system_owner_gid=0
pacman_candidate=

cleanup() {
  [[ -z $pacman_candidate ]] || rm -f -- "$pacman_candidate"
}
trap cleanup EXIT

system_file_ready() {
  local source=$1
  local target=$2
  local mode=$3

  [[ -f $target && ! -L $target ]] &&
    [[ $(stat -c '%u:%g:%a' -- "$target") == \
      "$system_owner_uid:$system_owner_gid:${mode#0}" ]] &&
    cmp -s "$source" "$target"
}

install_system_file() {
  local source=$1
  local target=$2
  local mode=$3

  system_file_ready "$source" "$target" "$mode" && return 0
  if [[ -n $system_root ]] || ((EUID == 0)); then
    install -D -o "$system_owner_uid" -g "$system_owner_gid" -m "$mode" \
      "$source" "$target"
  else
    /usr/bin/sudo /usr/bin/install -D -o root -g root -m "$mode" \
      "$source" "$target"
  fi
}

sysctl_baseline_ready() {
  local count=0
  local key
  local assignment
  local value
  local extra

  while read -r key assignment value extra; do
    [[ -n $key && $key != \#* ]] || continue
    [[ $assignment == "=" && -n $value && -z $extra ]] || return 1
    [[ $(/usr/bin/sysctl -n "$key" 2>/dev/null) == "$value" ]] || return 1
    ((count += 1))
  done <"$source_file"
  ((count > 0))
}

if [[ -n $system_root && ${QVOS_SECURITY_TESTING:-} != "1" ]]; then
  echo "A custom qvOS security system root is only valid in tests." >&2
  exit 2
fi
if [[ -n $system_root ]]; then
  system_owner_uid=$(id -u)
  system_owner_gid=$(id -g)
fi
if [[ ! -f $source_file ]]; then
  echo "Missing qvOS security baseline: $source_file" >&2
  exit 1
fi
if [[ ! -x $dev_share_helper_source ]]; then
  echo "Missing qvOS LAN preview firewall helper: $dev_share_helper_source" >&2
  exit 1
fi
if [[ ! -x $retire_passwordless_source ]]; then
  echo "Missing qvOS passwordless-sudo retirement owner: $retire_passwordless_source" >&2
  exit 1
fi
if [[ ! -x $auth_policy_source ]]; then
  echo "Missing qvOS authentication policy owner: $auth_policy_source" >&2
  exit 1
fi
if [[ ! -x $QVOS_PATH/qvcore/security/docker-policy ]]; then
  echo "Missing qvOS Docker security owner." >&2
  exit 1
fi
if [[ ! -f $pacman_config ]]; then
  echo "Missing pacman configuration: $pacman_config" >&2
  exit 1
fi
"$QVOS_PATH/qvcore/security/boot-mount" --check

read -r \
  omarchy_sections \
  omarchy_siglevels \
  offline_sections \
  offline_siglevels \
  offline_expected_siglevels \
  offline_servers \
  offline_expected_servers < <(
  awk '
    /^[[:space:]]*\[omarchy\][[:space:]]*$/ {
      in_omarchy = 1
      in_offline = 0
      sections++
      next
    }
    /^[[:space:]]*\[offline\][[:space:]]*$/ {
      in_omarchy = 0
      in_offline = 1
      offline_sections++
      next
    }
    /^[[:space:]]*\[[^]]+\][[:space:]]*$/ {
      in_omarchy = 0
      in_offline = 0
    }
    in_omarchy && /^[[:space:]]*SigLevel[[:space:]]*=/ {
      siglevels++
    }
    in_offline && /^[[:space:]]*SigLevel[[:space:]]*=/ {
      offline_siglevels++
      if ($0 ~ /^[[:space:]]*SigLevel[[:space:]]*=[[:space:]]*Required[[:space:]]+DatabaseOptional[[:space:]]*$/) {
        offline_expected_siglevels++
      }
    }
    in_offline && /^[[:space:]]*Server[[:space:]]*=/ {
      offline_servers++
      if ($0 ~ /^[[:space:]]*Server[[:space:]]*=[[:space:]]*file:\/\/\/var\/cache\/qvos\/mirror\/offline\/[[:space:]]*$/) {
        offline_expected_servers++
      }
    }
    END {
      print sections + 0, siglevels + 0,
        offline_sections + 0, offline_siglevels + 0,
        offline_expected_siglevels + 0,
        offline_servers + 0, offline_expected_servers + 0
    }
  ' "$pacman_config"
)
if [[ ${QVOS_CHROOT_INSTALL:-} == "1" ]] &&
  ((omarchy_sections == 0 && omarchy_siglevels == 0 &&
    offline_sections == 1 && offline_siglevels == 1 &&
    offline_expected_siglevels == 1 && offline_servers == 1 &&
    offline_expected_servers == 1)); then
  echo "Deferring qvOS security until the final Pacman configuration is installed."
  exit 0
fi
if ((omarchy_sections != 1 || omarchy_siglevels != 1)); then
  echo "Expected one Omarchy repository and signature policy in $pacman_config." >&2
  exit 1
fi

pacman_candidate=$(mktemp)
awk '
  /^[[:space:]]*\[omarchy\][[:space:]]*$/ {
    in_omarchy = 1
    print
    next
  }
  /^[[:space:]]*\[[^]]+\][[:space:]]*$/ {
    in_omarchy = 0
  }
  in_omarchy && /^[[:space:]]*SigLevel[[:space:]]*=/ {
    print "SigLevel = Required DatabaseOptional"
    next
  }
  {
    print
  }
' "$pacman_config" >"$pacman_candidate"

install_system_file "$retire_passwordless_source" "$retire_passwordless_helper" 0755
install_system_file "$auth_policy_source" "$auth_policy_helper" 0755
if [[ -n $system_root ]]; then
  QVOS_SECURITY_SYSTEM_ROOT="$system_root" \
    QVOS_SECURITY_TESTING=1 \
    "$retire_passwordless_helper"
elif ((EUID == 0)); then
  /usr/bin/env -i PATH=/usr/bin:/bin "$retire_passwordless_helper"
else
  /usr/bin/sudo /usr/bin/env -i PATH=/usr/bin:/bin \
    "$retire_passwordless_helper"
fi

for auth_feature in fingerprint fido2; do
  if [[ -n $system_root ]]; then
    QVOS_AUTH_SYSTEM_ROOT="$system_root" \
      QVOS_SECURITY_TESTING=1 \
      "$auth_policy_helper" reconcile "$auth_feature"
  elif ((EUID == 0)); then
    /usr/bin/env -i PATH=/usr/bin:/bin \
      "$auth_policy_helper" reconcile "$auth_feature"
  else
    /usr/bin/sudo /usr/bin/env -i PATH=/usr/bin:/bin \
      "$auth_policy_helper" reconcile "$auth_feature"
  fi
done

install_system_file "$source_file" "$target_file" 0644
install_system_file "$pacman_candidate" "$pacman_config" 0644
install_system_file "$dev_share_helper_source" "$dev_share_helper" 0755
"$QVOS_PATH/qvcore/security/docker-policy"

if [[ -d $system_install_tree ]]; then
  insecure_system_file=$(
    find -P "$system_install_tree" -xdev -type f \
      -uid "$system_owner_uid" -gid "$system_owner_gid" -perm /0022 \
      -print -quit
  )
  if [[ -n $insecure_system_file ]]; then
    if [[ -n $system_root ]] || ((EUID == 0)); then
      find -P "$system_install_tree" -xdev -type f \
        -uid "$system_owner_uid" -gid "$system_owner_gid" -perm /0022 \
        -exec chmod go-w -- {} +
    else
      /usr/bin/sudo /usr/bin/find -P "$system_install_tree" -xdev -type f \
        -uid 0 -gid 0 -perm /0022 \
        -exec /usr/bin/chmod go-w -- {} +
    fi
  fi
fi

"$QVOS_PATH/qvcore/security/boot-mount"

if [[ -z $system_root && ${QVOS_CHROOT_INSTALL:-} != "1" ]]; then
  if sysctl_baseline_ready; then
    :
  elif ((EUID == 0)); then
    /usr/bin/sysctl -q -p "$target_file"
  else
    /usr/bin/sudo /usr/bin/sysctl -q -p "$target_file"
  fi
fi
