#!/bin/bash
set -euo pipefail

system_root=${QVOS_SECURITY_SYSTEM_ROOT:-}
sudoers_dir="$system_root/etc/sudoers.d"
system_owner_uid=0
system_owner_gid=0

if [[ -n $system_root && ${QVOS_SECURITY_TESTING:-} != "1" ]]; then
  echo "A custom qvOS security system root is only valid in tests." >&2
  exit 2
fi
if [[ -n $system_root ]]; then
  system_owner_uid=$(/usr/bin/id -u)
  system_owner_gid=$(/usr/bin/id -g)
elif ((EUID != 0)); then
  echo "The installed qvOS retirement helper must run as root." >&2
  exit 1
fi

if [[ -e $sudoers_dir || -L $sudoers_dir ]]; then
  [[ -d $sudoers_dir && ! -L $sudoers_dir ]] || {
    echo "Refusing an unsafe sudoers directory: $sudoers_dir" >&2
    exit 1
  }
else
  exit 0
fi

rule_expected=
rule_timer=

load_rule_contract() {
  local path=$1
  local name=${path##*/}
  local account

  rule_expected=
  rule_timer=
  if [[ $name == "omarchy-tzupdate" ]]; then
    rule_expected='%wheel ALL=(root) NOPASSWD: /usr/bin/tzupdate, /usr/bin/timedatectl'
    return 0
  fi

  account=${name#99-omarchy-nopasswd-}
  [[ $name == 99-omarchy-nopasswd-* &&
    $account =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || return 1
  rule_expected="$account ALL=(ALL) NOPASSWD: ALL"
  rule_timer="omarchy-nopasswd-expire-$account"
}

validate_legacy_rule() {
  local path=$1

  load_rule_contract "$path" &&
    [[ -f $path && ! -L $path &&
      $(/usr/bin/stat -c '%u:%g:%a' -- "$path") == \
        "$system_owner_uid:$system_owner_gid:440" &&
      $(<"$path") == "$rule_expected" ]]
}

remove_legacy_rule() {
  local path=$1

  load_rule_contract "$path" || {
    echo "Refusing an invalid legacy passwordless sudo filename: $path" >&2
    return 1
  }
  if [[ -n $rule_timer && -z $system_root ]]; then
    /usr/bin/systemctl stop "$rule_timer.timer" "$rule_timer.service" \
      2>/dev/null || true
  fi
  /usr/bin/rm -f -- "$path"
}

shopt -s nullglob
legacy_rules=("$sudoers_dir"/99-omarchy-nopasswd-*)
shopt -u nullglob
fixed_timezone_rule="$sudoers_dir/omarchy-tzupdate"
if [[ -e $fixed_timezone_rule || -L $fixed_timezone_rule ]]; then
  legacy_rules+=("$fixed_timezone_rule")
fi

for legacy_rule in "${legacy_rules[@]}"; do
  if ! validate_legacy_rule "$legacy_rule"; then
    echo "Refusing a modified legacy passwordless sudo rule: $legacy_rule" >&2
    exit 1
  fi
done
for legacy_rule in "${legacy_rules[@]}"; do
  remove_legacy_rule "$legacy_rule"
done
