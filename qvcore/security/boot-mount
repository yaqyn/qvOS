#!/bin/bash
set -euo pipefail

mode=apply
if [[ ${1:-} == "--check" ]]; then
  mode=check
  shift
fi
(($# == 0)) || {
  echo "Usage: qvcore/security/boot-mount [--check]" >&2
  exit 2
}

system_root=${QVOS_SECURITY_SYSTEM_ROOT:-}
fstab="$system_root/etc/fstab"
candidate=""
backup_file=""
fstab_changed=0
desired_options=""

cleanup() {
  [[ -z $candidate ]] || rm -f -- "$candidate"
}
trap cleanup EXIT

as_root() {
  if ((EUID == 0)); then
    "$@"
  else
    /usr/bin/sudo "$@"
  fi
}

has_private_masks() {
  local options=$1

  [[ ,$options, == *",fmask=0077,"* ]] &&
    [[ ,$options, == *",dmask=0077,"* ]]
}

reload_mount_units() {
  as_root /usr/bin/systemctl daemon-reload
}

read_generated_boot_options() {
  local fragment_path source_path

  fragment_path=$(
    /usr/bin/systemctl show --property=FragmentPath --value boot.mount
  )
  source_path=$(
    /usr/bin/systemctl show --property=SourcePath --value boot.mount
  )
  [[ $fragment_path == "/run/systemd/generator/boot.mount" ]] || return 1
  [[ $source_path == "/etc/fstab" ]] || return 1
  [[ -f $fragment_path && ! -L $fragment_path ]] || return 1
  awk -F= '
    $1 == "Options" {
      options = substr($0, index($0, "=") + 1)
      count++
    }
    END {
      if (count != 1) {
        exit 1
      }
      print options
    }
  ' "$fragment_path"
}

restore_prior_policy() {
  ((fstab_changed)) || return 0
  as_root /usr/bin/install -o root -g root -m 0644 "$backup_file" "$fstab"
  reload_mount_units || true
}

if [[ -n $system_root && ${QVOS_SECURITY_TESTING:-} != "1" ]]; then
  echo "A custom qvOS security system root is only valid in tests." >&2
  exit 2
fi
[[ -e $fstab || -L $fstab ]] || exit 0
[[ -f $fstab && ! -L $fstab ]] || {
  echo "qvOS requires a regular fstab file: $fstab" >&2
  exit 1
}

read -r boot_entries boot_vfat_entries < <(
  awk '
    /^[[:space:]]*#/ || NF == 0 { next }
    $2 == "/boot" {
      entries++
      if ($3 == "vfat") {
        vfat_entries++
      }
    }
    END { print entries + 0, vfat_entries + 0 }
  ' "$fstab"
)
((boot_entries <= 1)) || {
  echo "Expected at most one active /boot entry in $fstab." >&2
  exit 1
}
((boot_entries == 1)) || exit 0
((boot_vfat_entries == 1)) || exit 0

candidate=$(mktemp)
awk '
  function secure_options(options,    count, fields, i, result) {
    count = split(options, fields, ",")
    result = ""
    for (i = 1; i <= count; i++) {
      if (fields[i] ~ /^(fmask|dmask|umask)=/) {
        continue
      }
      if (fields[i] != "") {
        result = result (result == "" ? "" : ",") fields[i]
      }
    }
    return result (result == "" ? "" : ",") "fmask=0077,dmask=0077"
  }
  /^[[:space:]]*#/ || NF == 0 {
    print
    next
  }
  $2 == "/boot" && $3 == "vfat" {
    if (NF < 6) {
      exit 3
    }
    output = $1 "\t" $2 "\t" $3 "\t" secure_options($4) "\t" $5 "\t" $6
    for (i = 7; i <= NF; i++) {
      output = output "\t" $i
    }
    print output
    next
  }
  { print }
' "$fstab" >"$candidate" || {
  echo "Could not construct a safe /boot mount policy from $fstab." >&2
  exit 1
}

[[ $mode == "apply" ]] || exit 0

if [[ -n $system_root ]]; then
  install -m 0644 "$candidate" "$fstab"
  exit 0
fi

[[ $(findmnt -n -o FSTYPE --target /boot 2>/dev/null || true) == "vfat" ]] || {
  echo "The active /boot mount is not the expected vfat filesystem." >&2
  exit 1
}
current_options=$(findmnt -n -o OPTIONS --target /boot)
desired_options=$(awk '$2 == "/boot" { print $4; exit }' "$candidate")
[[ -n $desired_options ]] || {
  echo "Could not resolve the desired /boot mount options." >&2
  exit 1
}
if ! cmp -s "$candidate" "$fstab"; then
  fstab_changed=1
fi

if ((fstab_changed)); then
  backup_file=$(as_root /usr/bin/mktemp /etc/fstab.qvos-backup.XXXXXX)
  as_root /usr/bin/install -o root -g root -m 0600 "$fstab" "$backup_file"
  as_root /usr/bin/install -o root -g root -m 0644 "$candidate" "$fstab"
fi

reload_status=0
reload_mount_units || reload_status=$?
generated_status=0
generated_options=$(read_generated_boot_options) || generated_status=$?
if ((reload_status != 0 || generated_status != 0)) ||
  [[ $generated_options != "$desired_options" ]]; then
  if ((fstab_changed)); then
    restore_prior_policy
    echo "Could not load the private /boot policy into systemd; restored the prior fstab policy." >&2
  else
    echo "Could not load the existing private /boot policy into systemd; fstab was unchanged." >&2
  fi
  exit 1
fi

if has_private_masks "$current_options"; then
  printf 'Protected /boot with fmask=0077,dmask=0077'
else
  printf 'Stored private /boot policy; reboot required to activate fmask=0077,dmask=0077'
fi
[[ -z $backup_file ]] || printf '; fstab backup: %s' "$backup_file"
printf '\n'
