#!/bin/bash
set -euo pipefail

source_path=${QVOS_PATH:-$HOME/.local/share/qvos}
QVOS_PATH=$(readlink -f -- "$source_path" 2>/dev/null || true)
mode=interactive

usage() {
  echo "Usage: qv update [-y|--check]" >&2
}

if (($# > 1)); then
  usage
  exit 2
fi
case ${1:-} in
"") ;;
-y) mode=noninteractive ;;
--check) mode=check ;;
*)
  usage
  exit 2
  ;;
esac

preflight() {
  "$QVOS_PATH/qvcore/update/source-check" "$QVOS_PATH"
  if [[ ! -x $QVOS_PATH/qvcore/update/run ]]; then
    echo "qvOS update cannot find its update engine." >&2
    return 1
  fi
  if [[ ! -x $QVOS_PATH/qvcore/tui/build ]] ||
    ! "$QVOS_PATH/qvcore/tui/build" --check; then
    echo "qvOS update cannot verify the native TUI build path." >&2
    return 1
  fi
}

if [[ $mode == "interactive" ]]; then
  tui=${QVOS_TUI_BINARY:-}
  if [[ -z $tui ]]; then
    tui=$(command -v qvos-tui || true)
  fi
  if [[ -n $tui && -x $tui ]]; then
    exec "$tui" --update
  fi
fi

preflight

if [[ $mode == "check" ]]; then
  exit 0
fi

if [[ $mode == "interactive" ]]; then
  gum style --border normal --padding "1 2" \
    "Ready to update qvOS?" \
    "" \
    "• The qvOS update engine will update qvOS and system packages" \
    "• Press Ctrl+C to stop the update if needed" \
    "• Make sure you're connected to power or have a full battery" \
    "" \
    "What's new: https://github.com/Yaqyn-qvOS/qvOS/commits/OS"

  echo
  if ! gum confirm "Continue with qvOS update?"; then
    echo "qvOS update cancelled."
    exit 130
  fi
fi

"$QVOS_PATH/qvcore/update/run"
echo -e "\e[32m\nqvOS update is complete.\e[0m"
