#!/bin/bash
set -euo pipefail

echo

request_reboot() {
  "$OMARCHY_PATH/qvcore/update/reboot-request" "$@"
}

running_kernel=$(uname -r)
kernel_image_found=false
running_kernel_found=false
shopt -s nullglob
kernel_images=(/usr/lib/modules/*/vmlinuz)
shopt -u nullglob

for kernel_image in "${kernel_images[@]}"; do
  if pacman -Qo "$kernel_image" &>/dev/null; then
    kernel_image_found=true
    installed_kernel=$(basename -- "$(dirname -- "$kernel_image")")
    if [[ $installed_kernel == "$running_kernel" ]]; then
      running_kernel_found=true
      break
    fi
  fi
done

if [[ $kernel_image_found == "true" && $running_kernel_found == "false" ]]; then
  request_reboot "Linux kernel updated" "Linux kernel has been updated. Reboot?"
elif [[ -f $HOME/.local/state/omarchy/reboot-required ]]; then
  request_reboot \
    "Updated components require a reboot" \
    "Updates require reboot. Ready?"
fi

hyprland_pid=$(pgrep -n -x Hyprland 2>/dev/null || true)
running_hyprland=""
if [[ -n $hyprland_pid ]]; then
  running_hyprland=$(readlink -- "/proc/$hyprland_pid/exe" 2>/dev/null || true)
fi
if [[ $running_hyprland == *"(deleted)"* ]]; then
  request_reboot "Hyprland updated" "Hyprland has been updated. Reboot?"
fi

state_dir="$HOME/.local/state/omarchy"
shopt -s nullglob
restart_markers=("$state_dir"/restart-*-required)
shopt -u nullglob

for marker in "${restart_markers[@]}"; do
  [[ -f $marker && ! -L $marker ]] || continue
  filename=$(basename -- "$marker")
  service=${filename#restart-}
  service=${service%-required}
  if [[ ! $service =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    echo "Keeping invalid restart marker: $filename" >&2
    continue
  fi

  restart_command="omarchy-restart-$service"
  if ! command -v "$restart_command" >/dev/null; then
    echo "Keeping restart marker without an owner: $filename" >&2
    continue
  fi

  echo "Restarting $service"
  "$restart_command"
  omarchy-state clear "$filename"
done
