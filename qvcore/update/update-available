#!/bin/bash
set -euo pipefail

source_path=${QVOS_PATH:-$HOME/.local/share/qvos}
source_path=$(readlink -f -- "$source_path" 2>/dev/null || true)

(( $# == 0 )) || {
  echo "Usage: qv update available" >&2
  exit 2
}
[[ -d $source_path && ! -L $source_path ]] || {
  echo "qvOS update check: live source checkout is unavailable." >&2
  exit 2
}
"$(dirname -- "${BASH_SOURCE[0]}")/source-check" "$source_path" >/dev/null

local_head=$(git -C "$source_path" rev-parse --verify HEAD 2>/dev/null) || {
  echo "qvOS update check: live source commit is unavailable." >&2
  exit 2
}
remote_line=$(
  timeout --foreground 30 \
    git -C "$source_path" \
    -c http.lowSpeedLimit=1024 \
    -c http.lowSpeedTime=10 \
    ls-remote --heads origin refs/heads/OS 2>/dev/null
) || {
  echo "qvOS update check: official OS branch is unreachable." >&2
  exit 2
}
read -r remote_head remote_ref extra <<<"$remote_line"
[[ $remote_head =~ ^[0-9a-f]{40}$ && $remote_ref == "refs/heads/OS" && -z ${extra:-} ]] || {
  echo "qvOS update check: official OS branch returned an invalid commit." >&2
  exit 2
}

if [[ $local_head == "$remote_head" ]]; then
  printf 'qvOS is up to date (%s)\n' "${local_head:0:8}"
  exit 1
fi
if git -C "$source_path" merge-base --is-ancestor "$remote_head" "$local_head" 2>/dev/null; then
  printf 'qvOS source is locally ahead (%s)\n' "${local_head:0:8}"
  exit 1
fi

printf 'qvOS update available (%s)\n' "${remote_head:0:8}"
