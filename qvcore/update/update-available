#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
export QVOS_PATH
owner_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
source_owner="$owner_root/qvcore/update/source-available"
package_owner="$owner_root/qvcore/packages/update-available"

(( $# == 0 )) || {
  echo "Usage: qv update available" >&2
  exit 2
}
[[ -x $source_owner && -x $package_owner ]] || {
  echo "qvOS update check: an availability owner is unavailable." >&2
  exit 2
}

set +e
source_output=$("$source_owner" 2>&1)
source_status=$?
package_output=$("$package_owner" 2>&1)
package_status=$?
set -e

if (( source_status == 0 || package_status == 0 )); then
  (( source_status != 0 )) || printf '%s\n' "$source_output"
  (( package_status != 0 )) || printf '%s\n' "$package_output"
  (( source_status == 0 || source_status == 1 )) ||
    printf '%s\n' "$source_output" >&2
  (( package_status == 0 || package_status == 1 )) ||
    printf '%s\n' "$package_output" >&2
  exit 0
fi

if (( source_status == 1 && package_status == 1 )); then
  printf '%s\n' "$source_output"
  printf '%s\n' "$package_output"
  exit 1
fi

printf '%s\n' "$source_output" >&2
printf '%s\n' "$package_output" >&2
exit 2
