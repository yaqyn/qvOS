#!/bin/bash
set -euo pipefail

(( $# == 2 )) || {
  echo "Usage: qvcore/update/reboot-request <reason> <prompt>" >&2
  exit 2
}
reason=$1
prompt=$2
[[ -n $reason && -n $prompt ]] || {
  echo "Usage: qvcore/update/reboot-request <reason> <prompt>" >&2
  exit 2
}

defer_reboot=${QVOS_UPDATE_DEFER_REBOOT:-${OMARCHY_UPDATE_DEFER_REBOOT:-0}}
if [[ $defer_reboot == "1" ]]; then
  printf 'qvOS action: reboot required: %s\n' "$reason"
else
  if gum confirm "$prompt"; then
    qv-system-reboot
  fi
fi
