#!/bin/bash
set -euo pipefail

official_https="https://github.com/Yaqyn-qvOS/qvOS.git"
official_ssh="git@github.com:Yaqyn-qvOS/qvOS.git"
official_ssh_url="ssh://git@github.com/Yaqyn-qvOS/qvOS.git"

(( $# == 1 )) || {
  echo "Usage: qvcore/update/source-check <source-path>" >&2
  exit 2
}
source_path=$1

[[ -d $source_path && ! -L $source_path ]] || {
  echo "qvOS source checkout is missing or unsafe: $source_path" >&2
  exit 1
}
branch=$(git -C "$source_path" branch --show-current 2>/dev/null || true)
[[ $branch == "OS" ]] || {
  echo "qvOS source update requires branch OS; found '${branch:-none}'." >&2
  exit 1
}
source_status=$(git -C "$source_path" status --porcelain=v1 --untracked-files=all 2>/dev/null) || {
  echo "qvOS source update cannot inspect the source checkout." >&2
  exit 1
}
[[ -z $source_status ]] || {
  echo "qvOS source has local changes; commit or preserve them before updating." >&2
  exit 1
}
origin_url=$(git -C "$source_path" config --get remote.origin.url 2>/dev/null || true)
case $origin_url in
  "$official_https" | "$official_ssh" | "$official_ssh_url") ;;
  *)
    echo "qvOS source update requires the official origin; found '${origin_url:-none}'." >&2
    exit 1
    ;;
esac
