#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
noidle_applied=false

(( $# == 0 )) || {
  echo "Usage: qvcore/update/perform" >&2
  exit 2
}

restore_idle() {
  [[ $noidle_applied == "true" ]] || return 0
  "$QVOS_PATH/qvcore/desktop/hyprland/qvos-runtime-config" \
    window tag remove noidle &>/dev/null || true
}
trap restore_idle EXIT

if "$QVOS_PATH/qvcore/desktop/hyprland/qvos-runtime-config" \
  window tag add noidle &>/dev/null; then
  noidle_applied=true
fi

"$QVOS_PATH/qvcore/packages/update-keyring"
"$QVOS_PATH/qvcore/update/available-reset"
"$QVOS_PATH/qvcore/packages/update-system"
"$QVOS_PATH/qvcore/migrations/run"
"$QVOS_PATH/qvcore/packages/update-aur"
"$QVOS_PATH/qvcore/packages/remove-orphans"
"$QVOS_PATH/qvcore/install/post-update-hook"
"$QVOS_PATH/qvcore/direct/post-update-hook"
"$QVOS_PATH/qvcore/waybar/post-update-hook"
if ! qv-hook post-update; then
  echo "qvOS update: one or more custom post-update hooks failed." >&2
fi
"$QVOS_PATH/qvcore/update/analyze-log"
"$QVOS_PATH/qvcore/update/restart"
