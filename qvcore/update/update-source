#!/bin/bash
set -euo pipefail

source_path=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
source_path=$(readlink -f -- "$source_path" 2>/dev/null || true)
QVOS_PATH="$source_path"
OMARCHY_PATH="$source_path"

"$QVOS_PATH/qvcore/update/source-check" "$QVOS_PATH"

reload_hyprland() {
  hyprctl keyword debug:suppress_errors false &>/dev/null || true
  hyprctl reload &>/dev/null || true
}
trap reload_hyprland EXIT

echo -e "\e[32mUpdate qvOS source\e[0m"
"$QVOS_PATH/qvcore/update/time-sync"
hyprctl keyword debug:suppress_errors true &>/dev/null || true

timeout --foreground 180 \
  git -C "$OMARCHY_PATH" \
  -c http.lowSpeedLimit=1024 \
  -c http.lowSpeedTime=30 \
  pull --ff-only --no-rebase origin OS
git -C "$OMARCHY_PATH" diff --check
[[ -z $(git -C "$OMARCHY_PATH" status --porcelain=v1 --untracked-files=all) ]] || {
  echo "qvOS source became dirty after updating; stopping before package changes." >&2
  exit 1
}
