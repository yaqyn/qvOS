#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/update/native-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

[[ -x $root/qvcore/update/update-source ]] || fail "native source updater mode"
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest") == $(
  sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest" | sort -u
) ]] || fail "native update paths are not sorted and unique"
# shellcheck disable=SC2016
grep -Fqx 'exec "$OMARCHY_PATH/qvcore/update/update-source" "$@"' \
  "$root/bin/omarchy-update-git" || fail "source update adapter"
if rg -n -- '--autostash|reset --merge|pull( |.* )origin master' \
  "$root/bin/omarchy-update-git" "$root/qvcore/update/update-source"; then
  fail "unsafe or inherited source-update behavior remains"
fi
grep -Fq 'pull --ff-only --no-rebase origin OS' \
  "$root/qvcore/update/update-source" || fail "OS fast-forward-only source update"
grep -Fq 'status --porcelain=v1 --untracked-files=all' \
  "$root/qvcore/update/qvos-update" || fail "live source cleanliness preflight"
[[ -x $root/qvcore/update/restart ]] || fail "native update restart owner mode"
(( $(wc -l <"$root/bin/omarchy-update-restart") <= 10 )) ||
  fail "update restart compatibility adapter contains implementation"
# shellcheck disable=SC2016
grep -Fqx 'exec "$OMARCHY_PATH/qvcore/update/restart" "$@"' \
  "$root/bin/omarchy-update-restart" ||
  fail "update restart compatibility adapter"
if rg -q 'gum confirm|omarchy-system-reboot|if \[\[ -x .*qvcore/update' \
  "$root/bin/omarchy-update-restart"; then
  fail "update restart compatibility route retains a fallback"
fi
for retired_switcher in \
  bin/omarchy-branch-set \
  bin/omarchy-channel-set \
  bin/omarchy-update-branch; do
  [[ ! -e $root/$retired_switcher && ! -L $root/$retired_switcher ]] ||
    fail "unsupported source switcher remains: $retired_switcher"
  grep -Fqx "$retired_switcher" "$root/qvcore/update/retired-paths" ||
    fail "retired source switcher is not inventoried: $retired_switcher"
done

printf 'ok - qvOS source updates are clean, official, and fast-forward only\n'
