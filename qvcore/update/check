#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
native_manifest="$root/qvcore/update/native-paths"
retired_manifest="$root/qvcore/update/retired-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$native_manifest") == $(
  sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$native_manifest" | sort -u
) ]] || fail "native update paths are not sorted and unique"
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == $(
  sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest" | sort -u
) ]] || fail "retired update paths are not sorted and unique"

owners=(
  analyze-log
  available-reset
  firmware
  log-path
  perform
  qvos-update
  reboot-request
  restart
  run
  snapshot
  source-check
  state
  time-sync
  update-available
  update-source
)
for owner in "${owners[@]}"; do
  [[ -x $root/qvcore/update/$owner ]] || fail "native update owner mode: $owner"
done

declare -A compatibility_owners=(
  [omarchy-snapshot]=snapshot
  [omarchy-update]=qvos-update
  [omarchy-update-available]=update-available
  [omarchy-update-firmware]=firmware
  [omarchy-update-time]=time-sync
)
for adapter in "${!compatibility_owners[@]}"; do
  path="$root/bin/$adapter"
  owner=${compatibility_owners[$adapter]}
  [[ -x $path ]] || fail "update compatibility adapter mode: $adapter"
  (( $(wc -l <"$path") <= 6 )) ||
    fail "update compatibility adapter contains implementation: $adapter"
  ! rg -q '^# (qv|omarchy):' "$path" ||
    fail "update compatibility adapter duplicates metadata: $adapter"
  grep -Fq "qvcore/update/$owner" "$path" ||
    fail "update compatibility adapter owner: $adapter"
done

declare -A native_owners=(
  [qv-snapshot]=snapshot
  [qv-update]=qvos-update
  [qv-update-available]=update-available
  [qv-update-firmware]=firmware
  [qv-update-time]=time-sync
)
for adapter in "${!native_owners[@]}"; do
  path="$root/bin/$adapter"
  owner=${native_owners[$adapter]}
  [[ -x $path ]] || fail "native update adapter mode: $adapter"
  (( $(wc -l <"$path") <= 12 )) ||
    fail "native update adapter contains implementation: $adapter"
  rg -q '^# qv:summary=' "$path" || fail "native update metadata: $adapter"
  grep -Fq "qvcore/update/$owner" "$path" || fail "native update owner: $adapter"
done

# shellcheck disable=SC2016
grep -Fqx '"$QVOS_PATH/qvcore/update/run"' "$root/qvcore/update/qvos-update" ||
  fail "guarded update wrapper does not delegate once to the native engine"
if rg -n 'omarchy-update|omarchy-migrate|/tmp/omarchy-update' \
  "$root/qvcore/update/qvos-update" \
  "$root/qvcore/update/run" \
  "$root/qvcore/update/perform" \
  "$root/qvcore/tui/update/run"; then
  fail "native update engine retains an inherited route or public tmp log"
fi
# shellcheck disable=SC2016
grep -Fq 'qvos_root="$state_parent/qvos"' "$root/qvcore/update/log-path" ||
  fail "private qvOS update state root"
# shellcheck disable=SC2016
grep -Fq 'log_path="$state_root/update.log"' "$root/qvcore/update/log-path" ||
  fail "private qvOS update log path"
grep -Fq 'trap restore_idle EXIT' "$root/qvcore/update/perform" ||
  fail "update no-idle cleanup trap"
grep -Fq 'restart-walker-required' "$root/qvcore/update/analyze-log" ||
  fail "Walker package restart analysis"
# shellcheck disable=SC2016
grep -Fqx '"$QVOS_PATH/qvcore/migrations/run"' "$root/qvcore/update/perform" ||
  fail "native migration owner in update pipeline"
grep -Fq 'ls-remote --heads origin refs/heads/OS' \
  "$root/qvcore/update/update-available" || fail "official OS availability check"
if rg -n 'rev-list --tags|describe --tags|ls-remote --tags' \
  "$root/qvcore/update/update-available"; then
  fail "tag-based update availability remains"
fi
grep -Fq 'pull --ff-only --no-rebase origin OS' \
  "$root/qvcore/update/update-source" || fail "OS fast-forward-only source update"
grep -Fq 'qvcore/update/source-check' "$root/qvcore/update/qvos-update" ||
  fail "guarded wrapper source contract"
grep -Fq 'qvcore/update/source-check' "$root/qvcore/update/update-source" ||
  fail "source updater source contract"
# shellcheck disable=SC2016
grep -Fq '/source-check" "$source_path"' "$root/qvcore/update/update-available" ||
  fail "availability source contract"
if rg -n -- '--autostash|reset --merge|pull( |.* )origin master' \
  "$root/qvcore/update/update-source"; then
  fail "unsafe or inherited source-update behavior remains"
fi
grep -Fq '.local/state/qvos/update' "$root/qvcore/update/restart" ||
  fail "native restart marker state"
if rg -q '\.local/state/omarchy|omarchy-state clear' "$root/qvcore/update/restart"; then
  fail "restart owner retains active Omarchy state"
fi

while IFS= read -r retired; do
  [[ -n $retired && $retired != \#* ]] || continue
  [[ ! -e $root/$retired && ! -L $root/$retired ]] ||
    fail "retired update path remains: $retired"
done <"$retired_manifest"

printf 'ok - qvOS owns one private, fail-closed update transaction\n'
