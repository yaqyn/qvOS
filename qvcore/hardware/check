#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/hardware/native-paths"
owner="$root/qvcore/hardware/detect"
retired_manifest="$root/qvcore/hardware/retired-paths"

fail() {
  printf 'qvOS hardware check: %s\n' "$1" >&2
  exit 1
}

expected=$'bin/omarchy-hw-asus-expertbook-b9406\nbin/omarchy-hw-asus-rog\nbin/omarchy-hw-asus-zenbook-ux5406aa\nbin/omarchy-hw-dell-xps-haptic-touchpad\nbin/omarchy-hw-dell-xps-oled\nbin/omarchy-hw-external-monitors\nbin/omarchy-hw-framework16\nbin/omarchy-hw-hybrid-gpu\nbin/omarchy-hw-intel\nbin/omarchy-hw-intel-ptl\nbin/omarchy-hw-intel-sof\nbin/omarchy-hw-match\nbin/omarchy-hw-nvidia-gsp\nbin/omarchy-hw-nvidia-without-gsp\nbin/omarchy-hw-surface\nbin/omarchy-hw-touchpad\nbin/omarchy-hw-touchscreen\nbin/omarchy-hw-vulkan'
native_paths=$(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest")
[[ $native_paths == "$expected" ]] || fail "native detector inventory is incomplete or unordered"
[[ -x $owner && ! -L $owner ]] || fail "native detector owner is unavailable or unsafe"
for qvos_only_route in intel-wifi7-eht tuxedo; do
  native_adapter="$root/bin/qv-hw-$qvos_only_route"
  [[ -x $native_adapter && ! -L $native_adapter ]] ||
    fail "qvOS-only hardware detector adapter: $qvos_only_route"
  (( $(wc -l <"$native_adapter") <= 9 )) ||
    fail "qvOS-only hardware adapter contains implementation: $qvos_only_route"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "qvOS-only hardware adapter lacks metadata: $qvos_only_route"
  grep -Fqx \
    "exec \"\$QVOS_PATH/qvcore/hardware/detect\" $qvos_only_route \"\$@\"" \
    "$native_adapter" ||
    fail "qvOS-only hardware adapter bypasses its owner: $qvos_only_route"
  [[ ! -e $root/bin/omarchy-hw-$qvos_only_route &&
    ! -L $root/bin/omarchy-hw-$qvos_only_route ]] ||
    fail "qvOS-only detector invents an Omarchy adapter: $qvos_only_route"
done
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == \
  'default/udev/' ]] || fail "retired hardware-policy inventory"
[[ ! -e $root/default/udev && ! -L $root/default/udev ]] ||
  fail "inherited udev policy remains"
[[ -f $root/qvcore/hardware/framework16-qmk-hid.rules &&
  ! -L $root/qvcore/hardware/framework16-qmk-hid.rules ]] ||
  fail "native Framework HID policy source"
framework_installer="$root/qvcore/install/config/hardware/framework/qmk-hid.sh"
grep -Fq 'qvcore/hardware/framework16-qmk-hid.rules' "$framework_installer" ||
  fail "Framework HID installer bypasses its native source"
# shellcheck disable=SC2016
grep -Fq 'sudo test -L "$rule"' "$framework_installer" ||
  fail "Framework HID installer does not reject symbolic-link targets"
# shellcheck disable=SC2016
grep -Fq 'sudo mv -Tn "$candidate" "$rule"' "$framework_installer" ||
  fail "Framework HID installer does not publish without clobbering"
if rg -n 'default/udev|sudo cp ' "$framework_installer"; then
  fail "Framework HID installer retains an inherited or unsafe copy path"
fi

for hardware_policy in \
  qvcore/install/hardware/intel/fred.conf \
  qvcore/install/hardware/intel/iwlwifi-disable-eht.conf \
  qvcore/install/hardware/tuxedo/blacklist-clevo-xsm-wmi.conf; do
  [[ -f $root/$hardware_policy && ! -L $root/$hardware_policy ]] ||
    fail "native hardware policy source: $hardware_policy"
done
# shellcheck disable=SC2016
for stage_contract in \
  'qvcore/install/config/hardware/intel/fred.sh|"$QVOS_PATH/qvcore/install/hardware/identity" intel-fred' \
  'qvcore/install/config/hardware/intel/fix-wifi7-eht.sh|"$QVOS_PATH/qvcore/install/hardware/identity" intel-wifi7-eht'; do
  stage=${stage_contract%%|*}
  expected_call=${stage_contract#*|}
  [[ $(<"$root/$stage") == "$expected_call" ]] ||
    fail "Intel hardware stage bypasses its transactional owner: $stage"
done
# shellcheck disable=SC2016
grep -Fq 'if "$QVOS_PATH/bin/qv-hw-tuxedo"; then' \
  "$root/qvcore/install/config/hardware/fix-tuxedo-backlight.sh" ||
  fail "Tuxedo stage bypasses the native detector"
# shellcheck disable=SC2016
grep -Fq '"$QVOS_PATH/qvcore/install/hardware/identity" tuxedo-backlight' \
  "$root/qvcore/install/config/hardware/fix-tuxedo-backlight.sh" ||
  fail "Tuxedo stage bypasses the transactional policy owner"
if rg -n '/etc/default/limine|sudo[[:space:]]+tee|/lib/modules/.+\.ko' \
  "$root/qvcore/install/config/hardware/intel/fred.sh" \
  "$root/qvcore/install/config/hardware/intel/fix-wifi7-eht.sh" \
  "$root/qvcore/install/config/hardware/fix-tuxedo-backlight.sh"; then
  fail "hardware policy retains duplicate, direct, or destructive root mutation"
fi

while IFS= read -r inherited_path; do
  route=${inherited_path##*/omarchy-hw-}
  native_adapter="$root/bin/qv-hw-$route"
  compatibility_adapter="$root/$inherited_path"
  [[ -x $native_adapter && ! -L $native_adapter &&
    -x $compatibility_adapter && ! -L $compatibility_adapter ]] ||
    fail "hardware adapters are unavailable or unsafe: $route"
  (($(wc -l <"$native_adapter") <= 9)) ||
    fail "native hardware adapter contains implementation: $route"
  (($(wc -l <"$compatibility_adapter") <= 6)) ||
    fail "hardware compatibility adapter contains implementation: $route"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native hardware adapter lacks metadata: $route"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "hardware compatibility adapter duplicates metadata: $route"
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    grep -Fqx "exec \"\$QVOS_PATH/qvcore/hardware/detect\" $route \"\$@\"" \
      "$adapter" || fail "hardware adapter bypasses its owner: $route"
  done
done <<<"$native_paths"

remaining_compatibility=$(
  rg --no-filename -o 'omarchy-hw-[a-z0-9-]+' "$root/qvcore" "$root/qvcore/config/files" \
    --glob '!**/hardware/**' --glob '!**/AGENTS.md' \
    --glob '!**/owner-contracts.psv' | sort -u || true
)
[[ $remaining_compatibility == "omarchy-hw-recover-internal-monitor" ]] ||
  fail "native qvOS source still calls a hardware compatibility command"

printf 'ok - qvOS owns one read-only hardware detection boundary\n'
