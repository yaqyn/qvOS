#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
waybar_source="$QVOS_PATH/qvcore/config/files/waybar/config.jsonc"
waybar_config="$HOME/.config/waybar/config.jsonc"
waybar_style_source="$QVOS_PATH/qvcore/config/files/waybar/style.css"
waybar_style="$HOME/.config/waybar/style.css"
mode=${1:---reset}

case $mode in
--reset | --status) ;;
*)
  echo "Usage: refresh [--reset|--status]" >&2
  exit 2
  ;;
esac

[[ -f $waybar_source && ! -L $waybar_source &&
  -f $waybar_style_source && ! -L $waybar_style_source ]] || {
  echo "The complete qvOS Waybar source is unavailable." >&2
  exit 1
}
jq -e 'type == "object"' "$waybar_source" >/dev/null || {
  echo "The qvOS Waybar configuration is invalid." >&2
  exit 1
}
[[ -s $waybar_style_source ]] || {
  echo "The qvOS Waybar style is empty." >&2
  exit 1
}
for target in "$waybar_config" "$waybar_style"; do
  [[ ! -e $target && ! -L $target ]] ||
    [[ -f $target || -L $target ]] || {
      echo "Refusing non-file Waybar target: $target" >&2
      exit 1
    }
done

if [[ $mode == "--status" ]]; then
  cmp -s "$waybar_source" "$waybar_config" &&
    cmp -s "$waybar_style_source" "$waybar_style"
  exit
fi

config_changed=0
style_changed=0
if ! cmp -s "$waybar_source" "$waybar_config"; then
  config_changed=1
fi
if ! cmp -s "$waybar_style_source" "$waybar_style"; then
  style_changed=1
fi

((config_changed == 0)) ||
  "$QVOS_PATH/qvcore/config/refresh" waybar/config.jsonc
((style_changed == 0)) ||
  "$QVOS_PATH/qvcore/config/refresh" waybar/style.css

if ((config_changed || style_changed)) &&
  [[ ${QVOS_WAYBAR_SKIP_RESTART:-0} != "1" ]]; then
  qv-restart-waybar
fi
