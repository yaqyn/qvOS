#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
waybar_source="$QVOS_PATH/config/waybar/config.jsonc"
qvos_overrides="$QVOS_PATH/qvcore/waybar/overrides.jsonc"
waybar_config="$HOME/.config/waybar/config.jsonc"
waybar_style_source="$QVOS_PATH/config/waybar/style.css"
waybar_style="$HOME/.config/waybar/style.css"
mode=${1:---reset}
merged_config=$(mktemp)
staged_config=""

cleanup() {
  rm -f -- "$merged_config"
  [[ -z $staged_config ]] || rm -f -- "$staged_config"
}
trap cleanup EXIT

case $mode in
--reset | --status) ;;
*)
  echo "Usage: refresh [--reset|--status]" >&2
  exit 2
  ;;
esac

merge_source="$waybar_source"
if [[ $mode == "--status" && -f $waybar_config ]]; then
  jq -e 'type == "object"' "$waybar_config" >/dev/null 2>&1 || exit 1
  merge_source="$waybar_config"
fi

jq -s '
  def has_bar_module($name):
    any(.["modules-left", "modules-center", "modules-right"] | arrays[]; . == $name);
  def replace_bar_module($from; $to):
    reduce ["modules-left", "modules-center", "modules-right"][] as $key (.;
      if (.[$key] | type) == "array" then
        .[$key] |= map(if . == $from then $to else . end)
      else
        .
      end
    );

  if (.[0] | type) != "object" or (.[1] | type) != "object" then
    error("Waybar base and qvOS overrides must be JSON objects")
  else
    .[0] * .[1]
    | if has_bar_module("clock") then
        replace_bar_module("clock"; "group/prayer-clock")
      elif has_bar_module("group/prayer-clock") then
        .
      elif (.["modules-center"] | type) == "array" then
        .["modules-center"] = ["group/prayer-clock"] + .["modules-center"]
      else
        .["modules-center"] = ["group/prayer-clock"]
      end
  end
' "$merge_source" "$qvos_overrides" >"$merged_config"

if [[ $mode == "--status" ]]; then
  cmp -s "$merged_config" "$waybar_config" &&
    [[ -f $waybar_style ]]
  exit
fi

config_changed=0
style_changed=0
if ! cmp -s "$merged_config" "$waybar_config"; then
  config_changed=1
fi
if ! cmp -s "$waybar_style_source" "$waybar_style"; then
  style_changed=1
fi

if ((config_changed)) &&
  [[ -f $waybar_config ]] &&
  ! cmp -s "$waybar_source" "$waybar_config"; then
  backup_config=$(mktemp "$waybar_config.bak.XXXXXXXX")
  cp --preserve=all -- "$waybar_config" "$backup_config"
  printf 'Updated qvOS Waybar integration.\nSaved backup as %s.\n' \
    "$backup_config"
fi

install -d "$(dirname -- "$waybar_config")"
if ((config_changed)); then
  staged_config=$(mktemp "$(dirname -- "$waybar_config")/.config.jsonc.XXXXXXXX")
  install -m 0644 "$merged_config" "$staged_config"
  mv -f -- "$staged_config" "$waybar_config"
  staged_config=""
fi
if ((style_changed)); then
  "$QVOS_PATH/qvcore/config/refresh" waybar/style.css
fi

if ((config_changed || style_changed)) &&
  [[ ${QVOS_WAYBAR_SKIP_RESTART:-0} != "1" ]]; then
  qv-restart-waybar
fi
