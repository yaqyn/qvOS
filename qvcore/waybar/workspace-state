#!/bin/bash
set -euo pipefail

mode=${1:---watch}
case $mode in
--events | --once | --watch) ;;
*)
  echo "Usage: workspace-state [--events|--once|--watch]" >&2
  exit 2
  ;;
esac

for dependency in hyprctl jq; do
  command -v "$dependency" >/dev/null || {
    echo "Cannot track qvOS workspaces: $dependency is unavailable." >&2
    exit 1
  }
done
if [[ $mode == "--watch" ]]; then
  command -v socat >/dev/null || {
    echo "Cannot track qvOS workspaces: socat is unavailable." >&2
    exit 1
  }
fi

style_dir="$HOME/.config/waybar"
style_file="$style_dir/workspace-state.css"
workspaces_json='[]'
clients_json='[]'
monitors_json='[]'
declare -A attention=()

read_snapshot() {
  local next_workspaces next_clients next_monitors

  next_workspaces=$(hyprctl -j workspaces) || return 1
  next_clients=$(hyprctl -j clients) || return 1
  next_monitors=$(hyprctl -j monitors) || return 1
  jq -e '
    type == "array" and
    all(.[];
      (.id | type == "number") and
      (.name | type == "string") and
      (.monitor | type == "string") and
      (.windows | type == "number"))
  ' <<<"$next_workspaces" >/dev/null || return 1
  jq -e '
    type == "array" and
    all(.[];
      (.address | type == "string") and
      (.workspace.id | type == "number"))
  ' <<<"$next_clients" >/dev/null || return 1
  jq -e '
    type == "array" and
    all(.[];
      (.name | type == "string") and
      (.activeWorkspace.id | type == "number") and
      (.specialWorkspace.id | type == "number"))
  ' <<<"$next_monitors" >/dev/null || return 1

  workspaces_json=$next_workspaces
  clients_json=$next_clients
  monitors_json=$next_monitors
}

workspace_id_for_address() {
  local address=${1,,}

  [[ $address == 0x* ]] || address="0x$address"
  jq -r --arg address "$address" '
    first(.[] | select((.address | ascii_downcase) == $address) | .workspace.id)
      // empty
  ' <<<"$clients_json"
}

workspace_id_for_name() {
  local name=$1

  jq -r --arg name "$name" '
    first(.[] | select(.name == $name) | .id) // empty
  ' <<<"$workspaces_json"
}

workspace_is_visible() {
  local workspace_id=$1

  jq -e --argjson workspace_id "$workspace_id" '
    any(.[]; .activeWorkspace.id == $workspace_id or
      .specialWorkspace.id == $workspace_id)
  ' <<<"$monitors_json" >/dev/null
}

mark_attention() {
  local workspace_id=$1

  [[ $workspace_id =~ ^-?[0-9]+$ ]] || return 0
  workspace_is_visible "$workspace_id" && return 0
  attention[$workspace_id]=1
}

reconcile_attention() {
  local workspace_id

  while IFS= read -r workspace_id; do
    unset 'attention[$workspace_id]'
  done < <(jq -r '.[] | .activeWorkspace.id, .specialWorkspace.id' \
    <<<"$monitors_json")

  for workspace_id in "${!attention[@]}"; do
    jq -e --argjson workspace_id "$workspace_id" '
      any(.[]; .id == $workspace_id and .windows > 0)
    ' <<<"$workspaces_json" >/dev/null || unset 'attention[$workspace_id]'
  done
}

css_for_state() {
  local css monitor workspace_id windows position selector
  local -a ordered=()

  css=$'/* Generated by qvOS; manual changes are replaced. */\n'
  while IFS= read -r monitor; do
    [[ $monitor =~ ^[A-Za-z_][A-Za-z0-9_-]*$ ]] || continue
    mapfile -t ordered < <(
      jq -r --arg monitor "$monitor" '
        sort_by(if .id > 0 then .id else .id + 4294965958 end)
        | .[] | select(.monitor == $monitor)
        | [.id, .windows] | @tsv
      ' <<<"$workspaces_json"
    )

    position=0
    for workspace in "${ordered[@]}"; do
      ((position += 1))
      IFS=$'\t' read -r workspace_id windows <<<"$workspace"
      selector="window#waybar.$monitor #workspaces button:nth-child($position):not(.active)"
      if [[ -v attention[$workspace_id] ]]; then
        css+="$selector { color: @bright; opacity: 0.9; }"$'\n'
      elif ((windows > 0)); then
        css+="$selector { color: @foreground; opacity: 0.6; }"$'\n'
      fi
    done
  done < <(jq -r '.[].name' <<<"$monitors_json" | sort -u)

  printf '%s' "$css"
}

publish_style() {
  local next_style

  next_style=$(css_for_state)
  next_style+=$'\n'
  if [[ -f $style_file && ! -L $style_file ]] &&
    [[ $(<"$style_file")$'\n' == "$next_style" ]]; then
    return 0
  fi
  [[ ! -e $style_file && ! -L $style_file ]] ||
    [[ -f $style_file && ! -L $style_file ]] || {
      echo "Refusing unsafe qvOS workspace style: $style_file" >&2
      return 1
    }

  if [[ -e $style_dir || -L $style_dir ]]; then
    [[ -d $style_dir && ! -L $style_dir ]] || {
      echo "Refusing unsafe qvOS Waybar directory: $style_dir" >&2
      return 1
    }
  else
    install -d -m 0700 "$style_dir"
  fi
  umask 077
  printf '%s' "$next_style" >"$style_file"
}

handle_event() {
  local event=$1 name data address workspace_id workspace_name remainder

  name=${event%%>>*}
  [[ $event == *'>>'* ]] || return 0
  data=${event#*>>}

  case $name in
  urgent | bell | windowtitlev2)
    address=${data%%,*}
    [[ -n $address ]] || return 0
    workspace_id=$(workspace_id_for_address "$address")
    [[ -n $workspace_id ]] && mark_attention "$workspace_id"
    ;;
  openwindow)
    address=${data%%,*}
    remainder=${data#*,}
    workspace_name=${remainder%%,*}
    workspace_id=$(workspace_id_for_address "$address")
    [[ -n $workspace_id ]] || workspace_id=$(workspace_id_for_name "$workspace_name")
    [[ -n $workspace_id ]] && mark_attention "$workspace_id"
    ;;
  movewindowv2)
    remainder=${data#*,}
    workspace_id=${remainder%%,*}
    mark_attention "$workspace_id"
    ;;
  workspacev2)
    workspace_id=${data%%,*}
    [[ $workspace_id =~ ^-?[0-9]+$ ]] && unset 'attention[$workspace_id]'
    ;;
  focusedmonv2)
    workspace_id=${data##*,}
    [[ $workspace_id =~ ^-?[0-9]+$ ]] && unset 'attention[$workspace_id]'
    ;;
  esac
}

refresh_state() {
  local event

  read_snapshot || return 1
  for event in "$@"; do
    handle_event "$event"
  done
  reconcile_attention
  publish_style
}

refresh_state || {
  echo "Cannot read the initial Hyprland workspace state." >&2
  exit 1
}
[[ $mode != "--once" ]] || exit 0

consume_events() {
  local event next_event
  local -a events=()

  while IFS= read -r event; do
    events=("$event")
    while IFS= read -r -t 0.08 next_event; do
      events+=("$next_event")
    done
    if ! refresh_state "${events[@]}"; then
      echo "qvOS workspace state refresh failed; preserving the last style." >&2
    fi
  done
}

if [[ $mode == "--events" ]]; then
  consume_events
  exit 0
fi

runtime_dir=${XDG_RUNTIME_DIR:-}
instance=${HYPRLAND_INSTANCE_SIGNATURE:-}
[[ -n $runtime_dir && -n $instance && $instance != */* ]] || {
  echo "Cannot locate the Hyprland event socket." >&2
  exit 1
}
event_socket="$runtime_dir/hypr/$instance/.socket2.sock"
while true; do
  if [[ -S $event_socket ]]; then
    consume_events < <(socat -u "UNIX-CONNECT:$event_socket" -)
  fi
  sleep 1
done
