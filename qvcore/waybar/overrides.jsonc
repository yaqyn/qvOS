{
  "custom/omarchy": {
    "format": "󱅾",
    "on-click": "omarchy-menu",
    "tooltip-format": "qvOS Menu\n\nSuper + Space"
  },
  "custom/update": {
    "exec": "qv-update-available",
    "on-click": "qv-launch-update",
    "tooltip-format": "qvOS update available"
  },
  "network": {
    "on-click-right": "qv-launch-task dns-configure"
  },
  "custom/prayerbar": {
    "format": "{}",
    "tooltip": true,
    "interval": 60,
    "signal": 11,
    "exec": "~/.local/lib/qvos/waybar/prayerbar.sh",
    "return-type": "json"
  },
  "custom/qv-clock": {
    "format": "{}",
    "tooltip": true,
    "interval": 60,
    "signal": 12,
    "exec": "~/.local/lib/qvos/waybar/clock.sh",
    "on-click-right": "qv-launch-task timezone",
    "return-type": "json"
  },
  "group/prayer-clock": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "prayer-clock-item"
    },
    "modules": ["custom/prayerbar", "custom/qv-clock"]
  }
}
