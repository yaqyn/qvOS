#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/waybar/native-paths"
retired_manifest="$root/qvcore/waybar/retired-paths"
runtime_manifest="$root/qvcore/waybar/runtime-paths"
config="$root/qvcore/config/files/waybar/config.jsonc"

fail() {
  printf 'qvOS Waybar check: %s\n' "$1" >&2
  exit 1
}

[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest") == \
  $'bin/omarchy-refresh-waybar\nbin/omarchy-toggle-waybar' ]] || fail "native Waybar inventory"
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$runtime_manifest") == \
  $'clock.sh\nprayer-data.sh\nprayerbar.sh' ]] || fail "Waybar runtime inventory"
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == \
  'default/waybar/' ]] || fail "retired Waybar inventory"
[[ ! -e $root/default/waybar && ! -L $root/default/waybar ]] ||
  fail "inherited Waybar source remains"
[[ ! -e $root/qvcore/waybar/overrides.jsonc &&
  ! -L $root/qvcore/waybar/overrides.jsonc ]] ||
  fail "redundant Waybar overlay remains"

for owner in check idle-status install notification-status refresh; do
  [[ -x $root/qvcore/waybar/$owner && ! -L $root/qvcore/waybar/$owner ]] ||
    fail "native Waybar owner: $owner"
done
for runtime_path in clock.sh prayer-data.sh prayerbar.sh; do
  [[ -f $root/qvcore/waybar/$runtime_path && ! -L $root/qvcore/waybar/$runtime_path ]] ||
    fail "Waybar runtime source: $runtime_path"
done

native="$root/bin/qv-refresh-waybar"
compatibility="$root/bin/omarchy-refresh-waybar"
[[ -x $native && -x $compatibility ]] || fail "Waybar adapter modes"
rg -q '^# qv:summary=' "$native" || fail "native Waybar metadata"
! rg -q '^# (qv|omarchy):' "$compatibility" ||
  fail "compatibility Waybar metadata"
for adapter in "$native" "$compatibility"; do
  # shellcheck disable=SC2016
  grep -Fqx 'exec "$QVOS_PATH/qvcore/waybar/refresh" "$@"' "$adapter" ||
    fail "Waybar adapter bypasses native owner"
done

toggle_native="$root/bin/qv-toggle-waybar"
toggle_compatibility="$root/bin/omarchy-toggle-waybar"
[[ -x $root/qvcore/waybar/toggle && -x $toggle_native &&
  -x $toggle_compatibility ]] || fail "Waybar toggle owner and adapter modes"
rg -q '^# qv:summary=' "$toggle_native" || fail "native Waybar toggle metadata"
! rg -q '^# (qv|omarchy):' "$toggle_compatibility" ||
  fail "compatibility Waybar toggle metadata"
for adapter in "$toggle_native" "$toggle_compatibility"; do
  # shellcheck disable=SC2016
  grep -Fqx 'exec "$QVOS_PATH/qvcore/waybar/toggle" "$@"' "$adapter" ||
    fail "Waybar toggle adapter bypasses native owner"
done

task_native="$root/bin/qv-launch-task"
task_compatibility="$root/bin/omarchy-launch-task"
[[ -x $task_native && -x $task_compatibility ]] || fail "task launcher modes"
rg -q '^# qv:summary=' "$task_native" ||
  fail "native task launcher metadata"
! rg -q '^# (qv|omarchy):' "$task_compatibility" ||
  fail "compatibility task launcher metadata"
# shellcheck disable=SC2016
for adapter in "$task_native" "$task_compatibility"; do
  grep -Fqx 'exec "$QVOS_PATH/qvcore/tui/task/launch" "$@"' "$adapter" ||
    fail "task launcher owner"
done

for obsolete in \
  bin/omarchy-launch-qvos-task \
  bin/omarchy-qvos-refresh-waybar; do
  [[ ! -e $root/$obsolete && ! -L $root/$obsolete ]] ||
    fail "obsolete qvOS-in-Omarchy route: $obsolete"
done
if rg -n 'omarchy-(launch-qvos-task|qvos-refresh-waybar)' \
  "$root/qvcore" "$root/qvcore/config/files" \
  --glob '!**/AGENTS.md' --glob '!**/check' --glob '!**/owner-contracts.psv'; then
  fail "native qvOS source calls a retired Waybar or task route"
fi
if rg -n 'omarchy-toggle-waybar' "$root/qvcore" "$root/qvcore/config/files" \
  --glob '!**/AGENTS.md' --glob '!**/check' \
  --glob '!**/native-paths' --glob '!**/owner-contracts.psv'; then
  fail "native qvOS source calls the Waybar-toggle compatibility route"
fi

jq -e '
  (."modules-left" + ."modules-center" + ."modules-right"
    | index("custom/omarchy") == null) and
  (."modules-left" + ."modules-center" + ."modules-right"
    | index("custom/qvos") != null) and
  (."modules-left" + ."modules-center" + ."modules-right"
    | index("group/prayer-clock") != null) and
  ."custom/qvos".format == "󱅾" and
  ."custom/qvos"."on-click" == "qv-menu" and
  ."network"."on-click-right" == "qv-launch-task dns-configure" and
  ."custom/qv-clock"."on-click-right" == "qv-launch-task timezone" and
  ."custom/weather".exec == "$QVOS_PATH/qvcore/weather/waybar" and
  ."custom/idle-indicator".exec == "$QVOS_PATH/qvcore/waybar/idle-status" and
  ."custom/notification-silencing-indicator".exec
    == "$QVOS_PATH/qvcore/waybar/notification-status" and
  ."custom/voxtype".exec == "qv-voxtype-status" and
  ."custom/voxtype"."on-click-right" == "qv-voxtype-config" and
  ."custom/voxtype"."on-click" == "qv-voxtype-model"
' "$config" >/dev/null || fail "complete native Waybar configuration"
if rg -n 'default/waybar|custom/omarchy|omarchy-(menu|voxtype)' "$config"; then
  fail "native Waybar configuration retains inherited ownership"
fi
grep -Fqx 'qv-refresh-waybar' "$root/qvcore/waybar/post-update-hook" ||
  fail "Waybar post-update route"

printf 'ok - qvOS owns one complete Waybar configuration and minimal runtime\n'
