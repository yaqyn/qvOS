#!/bin/bash
set -euo pipefail

# qvos:contract=qvcore/waybar/workspace-state
runtime_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
tracker="$runtime_root/workspace-state"
tracker_pid=""
waybar_pid=""

cleanup() {
  local pid

  trap - EXIT HUP INT TERM
  for pid in "$tracker_pid" "$waybar_pid"; do
    [[ -n $pid ]] || continue
    kill "$pid" 2>/dev/null || true
  done
  for pid in "$tracker_pid" "$waybar_pid"; do
    [[ -n $pid ]] || continue
    wait "$pid" 2>/dev/null || true
  done
}
trap cleanup EXIT HUP INT TERM

[[ -x $tracker && ! -L $tracker ]] || {
  echo "Cannot start qvOS Waybar: the workspace-state owner is unavailable." >&2
  exit 1
}
command -v waybar >/dev/null || {
  echo "Cannot start qvOS Waybar: waybar is unavailable." >&2
  exit 1
}

"$tracker" --once
"$tracker" --watch &
tracker_pid=$!
waybar &
waybar_pid=$!

set +e
wait -n "$tracker_pid" "$waybar_pid"
status=$?
set -e
cleanup
exit "$status"
