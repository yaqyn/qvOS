#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
catalog="$QVOS_PATH/qvcore/menu/software-installers.psv"
slug=${1:-}
declare -A package_inventory=()

usage() {
  echo "Usage: qvcore/menu/software-installer-state <software-slug>" >&2
}

installer_record() {
  awk -F '|' -v wanted="$slug" '
    $1 !~ /^#/ && NF == 11 && $1 == wanted {
      print
      found = 1
      exit
    }
    END { exit !found }
  ' "$catalog"
}

load_package_inventory() {
  local package

  while IFS= read -r package; do
    [[ -n $package ]] && package_inventory["$package"]=1
  done < <(pacman -Qq 2>/dev/null || true)
}

probe_ready() {
  local kind=$1
  local value=$2
  local package
  local path
  local line
  local prefix
  local found
  local -a packages=()
  local -a parts=()
  local -a required_lines=()
  local -a required_prefixes=()

  case $kind in
  file)
    [[ -e $HOME/$value ]]
    ;;
  file-lines)
    read -r -a parts <<<"$value"
    path=${parts[0]:-}
    required_lines=("${parts[@]:1}")
    [[ -n $path && ${#required_lines[@]} -gt 0 && -f $HOME/$path ]] || return 1
    for line in "${required_lines[@]}"; do
      grep -qxF -- "$line" "$HOME/$path" || return 1
    done
    ;;
  file-prefixes)
    read -r -a parts <<<"$value"
    path=${parts[0]:-}
    required_prefixes=("${parts[@]:1}")
    [[ -n $path && ${#required_prefixes[@]} -gt 0 && -f $HOME/$path ]] || return 1
    for prefix in "${required_prefixes[@]}"; do
      found=false
      while IFS= read -r line; do
        if [[ $line == "$prefix"?* ]]; then
          found=true
          break
        fi
      done <"$HOME/$path"
      [[ $found == "true" ]] || return 1
    done
    ;;
  package)
    load_package_inventory
    [[ -n ${package_inventory[$value]:-} ]]
    ;;
  package-any)
    load_package_inventory
    read -r -a packages <<<"$value"
    for package in "${packages[@]}"; do
      [[ -z ${package_inventory[$package]:-} ]] || return 0
    done
    return 1
    ;;
  *)
    echo "Unsupported qvOS TUI installer probe: $kind" >&2
    return 2
    ;;
  esac
}

[[ -n $slug && $# == 1 ]] || {
  usage
  exit 2
}
[[ -f $catalog ]] || {
  echo "Missing software installer catalog: $catalog" >&2
  exit 1
}

record=$(installer_record) || {
  echo "Unknown software installer: $slug" >&2
  exit 2
}
IFS='|' read -r \
  _ \
  _ \
  _ \
  _ \
  _ \
  presentation \
  _ \
  probe_kind \
  probe_value \
  _ \
  _ <<<"$record"

[[ $presentation == "tui" ]] || {
  echo "The $slug installer does not use captured qvOS TUI output." >&2
  exit 2
}
if probe_ready "$probe_kind" "$probe_value"; then
  printf 'installed\n'
  exit
fi

echo "The $slug installation owner finished without an installed result." >&2
exit 1
