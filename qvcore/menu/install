#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
menu_source_dir="$QVOS_PATH/qvcore/menu"
base_source="$menu_source_dir/base"
routes_source="$menu_source_dir/routes"
menu_owner="$menu_source_dir/menu"
personal_extension_source="$QVOS_PATH/qvcore/config/files/qvos/extensions/menu.sh"
extension_dir="$HOME/.config/qvos/extensions"
target_path="$extension_dir/menu.sh"
legacy_extension_dir="$HOME/.config/omarchy/extensions"
legacy_target_path="$legacy_extension_dir/menu.sh"
legacy_qvos_target_path="$legacy_extension_dir/qvos-menu.sh"
# Exact generated overlay installed before the native menu promotion.
legacy_qvos_target_hash="bbe35b8874f031d6118492ac08f0f19814aa272a4c6c72364a477e1062b95405"
# Exact stock menu-extension files that contain no user customization.
legacy_stock_extension_hashes=(
  0017edb84ff30cc838582ae19843dff7523f867b05f80645f89c9fa4ec29b7c2
  36e836660032d7fd66777a58a2cc719a8dca7424b6ecf279b4d7e9443544e513
  ddc57399d297c1561a263990ccc24f04e45591a51285bbc4924d9e5be26d4a42
  7ac9d68ef8179f483a0ae2b3127c7f03929a377c59f458d1ef243e39131ae054
  55c5d4f3127471959ef8cd4813d4edf54052d8c63b45eb056625f63d9baa5048
  9b0bbaa8ebe0d54349d1af977cea73cfbd926c8a6c0a366bc8cf8ff576518685
  fcf552727705655f75dee6b79ac9dd34c38da55cecf3fd476337d77bf93cdf31
)
provider_source_dir="$menu_source_dir/elephant"
menu_runtime_dir="$HOME/.local/lib/qvos/menu"
provider_runtime_dir="$menu_runtime_dir/elephant"
provider_menu_dir="$HOME/.config/elephant/menus"
concept_source="$menu_source_dir/concepts.psv"
concept_runtime="$menu_runtime_dir/concepts.psv"
software_actions_source="$menu_source_dir/software-actions.psv"
software_install_source="$menu_source_dir/software-install"
software_installer_state_source="$menu_source_dir/software-installer-state"
software_installers_source="$menu_source_dir/software-installers.psv"
software_installers_runtime="$menu_runtime_dir/software-installers.psv"
software_state_source="$menu_source_dir/software-state"
font_install_source="$menu_source_dir/font-install"
font_install_runtime="$menu_runtime_dir/font-install"
terminal_action_source="$menu_source_dir/terminal-action"
terminal_action_runtime="$menu_runtime_dir/terminal-action"
retired_steam_remove_runtime="$menu_runtime_dir/steam-remove"
retired_steam_remove_hash="4435fcd69490cc49fe4079391157fe2d7347b20c9b3357d7e1ab512df091a407"
retired_entities_runtime="$menu_runtime_dir/entities.psv"
retired_entities_hash="80bee250c5d8334cc89c9a026d60684de014daeeadc35f7610565ae7c80a2c80"
task_catalog_source="$QVOS_PATH/qvcore/tui/task/actions.psv"
task_launch_source="$QVOS_PATH/qvcore/tui/task/launch"
task_run_source="$QVOS_PATH/qvcore/tui/task/run"
task_selectable_owner="$QVOS_PATH/qvcore/tui/task/selectable-owner"
task_selection_source="$QVOS_PATH/qvcore/tui/task/selections.psv"
success_guidance_source="$QVOS_PATH/qvcore/tui/success-guidance.psv"
search_intents_source="$menu_source_dir/search-intents.psv"
search_intents_runtime="$menu_runtime_dir/search-intents.psv"
elephant_ready_source="$menu_source_dir/wait-for-elephant"
elephant_ready_runtime="$menu_runtime_dir/wait-for-elephant"
walker_ready_source="$menu_source_dir/walker-elephant-ready.conf"
walker_ready_target="$HOME/.config/systemd/user/app-walker@autostart.service.d/qvos-elephant-ready.conf"
provider_set_source="$menu_source_dir/walker-provider-set.toml"
provider_set_start="# qvOS menu provider set start"
provider_set_end="# qvOS menu provider set end"
provider_set_header="[providers.sets.qvos-menu]"
legacy_provider_set_start="# qvOS Omarchy menu provider set start"
legacy_provider_set_end="# qvOS Omarchy menu provider set end"
legacy_provider_set_header="[providers.sets.qvos-omarchy-menu]"
walker_config="$HOME/.config/walker/config.toml"
walker_config_source="$QVOS_PATH/qvcore/config/files/walker/config.toml"
walker_autostart_source="$QVOS_PATH/qvcore/config/files/autostart/walker.desktop"
walker_restart_source="$QVOS_PATH/qvcore/config/files/systemd/user/app-walker@autostart.service.d/restart.conf"
elephant_calc_source="$QVOS_PATH/qvcore/config/files/elephant/calc.toml"
elephant_desktop_source="$QVOS_PATH/qvcore/config/files/elephant/desktopapplications.toml"
walker_theme_name="qvos-menu"
legacy_walker_theme_name="qvos-omarchy-menu"
walker_theme_source="$menu_source_dir/walker-theme"
walker_theme_target="$HOME/.config/walker/themes/qvos-menu"
legacy_walker_theme_target="$HOME/.config/walker/themes/qvos-omarchy-menu"
walker_subtext_source="$menu_source_dir/walker-subtext.css"
providers=(
  qvos_background_selector.lua
  qvos_themes.lua
  qvos_unlocks.lua
  qvos_menu.lua
)
retired_providers=(
  omarchy_background_selector.lua
  omarchy_themes.lua
  omarchy_unlocks.lua
  qvos_omarchy_menu.lua
)
# shellcheck disable=SC2016
legacy_source_line='[[ -f $HOME/.config/omarchy/extensions/qvos-menu.sh ]] && source "$HOME/.config/omarchy/extensions/qvos-menu.sh"'
walker_config_backed_up=false
mode=${1:---install}

require_sources() {
  local required_sources=(
    "$base_source"
    "$routes_source"
    "$menu_owner"
    "$personal_extension_source"
    "$concept_source"
    "$software_actions_source"
    "$software_install_source"
    "$software_installer_state_source"
    "$software_installers_source"
    "$software_state_source"
    "$font_install_source"
    "$terminal_action_source"
    "$task_catalog_source"
    "$task_launch_source"
    "$task_run_source"
    "$task_selectable_owner"
    "$task_selection_source"
    "$success_guidance_source"
    "$search_intents_source"
    "$elephant_ready_source"
    "$walker_ready_source"
    "$provider_set_source"
    "$walker_subtext_source"
    "$walker_config_source"
    "$walker_autostart_source"
    "$walker_restart_source"
    "$elephant_calc_source"
    "$elephant_desktop_source"
    "$walker_theme_source/layout.xml"
    "$walker_theme_source/style.css"
  )
  local provider
  local required_source

  for provider in "${providers[@]}"; do
    required_sources+=("$provider_source_dir/$provider")
  done
  for required_source in "${required_sources[@]}"; do
    if [[ ! -f $required_source ]]; then
      echo "Missing qvOS menu source: $required_source" >&2
      return 1
    fi
  done

  if [[ $(head -n 1 "$walker_theme_source/style.css") != \
    '@import "../../../qvos/current/theme/walker.css";' ]]; then
    echo "The qvOS Walker theme import is invalid." >&2
    return 1
  fi
  [[ -x $software_state_source ]] || {
    echo "qvOS software state owner is not executable: $software_state_source" >&2
    return 1
  }
  [[ -x $software_install_source ]] || {
    echo "qvOS software installer owner is not executable: $software_install_source" >&2
    return 1
  }
  [[ -x $software_installer_state_source ]] || {
    echo "qvOS software installer state owner is not executable: $software_installer_state_source" >&2
    return 1
  }
  [[ -x $font_install_source ]] || {
    echo "qvOS font lifecycle owner is not executable: $font_install_source" >&2
    return 1
  }
  [[ -x $terminal_action_source ]] || {
    echo "qvOS terminal lifecycle owner is not executable: $terminal_action_source" >&2
    return 1
  }
  [[ -x $task_launch_source && -x $task_run_source && -x $task_selectable_owner ]] || {
    echo "qvOS TUI task adapters are not executable." >&2
    return 1
  }

}

validate_user_directory() {
  local directory=$1
  local label=$2

  [[ -e $directory || -L $directory ]] || return 0
  [[ -d $directory && ! -L $directory && -O $directory ]] || {
    echo "Refusing unsafe $label directory: $directory" >&2
    return 1
  }
}

validate_menu_paths() {
  local directory

  for directory in \
    "$HOME/.config" \
    "$HOME/.config/qvos" \
    "$extension_dir" \
    "$HOME/.config/omarchy" \
    "$legacy_extension_dir" \
    "$HOME/.config/elephant" \
    "$provider_menu_dir" \
    "$HOME/.config/walker" \
    "$HOME/.config/walker/themes" \
    "$walker_theme_target" \
    "$legacy_walker_theme_target" \
    "$HOME/.local" \
    "$HOME/.local/lib" \
    "$HOME/.local/lib/qvos" \
    "$menu_runtime_dir" \
    "$provider_runtime_dir" \
    "$HOME/.local/state" \
    "$HOME/.local/state/qvos" \
    "$HOME/.local/state/qvos/menu-backups"; do
    validate_user_directory "$directory" "qvOS menu" || return
  done

  if [[ -e $walker_config || -L $walker_config ]]; then
    [[ -f $walker_config && ! -L $walker_config && -O $walker_config ]] || {
      echo "Refusing unsafe Walker configuration: $walker_config" >&2
      return 1
    }
  fi
}

extension_is_stock() {
  local candidate=$1
  local expected_hash
  local installed_hash

  [[ -f $candidate && ! -L $candidate && -O $candidate ]] || return 1
  read -r installed_hash _ < <(sha256sum -- "$candidate")
  for expected_hash in "${legacy_stock_extension_hashes[@]}"; do
    [[ $installed_hash != "$expected_hash" ]] || return 0
  done
  return 1
}

validate_personal_extension() {
  local label=$1
  local path=$2

  [[ ! -e $path && ! -L $path ]] && return
  [[ -f $path && ! -L $path && -O $path ]] || {
    echo "Refusing an unsafe $label: $path" >&2
    return 1
  }
}

validate_personal_extension_migration() {
  validate_personal_extension "personal qvOS menu extension" "$target_path"
  validate_personal_extension "inherited personal menu extension" \
    "$legacy_target_path"

  [[ -f $legacy_target_path && -f $target_path ]] || return 0
  extension_is_stock "$legacy_target_path" && return 0
  cmp -s "$legacy_target_path" "$target_path" && return 0
  cmp -s "$personal_extension_source" "$target_path" && return 0

  echo "Both qvOS and inherited personal menu extensions contain custom content; preserve them and reconcile manually." >&2
  return 1
}

validate_generated_overlay_cleanup() {
  local installed_hash

  validate_personal_extension_migration

  [[ ! -e $legacy_qvos_target_path && ! -L $legacy_qvos_target_path ]] && return
  [[ -f $legacy_qvos_target_path && ! -L $legacy_qvos_target_path &&
    -O $legacy_qvos_target_path ]] || {
    echo "Refusing an unsafe retired qvOS menu overlay: $legacy_qvos_target_path" >&2
    return 1
  }

  read -r installed_hash _ < <(sha256sum -- "$legacy_qvos_target_path")
  if [[ $installed_hash != "$legacy_qvos_target_hash" ]]; then
    echo "Preserving a modified retired qvOS menu overlay: $legacy_qvos_target_path" >&2
  fi
}

migrate_personal_extension() {
  if [[ -f $legacy_target_path ]]; then
    if extension_is_stock "$legacy_target_path" ||
      { [[ -f $target_path ]] && cmp -s "$legacy_target_path" "$target_path"; }; then
      unlink -- "$legacy_target_path"
    elif [[ ! -e $target_path && ! -L $target_path ]]; then
      mv -T -- "$legacy_target_path" "$target_path"
    elif cmp -s "$personal_extension_source" "$target_path"; then
      mv -fT -- "$legacy_target_path" "$target_path"
    else
      echo "Could not safely migrate the inherited personal menu extension." >&2
      return 1
    fi
  fi

  if [[ ! -e $target_path && ! -L $target_path ]]; then
    install -m 0644 -- "$personal_extension_source" "$target_path"
  fi
}

retire_generated_menu_overlay() {
  local backup_path
  local installed_hash
  local temporary_path

  validate_generated_overlay_cleanup

  if [[ -f $target_path ]] && grep -Fqx "$legacy_source_line" "$target_path"; then
    backup_path=$(mktemp "$target_path.qvos-backup.XXXXXX")
    cp -a -- "$target_path" "$backup_path"
    temporary_path=$(mktemp "$extension_dir/.qvos-menu-extension.XXXXXX")
    if ! awk -v retired="$legacy_source_line" '$0 != retired { print }' \
      "$target_path" >"$temporary_path"; then
      rm -f -- "$temporary_path"
      echo "Could not retire the generated qvOS menu source line." >&2
      return 1
    fi
    chmod --reference="$target_path" "$temporary_path"
    mv -f -- "$temporary_path" "$target_path"
  fi

  if [[ -f $legacy_qvos_target_path ]]; then
    read -r installed_hash _ < <(sha256sum -- "$legacy_qvos_target_path")
    if [[ $installed_hash == "$legacy_qvos_target_hash" ]]; then
      unlink -- "$legacy_qvos_target_path"
    fi
  fi

  rmdir -- "$legacy_extension_dir" 2>/dev/null || true
}

retired_provider_target_allowed() {
  local provider=$1
  local target=$2

  case $provider in
  omarchy_background_selector.lua | omarchy_themes.lua)
    [[ $target == "$QVOS_PATH/default/elephant/$provider" ||
      $target == "$HOME/.local/share/omarchy/default/elephant/$provider" ]]
    ;;
  omarchy_unlocks.lua | qvos_omarchy_menu.lua)
    [[ $target == "$provider_runtime_dir/$provider" ]]
    ;;
  *) return 1 ;;
  esac
}

validate_retired_provider_links() {
  local provider
  local provider_link
  local target

  for provider in "${retired_providers[@]}"; do
    provider_link="$provider_menu_dir/$provider"
    [[ -e $provider_link || -L $provider_link ]] || continue
    [[ -L $provider_link ]] || {
      echo "Refusing a foreign retired menu provider: $provider_link" >&2
      return 1
    }
    target=$(readlink -- "$provider_link")
    retired_provider_target_allowed "$provider" "$target" || {
      echo "Refusing a foreign retired menu provider link: $provider_link" >&2
      return 1
    }
  done
}

validate_native_provider_links() {
  local provider
  local provider_link

  for provider in "${providers[@]}"; do
    provider_link="$provider_menu_dir/$provider"
    [[ -e $provider_link || -L $provider_link ]] || continue
    [[ -L $provider_link &&
      $(readlink -- "$provider_link") == "$provider_runtime_dir/$provider" ]] || {
      echo "Refusing a foreign qvOS menu provider: $provider_link" >&2
      return 1
    }
  done
}

install_menu_providers() {
  local provider
  local provider_link
  local runtime_provider

  validate_menu_paths
  validate_retired_provider_links
  validate_native_provider_links
  rm -rf -- "$provider_runtime_dir"
  install -d "$provider_runtime_dir" "$provider_menu_dir"

  for provider in "${providers[@]}"; do
    runtime_provider="$provider_runtime_dir/$provider"
    install -m 0644 "$provider_source_dir/$provider" "$runtime_provider"
    ln -sfn "$runtime_provider" "$provider_menu_dir/$provider"
  done
  for provider in "${retired_providers[@]}"; do
    provider_link="$provider_menu_dir/$provider"
    [[ ! -L $provider_link ]] || unlink -- "$provider_link"
  done
}

install_menu_runtime() {
  local manager_home

  install -D -m 0755 "$font_install_source" "$font_install_runtime"
  install -D -m 0755 "$terminal_action_source" "$terminal_action_runtime"
  retire_menu_runtime
  install -D -m 0644 "$concept_source" "$concept_runtime"
  install -D -m 0644 "$software_installers_source" "$software_installers_runtime"
  install -D -m 0644 "$search_intents_source" "$search_intents_runtime"
  install -D -m 0755 "$elephant_ready_source" "$elephant_ready_runtime"
  install -D -m 0644 "$walker_ready_source" "$walker_ready_target"

  if manager_home=$(
    systemctl --user show-environment 2>/dev/null |
      sed -n 's/^HOME=//p' |
      head -n 1
  ) && [[ $manager_home == "$HOME" ]]; then
    systemctl --user daemon-reload
  fi
}

retire_menu_runtime_file() {
  local target=$1
  local expected_hash=$2
  local label=$3
  local installed_hash

  [[ ! -e $target && ! -L $target ]] && return
  if [[ ! -f $target || -L $target || ! -O $target ]]; then
    echo "Refusing an unsafe retired $label runtime owner: $target" >&2
    return 1
  fi
  read -r installed_hash _ < <(sha256sum -- "$target")
  [[ $installed_hash == "$expected_hash" ]] || {
    echo "Refusing a modified retired $label runtime owner: $target" >&2
    return 1
  }
  unlink -- "$target"
}

retire_menu_runtime() {
  retire_menu_runtime_file \
    "$retired_steam_remove_runtime" \
    "$retired_steam_remove_hash" \
    "Steam"
  retire_menu_runtime_file \
    "$retired_entities_runtime" \
    "$retired_entities_hash" \
    "menu catalog"
}

ensure_walker_config() {
  if [[ ! -f $walker_config ]]; then
    install -D -m 0644 "$walker_config_source" "$walker_config"
  fi
}

backup_walker_config() {
  local backup_path

  [[ $walker_config_backed_up == "false" ]] || return 0
  if cmp -s "$walker_config_source" "$walker_config"; then
    walker_config_backed_up=true
    return 0
  fi

  backup_path="$walker_config.bak.$(date +%s).$$"
  cp -a "$walker_config" "$backup_path"
  walker_config_backed_up=true
}

provider_set_block() {
  awk \
    -v start="$provider_set_start" \
    -v finish="$provider_set_end" '
      $0 == start { copying = 1 }
      copying { print }
      $0 == finish && copying { exit }
    ' "$walker_config"
}

install_provider_set() {
  local temporary_path

  if cmp -s <(provider_set_block) "$provider_set_source"; then
    return
  fi

  if awk \
    -v start="$provider_set_start" \
    -v finish="$provider_set_end" \
    -v legacy_start="$legacy_provider_set_start" \
    -v legacy_finish="$legacy_provider_set_end" \
    -v header="$provider_set_header" \
    -v legacy_header="$legacy_provider_set_header" '
      $0 == start || $0 == legacy_start { managed = 1; next }
      ($0 == finish || $0 == legacy_finish) && managed { managed = 0; next }
      !managed && ($0 == header || $0 == legacy_header) { found = 1 }
      END { exit found ? 0 : 1 }
    ' "$walker_config"; then
    echo "Walker provider set already exists outside the qvOS-managed block: $provider_set_header" >&2
    return 1
  fi

  backup_walker_config

  temporary_path=$(mktemp "$walker_config.tmp.XXXXXX")
  if ! awk \
    -v start="$provider_set_start" \
    -v finish="$provider_set_end" \
    -v legacy_start="$legacy_provider_set_start" \
    -v legacy_finish="$legacy_provider_set_end" '
      $0 == start {
        if (skipping) exit 3
        skipping = 1
        expected = finish
        next
      }
      $0 == legacy_start {
        if (skipping) exit 3
        skipping = 1
        expected = legacy_finish
        next
      }
      skipping && $0 == expected { skipping = 0; next }
      !skipping { print }
      END { if (skipping) exit 2 }
    ' "$walker_config" >"$temporary_path"; then
    rm -f -- "$temporary_path"
    echo "Walker config contains an incomplete qvOS menu provider block." >&2
    return 1
  fi

  {
    printf '\n'
    cat "$provider_set_source"
  } >>"$temporary_path"
  chmod --reference="$walker_config" "$temporary_path"
  mv "$temporary_path" "$walker_config"
}

walker_config_theme() {
  sed -n 's/^theme = "\([^"]*\)".*/\1/p' "$walker_config" | head -n 1
}

reconcile_walker_defaults() {
  local temporary_path

  temporary_path=$(mktemp "$walker_config.tmp.XXXXXX")
  awk \
    -v legacy="theme = \"$legacy_walker_theme_name\"" \
    -v upstream='theme = "omarchy-default"' \
    -v new="theme = \"$walker_theme_name\"" '
      index($0, legacy) == 1 { sub(legacy, new) }
      index($0, upstream) == 1 { sub(upstream, new) }
      $0 == "command = \"omarchy-restart-walker\"" {
        $0 = "command = \"qv-restart-walker\""
      }
      $0 == "additional_theme_location = \"~/.local/share/omarchy/default/walker/themes/\"" { next }
      $0 == "additional_theme_location = \"~/.local/share/qvos/default/walker/themes/\"" { next }
      { print }
    ' "$walker_config" >"$temporary_path"

  if cmp -s "$walker_config" "$temporary_path"; then
    unlink -- "$temporary_path"
    return
  fi

  backup_walker_config
  chmod --reference="$walker_config" "$temporary_path"
  mv "$temporary_path" "$walker_config"
}

generated_theme_style() {
  cat "$walker_theme_source/style.css"
  printf '\n\n/* qvOS menu breadcrumbs */\n'
  cat "$walker_subtext_source"
}

install_menu_theme() {
  local backup_root="$HOME/.local/state/qvos/menu-backups"
  local previous_theme=""
  local temporary_theme

  validate_menu_paths
  install -d "$(dirname -- "$walker_theme_target")"
  temporary_theme=$(mktemp -d "$(dirname -- "$walker_theme_target")/.qvos-menu.XXXXXX")
  cp -a "$walker_theme_source/." "$temporary_theme/"
  generated_theme_style >"$temporary_theme/style.css"
  chmod --reference="$walker_theme_source/style.css" "$temporary_theme/style.css"

  if menu_theme_matches "$walker_theme_target"; then
    rm -rf -- "$temporary_theme"
    return
  fi
  if [[ -d $walker_theme_target ]]; then
    install -d -m 0700 "$backup_root"
    previous_theme=$(mktemp -d "$backup_root/qvos-menu.XXXXXX")
    if ! cp -a "$walker_theme_target/." "$previous_theme/"; then
      rm -rf -- "$temporary_theme" "$previous_theme"
      return 1
    fi
    chmod 0700 "$previous_theme"
    printf 'Backed up the previous qvOS Walker theme: %s\n' "$previous_theme"
  fi
  rm -rf -- "$walker_theme_target"
  if ! mv "$temporary_theme" "$walker_theme_target"; then
    rm -rf -- "$temporary_theme"
    if [[ -n $previous_theme && -d $previous_theme ]]; then
      mv "$previous_theme" "$walker_theme_target" || true
    fi
    return 1
  fi
}

cleanup_legacy_menu_theme() {
  validate_menu_paths
  [[ $(walker_config_theme) != "$legacy_walker_theme_name" ]] || {
    echo "Refusing to remove the active legacy qvOS menu theme." >&2
    return 1
  }
  [[ -e $legacy_walker_theme_target || -L $legacy_walker_theme_target ]] ||
    return 0
  if menu_theme_matches "$legacy_walker_theme_target"; then
    rm -rf -- "$legacy_walker_theme_target"
  else
    echo "Preserving a modified retired qvOS Walker theme: $legacy_walker_theme_target" >&2
  fi
}

reload_active_menu_services() {
  local manager_home
  local service

  manager_home=$(
    systemctl --user show-environment 2>/dev/null |
      sed -n 's/^HOME=//p' |
      head -n 1
  ) || return 0
  [[ $manager_home == "$HOME" ]] || return 0

  for service in elephant.service app-walker@autostart.service; do
    if systemctl --user is-active --quiet "$service"; then
      systemctl --user restart "$service"
    fi
  done
}

personal_extension_native() {
  local installed_hash

  [[ -f $target_path && ! -L $target_path && -O $target_path ]] || return 1
  ! grep -Fqx "$legacy_source_line" "$target_path" || return 1
  [[ ! -e $legacy_target_path && ! -L $legacy_target_path ]] || return 1

  [[ ! -e $legacy_qvos_target_path && ! -L $legacy_qvos_target_path ]] && return
  [[ -f $legacy_qvos_target_path && ! -L $legacy_qvos_target_path &&
    -O $legacy_qvos_target_path ]] || return 1
  read -r installed_hash _ < <(sha256sum -- "$legacy_qvos_target_path")
  [[ $installed_hash != "$legacy_qvos_target_hash" ]]
}

menu_providers_ready() {
  local provider
  local runtime_provider

  for provider in "${providers[@]}"; do
    runtime_provider="$provider_runtime_dir/$provider"
    if [[ ! -f $runtime_provider || -L $runtime_provider ]] ||
      ! cmp -s "$provider_source_dir/$provider" "$runtime_provider" ||
      [[ ! -L $provider_menu_dir/$provider ]] ||
      [[ $(readlink "$provider_menu_dir/$provider") != "$runtime_provider" ]]; then
      return 1
    fi
  done
  for provider in "${retired_providers[@]}"; do
    [[ ! -e $provider_menu_dir/$provider &&
      ! -L $provider_menu_dir/$provider ]] || return 1
  done
}

walker_config_native() {
  [[ $(walker_config_theme) != "omarchy-default" &&
    $(walker_config_theme) != "$legacy_walker_theme_name" ]] &&
    ! grep -Fqx 'command = "omarchy-restart-walker"' "$walker_config" &&
    ! grep -Fqx 'additional_theme_location = "~/.local/share/omarchy/default/walker/themes/"' "$walker_config" &&
    ! grep -Fqx 'additional_theme_location = "~/.local/share/qvos/default/walker/themes/"' "$walker_config"
}

menu_runtime_ready() {
  cmp -s "$font_install_source" "$font_install_runtime" &&
    [[ -x $font_install_runtime ]] &&
    cmp -s "$terminal_action_source" "$terminal_action_runtime" &&
    [[ -x $terminal_action_runtime ]] &&
    [[ ! -e $retired_steam_remove_runtime && ! -L $retired_steam_remove_runtime ]] &&
    [[ ! -e $retired_entities_runtime && ! -L $retired_entities_runtime ]] &&
    cmp -s "$concept_source" "$concept_runtime" &&
    cmp -s "$software_installers_source" "$software_installers_runtime" &&
    cmp -s "$search_intents_source" "$search_intents_runtime" &&
    cmp -s "$elephant_ready_source" "$elephant_ready_runtime" &&
    [[ -x $elephant_ready_runtime ]] &&
    cmp -s "$walker_ready_source" "$walker_ready_target"
}

menu_theme_matches() {
  local target=$1
  local source_inventory
  local target_inventory
  local source_file
  local relative_path

  [[ -d $target && ! -L $target ]] || return 1

  source_inventory=$(
    find "$walker_theme_source" -mindepth 1 -printf '%y\t%m\t%P\t%l\n' | sort
  )
  target_inventory=$(
    find "$target" -mindepth 1 -printf '%y\t%m\t%P\t%l\n' | sort
  )
  [[ $source_inventory == "$target_inventory" ]] || return 1

  while IFS= read -r -d '' source_file; do
    relative_path=${source_file#"$walker_theme_source/"}
    [[ $relative_path == "style.css" ]] && continue
    cmp -s "$source_file" "$target/$relative_path" || return 1
  done < <(find "$walker_theme_source" -type f -print0)

  cmp -s <(generated_theme_style) "$target/style.css"
}

menu_theme_ready() {
  menu_theme_matches "$walker_theme_target" || return 1
  if [[ -e $legacy_walker_theme_target || -L $legacy_walker_theme_target ]] &&
    menu_theme_matches "$legacy_walker_theme_target"; then
    return 1
  fi
  return 0
}

case $mode in
--preflight)
  require_sources
  validate_generated_overlay_cleanup
  validate_menu_paths
  validate_retired_provider_links
  validate_native_provider_links
  ;;
--status)
  require_sources >/dev/null 2>&1 &&
    [[ -f $walker_config ]] &&
    personal_extension_native &&
    menu_providers_ready &&
    menu_runtime_ready &&
    cmp -s <(provider_set_block) "$provider_set_source" &&
    walker_config_native &&
    menu_theme_ready
  ;;
--install)
  require_sources
  validate_generated_overlay_cleanup
  validate_menu_paths
  validate_retired_provider_links
  validate_native_provider_links
  install -d "$extension_dir"
  migrate_personal_extension
  retire_generated_menu_overlay
  ensure_walker_config
  install_menu_runtime
  install_menu_providers
  install_provider_set
  install_menu_theme
  reconcile_walker_defaults
  cleanup_legacy_menu_theme
  reload_active_menu_services
  ;;
*)
  echo "Usage: install [--preflight|--status|--install]" >&2
  exit 2
  ;;
esac
