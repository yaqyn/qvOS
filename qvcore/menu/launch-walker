#!/bin/bash
set -euo pipefail

# qvos:contract=bin/qv-launch-app

if ! pgrep -u "$UID" -x elephant >/dev/null; then
  setsid qv-launch-app -- elephant >/dev/null 2>&1 &
fi

if ! pgrep -u "$UID" -f '(^|/)walker( |$).*--gapplication-service' >/dev/null; then
  setsid qv-launch-app -- env GSK_RENDERER=cairo \
    walker --gapplication-service >/dev/null 2>&1 &
fi

exec walker --width 644 --maxheight 300 --minheight 300 "$@"
