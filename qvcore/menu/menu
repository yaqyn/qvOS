#!/bin/bash
set -eo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
export QVOS_PATH

base="$QVOS_PATH/qvcore/menu/base"
routes="$QVOS_PATH/qvcore/menu/routes"
personal_extension="$HOME/.config/qvos/extensions/menu.sh"
BACK_TO_EXIT=false

if [[ ! -f $base || -L $base || ! -f $routes || -L $routes ]]; then
  echo "The qvOS menu source is incomplete." >&2
  exit 1
fi

# shellcheck source=qvcore/menu/base
source "$base"
# shellcheck source=qvcore/menu/routes
source "$routes"

# Load the user-owned qvOS extension last so personal functions can deliberately
# override qvOS defaults.
# shellcheck source=/dev/null
if [[ -e $personal_extension || -L $personal_extension ]]; then
  if [[ ! -f $personal_extension || -L $personal_extension ||
    ! -O $personal_extension ]]; then
    echo "Refusing an unsafe personal qvOS menu extension: $personal_extension" >&2
    exit 1
  fi
  source "$personal_extension"
fi

if (($# > 1)); then
  echo "Usage: qv-menu [destination]" >&2
  exit 2
fi

toggle_existing_menu
if (($# == 1)); then
  BACK_TO_EXIT=true
  go_to_menu "$1"
else
  show_main_menu
fi
