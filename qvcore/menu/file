#!/bin/bash

set -euo pipefail

if (( $# < 3 )); then
  echo "Usage: qv menu file <label> <paths> <formats> [walker args...]" >&2
  exit 2
fi

label="$1"
paths_arg="$2"
formats_arg="$3"
shift 3

IFS=: read -r -a paths <<<"$paths_arg"
read -r -a formats <<<"$formats_arg"

if (( ${#paths[@]} == 0 || ${#formats[@]} == 0 )); then
  echo "Usage: qv menu file <label> <paths> <formats> [walker args...]" >&2
  exit 2
fi

for index in "${!paths[@]}"; do
  path=${paths[$index]}
  [[ -d $path ]] || {
    echo "Search directory not found: $path" >&2
    exit 1
  }
  paths[index]=$(realpath -e -- "$path")
done

find_args=("${paths[@]}" "(" -type d -name ".*" ! -name "." -prune ")" -o -type f ! -name ".*" "(")
first_format=true
for format in "${formats[@]}"; do
  format=${format#.}
  [[ $format =~ ^[[:alnum:]]+$ ]] || {
    echo "Invalid file format: $format" >&2
    exit 2
  }
  if [[ $first_format == "true" ]]; then
    first_format=false
  else
    find_args+=(-o)
  fi

  find_args+=(-iname "*.$format")
done
find_args+=(")" -printf '%T@\t%p\n')

find "${find_args[@]}" 2>/dev/null | sort -rn | cut -f2- |
  qv-launch-walker --dmenu --width 800 --minheight 1 --maxheight 500 \
    -p "$label…" "$@" 2>/dev/null
