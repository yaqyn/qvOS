#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/menu/native-paths"
retired_manifest="$root/qvcore/menu/retired-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

expected=$'bin/omarchy-launch-walker\nbin/omarchy-menu\nbin/omarchy-menu-file\nbin/omarchy-menu-input\nbin/omarchy-menu-keybindings\nbin/omarchy-menu-select\nbin/omarchy-refresh-walker'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest") == "$expected" ]] ||
  fail "native menu inventory"

declare -A owners=(
  [launch-walker]=launch-walker
  [menu]=menu
  [menu-file]=file
  [menu-input]=input
  [menu-keybindings]=keybindings
  [menu-select]=select
  [refresh-walker]=refresh-walker
)
for command in "${!owners[@]}"; do
  owner=${owners[$command]}
  native="$root/bin/qv-$command"
  compatibility="$root/bin/omarchy-$command"
  [[ -x $root/qvcore/menu/$owner && -x $native && -x $compatibility ]] ||
    fail "menu owner or adapter mode: $command"
  (( $(wc -l <"$native") <= 12 && $(wc -l <"$compatibility") <= 5 )) ||
    fail "menu adapter contains implementation: $command"
  rg -q '^# qv:summary=' "$native" || fail "native menu metadata: $command"
  ! rg -q '^# (qv|omarchy):' "$compatibility" ||
    fail "compatibility menu metadata: $command"
  # shellcheck disable=SC2016
  grep -Fqx "exec \"\$QVOS_PATH/qvcore/menu/$owner\" \"\$@\"" "$native" ||
    fail "native menu adapter owner: $command"
  # shellcheck disable=SC2016
  grep -Fqx "exec \"\$QVOS_PATH/qvcore/menu/$owner\" \"\$@\"" \
    "$compatibility" || fail "compatibility menu adapter owner: $command"
done

if rg -n 'omarchy-(launch-walker|menu-(file|input|keybindings|select|share)|qvos-share|refresh-walker)' \
  "$root/bin/omarchy-menu" \
  "$root/qvcore/config/files/hypr/bindings.lua" \
  "$root/qvcore/controls/notification/mako-core.ini" \
  "$root/qvcore/branding" \
  "$root/qvcore/desktop" \
  "$root/qvcore/menu" \
  "$root/qvcore/thunar" \
  --glob '!**/AGENTS.md' \
  --glob '!**/check' \
  --glob '!**/native-paths'; then
  fail "active qvOS consumer uses a menu or Share compatibility route"
fi

for frontend in qv omarchy; do
  for route in \
    'launch walker|qv-launch-walker' \
    'menu|qv-menu' \
    'menu file|qv-menu-file' \
    'menu input|qv-menu-input' \
    'menu keybindings|qv-menu-keybindings' \
    'menu select|qv-menu-select' \
    'refresh walker|qv-refresh-walker' \
    'share|qv-share'; do
    name=${route%%|*}
    binary=${route#*|}
    "$root/bin/$frontend" commands --json | jq -e \
      --arg route "$frontend $name" --arg binary "$binary" '
        [.commands[] | select(.route == $route and .binary == $binary)] |
        length == 1
      ' >/dev/null || fail "$frontend $name native route"
  done
done

expected_retired=$'default/elephant/\ndefault/walker/'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == \
  "$expected_retired" ]] || fail "retired Walker source inventory"
while IFS= read -r path; do
  [[ -n $path && $path != \#* ]] || continue
  [[ ! -e $root/$path && ! -L $root/$path ]] ||
    fail "retired Walker source remains: $path"
done <"$retired_manifest"

declare -A provider_names=(
  [qvos_background_selector.lua]=qvosBackgroundSelector
  [qvos_menu.lua]=qvosMenu
  [qvos_themes.lua]=qvosThemes
  [qvos_unlocks.lua]=qvosUnlocks
)
for provider in "${!provider_names[@]}"; do
  provider_source="$root/qvcore/menu/elephant/$provider"
  [[ -f $provider_source && ! -L $provider_source ]] ||
    fail "native Elephant provider: $provider"
  grep -Fqx "Name = \"${provider_names[$provider]}\"" "$provider_source" ||
    fail "native Elephant identity: $provider"
done
for theme_source in layout.xml style.css; do
  [[ -f $root/qvcore/menu/walker-theme/$theme_source &&
    ! -L $root/qvcore/menu/walker-theme/$theme_source ]] ||
    fail "native Walker theme source: $theme_source"
done
grep -Fqx 'theme = "qvos-menu"                                                        # theme to use' \
  "$root/qvcore/config/files/walker/config.toml" ||
  fail "native Walker default theme"
if rg -n 'menus:omarchy|default/(elephant|walker)|omarchy-restart-walker' \
  "$root/qvcore/menu/base" \
  "$root/qvcore/menu/routes" \
  "$root/qvcore/menu/concepts.psv" \
  "$root/qvcore/config/files/walker/config.toml"; then
  fail "active menu source retains an inherited provider or Walker default"
fi

[[ ! -e $root/qvcore/menu/retire-pacman-hook &&
  ! -L $root/qvcore/menu/retire-pacman-hook ]] ||
  fail "pre-release Walker hook cleanup owner remains"
grep -Fq 'restart-walker-required' "$root/qvcore/update/analyze-log" ||
  fail "Walker update restart marker"

[[ -x $root/bin/qv-share && -x $root/bin/omarchy-share ]] ||
  fail "Share adapter mode"
! rg -q '^# (qv|omarchy):' "$root/bin/omarchy-share" ||
  fail "Share compatibility metadata"
# shellcheck disable=SC2016
grep -Fqx 'exec "$QVOS_PATH/qvcore/share/share" "$@"' \
  "$root/bin/qv-share" || fail "native Share adapter owner"
# shellcheck disable=SC2016
grep -Fqx 'exec "$QVOS_PATH/qvcore/share/share" "$@"' \
  "$root/bin/omarchy-share" || fail "compatibility Share adapter owner"

mapfile -t base_functions < <(
  sed -nE 's/^(function[[:space:]]+)?([[:alnum:]_]+)\(\).*/\2/p' \
    "$root/qvcore/menu/base" | sort -u
)
mapfile -t route_functions < <(
  sed -nE 's/^(function[[:space:]]+)?([[:alnum:]_]+)\(\).*/\2/p' \
    "$root/qvcore/menu/routes" | sort -u
)
if comm -12 \
  <(printf '%s\n' "${base_functions[@]}") \
  <(printf '%s\n' "${route_functions[@]}") | grep -q .; then
  fail "duplicate native menu function ownership"
fi
if rg -n '(^|[^[:alnum:]_-])omarchy-[[:alnum:]_-]+' \
  "$root/qvcore/menu/base" "$root/qvcore/menu/routes"; then
  fail "native menu implementation uses an Omarchy command route"
fi
if rg -n 'install_qvos_menu|menu_extension_ready' \
  "$root/qvcore/menu/install"; then
  fail "retired generated menu overlay remains active"
fi
grep -Fq "personal_extension=\"\$HOME/.config/qvos/extensions/menu.sh\"" \
  "$root/qvcore/menu/menu" || fail "native personal menu-extension runtime"
grep -Fq "legacy_target_path=\"\$legacy_extension_dir/menu.sh\"" \
  "$root/qvcore/menu/install" || fail "inherited menu-extension migration owner"
[[ -f $root/qvcore/config/files/qvos/extensions/menu.sh &&
  ! -e $root/qvcore/config/files/omarchy ]] ||
  fail "singular native personal menu-extension source"
if rg -n 'omarchy-menu' \
  "$root/qvcore/config/files/hypr/bindings.lua" \
  "$root/qvcore/config/files/waybar/config.jsonc" \
  "$root/qvcore/menu/elephant/qvos_menu.lua"; then
  fail "active desktop surface uses the menu compatibility route"
fi
if rg -n -i 'omarchy' \
  "$root/qvcore/menu/concepts.psv" \
  "$root/qvcore/menu/elephant/qvos_menu.lua"; then
  fail "active menu catalog retains inherited product identity"
fi
grep -Fq '|Install|terminal:qv-pkg-install|AUR|terminal:qv-pkg-aur-install|Remove|terminal:qv-pkg-remove' \
  "$root/qvcore/menu/concepts.psv" || fail "native package menu routes"

printf 'ok - qvOS menu helpers, Walker, and Share have singular native owners\n'
