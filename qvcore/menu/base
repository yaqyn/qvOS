  *"qvOS Source"*) qv-launch-webapp "https://github.com/Yaqyn-qvOS/qvOS" ;;
  *Hyprland*) qv-launch-webapp "https://wiki.hypr.land/" ;;
  *Arch*) qv-launch-webapp "https://wiki.archlinux.org/title/Main_page" ;;
  *Bash*) qv-launch-webapp "https://devhints.io/bash" ;;
  *Neovim*) qv-launch-webapp "https://www.lazyvim.org/keymaps" ;;
