  *Hibernate*) systemctl hibernate ;;
  *Logout*) qv-system-logout ;;
  *Restart*) qv-system-reboot ;;
  *Shutdown*) qv-system-shutdown ;;
  *) back_to show_main_menu ;;
  esac
}
