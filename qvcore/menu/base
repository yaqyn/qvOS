  case $(menu "Toggle" "$options") in
  *Screensaver*) qv-toggle-screensaver ;;
  *Nightlight*) qv-toggle-nightlight ;;
  *Idle*) qv-toggle-idle ;;
  *Notifications*) qv-toggle-notification-silencing ;;
  *Bar*) qv-toggle-waybar ;;
  *Layout*) qv-hyprland-workspace-layout-toggle ;;
  *Ratio*) qv-hyprland-window-single-square-aspect-toggle ;;
  *Gaps*) qv-hyprland-window-gaps-toggle ;;
  *Scaling*) qv-hyprland-monitor-scaling-cycle ;;
  *"Direct Boot"*) present_terminal qv-config-direct-boot ;;
