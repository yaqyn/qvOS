show_hardware_menu() {
  local options="󰛧  Laptop Display\n 󰍹  Mirror Display"

  if qv-hw-hybrid-gpu; then
    options="$options\n  Hybrid GPU"
  fi

  if qv-hw-touchpad; then
    options="$options\n󰟸  Touchpad"
  fi

  if qv-hw-dell-xps-haptic-touchpad && qv-cmd-present dell-xps-touchpad-haptics; then
    options="$options\n󰌌  Touchpad Haptics"
  fi

  if qv-hw-touchscreen; then
    options="$options\n󰆽  Touchscreen"
  fi

  case $(menu "Toggle" "$options") in
  *Laptop*) qv-hyprland-monitor-internal toggle ;;
  *Mirror*) qv-hyprland-monitor-internal-mirror toggle ;;
  *Haptics*) show_hardware_touchpad_haptics_menu ;;
  *Touchpad*) qv-toggle-touchpad ;;
  *Touchscreen*) qv-toggle-touchscreen ;;
  *"Hybrid GPU"*) present_terminal qv-toggle-hybrid-gpu ;;
  *) back_to show_trigger_menu ;;
  esac
}

show_hardware_touchpad_haptics_menu() {
  local current
  local selected
  current=$(dell-xps-touchpad-haptics get)
  selected=$(menu "Touchpad Haptics" "low\nmid\nhigh" "" "$current")

  if [[ -n $selected ]]; then
    dell-xps-touchpad-haptics set "$selected"
  else
    back_to show_hardware_menu
  fi
}

