show_system_menu() {
  local options="󱄄  Screensaver\n  Lock"
  ! qv-toggle-enabled suspend-off && options="$options\n󰒲  Suspend"
  qv-hibernation-available && options="$options\n󰤁  Hibernate"
  options="$options\n󰍃  Logout\n󰜉  Restart\n󰐥  Shutdown"

  case $(menu "System" "$options") in
  *Screensaver*) qv-launch-screensaver force ;;
