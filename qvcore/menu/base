show_setup_system_menu() {
  local options=""

  if qv-toggle-enabled suspend-off; then
    options="$options󰒲  Enable Suspend"
  else
    options="$options󰒲  Disable Suspend"
  fi

  if qv-hibernation-available; then
    options="$options\n󰤁  Disable Hibernate"
  else
    options="$options\n󰤁  Enable Hibernate"
  fi

  case $(menu "System" "$options") in
  *Suspend*) qv-toggle-suspend ;;
  *"Enable Hibernate"*) present_terminal qv-hibernation-setup ;;
  *"Disable Hibernate"*) present_terminal qv-hibernation-remove ;;
  *) show_setup_menu ;;
  esac
}

