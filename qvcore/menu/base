  *Hypridle*) open_in_editor ~/.config/hypr/hypridle.conf && qv-restart-hypridle ;;
  *Hyprlock*) open_in_editor ~/.config/hypr/hyprlock.conf ;;
  *Hyprsunset*) open_in_editor ~/.config/hypr/hyprsunset.conf && qv-restart-hyprsunset ;;
