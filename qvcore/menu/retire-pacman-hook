#!/bin/bash
set -euo pipefail

(( $# == 0 )) || {
  echo "Usage: qvcore/menu/retire-pacman-hook" >&2
  exit 2
}

system_root=${QVOS_MENU_SYSTEM_ROOT:-}
testing=${QVOS_MENU_TESTING:-}
hook="$system_root/etc/pacman.d/hooks/walker-restart.hook"
expected_uid=0

if [[ -n $system_root ]]; then
  [[ $testing == "1" && $system_root == /tmp/* && -d $system_root &&
    ! -L $system_root && $(stat -c '%u' -- "$system_root") == "$UID" ]] || {
    echo "Invalid qvOS menu test root." >&2
    exit 2
  }
  expected_uid=$UID
fi

[[ -e $hook || -L $hook ]] || exit 0

preserve() {
  echo "Preserving modified or unsafe retired Walker Pacman hook: $hook" >&2
  exit 0
}

[[ -f $hook && ! -L $hook && $(stat -c '%u' -- "$hook") == "$expected_uid" ]] ||
  preserve

mapfile -t lines <"$hook"
((${#lines[@]} == 11)) || preserve
[[ ${lines[0]} == "[Trigger]" &&
  ${lines[1]} == "Type = Package" &&
  ${lines[2]} == "Operation = Upgrade" &&
  ${lines[3]} == "Target = walker" &&
  ${lines[4]} == "Target = walker-debug" &&
  ${lines[5]} == "Target = elephant*" &&
  -z ${lines[6]} &&
  ${lines[7]} == "[Action]" &&
  ${lines[8]} == "Description = Restarting Walker services after system update" &&
  ${lines[9]} == "When = PostTransaction" ]] || preserve
[[ ${lines[10]} =~ ^Exec\ =\ /home/[A-Za-z0-9._-]+/\.local/share/(omarchy|qvos)/bin/(omarchy|qv)-restart-walker$ ]] ||
  preserve

if [[ -n $system_root ]]; then
  rm -- "$hook"
else
  sudo /usr/bin/rm -- "$hook"
fi

echo "Removed the retired Walker Pacman hook; qvOS updates now restart Walker through private update state."
