#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
OMARCHY_PATH=$QVOS_PATH
slug=${1:-}
no_launch=false

usage() {
  echo "Usage: qvcore/menu/software-install <bitwarden|crush|cursor|emacs|lm-studio|ollama|sublime-text|vim> [--no-launch]" >&2
}

launch_desktop() {
  [[ $no_launch == "false" ]] || return
  setsid gtk-launch "$1"
}

if (($# == 2)); then
  [[ $2 == "--no-launch" ]] || {
    usage
    exit 2
  }
  no_launch=true
elif (($# != 1)); then
  usage
  exit 2
fi

case $slug in
bitwarden)
  omarchy-pkg-add bitwarden bitwarden-cli
  launch_desktop bitwarden
  ;;
cursor)
  omarchy-pkg-add cursor-bin
  launch_desktop cursor
  ;;
sublime-text)
  omarchy-pkg-add sublime-text-4
  launch_desktop sublime_text
  ;;
vim)
  omarchy-pkg-add vim
  ;;
emacs)
  omarchy-pkg-add emacs-wayland
  systemctl --user enable --now emacs.service
  ;;
lm-studio)
  omarchy-pkg-add lmstudio-bin
  ;;
ollama)
  if qv-cmd-present nvidia-smi; then
    package=ollama-cuda
  elif qv-cmd-present rocminfo; then
    package=ollama-rocm
  else
    package=ollama
  fi
  omarchy-pkg-add "$package"
  ;;
crush)
  omarchy-pkg-add crush-bin
  ;;
*)
  usage
  exit 2
  ;;
esac
