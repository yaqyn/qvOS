#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)}
native_manifest="$QVOS_PATH/qvcore/cli/native-paths"
retired_manifest="$QVOS_PATH/qvcore/cli/retired-paths"

expected_native=$'bin/omarchy\nbin/omarchy-cmd-missing\nbin/omarchy-cmd-present\nbin/omarchy-dev-benchmark\nbin/omarchy-dev-bin-metadata'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$native_manifest") == "$expected_native" ]] || {
  echo "Native CLI path inventory is incomplete or unordered." >&2
  exit 1
}
grep -Fqx 'bin/omarchy-cmd-terminal-cwd' "$retired_manifest" || {
  echo "Retired terminal-cwd command is not inventoried." >&2
  exit 1
}
[[ ! -e $QVOS_PATH/bin/omarchy-cmd-terminal-cwd && ! -L $QVOS_PATH/bin/omarchy-cmd-terminal-cwd ]] || {
  echo "Retired terminal-cwd implementation remains." >&2
  exit 1
}

for adapter in "$QVOS_PATH/bin/qv" "$QVOS_PATH/bin/omarchy"; do
  [[ -x $adapter ]] || {
    echo "Missing executable CLI adapter: $adapter" >&2
    exit 1
  }
done

[[ -x $QVOS_PATH/qvcore/cli/qv ]] || {
  echo "Missing executable native CLI engine." >&2
  exit 1
}
[[ -x $QVOS_PATH/qvcore/cli/command-missing && -x $QVOS_PATH/qvcore/cli/command-present ]] || {
  echo "Native command-presence owners are unavailable." >&2
  exit 1
}

declare -A dev_tool_owners=(
  [dev-benchmark]=benchmark
  [dev-bin-metadata]=metadata
)
for route in "${!dev_tool_owners[@]}"; do
  owner="qvcore/cli/${dev_tool_owners[$route]}"
  native_adapter="$QVOS_PATH/bin/qv-$route"
  compatibility_adapter="$QVOS_PATH/bin/omarchy-$route"
  [[ -x $QVOS_PATH/$owner && -x $native_adapter && -x $compatibility_adapter ]] || {
    echo "Missing native CLI tool owner or adapter: $route" >&2
    exit 1
  }
  (($(wc -l <"$native_adapter") <= 12)) || {
    echo "Native CLI tool adapter contains implementation: $route" >&2
    exit 1
  }
  (($(wc -l <"$compatibility_adapter") <= 5)) || {
    echo "CLI tool compatibility adapter contains implementation: $route" >&2
    exit 1
  }
  rg -q '^# qv:summary=' "$native_adapter" || {
    echo "Native CLI tool adapter lacks metadata: $route" >&2
    exit 1
  }
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" || {
    echo "CLI tool compatibility adapter duplicates metadata: $route" >&2
    exit 1
  }
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    grep -Fqx "exec \"\$QVOS_PATH/$owner\" \"\$@\"" "$adapter" || {
      echo "CLI tool adapter does not delegate directly: $route" >&2
      exit 1
    }
  done
done

"$QVOS_PATH/bin/qv" commands --check
"$QVOS_PATH/bin/omarchy" commands --check
native_catalog_binaries=$(
  "$QVOS_PATH/bin/qv" commands --all --json | jq -r '.commands[].binary'
)

for native_adapter in "$QVOS_PATH"/bin/qv-*; do
  [[ -f $native_adapter && -x $native_adapter ]] || continue
  stem=${native_adapter##*/qv-}
  compatibility_adapter="$QVOS_PATH/bin/omarchy-$stem"
  [[ -f $compatibility_adapter && -x $compatibility_adapter ]] || {
    echo "Missing compatibility adapter for native command: $stem" >&2
    exit 1
  }
  if rg -q '^# (qv|omarchy):' "$compatibility_adapter"; then
    echo "Compatibility adapter duplicates native metadata: $stem" >&2
    exit 1
  fi
  [[ $(grep -Fxc "qv-$stem" <<<"$native_catalog_binaries") == 1 ]] || {
    echo "Native command is absent or duplicated in the catalog: $stem" >&2
    exit 1
  }
done

qv_update_help=$("$QVOS_PATH/bin/qv" update --help)
[[ $qv_update_help == *"qv-update"* ]] || {
  echo "qv update does not resolve to the guarded qvOS update owner." >&2
  exit 1
}
[[ $qv_update_help != *"omarchy-update-perform"* ]] || {
  echo "qv update exposes an inherited updater implementation route." >&2
  exit 1
}

echo "qvOS CLI ownership check passed."
