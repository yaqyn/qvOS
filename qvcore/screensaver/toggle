#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}

(( $# == 0 )) || {
  echo "Usage: qv toggle screensaver" >&2
  exit 2
}
exec "$QVOS_PATH/qvcore/config/toggle" \
  --enabled-notification "󱄄   Screensaver disabled" \
  --disabled-notification "󱄄   Screensaver enabled" \
  screensaver-off
