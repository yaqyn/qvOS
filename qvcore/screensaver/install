#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
source_dir="$QVOS_PATH/qvcore/screensaver"
runtime_root="$HOME/.local/lib/qvos"
runtime_config="$runtime_root/screensaver"
qvos_bin="$runtime_root/bin"
local_bin="$HOME/.local/bin"
staged_file=""
commands=(
  qvos-launch-screensaver
  qvos-screensaver
)
aliases=(
  omarchy-launch-screensaver:qvos-launch-screensaver
  omarchy-screensaver:qvos-screensaver
  qv-launch-screensaver:qvos-launch-screensaver
  qv-screensaver:qvos-screensaver
)

cleanup() {
  [[ -z $staged_file ]] || rm -f -- "$staged_file"
}
trap cleanup EXIT

[[ -f $source_dir/alacritty.toml ]] || {
  echo "Missing qvOS screensaver config." >&2
  exit 1
}
for command_name in "${commands[@]}"; do
  [[ -x $source_dir/$command_name ]] || {
    echo "Missing qvOS screensaver command: $command_name" >&2
    exit 1
  }
done
[[ ! -L $runtime_config ]] || {
  echo "Refusing symbolic-link qvOS screensaver runtime: $runtime_config" >&2
  exit 1
}

install -d "$runtime_config" "$qvos_bin" "$local_bin"

staged_file=$(mktemp "$runtime_config/.alacritty.toml.XXXXXX")
install -m 0644 "$source_dir/alacritty.toml" "$staged_file"
mv -f -- "$staged_file" "$runtime_config/alacritty.toml"
staged_file=""

find "$runtime_config" \
  -mindepth 1 \
  -maxdepth 1 \
  ! -name alacritty.toml \
  -exec rm -rf -- {} +

for command_name in "${commands[@]}"; do
  staged_file=$(mktemp "$qvos_bin/.$command_name.XXXXXX")
  install -m 0755 "$source_dir/$command_name" "$staged_file"
  mv -f -- "$staged_file" "$qvos_bin/$command_name"
  staged_file=""
  ln -sfn "$qvos_bin/$command_name" "$local_bin/$command_name"
done

for alias_entry in "${aliases[@]}"; do
  alias_name=${alias_entry%%:*}
  owner_name=${alias_entry#*:}
  ln -sfn "$qvos_bin/$owner_name" "$local_bin/$alias_name"
done
