#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/screensaver/native-paths"
retired_manifest="$root/qvcore/screensaver/retired-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

for owner in close qvos-launch-screensaver qvos-screensaver; do
  [[ -x $root/qvcore/screensaver/$owner ]] ||
    fail "screensaver owner mode: $owner"
done
[[ ! -e $root/qvcore/screensaver/omarchy-launch-screensaver ]] ||
  fail "duplicate runtime compatibility adapter remains"

declare -A route_owners=(
  [launch-screensaver]=qvos-launch-screensaver
  [screensaver]=qvos-screensaver
  [toggle-screensaver]=toggle
)
for route in "${!route_owners[@]}"; do
  owner="qvcore/screensaver/${route_owners[$route]}"
  native_adapter="$root/bin/qv-$route"
  compatibility_adapter="$root/bin/omarchy-$route"
  [[ -x $native_adapter && -x $compatibility_adapter ]] ||
    fail "screensaver adapter mode: $route"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native screensaver adapter lacks metadata: $route"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "screensaver compatibility adapter duplicates metadata: $route"
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    grep -Fqx "exec \"\$QVOS_PATH/$owner\" \"\$@\"" "$adapter" ||
      fail "screensaver adapter owner: $route"
  done
done

expected_manifest=$'bin/omarchy-launch-screensaver\nbin/omarchy-screensaver\nbin/omarchy-toggle-screensaver'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest") == "$expected_manifest" ]] ||
  fail "screensaver native inventory is incomplete or unordered"
expected_retired=$'default/alacritty/\ndefault/ghostty/'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == \
  "$expected_retired" ]] || fail "screensaver retired inventory"
for retired in default/alacritty default/ghostty; do
  [[ ! -e $root/$retired && ! -L $root/$retired ]] ||
    fail "inherited screensaver source remains: $retired"
done
for config_name in alacritty.toml foot.ini ghostty.conf; do
  [[ -f $root/qvcore/screensaver/$config_name &&
    ! -L $root/qvcore/screensaver/$config_name ]] ||
    fail "native screensaver profile: $config_name"
  grep -Fq 'qvOS screensaver terminal profile' \
    "$root/qvcore/screensaver/$config_name" ||
    fail "unbranded screensaver profile: $config_name"
done

grep -Fq 'qv-cmd-present tte' "$root/qvcore/screensaver/qvos-launch-screensaver" ||
  fail "screensaver bypasses the native command helper"
grep -Fq 'qv-hyprland-monitor-focused' "$root/qvcore/screensaver/qvos-launch-screensaver" ||
  fail "screensaver bypasses the native monitor helper"
for class_owner in \
  qvcore/screensaver/qvos-launch-screensaver \
  qvcore/screensaver/close; do
  grep -Fq 'org.qvos.screensaver' "$root/$class_owner" ||
    fail "native screensaver class is missing: $class_owner"
done
grep -Fq 'org\.qvos\.screensaver' \
  "$root/qvcore/config/base/hypr/windows.lua" ||
  fail "native screensaver class is missing from Hyprland rules"
if rg -n 'org\.omarchy\.screensaver' \
  "$root/qvcore/screensaver" "$root/qvcore/config/base/hypr/windows.lua" \
  --glob '!AGENTS.md' --glob '!check'; then
  fail "native screensaver retains the inherited window class"
fi
# shellcheck disable=SC2016
for runtime_profile in \
  '"$qvos_root/screensaver/alacritty.toml"' \
  '"$qvos_root/screensaver/foot.ini"' \
  '"$qvos_root/screensaver/ghostty.conf"'; do
  grep -Fq "$runtime_profile" "$root/qvcore/screensaver/qvos-launch-screensaver" ||
    fail "launcher bypasses runtime profile: $runtime_profile"
done
if rg -n 'default/(alacritty|foot|ghostty)' "$root/qvcore/screensaver" \
  --glob '!check' --glob '!retired-paths'; then
  fail "native screensaver retains an inherited configuration dependency"
fi
# shellcheck disable=SC2016
grep -Fq '"$close_owner"' "$root/qvcore/screensaver/qvos-screensaver" ||
  fail "screensaver runner bypasses the shared close owner"
if rg -q '^close_screensaver_windows\(\)' "$root/qvcore/screensaver/qvos-screensaver"; then
  fail "screensaver runner duplicates the shared close owner"
fi
# shellcheck disable=SC2016
grep -Fqx '    on-timeout = pidof hyprlock || systemctl --user start qvos-screensaver.service' \
  "$root/qvcore/config/files/hypr/hypridle.conf" ||
  fail "installed idle config bypasses isolated screensaver supervision"
grep -Fqx 'ExecStart=%h/.local/lib/qvos/bin/qvos-launch-screensaver' \
  "$root/qvcore/config/files/systemd/user/qvos-screensaver.service" ||
  fail "screensaver user service bypasses the installed runtime owner"
if rg -q '^\[Install\]$' \
  "$root/qvcore/config/files/systemd/user/qvos-screensaver.service"; then
  fail "screensaver user service must remain on demand"
fi

for alias_entry in \
  qv-launch-screensaver:qvos-launch-screensaver \
  qv-screensaver:qvos-screensaver; do
  grep -Fqx "  $alias_entry" "$root/qvcore/screensaver/install" ||
    fail "screensaver runtime alias is missing: $alias_entry"
done
if rg -n 'omarchy-((launch-)?screensaver|toggle-screensaver)([^[:alnum:]_-]|$)' \
  "$root/qvcore/screensaver/install"; then
  fail "screensaver installer retains runtime compatibility convergence"
fi
if rg -n 'omarchy-((launch-)?screensaver|toggle-screensaver)([^[:alnum:]_-]|$)' \
  "$root/qvcore" "$root/qvcore/config/files" \
  --glob '!**/AGENTS.md' --glob '!**/native-paths' \
  --glob '!**/screensaver/check' \
  --glob '!**/screensaver/install' \
  --glob '!**/owner-contracts.psv'; then
  fail "native qvOS surface calls a screensaver compatibility route"
fi

printf 'ok - qvOS screensaver source and runtime have one native owner pair\n'
