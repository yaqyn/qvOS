#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/software/native-paths"
retired_manifest="$root/qvcore/software/retired-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

expected=$'bin/omarchy-install-dropbox\nbin/omarchy-install-helix\nbin/omarchy-install-nordvpn\nbin/omarchy-install-once\nbin/omarchy-install-tailscale\nbin/omarchy-install-terminal\nbin/omarchy-install-vscode\nbin/omarchy-install-zed\nbin/omarchy-voxtype-config\nbin/omarchy-voxtype-install\nbin/omarchy-voxtype-model\nbin/omarchy-voxtype-remove\nbin/omarchy-voxtype-status'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest") == "$expected" ]] ||
  fail "native optional-software inventory"
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == \
  $'default/foot/\ndefault/voxtype/' ]] ||
  fail "retired optional-software inventory"
for retired_path in default/foot default/voxtype; do
  [[ ! -e $root/$retired_path && ! -L $root/$retired_path ]] ||
    fail "inherited optional-software default remains: $retired_path"
done
[[ -f $root/qvcore/software/foot.desktop &&
  ! -L $root/qvcore/software/foot.desktop ]] ||
  fail "native Foot desktop source"
[[ -f $root/qvcore/software/voxtype-config.toml &&
  ! -L $root/qvcore/software/voxtype-config.toml ]] ||
  fail "native Voxtype configuration seed"
grep -Fq 'qvcore/software/voxtype-config.toml' \
  "$root/qvcore/software/voxtype-install" ||
  fail "Voxtype installer bypasses its native configuration seed"

declare -A owner_by_route=(
  [install-dropbox]=qvcore/software/dropbox-install
  [install-helix]=qvcore/software/helix-install
  [install-nordvpn]=qvcore/software/nordvpn-install
  [install-once]=qvcore/software/once-install
  [install-tailscale]=qvcore/software/tailscale-install
  [install-terminal]=qvcore/software/terminal-install
  [install-vscode]=qvcore/software/vscode-install
  [install-zed]=qvcore/software/zed-install
  [voxtype-config]=qvcore/software/voxtype-config
  [voxtype-install]=qvcore/software/voxtype-install
  [voxtype-model]=qvcore/software/voxtype-model
  [voxtype-remove]=qvcore/software/voxtype-remove
  [voxtype-status]=qvcore/software/voxtype-status
)
for route in "${!owner_by_route[@]}"; do
  owner=${owner_by_route[$route]}
  native_adapter="$root/bin/qv-$route"
  compatibility_adapter="$root/bin/omarchy-$route"
  [[ -x $native_adapter && -x $compatibility_adapter && -x $root/$owner ]] ||
    fail "optional-software adapter or owner mode: $route"
  (( $(wc -l <"$native_adapter") <= 10 )) ||
    fail "native optional-software adapter contains implementation: $route"
  (( $(wc -l <"$compatibility_adapter") <= 6 )) ||
    fail "optional-software compatibility adapter contains implementation: $route"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native optional-software adapter lacks metadata: $route"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "optional-software compatibility adapter duplicates metadata: $route"
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    # shellcheck disable=SC2016
    grep -Fqx "exec \"\$QVOS_PATH/$owner\" \"\$@\"" "$adapter" ||
      fail "optional-software adapter owner: $route"
  done
done

if rg -n 'qv-pkg-(add|drop).*wtype|rm[[:space:]]+-rf.*voxtype' \
  "$root/qvcore/software"; then
  fail "Dictation owner claims a base package or deletes user data"
fi
if rg -n 'setsid|gtk-launch|>[[:space:]]*.*(argv|settings)\.json' \
  "$root/qvcore/software/vscode-install"; then
  fail "VS Code owner launches the app or overwrites existing settings"
fi
# shellcheck disable=SC2016
grep -Fq 'id -nG "$USER"' "$root/qvcore/software/nordvpn-install" ||
  fail "NordVPN owner does not detect active group access"
compatibility_path_refs=$(
  rg -n 'OMARCHY_PATH' \
    "$root/qvcore/software" \
    --glob '!AGENTS.md' \
    --glob '!check' \
    --glob '!native-paths' || true
)
if [[ -n $compatibility_path_refs ]]; then
  printf '%s\n' "$compatibility_path_refs" >&2
  fail "native optional-software owner dereferences the compatibility source root"
fi
if rg -n 'omarchy-(pkg|cmd|system)-(add|aur-add|drop|present|reboot)' \
  "$root/qvcore/software" \
  --glob '!AGENTS.md' \
  --glob '!check' \
  --glob '!native-paths'; then
  fail "native optional-software owner calls a compatibility helper"
fi
if rg -n 'omarchy-(install-(dropbox|helix|nordvpn|once|tailscale|terminal|vscode|zed)|voxtype-(config|install|model|remove|status))' \
  "$root/qvcore/menu" \
  "$root/qvcore/tui" \
  "$root/qvcore/waybar" \
  "$root/qvcore/controls/notification/mako-core.ini" \
  --glob '!owner-contracts.psv'; then
  fail "native qvOS surfaces call optional-software compatibility routes"
fi
if rg -n 'omazed|setsid|gtk-launch|xdg-terminals\.list[[:space:]]*<<|alias[[:space:]]+hx' \
  "$root/qvcore/software/helix-install" \
  "$root/qvcore/software/terminal-install" \
  "$root/qvcore/software/zed-install"; then
  fail "editor or terminal owner retains duplicate state, shell, or launch behavior"
fi
if rg -n 'legacy_(config|link|theme)|omarchy\.toml|theme = "omarchy"' \
  "$root/qvcore/software/helix-install"; then
  fail "Helix installer retains pre-release theme convergence"
fi
grep -Fq 'qv-pkg-add helix' "$root/qvcore/software/helix-install" ||
  fail "Helix package boundary"
# shellcheck disable=SC2016
grep -Fq '[[ $1 == "--reconcile" ]]' "$root/qvcore/software/helix-install" ||
  fail "Helix configuration lacks a package-free reconciliation mode"
grep -Fq 'qvcore/software/helix-install" --reconcile' \
  "$root/qvcore/install/desktop" ||
  fail "desktop reconciliation bypasses installed Helix configuration"
grep -Fqx 'qv-pkg-add zed' "$root/qvcore/software/zed-install" ||
  fail "Zed package boundary"
grep -Fq 'qvcore/theme/set-zed' "$root/qvcore/software/zed-install" ||
  fail "Zed installer bypasses its native theme owner"
# shellcheck disable=SC2016
grep -Fqx '"$default_owner" "$slug"' "$root/qvcore/software/terminal-install" ||
  fail "terminal installer bypasses the qvOS default owner"
grep -Fq '# qvos:contract=qvcore/software/foot.desktop' \
  "$root/qvcore/software/terminal-install" ||
  fail "terminal installer bypasses the native Foot desktop source"
if rg -n 'default/foot' "$root/qvcore/software" \
  --glob '!check' --glob '!retired-paths'; then
  fail "optional software retains an inherited Foot dependency"
fi
grep -Fqx 'alias hx=helix' "$root/qvcore/shell/aliases" ||
  fail "Helix command alias is not owned by the qvOS shell overlay"
grep -Fq 'qv-voxtype-install' \
  "$root/qvcore/controls/notification/mako-core.ini" ||
  fail "Dictation notification does not use the native owner route"
# shellcheck disable=SC2016
grep -Fqx 'exec qv-launch-floating-terminal-with-presentation voxtype setup model' \
  "$root/qvcore/software/voxtype-model" ||
  fail "Voxtype model setup does not preserve exact arguments"
if rg -n 'kill[[:space:]]+0|"voxtype setup model"' \
  "$root/qvcore/software/voxtype-model" \
  "$root/qvcore/software/voxtype-status"; then
  fail "Voxtype control retains unsafe process-group cleanup or shell-like arguments"
fi
if rg -n \
  'nautilus-dropbox|libappindicator-gtk3|dropbox-cli[[:space:]]+start|uwsm-app|webapp-install|tailscale-light\.png' \
  "$root/qvcore/software/dropbox-install" \
  "$root/qvcore/software/tailscale-install"; then
  fail "optional service installer retains desktop bloat, detached launch, or implicit routing"
fi
grep -Fqx 'qv-pkg-add dropbox-cli python-gpgme libayatana-appindicator' \
  "$root/qvcore/software/dropbox-install" ||
  fail "Dropbox minimal package boundary"
grep -Fqx \
  'exec sudo tailscale up --accept-dns=false --accept-routes=false' \
  "$root/qvcore/software/tailscale-install" ||
  fail "Tailscale safe DNS and route defaults"

printf 'ok - optional software preserves base ownership and user data\n'
