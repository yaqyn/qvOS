#!/bin/bash
set -euo pipefail

version_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=qvcore/version/lib
source "$version_root/lib"

requested_root=${QVOS_VERSION_SOURCE_ROOT:-${QVOS_PATH:-$HOME/.local/share/qvos}}

(( $# == 0 )) || {
  echo "Usage: qv version" >&2
  exit 2
}

source_root=$(qvos_version_source_root "$requested_root") || {
  echo "qvOS version: installed source is not a safe Git checkout." >&2
  exit 1
}

commit=$(qvos_version_commit "$source_root") || {
  echo "qvOS version: installed source has no valid commit." >&2
  exit 1
}
source_status=$(
  git -C "$source_root" status --porcelain=v1 --untracked-files=all 2>/dev/null
) || {
  echo "qvOS version: installed source state is unavailable." >&2
  exit 1
}

version="rolling-${commit:0:12}"
[[ -z $source_status ]] || version+="-dirty"

printf '%s\n' "$version"
