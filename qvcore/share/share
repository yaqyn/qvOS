#!/bin/bash
set -euo pipefail

clipboard_temp=""

cleanup() {
  if [[ -n $clipboard_temp && -f $clipboard_temp ]]; then
    rm -f -- "$clipboard_temp"
  fi
}
trap cleanup EXIT

usage() {
  echo "Usage: qv share <clipboard|file|folder> [path...]" >&2
  exit 2
}

if qv-cmd-missing localsend; then
  echo "LocalSend is not installed" >&2
  exit 1
fi

(( $# > 0 )) || usage
mode=$1
shift
files=()

case $mode in
--send-clipboard-temp)
  (( $# == 1 )) || usage
  clipboard_candidate=$1
  runtime_root=${XDG_RUNTIME_DIR:-/run/user/$UID}
  share_runtime="$runtime_root/qvos/share"
  clipboard_name=${clipboard_candidate##*/}

  if [[ ${clipboard_candidate%/*} != "$share_runtime" ]] ||
    [[ ! $clipboard_name =~ ^clipboard\.[[:alnum:]]{6}\.txt$ ]] ||
    [[ ! -f $clipboard_candidate || -L $clipboard_candidate ]] ||
    [[ ! -O $clipboard_candidate ]] ||
    [[ $(stat -c '%a' -- "$clipboard_candidate") != "600" ]]; then
    echo "Refusing unsafe LocalSend clipboard cleanup path." >&2
    exit 1
  fi

  clipboard_temp=$clipboard_candidate
  localsend --headless send "$clipboard_temp"
  exit
  ;;
clipboard)
  (( $# == 0 )) || usage
  runtime_root=${XDG_RUNTIME_DIR:-/run/user/$UID}
  [[ -d $runtime_root && ! -L $runtime_root && -O $runtime_root ]] || {
    echo "Refusing unsafe user runtime directory: $runtime_root" >&2
    exit 1
  }
  share_runtime="$runtime_root/qvos/share"
  if [[ -e $share_runtime || -L $share_runtime ]]; then
    [[ -d $share_runtime && ! -L $share_runtime && -O $share_runtime ]] || {
      echo "Refusing unsafe qvOS share runtime: $share_runtime" >&2
      exit 1
    }
  else
    install -d -m 0700 "$share_runtime"
  fi
  chmod 0700 "$share_runtime"
  clipboard_temp=$(mktemp "$share_runtime/clipboard.XXXXXX.txt")
  chmod 0600 "$clipboard_temp"
  wl-paste >"$clipboard_temp"
  files=("$clipboard_temp")
  ;;
file | folder)
  if (( $# > 0 )); then
    files=("$@")
  elif [[ $mode == "folder" ]]; then
    selection=$(find "$HOME" -type d 2>/dev/null | fzf) || exit $?
    [[ -n $selection ]] || exit 0
    files=("$selection")
  else
    mapfile -t files < <(find "$HOME" -type f 2>/dev/null | fzf --multi)
    (( ${#files[@]} > 0 )) || exit 0
  fi
  ;;
*) usage ;;
esac

if [[ $mode == "file" ]]; then
  for file in "${files[@]}"; do
    [[ -f $file ]] || {
      echo "Share file not found: $file" >&2
      exit 1
    }
  done
elif [[ $mode == "folder" ]]; then
  for folder in "${files[@]}"; do
    [[ -d $folder ]] || {
      echo "Share folder not found: $folder" >&2
      exit 1
    }
  done
fi

if [[ $mode == "clipboard" ]]; then
  systemd-run --user --quiet --collect \
    "$0" --send-clipboard-temp "$clipboard_temp"
  clipboard_temp=""
else
  systemd-run --user --quiet --collect \
    localsend --headless send "${files[@]}"
fi
