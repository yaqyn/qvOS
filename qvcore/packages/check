#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
provider_dir="$root/qvcore/packages/provider/omarchy"
stable_config="$provider_dir/pacman-stable.conf"
stable_mirror="$provider_dir/mirrorlist-stable"
manifest="$root/qvcore/packages/native-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

expected_paths=$'bin/omarchy-pkg-add\nbin/omarchy-pkg-aur-accessible\nbin/omarchy-pkg-aur-add\nbin/omarchy-pkg-aur-install\nbin/omarchy-pkg-drop\nbin/omarchy-pkg-install\nbin/omarchy-pkg-missing\nbin/omarchy-pkg-present\nbin/omarchy-pkg-remove\nbin/omarchy-refresh-pacman'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest") == "$expected_paths" ]] ||
  fail "native package inventory"

operations=(
  add
  aur-accessible
  aur-add
  aur-install
  drop
  install
  missing
  present
  remove
)
for operation in "${operations[@]}"; do
  owner="$root/qvcore/packages/$operation"
  native_adapter="$root/bin/qv-pkg-$operation"
  compatibility_adapter="$root/bin/omarchy-pkg-$operation"
  [[ -x $owner && -x $native_adapter && -x $compatibility_adapter ]] ||
    fail "package $operation owner or adapter mode"
  (( $(wc -l <"$native_adapter") <= 12 )) ||
    fail "native package adapter contains implementation: $operation"
  (( $(wc -l <"$compatibility_adapter") <= 5 )) ||
    fail "package compatibility adapter contains implementation: $operation"
  grep -Fq "# qv:summary=" "$native_adapter" ||
    fail "native package metadata: $operation"
  if rg -q '^# (qv|omarchy):' "$compatibility_adapter"; then
    fail "package compatibility adapter duplicates metadata: $operation"
  fi
  grep -Fq "qvcore/packages/$operation" "$native_adapter" ||
    fail "native package adapter ownership: $operation"
  grep -Fq "qvcore/packages/$operation" "$compatibility_adapter" ||
    fail "package compatibility adapter ownership: $operation"
done

for owner in update-aur update-available update-keyring remove-orphans update-system; do
  [[ -x $root/qvcore/packages/$owner ]] ||
    fail "native package-update owner mode: $owner"
done
[[ -x $root/qvcore/packages/provider-files ]] ||
  fail "native package-provider resolver mode"
expected_provider_files=$'mirrorlist-edge\nmirrorlist-rc\nmirrorlist-stable\npacman-edge.conf\npacman-rc.conf\npacman-stable.conf\nsigning-key.gpg'
actual_provider_files=$(
  find "$provider_dir" -mindepth 1 -maxdepth 1 -type f -printf '%f\n' | LC_ALL=C sort
)
[[ $actual_provider_files == "$expected_provider_files" ]] ||
  fail "credited provider source inventory"
while IFS= read -r provider_file; do
  [[ -f $provider_file && ! -L $provider_file &&
    $(stat -c '%a' -- "$provider_file") == "644" ]] ||
    fail "unsafe credited provider source: ${provider_file#"$root/"}"
done < <(find "$provider_dir" -mindepth 1 -maxdepth 1 -print)
sudo_keepalive="$root/qvcore/packages/sudo-keepalive"
[[ -x $sudo_keepalive ]] || fail "native package sudo refresh owner mode"
for picker in install aur-install; do
  # This intentionally matches the literal runtime source expression.
  # shellcheck disable=SC2016
  grep -Fq 'source "$QVOS_PATH/qvcore/packages/sudo-keepalive"' \
    "$root/qvcore/packages/$picker" ||
    fail "package $picker does not source native sudo refresh"
  grep -Fq 'trap qvos_sudo_keepalive_stop EXIT' \
    "$root/qvcore/packages/$picker" ||
    fail "package $picker does not bound sudo refresh lifetime"
done
if rg -n '(^|[[:space:]])(sudo[[:space:]]+)?updatedb([[:space:]]|$)' \
  "$root/qvcore/packages" --glob '!AGENTS.md' --glob '!check'; then
  fail "package mutation eagerly rebuilds the host-wide locate database"
fi
retired_manifest="$root/qvcore/packages/retired-paths"
expected_retired=$'bin/omarchy-sudo-keepalive\nbin/omarchy-update-aur-pkgs\nbin/omarchy-update-keyring\nbin/omarchy-update-orphan-pkgs\nbin/omarchy-update-system-pkgs\ndefault/pacman/'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == "$expected_retired" ]] ||
  fail "retired package source inventory"
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == $(
  sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest" | LC_ALL=C sort -u
) ]] || fail "retired package paths are not sorted and unique"
while IFS= read -r retired; do
  [[ -n $retired && $retired != \#* ]] || continue
  [[ ! -e $root/$retired && ! -L $root/$retired ]] ||
    fail "retired package-update path remains: $retired"
done <"$retired_manifest"

if rg -n '^omarchy-[A-Za-z0-9@._+-]+$' \
  "$root/qvcore/install/packaging/base.packages" \
  "$root/qvcore/install/packaging/other.packages"; then
  fail "qvOS package manifests select a provider-branded application bundle"
fi

native_refresh="$root/bin/qv-refresh-pacman"
compatibility_refresh="$root/bin/omarchy-refresh-pacman"
[[ -x $native_refresh && -x $compatibility_refresh ]] ||
  fail "package refresh adapter mode"
(( $(wc -l <"$native_refresh") <= 10 )) ||
  fail "native package refresh adapter contains implementation"
(( $(wc -l <"$compatibility_refresh") <= 5 )) ||
  fail "package refresh compatibility adapter contains implementation"
rg -q '^# qv:summary=' "$native_refresh" ||
  fail "native package refresh metadata"
! rg -q '^# (qv|omarchy):' "$compatibility_refresh" ||
  fail "package refresh compatibility adapter duplicates metadata"
for adapter in "$native_refresh" "$compatibility_refresh"; do
  # shellcheck disable=SC2016
  grep -Fqx 'exec "$QVOS_PATH/qvcore/packages/configure" "$@"' "$adapter" ||
    fail "package refresh adapter ownership"
done
if rg -n 'OMARCHY_PATH' "$root/qvcore/packages" \
  --glob '!AGENTS.md' --glob '!check'; then
  fail "native package owner dereferences the compatibility source root"
fi
if rg -n 'omarchy-refresh-pacman' \
  "$root/qvcore" \
  --glob '!**/AGENTS.md' --glob '!**/check' \
  --glob '!**/native-paths' --glob '!**/owner-contracts.psv'; then
  fail "native qvOS source calls the package refresh compatibility route"
fi
grep -Fq 'qvcore/packages/provider-files' "$root/qvcore/packages/configure" ||
  fail "Stable reset bypasses the provider resolver"
for installer_stage in \
  "$root/qvcore/install/preflight/pacman.sh" \
  "$root/qvcore/install/post-install/pacman.sh"; do
  grep -Fq 'qvcore/packages/provider-files' "$installer_stage" ||
    fail "installer bypasses the provider resolver: ${installer_stage#"$root/"}"
  if rg -n 'default/pacman|pacman-\$\{|mirrorlist-\$\{' "$installer_stage"; then
    fail "installer interpolates an inherited provider path"
  fi
done

for frontend in qv omarchy; do
  "$root/bin/$frontend" commands --json | jq -e --arg route "$frontend pkg add" '
    [.commands[] | select(.route == $route and .binary == "qv-pkg-add")] |
    length == 1
  ' >/dev/null ||
    fail "$frontend package route does not prefer the native catalog"
done

if rg -n '\bxargs\b|\beval\b' \
  "$root/qvcore/packages/add" \
  "$root/qvcore/packages/aur-add" \
  "$root/qvcore/packages/aur-install" \
  "$root/qvcore/packages/drop" \
  "$root/qvcore/packages/install" \
  "$root/qvcore/packages/missing" \
  "$root/qvcore/packages/present" \
  "$root/qvcore/packages/remove"; then
  fail "native package owners rebuild argument strings"
fi
grep -Fq 'pacman -S --noconfirm --needed -- "$@"' \
  "$root/qvcore/packages/add" || fail "Pacman option boundary"
grep -Fq 'yay -S --noconfirm --needed -- "$@"' \
  "$root/qvcore/packages/aur-add" || fail "Yay option boundary"
grep -Fq "pacman -Q -- \"\$package\"" "$root/qvcore/packages/add" ||
  fail "Pacman installation readback"
grep -Fq "pacman -Q -- \"\$package\"" "$root/qvcore/packages/aur-add" ||
  fail "AUR installation readback"

# shellcheck disable=SC2016
[[ $(<"$stable_mirror") == 'Server = https://stable-mirror.omarchy.org/$repo/os/$arch' ]] || {
  fail "Omarchy Stable Arch mirror contract drifted"
}
declare -A expected_mirrors=(
  [edge]="https://mirror.omarchy.org/\$repo/os/\$arch"
  [rc]="https://rc-mirror.omarchy.org/\$repo/os/\$arch"
  [stable]="https://stable-mirror.omarchy.org/\$repo/os/\$arch"
)
declare -A expected_repositories=(
  [edge]="https://pkgs.omarchy.org/edge/\$arch"
  [rc]="https://pkgs.omarchy.org/edge/\$arch"
  [stable]="https://pkgs.omarchy.org/stable/\$arch"
)
for channel in edge rc stable; do
  config="$provider_dir/pacman-$channel.conf"
  mirror="$provider_dir/mirrorlist-$channel"
  [[ $(grep -Fxc '[omarchy]' "$config") == 1 ]] ||
    fail "expected one credited Omarchy repository: $channel"
  [[ $(awk '
    /^\[omarchy\]$/ { active = 1; next }
    /^\[/ { active = 0 }
    active && /^SigLevel = / { print }
  ' "$config") == "SigLevel = Required DatabaseOptional" ]] ||
    fail "Omarchy package signatures are not required at source: $channel"
  grep -Fqx "Server = ${expected_repositories[$channel]}" "$config" ||
    fail "Omarchy package repository contract drifted: $channel"
  grep -Fqx "Server = ${expected_mirrors[$channel]}" "$mirror" ||
    fail "Omarchy Arch mirror contract drifted: $channel"
done
if rg -n 'Optional[[:space:]]+TrustAll|SigLevel[[:space:]]*=[[:space:]]*Never' \
  "$provider_dir"; then
  fail "credited provider source contains weak signature policy"
fi
if ! grep -Fq 'package_file.sig' \
  "$root/release/iso/builder/build-iso.sh" ||
  ! grep -Fq 'Server = file:///var/cache/qvos/mirror/offline/' \
    "$root/release/iso/profile/pacman-offline.conf" ||
  ! grep -Fq 'SigLevel = Required DatabaseOptional' \
    "$root/release/iso/profile/pacman-offline.conf" ||
  ! grep -Fq 'LocalFileSigLevel = Required' \
    "$root/release/iso/profile/pacman-offline.conf"; then
  fail "ISO offline mirror does not preserve the signed provider policy"
fi
mapfile -t stable_files < <("$root/qvcore/packages/provider-files" stable)
[[ ${stable_files[*]} == "$stable_config $stable_mirror" ]] ||
  fail "Stable provider resolution"
if "$root/qvcore/packages/provider-files" edge >/dev/null 2>&1 ||
  "$root/qvcore/packages/provider-files" rc >/dev/null 2>&1 ||
  "$root/qvcore/packages/provider-files" '../stable' >/dev/null 2>&1; then
  fail "provider resolver accepts an unreviewed installed channel"
fi
for channel in edge rc; do
  mapfile -t iso_files < <(
    QVOS_CHROOT_INSTALL=1 \
      "$root/qvcore/packages/provider-files" "$channel"
  )
  [[ ${iso_files[*]} == \
    "$provider_dir/pacman-$channel.conf $provider_dir/mirrorlist-$channel" ]] ||
    fail "ISO provider resolution: $channel"
done
if rg -n '^\[qvos\]$|pkgs\.qvos|mirror\.qvos' \
  "$provider_dir" "$root/qvcore"; then
  fail "qvOS claims package infrastructure it does not operate"
fi
grep -Fq 'omarchy-keyring' "$root/qvcore/packages/update-keyring" || {
  fail "Omarchy keyring package contract is missing"
}
grep -Fq '40DFB630FF42BCFFB047046CF0134EE680CAC571' \
  "$root/qvcore/packages/update-keyring" || {
  fail "Omarchy signing fingerprint contract is missing"
}
provider_key="$provider_dir/signing-key.gpg"
[[ $(sha256sum "$provider_key" | cut -d ' ' -f 1) == \
  "15d6aac44df688165b2ea35fe0b23af239bbc66a6909c10a5c219e8d94b707de" ]] ||
  fail "Omarchy signing key payload drifted"
gpg --show-keys --with-colons "$provider_key" 2>/dev/null |
  awk -F: '$1 == "fpr" { print $10 }' |
  grep -Fqx '40DFB630FF42BCFFB047046CF0134EE680CAC571' ||
  fail "Omarchy signing key fingerprint drifted"
grep -Fq 'pacman -Syu --noconfirm' "$root/qvcore/packages/update-system" ||
  fail "native package full-upgrade stage"
package_availability="$root/qvcore/packages/update-available"
grep -Fq 'fakeroot -- pacman -Sy --noconfirm' "$package_availability" ||
  fail "package availability does not use isolated repository metadata"
# shellcheck disable=SC2016
grep -Fq 'pacman -Qu --color never --dbpath "$database_path"' \
  "$package_availability" || fail "package availability comparison"
grep -Fq 'local_database=/var/lib/pacman/local' "$package_availability" ||
  fail "package availability installed-database owner"
if rg -n 'sudo|/var/lib/pacman/sync|pacman -Syu' "$package_availability"; then
  fail "package availability mutates or synchronizes the live package database"
fi
if rg -n 'pacman -Syyu|for pkg in|xargs|eval' \
  "$root/qvcore/packages/update-system" \
  "$root/qvcore/packages/remove-orphans"; then
  fail "wasteful refresh or rebuilt package arguments remain"
fi
# shellcheck disable=SC2016
grep -Fq 'pacman -Rs --noconfirm -- "${orphans[@]}"' \
  "$root/qvcore/packages/remove-orphans" ||
  fail "single argument-safe orphan cleanup"
grep -Fq 'SigLevel = Required DatabaseOptional' \
  "$root/qvcore/security/install" || {
  fail "Omarchy package signatures are not required by qvOS"
}
grep -Fq 'qvOS supports only the Omarchy Stable package channel.' \
  "$root/qvcore/packages/configure" || {
  fail "installed package channel is not constrained to Stable"
}
if git -C "$root" ls-files | grep -Eq '(^|/)(PKGBUILD|\.SRCINFO)$'; then
  fail "qvOS unexpectedly owns package build recipes"
fi

echo "qvOS uses credited, signed Omarchy Stable infrastructure without owning a package repository."
