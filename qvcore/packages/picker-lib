#!/bin/bash

qvos_package_pick() {
  local output_name=$1
  local source_name=$2
  shift 2
  local -n output=$output_name
  local -n source_argv=$source_name

  # shellcheck disable=SC2034 # nameref publishes the selection to the caller
  output=$(
    local picker_status source_status
    local -a pipeline_status=()

    set +e
    "${source_argv[@]}" | fzf "$@"
    pipeline_status=("${PIPESTATUS[@]}")
    source_status=${pipeline_status[0]:-125}
    picker_status=${pipeline_status[1]:-125}

    (( picker_status == 0 )) || exit "$picker_status"
    (( source_status == 0 || source_status == 141 )) || exit "$source_status"
  )
}
