#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
# qvos:contract=qvcore/packages/picker-lib
# shellcheck source=qvcore/packages/picker-lib
source "$QVOS_PATH/qvcore/packages/picker-lib"

fzf_args=(
  --multi
  --preview 'pacman -Sii -- {1}'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

source_command=(pacman -Slq)
set +e
qvos_package_pick selection source_command "${fzf_args[@]}"
selection_status=$?
set -e
case $selection_status in
0) ;;
1 | 130) exit 0 ;;
*) exit "$selection_status" ;;
esac
[[ -n $selection ]] || exit 0

mapfile -t packages <<<"$selection"
"$QVOS_PATH/qvcore/packages/validate-targets" "${packages[@]}"
# shellcheck source=qvcore/packages/sudo-keepalive disable=SC1091
source "$QVOS_PATH/qvcore/packages/sudo-keepalive"
qvos_sudo_keepalive_start
trap qvos_sudo_keepalive_stop EXIT
sudo pacman -S --noconfirm --needed -- "${packages[@]}"
qv-show-done
