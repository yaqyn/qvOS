#!/bin/bash
set -euo pipefail

(( $# == 0 )) || {
  echo "Usage: qvcore/packages/remove-orphans" >&2
  exit 2
}

set +e
orphan_output=$(pacman -Qtdq)
orphan_status=$?
set -e
if (( orphan_status == 1 )); then
  exit 0
fi
(( orphan_status == 0 )) || {
  echo "qvOS packages: could not inspect orphan packages." >&2
  exit "$orphan_status"
}

orphans=()
while IFS= read -r orphan; do
  [[ -n $orphan ]] && orphans+=("$orphan")
done <<<"$orphan_output"
((${#orphans[@]} > 0)) || exit 0

echo -e "\e[32m\nRemove orphan system packages\e[0m"
sudo pacman -Rs --noconfirm -- "${orphans[@]}"
echo
