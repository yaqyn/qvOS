#!/bin/bash
set -euo pipefail

kind=${1:-}
shift || true
mode=install
case ${1:-} in
"") ;;
--existing) mode=existing ;;
*)
  echo "Usage: qvcore/power/event-rule <profile|wifi> [--existing]" >&2
  exit 2
  ;;
esac
(($# <= 1)) || {
  echo "Usage: qvcore/power/event-rule <profile|wifi> [--existing]" >&2
  exit 2
}

script_path=$(/usr/bin/readlink -f -- "${BASH_SOURCE[0]}")
qvos_root=$(cd -- "$(/usr/bin/dirname -- "$script_path")/../.." && pwd)
system_root=${QVOS_POWER_SYSTEM_ROOT:-}
testing=${QVOS_POWER_TESTING:-}
chroot_install=${QVOS_CHROOT_INSTALL:-}
reload_command=/usr/bin/udevadm
trigger=false
temporary=""

case $chroot_install in
"" | "1") ;;
*)
  echo "Invalid qvOS chroot-install signal." >&2
  exit 2
  ;;
esac
if [[ -n $system_root && $testing != "1" ]]; then
  echo "A custom qvOS power system root is valid only in tests." >&2
  exit 2
fi
if [[ $testing == "1" ]]; then
  reload_command=${QVOS_UDEVADM:-}
fi
if [[ $chroot_install == "1" ]]; then
  reload_command=""
fi

profile_rule_content() {
  local command_path=$1

  for supply_pattern in Mains 'USB*' Wireless; do
    printf 'SUBSYSTEM=="power_supply", ATTR{type}=="%s", RUN+="/usr/bin/systemd-run --quiet --no-block --collect --service-type=exec --property=After=power-profiles-daemon.service --property=CapabilityBoundingSet= --property=NoNewPrivileges=yes --property=PrivateTmp=yes --property=ProtectHome=yes --property=ProtectSystem=strict %s autodetect"\n' \
      "$supply_pattern" "$command_path"
  done
}

wifi_rule_content() {
  local command_path=$1

  for supply_type in Mains 'USB*' Wireless; do
    printf 'SUBSYSTEM=="power_supply", ATTR{type}=="%s", RUN+="/usr/bin/systemd-run --quiet --no-block --collect --service-type=exec --property=CapabilityBoundingSet=CAP_NET_ADMIN --property=NoNewPrivileges=yes --property=PrivateTmp=yes --property=ProtectHome=yes --property=ProtectSystem=strict %s auto"\n' \
      "$supply_type" "$command_path"
  done
}

case $kind in
profile)
  rule_path=${QVOS_POWER_PROFILE_RULE:-$system_root/etc/udev/rules.d/99-power-profile.rules}
  default_rule=/etc/udev/rules.d/99-power-profile.rules
  helper="$system_root/usr/lib/qvos/power/profiles-set"
  desired_content=$(profile_rule_content "$helper")
  label=power-profile
  ;;
wifi)
  rule_path=${QVOS_POWER_WIFI_RULE:-$system_root/etc/udev/rules.d/99-wifi-powersave.rules}
  default_rule=/etc/udev/rules.d/99-wifi-powersave.rules
  helper="$system_root/usr/lib/qvos/power/wifi-powersave"
  desired_content=$(wifi_rule_content "$helper")
  label=wifi-power-save
  trigger=true
  ;;
*)
  echo "Usage: qvcore/power/event-rule <profile|wifi> [--existing]" >&2
  exit 2
  ;;
esac

if [[ $rule_path != "$default_rule" && $testing != "1" ]]; then
  echo "A custom qvOS $label rule path is valid only in tests." >&2
  exit 2
fi
if [[ $mode == "existing" && ! -e $rule_path && ! -L $rule_path ]]; then
  exit
fi
if [[ $rule_path == "$default_rule" && $EUID != 0 ]]; then
  exec /usr/bin/sudo -- "$script_path" "$kind" "$@"
fi
if [[ ! $helper =~ ^/[-[:alnum:]_./:]+$ ]]; then
  echo "The qvOS root helper path is unsafe for a udev command." >&2
  exit 1
fi

rule_dir=${rule_path%/*}
expected_uid=$EUID
if [[ -z $system_root ]]; then
  expected_uid=0
fi
[[ -d $rule_dir && ! -L $rule_dir ]] || {
  echo "Refusing unsafe udev rule directory: $rule_dir" >&2
  exit 1
}
[[ $(/usr/bin/stat -c %u -- "$rule_dir") == "$expected_uid" ]] || {
  echo "Refusing a foreign udev rule directory: $rule_dir" >&2
  exit 1
}

rule_current=false
if [[ -e $rule_path || -L $rule_path ]]; then
  [[ -f $rule_path && ! -L $rule_path &&
    $(/usr/bin/stat -c %u -- "$rule_path") == "$expected_uid" ]] || {
    echo "Refusing unsafe qvOS $label rule: $rule_path" >&2
    exit 1
  }
  current_content=$(<"$rule_path")
  if [[ $current_content == "$desired_content" ]]; then
    rule_current=true
  else
    echo "Preserving an unknown qvOS $label rule: $rule_path" >&2
    exit 1
  fi
fi

QVOS_POWER_SYSTEM_ROOT="$system_root" QVOS_POWER_TESTING="$testing" \
  "$qvos_root/qvcore/power/root-install"
if [[ $rule_current == "true" ]]; then
  /usr/bin/chmod 0644 -- "$rule_path"
  exit
fi

cleanup() {
  [[ -z $temporary || ! -e $temporary ]] || /usr/bin/rm -f -- "$temporary"
}
trap cleanup EXIT
temporary=$(/usr/bin/mktemp "$rule_dir/.qvos-$label.XXXXXX")
printf '%s\n' "$desired_content" >"$temporary"
/usr/bin/chmod 0644 -- "$temporary"
/usr/bin/mv -f -- "$temporary" "$rule_path"
temporary=""

restore_rule() {
  /usr/bin/rm -f -- "$rule_path"
  [[ -z $reload_command ]] ||
    "$reload_command" control --reload-rules >/dev/null 2>&1 || true
}

if [[ -n $reload_command ]] && ! "$reload_command" control --reload-rules; then
  restore_rule
  echo "Could not reload the native qvOS $label rule; restored its prior state." >&2
  exit 1
fi
if [[ $trigger == "true" && -n $reload_command ]] &&
  ! "$reload_command" trigger --subsystem-match=power_supply; then
  restore_rule
  echo "Could not activate the native qvOS $label rule; restored its prior state." >&2
  exit 1
fi

printf 'Installed native qvOS %s rule.\n' "$label"
