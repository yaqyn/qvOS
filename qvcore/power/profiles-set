#!/bin/bash
set -euo pipefail

(($# <= 1)) || {
  echo "Usage: qv powerprofiles set [autodetect|ac|battery|profile]" >&2
  exit 2
}
action=${1:-autodetect}
power_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=qvcore/power/supply-lib
source "$power_root/supply-lib"

mapfile -t profiles < <(powerprofilesctl list | awk '/^[[:space:]]*[* ]?[[:space:]]*[a-zA-Z0-9-]+:$/ {
  gsub(/^[*[:space:]]+|:$/, "")
  print
}')
((${#profiles[@]})) || {
  echo "No power profiles are available." >&2
  exit 1
}
has_profile() {
  local expected=$1
  local profile
  for profile in "${profiles[@]}"; do
    [[ $profile == "$expected" ]] && return
  done
  return 1
}

if [[ $action == "autodetect" ]]; then
  if qvos_ac_present; then
    action=ac
  else
    action=battery
  fi
fi

case $action in
ac)
  if has_profile performance; then
    target=performance
  else
    target=balanced
  fi
  ;;
battery)
  target=balanced
  ;;
*)
  has_profile "$action" || {
    echo "Unknown power profile: $action" >&2
    exit 2
  }
  target=$action
  ;;
esac
has_profile "$target" || {
  echo "Required power profile is unavailable: $target" >&2
  exit 1
}
exec powerprofilesctl set "$target"
