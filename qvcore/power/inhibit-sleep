#!/bin/bash

set -euo pipefail

if [[ ${1:-} == "--" ]]; then
  shift
fi
if (($# == 0)); then
  echo "Usage: qv system inhibit sleep -- <command> [arguments...]" >&2
  exit 2
fi

reason="${QVOS_SLEEP_INHIBIT_REASON:-Development work is active}"

exec systemd-inhibit \
  --what=sleep \
  --who=qvOS \
  --why="$reason" \
  --mode=block-weak \
  -- "$@"
