#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
source_dir="$QVOS_PATH/qvcore/power"
runtime_dir="$HOME/.local/lib/qvos/power"
qvos_bin="$HOME/.local/lib/qvos/bin"
local_bin="$HOME/.local/bin"
user_unit_dir="$HOME/.config/systemd/user"
system_root=${QVOS_POWER_SYSTEM_ROOT:-}
system_helper="${system_root}/usr/lib/qvos/battery-protection-hwdb"

system_helper_ready() {
  local expected_uid=0
  local expected_gid=0

  if [[ -n $system_root ]]; then
    expected_uid=$(id -u)
    expected_gid=$(id -g)
  fi
  [[ -f $system_helper && ! -L $system_helper ]] &&
    [[ $(stat -c '%u:%g:%a' -- "$system_helper") == "$expected_uid:$expected_gid:755" ]] &&
    cmp -s "$source_dir/battery-protection-hwdb" "$system_helper"
}

if [[ -n $system_root && ${QVOS_POWER_TESTING:-} != "1" ]]; then
  echo "A custom Battery Protection system root is only valid in tests." >&2
  exit 2
fi

runtime_files=(
  battery-protection
  battery-protection-backend
  battery-protection-lib
  inhibit-sleep
  suspend-if-safe
)

rm -rf "$runtime_dir"
install -d "$runtime_dir" "$qvos_bin" "$local_bin" "$user_unit_dir"
for runtime_file in "${runtime_files[@]}"; do
  mode=0644
  [[ $runtime_file != "battery-protection-lib" ]] && mode=0755
  install -m "$mode" "$source_dir/$runtime_file" "$runtime_dir/$runtime_file"
done

declare -A runtime_commands=(
  [qv-system-inhibit-sleep]=inhibit-sleep
  [qv-system-suspend-if-safe]=suspend-if-safe
)
declare -A retired_runtime_commands=(
  [omarchy-system-inhibit-sleep]=inhibit-sleep
  [omarchy-system-suspend-if-safe]=suspend-if-safe
)
declare -A legacy_runtime_hashes=(
  [inhibit-sleep]=3a6afde2549cd64888507c5d5ad534e368b29711a9cde1d916199d3c137715b5
  [suspend-if-safe]=2e11eb00125215d89cfd545af7d3974e45b6e70bc9e27d9806e145bf26b16e88
)
for command_name in "${!retired_runtime_commands[@]}"; do
  command_path="$qvos_bin/$command_name"
  power_owner=${retired_runtime_commands[$command_name]}
  expected_target="../power/$power_owner"
  if [[ -L $command_path && $(readlink -- "$command_path") == "$expected_target" ]]; then
    rm -f -- "$command_path"
  elif [[ -f $command_path && ! -L $command_path && -O $command_path ]]; then
    runtime_hash=$(sha256sum -- "$command_path")
    runtime_hash=${runtime_hash%% *}
    if [[ $runtime_hash == "${legacy_runtime_hashes[$power_owner]}" ]]; then
      rm -f -- "$command_path"
    else
      printf 'Preserving modified sleep-guard runtime command: %s\n' \
        "$command_path" >&2
    fi
  elif [[ -e $command_path || -L $command_path ]]; then
    printf 'Preserving unsafe sleep-guard runtime command: %s\n' \
      "$command_path" >&2
  fi
done
for command_name in "${!runtime_commands[@]}"; do
  command_path="$qvos_bin/$command_name"
  power_owner=${runtime_commands[$command_name]}
  expected_target="../power/$power_owner"
  if [[ -e $command_path || -L $command_path ]]; then
    if [[ -L $command_path && $(readlink -- "$command_path") == "$expected_target" ]]; then
      continue
    fi
    if [[ -f $command_path && ! -L $command_path ]]; then
      runtime_hash=$(sha256sum -- "$command_path")
      runtime_hash=${runtime_hash%% *}
      if cmp -s "$source_dir/$power_owner" "$command_path" ||
        [[ $runtime_hash == "${legacy_runtime_hashes[$power_owner]}" ]]; then
        rm -f -- "$command_path"
      else
        echo "Refusing modified qvOS sleep-guard runtime command: $command_path" >&2
        exit 1
      fi
    else
      echo "Refusing unsafe qvOS sleep-guard runtime command: $command_path" >&2
      exit 1
    fi
  fi
  ln -s "$expected_target" "$command_path"
done

install -m 0644 \
  "$source_dir/qvos-battery-full-charge-once.service" \
  "$user_unit_dir/qvos-battery-full-charge-once.service"

if system_helper_ready; then
  :
elif [[ -n $system_root ]] || ((EUID == 0)); then
  install -D -o "$(id -u)" -g "$(id -g)" -m 0755 \
    "$source_dir/battery-protection-hwdb" "$system_helper"
  if ((EUID == 0)); then
    chown root:root "$system_helper"
  fi
else
  /usr/bin/sudo /usr/bin/install -D -o root -g root -m 0755 \
    "$source_dir/battery-protection-hwdb" "$system_helper"
fi

"$source_dir/root-install"
if [[ -n $system_root ]]; then
  QVOS_HIBERNATION_TESTING=1 \
    QVOS_HIBERNATION_SYSTEM_ROOT="$system_root" \
    "$source_dir/hibernation/install-root"
else
  "$source_dir/hibernation/install-root"
fi

if [[ -z $system_root ]]; then
  /usr/bin/systemctl --user daemon-reload
fi
