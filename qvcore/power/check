#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/power/native-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

expected=$'bin/omarchy-ac-present\nbin/omarchy-battery-capacity\nbin/omarchy-battery-present\nbin/omarchy-battery-remaining\nbin/omarchy-battery-remaining-time\nbin/omarchy-battery-status\nbin/omarchy-hibernation-available\nbin/omarchy-hibernation-remove\nbin/omarchy-hibernation-setup\nbin/omarchy-powerprofiles-init\nbin/omarchy-powerprofiles-list\nbin/omarchy-powerprofiles-set\nbin/omarchy-system-reboot\nbin/omarchy-system-shutdown\nbin/omarchy-toggle-suspend\nbin/omarchy-wifi-powersave'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest") == "$expected" ]] ||
  fail "native power route inventory"

declare -A route_owners=(
  [ac-present]=supply-status
  [battery-capacity]=battery-info
  [battery-present]=supply-status
  [battery-protection]=battery-protection
  [battery-remaining]=battery-info
  [battery-remaining-time]=battery-info
  [battery-status]=battery-info
  [hibernation-available]=hibernation/available
  [hibernation-remove]=hibernation/remove
  [hibernation-setup]=hibernation/setup
  [powerprofiles-init]=profiles-init
  [powerprofiles-list]=profiles-list
  [powerprofiles-set]=profiles-set
  [system-reboot]=system-power
  [system-shutdown]=system-power
  [system-inhibit-sleep]=inhibit-sleep
  [system-suspend-if-safe]=suspend-if-safe
  [toggle-suspend]=toggle-suspend
  [wifi-powersave]=wifi-powersave
)
declare -A route_actions=(
  [ac-present]=ac
  [battery-capacity]=capacity
  [battery-present]=battery
  [battery-remaining]=remaining
  [battery-remaining-time]=remaining-time
  [battery-status]=status
  [system-reboot]=reboot
  [system-shutdown]=poweroff
)
for route in "${!route_owners[@]}"; do
  native_adapter="$root/bin/qv-$route"
  compatibility_adapter="$root/bin/omarchy-$route"
  owner="$root/qvcore/power/${route_owners[$route]}"
  [[ -x $native_adapter && -x $compatibility_adapter && -x $owner ]] ||
    fail "power owner or adapter mode: $route"
  (($(wc -l <"$native_adapter") <= 12)) ||
    fail "native power adapter contains implementation: $route"
  (($(wc -l <"$compatibility_adapter") <= 6)) ||
    fail "power compatibility adapter contains implementation: $route"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native power adapter lacks metadata: $route"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "power compatibility adapter duplicates metadata: $route"
  fixed_action=${route_actions[$route]:-}
  if [[ -n $fixed_action ]]; then
    expected_exec="exec \"\$QVOS_PATH/qvcore/power/${route_owners[$route]}\" $fixed_action \"\$@\""
  else
    expected_exec="exec \"\$QVOS_PATH/qvcore/power/${route_owners[$route]}\" \"\$@\""
  fi
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    grep -Fqx "$expected_exec" "$adapter" ||
      fail "power adapter ownership: $route"
  done
done

[[ -x $root/qvcore/power/system-power ]] || fail "system-power owner mode"
for owner in event-rule profile-rule root-install unmount-fuse wifi-rule \
  hibernation/available hibernation/install-root hibernation/remove \
  hibernation/root hibernation/setup; do
  [[ -x $root/qvcore/power/$owner ]] || fail "power event owner mode: $owner"
done
# shellcheck disable=SC2016
grep -Fqx '  "$QVOS_PATH/qvcore/power/profile-rule"' \
  "$root/qvcore/install/config/powerprofilesctl-rules.sh" ||
  fail "installer does not use the native power-profile rule owner"
# shellcheck disable=SC2016
grep -Fqx '  "$QVOS_PATH/qvcore/power/wifi-rule"' \
  "$root/qvcore/install/config/wifi-powersave-rules.sh" ||
  fail "installer does not use the native Wi-Fi power rule owner"
if rg -q 'cat <<EOF|tee .*99-power-profile' \
  "$root/qvcore/install/config/powerprofilesctl-rules.sh"; then
  fail "installer duplicates the native power-profile rule"
fi
if rg -q 'cat <<EOF|tee .*99-wifi-powersave' \
  "$root/qvcore/install/config/wifi-powersave-rules.sh"; then
  fail "installer duplicates the native Wi-Fi power rule"
fi
for helper in profiles-set supply-lib wifi-powersave; do
  grep -Fq "install_system_helper $helper" "$root/qvcore/power/root-install" ||
    fail "root helper installer omits $helper"
done
grep -Fq 'qvos-unmount-fuse' "$root/qvcore/power/root-install" ||
  fail "root helper installer omits the native FUSE sleep hook"
for retired_runtime in \
  omarchy-system-inhibit-sleep \
  omarchy-system-suspend-if-safe; do
  grep -Fq "  [$retired_runtime]=" "$root/qvcore/power/install" ||
    fail "retired sleep-guard runtime is not recognized: $retired_runtime"
done
grep -Fq 'ab7034106e456e93dfb01c6948706c0bfcf0f19e6c9b4c2335b5fb1b3e7ec177' \
  "$root/qvcore/power/root-install" ||
  fail "native FUSE sleep hook omits exact inherited cleanup"
grep -Fq '/usr/lib/qvos/power/profiles-set' "$root/qvcore/power/event-rule" ||
  fail "power-profile rule bypasses its root-owned helper"
grep -Fq '/usr/lib/qvos/power/wifi-powersave' "$root/qvcore/power/event-rule" ||
  fail "Wi-Fi rule bypasses its root-owned helper"
if rg -n '\.local/share/(qvos|omarchy).*(profiles|wifi-powersave)' \
  "$root/qvcore/install/config/powerprofilesctl-rules.sh" \
  "$root/qvcore/install/config/wifi-powersave-rules.sh"; then
  fail "installer retains a user-writable root event command"
fi
if rg -n 'omarchy-(ac-present|battery-(capacity|present|protection|remaining|remaining-time|status)|hibernation-|powerprofiles-|system-(inhibit-sleep|suspend-if-safe|reboot|shutdown)|toggle-suspend|wifi-powersave)' \
  "$root/qvcore" "$root/qvcore/config/files" \
  --glob '!**/AGENTS.md' --glob '!**/native-paths' \
  --glob '!**/owner-contracts.psv' --glob '!**/power/check' \
  --glob '!**/check' --glob '!**/omarchy/extensions/menu.sh' \
  --glob '!**/power/event-rule' \
  --glob '!**/power/profile-rule' --glob '!**/power/install' \
  --glob '!**/config/migrate-runtime-root'; then
  fail "native qvOS source still calls a power compatibility command"
fi
if rg -n 'omarchy-hibernation-' \
  "$root/qvcore/menu" "$root/qvcore/tui/task/actions.psv" \
  --glob '!AGENTS.md' --glob '!native-paths'; then
  fail "active qvOS interface calls hibernation compatibility"
fi
event_compatibility=$(
  rg -o 'omarchy-(powerprofiles-set|wifi-powersave)' \
    "$root/qvcore/power/event-rule" | sort -u
)
[[ $event_compatibility == $'omarchy-powerprofiles-set\nomarchy-wifi-powersave' ]] ||
  fail "AC-event migration accepts an unexpected compatibility command"
# shellcheck disable=SC2016
grep -Fq '"${system_root:-/}" "$etc_root" "$run_root"' \
  "$root/qvcore/power/hibernation/root" ||
  fail "production hibernation root validation"

retired_manifest="$root/qvcore/power/retired-paths"
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == \
  $'default/systemd/system-sleep/keyboard-backlight\ndefault/systemd/system-sleep/unmount-fuse' ]] ||
  fail "retired hibernation payload inventory"
for retired in keyboard-backlight unmount-fuse; do
  [[ ! -e $root/default/systemd/system-sleep/$retired ]] ||
    fail "retired power sleep payload remains: $retired"
done

printf 'ok - qvOS owns power telemetry, profiles, sleep guards, and system power\n'
