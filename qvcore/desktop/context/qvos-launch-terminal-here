#!/bin/bash
set -euo pipefail

# Open a terminal command in the current desktop context.

mode="${1:-terminal}"
if (($# > 0)); then
  shift
fi

case "$mode" in
terminal | root | codex | codex-yolo) ;;
*)
  printf 'Usage: qvos-launch-terminal-here [terminal|root|codex|codex-yolo] [path]\n' >&2
  exit 2
  ;;
esac

if (($# > 1)); then
  printf 'Usage: qvos-launch-terminal-here [terminal|root|codex|codex-yolo] [path]\n' >&2
  exit 2
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
location="$("$script_dir/qvos-active-location" "$@")"

case "$mode" in
terminal)
  exec uwsm-app -- xdg-terminal-exec --dir="$location"
  ;;
root)
  exec uwsm-app -- xdg-terminal-exec --dir="$location" sudo -s
  ;;
codex)
  exec uwsm-app -- xdg-terminal-exec --app-id=org.qvos.codex --title="Codex" --dir="$location" \
    env QVOS_SLEEP_INHIBIT_REASON="Codex session is active" \
    "$HOME/.local/lib/qvos/bin/omarchy-system-inhibit-sleep" "$HOME/.local/bin/codex"
  ;;
codex-yolo)
  exec uwsm-app -- xdg-terminal-exec --app-id=org.qvos.codex --title="Codex YOLO" --dir="$location" \
    env QVOS_SLEEP_INHIBIT_REASON="Codex session is active" \
    "$HOME/.local/lib/qvos/bin/omarchy-system-inhibit-sleep" "$HOME/.local/bin/codex" --yolo
  ;;
esac
