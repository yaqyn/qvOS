#!/bin/bash
set -euo pipefail

if ((EUID == 0)); then
  echo "Walker must be restarted from the active desktop user session." >&2
  exit 1
fi

if systemctl --user --quiet is-enabled elephant.service; then
  systemctl --user restart elephant.service
fi
systemctl --user --quiet is-enabled app-walker@autostart.service || {
  echo "Unable to restart Walker because its user service is not enabled." >&2
  exit 1
}
systemctl --user restart app-walker@autostart.service
