#!/bin/bash
set -euo pipefail

# qvos:contract=qvcore/desktop/restart/process-lib
restart_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=qvcore/desktop/restart/process-lib
source "$restart_root/process-lib"

if [[ -f $HOME/.config/alacritty/alacritty.toml ]]; then
  touch "$HOME/.config/alacritty/alacritty.toml"
fi
qvos_process_signal_exact kitty USR1
qvos_process_signal_exact ghostty USR2
