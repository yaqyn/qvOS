#!/bin/bash
set -euo pipefail

# qvos:contract=qvcore/desktop/restart/process-lib
# qvos:contract=qvcore/desktop/restart/user-unit-lib
restart_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=qvcore/desktop/restart/process-lib disable=SC1091
source "$restart_root/process-lib"
# shellcheck source=qvcore/desktop/restart/user-unit-lib disable=SC1091
source "$restart_root/user-unit-lib"

fixed_unit="qvos-waybar.scope"

qvos_user_unit_stop "$fixed_unit"
qvos_process_stop_exact waybar
command -v uwsm-app >/dev/null || {
  echo "Cannot restart Waybar: uwsm-app is unavailable." >&2
  exit 1
}
setsid uwsm-app \
  -u "$fixed_unit" \
  -d "qvOS Waybar" \
  -S both \
  -- waybar >/dev/null 2>&1 &
qvos_user_unit_wait_active "$fixed_unit"
