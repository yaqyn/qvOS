#!/bin/bash
set -euo pipefail

# qvos:contract=qvcore/desktop/restart/process-lib
# qvos:contract=bin/qv-launch-app
restart_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=qvcore/desktop/restart/process-lib
source "$restart_root/process-lib"

(($# > 0)) || {
  echo "Usage: qv restart app <application-name> [application-args...]" >&2
  exit 2
}
command -v qv-launch-app >/dev/null || {
  echo "Cannot restart $1: the qvOS application launcher is unavailable." >&2
  exit 1
}

qvos_process_signal_exact "$1" TERM
setsid qv-launch-app -- "$@" >/dev/null 2>&1 &
