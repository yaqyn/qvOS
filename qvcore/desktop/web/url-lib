#!/bin/bash

qvos_web_is_valid_ipv4() {
  local hostname=$1
  local octet
  local -a octets

  [[ $hostname =~ ^[0-9]+(\.[0-9]+){3}$ ]] || return 1
  IFS="." read -r -a octets <<<"$hostname"
  ((${#octets[@]} == 4)) || return 1

  for octet in "${octets[@]}"; do
    ((${#octet} <= 3 && 10#$octet <= 255)) || return 1
  done
}

qvos_web_is_valid_hostname() {
  local hostname=${1,,}
  local label
  local -a labels

  ((0 < ${#hostname} && ${#hostname} <= 253)) || return 1

  if [[ $hostname =~ ^[0-9.]+$ && $hostname == *.* ]]; then
    qvos_web_is_valid_ipv4 "$hostname"
    return
  fi

  [[ $hostname =~ ^[a-z0-9.-]+$ ]] || return 1
  [[ $hostname != .* && $hostname != *. && $hostname != *..* ]] || return 1

  IFS="." read -r -a labels <<<"$hostname"
  for label in "${labels[@]}"; do
    ((0 < ${#label} && ${#label} <= 63)) || return 1
    [[ $label =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || return 1
  done
}

# shellcheck disable=SC2034 # qvos_web_validation_error is returned to sourcing owners
qvos_web_validate_url() {
  local LC_ALL=C
  local candidate=$1
  local max_length=$2
  local https_only=${3:-false}
  local authority
  local hostname
  local port
  local remainder

  qvos_web_validation_error=""

  if ((${#candidate} > max_length)); then
    qvos_web_validation_error="Website must be $max_length characters or fewer"
    return 1
  fi

  if [[ $candidate == *[![:print:]]* ]]; then
    qvos_web_validation_error="Use printable ASCII characters and Punycode hostnames"
    return 1
  fi

  if [[ $candidate == *[[:space:]]* ]]; then
    qvos_web_validation_error="Website cannot contain spaces"
    return 1
  fi

  case $candidate in
  https://*) ;;
  http://*)
    if [[ $https_only == "true" ]]; then
      qvos_web_validation_error="Website must use HTTPS"
      return 1
    fi
    ;;
  *)
    qvos_web_validation_error="Only HTTP and HTTPS websites are supported"
    return 1
    ;;
  esac

  remainder=${candidate#*://}
  authority=${remainder%%[/?#]*}
  if [[ -z $authority ]]; then
    qvos_web_validation_error="Website hostname is missing"
    return 1
  fi

  if [[ $authority == *"@"* ]]; then
    qvos_web_validation_error="URLs with embedded credentials are not supported"
    return 1
  fi

  hostname=$authority
  if [[ $authority == *":"* ]]; then
    if [[ $authority == *":"*":"* ]]; then
      qvos_web_validation_error="IPv6 website addresses are not supported"
      return 1
    fi

    hostname=${authority%%:*}
    port=${authority#*:}
    if [[ ! $port =~ ^[0-9]{1,5}$ ]] || ((10#$port < 1 || 10#$port > 65535)); then
      qvos_web_validation_error="Website port must be between 1 and 65535"
      return 1
    fi
  fi

  if ! qvos_web_is_valid_hostname "$hostname"; then
    qvos_web_validation_error="Enter a valid ASCII hostname"
    return 1
  fi
}
