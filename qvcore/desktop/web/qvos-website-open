#!/bin/bash
set -euo pipefail

# Normalize and open a website through the Omarchy web-app launcher.

LC_ALL=C
MAX_URL_LENGTH=2048

notify_error() {
  local message="$1"

  notify-send -u critical "Open website" "$message" >/dev/null 2>&1 || true
  printf 'qvos-website-open: %s\n' "$message" >&2
}

cmd_present() {
  local command_name="$1"

  if command -v qv-cmd-present >/dev/null 2>&1; then
    qv-cmd-present "$command_name"
  else
    command -v "$command_name" >/dev/null 2>&1
  fi
}

is_valid_ipv4() {
  local hostname="$1"
  local octet
  local -a octets

  [[ $hostname =~ ^[0-9]+(\.[0-9]+){3}$ ]] || return 1
  IFS="." read -r -a octets <<<"$hostname"
  ((${#octets[@]} == 4)) || return 1

  for octet in "${octets[@]}"; do
    ((${#octet} <= 3 && 10#$octet <= 255)) || return 1
  done
}

is_valid_hostname() {
  local hostname="${1,,}"
  local label
  local -a labels

  ((0 < ${#hostname} && ${#hostname} <= 253)) || return 1

  if [[ $hostname =~ ^[0-9.]+$ && $hostname == *.* ]]; then
    is_valid_ipv4 "$hostname"
    return
  fi

  [[ $hostname =~ ^[a-z0-9.-]+$ ]] || return 1
  [[ $hostname != .* && $hostname != *. && $hostname != *..* ]] || return 1

  IFS="." read -r -a labels <<<"$hostname"
  for label in "${labels[@]}"; do
    ((0 < ${#label} && ${#label} <= 63)) || return 1
    [[ $label =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || return 1
  done
}

has_explicit_tld() {
  local hostname="$1"
  local tld="${hostname##*.}"

  [[ $hostname != "$tld" ]] || return 1
  [[ $tld =~ ^[a-z]{2}$ ]] && return 0

  case $tld in
  com | net | org | edu | gov | mil | int | io | ai | app | dev | me | co | tv | info | biz | name | pro | mobi | xyz | online | site | tech | store | cloud | shop | blog)
    return 0
    ;;
  *)
    return 1
    ;;
  esac
}

validate_url() {
  local candidate="$1"
  local remainder authority hostname port

  validation_error=""

  if ((${#candidate} > MAX_URL_LENGTH)); then
    validation_error="Website must be $MAX_URL_LENGTH characters or fewer"
    return 1
  fi

  if [[ $candidate == *[![:print:]]* ]]; then
    validation_error="Use printable ASCII characters and Punycode hostnames"
    return 1
  fi

  if [[ $candidate == *[[:space:]]* ]]; then
    validation_error="Website cannot contain spaces"
    return 1
  fi

  if [[ $candidate != "https://"* ]]; then
    validation_error="Website must use HTTPS"
    return 1
  fi

  remainder="${candidate#https://}"
  authority="${remainder%%[/?#]*}"
  if [[ -z $authority ]]; then
    validation_error="Website hostname is missing"
    return 1
  fi

  if [[ $authority == *"@"* ]]; then
    validation_error="URLs with embedded credentials are not supported"
    return 1
  fi

  hostname="$authority"
  if [[ $authority == *":"* ]]; then
    if [[ $authority == *":"*":"* ]]; then
      validation_error="IPv6 website addresses are not supported"
      return 1
    fi

    hostname="${authority%%:*}"
    port="${authority#*:}"
    if [[ ! $port =~ ^[0-9]{1,5}$ ]] || ((10#$port < 1 || 10#$port > 65535)); then
      validation_error="Website port must be between 1 and 65535"
      return 1
    fi
  fi

  if ! is_valid_hostname "$hostname"; then
    validation_error="Enter a valid ASCII hostname"
    return 1
  fi
}

is_sensitive_parameter() {
  local key="$1"

  case $key in
  access_token | api_key | apikey | auth | authorization | client_id | client_secret | code | code_challenge | code_challenge_method | expires | expiry | hmac | jwt | key | key-pair-id | nonce | oauth_* | passcode | password | payment_intent | payment_intent_client_secret | policy | redirect_uri | reset_token | response_type | saml* | scope | session | session_id | sessionid | sig | signature | state | token | verification_token | x-amz-* | x-goog-*)
    return 0
    ;;
  *)
    return 1
    ;;
  esac
}

is_tracking_parameter() {
  local key="$1"

  case $key in
  _ga | _gl | dclid | fbclid | gclid | mc_cid | mc_eid | msclkid | utm_*)
    return 0
    ;;
  *)
    return 1
    ;;
  esac
}

contains_sensitive_parameters() {
  local field key
  local -a fields

  IFS="&" read -r -a fields <<<"$1"
  for field in "${fields[@]}"; do
    key="${field%%=*}"
    key="${key,,}"
    is_sensitive_parameter "$key" && return 0
  done

  return 1
}

clean_tracking_parameters() {
  local candidate="$1"
  local without_fragment="$candidate"
  local fragment="" fragment_fields="" base query parameter key kept_query=""
  local kept_count=0
  local -a parameters

  cleaned_url="$candidate"

  if [[ $candidate == *"#"* ]]; then
    without_fragment="${candidate%%#*}"
    fragment="#${candidate#*#}"
  fi

  [[ $without_fragment == *"?"* ]] || return 0
  base="${without_fragment%%\?*}"
  query="${without_fragment#*\?}"
  IFS="&" read -r -a parameters <<<"$query"

  contains_sensitive_parameters "$query" && return 0

  if [[ -n $fragment ]]; then
    fragment_fields="${fragment#\#}"
    [[ $fragment_fields == *"?"* ]] && fragment_fields="${fragment_fields#*\?}"
    contains_sensitive_parameters "$fragment_fields" && return 0
  fi

  for parameter in "${parameters[@]}"; do
    key="${parameter%%=*}"
    key="${key,,}"
    is_tracking_parameter "$key" && continue

    if ((kept_count == 0)); then
      kept_query="$parameter"
    else
      kept_query+="&$parameter"
    fi
    ((kept_count += 1))
  done

  cleaned_url="$base"
  ((kept_count > 0)) && cleaned_url+="?$kept_query"
  cleaned_url+="$fragment"
}

if (($# > 1)); then
  printf 'Usage: qvos-website-open [url]\n' >&2
  exit 2
fi

url="${1:-}"

if [[ -z $url ]]; then
  if ! cmd_present qv-menu-input; then
    notify_error "Website prompt is unavailable"
    exit 1
  fi

  url="$(qv-menu-input "Website or link" --width 520)"
fi

url="${url#"${url%%[![:space:]]*}"}"
url="${url%"${url##*[![:space:]]}"}"
if [[ -z $url ]]; then
  exit 0
fi

if ((${#url} > MAX_URL_LENGTH)); then
  notify_error "Website must be $MAX_URL_LENGTH characters or fewer"
  exit 1
fi

if [[ $url == *[![:print:]]* ]]; then
  notify_error "Use printable ASCII characters and Punycode hostnames"
  exit 1
fi

if [[ $url == "http://"* ]]; then
  url="https://${url#http://}"
elif [[ $url == "https://"* ]]; then
  :
elif [[ $url == *"://"* ]]; then
  notify_error "Only HTTP and HTTPS websites are supported"
  exit 1
else
  hostname="${url%%[/?#]*}"
  suffix="${url#"$hostname"}"
  hostname="${hostname,,}"

  if ! is_valid_hostname "$hostname"; then
    notify_error "Enter a valid ASCII website name without spaces"
    exit 1
  fi

  if is_valid_ipv4 "$hostname"; then
    :
  elif ! has_explicit_tld "$hostname"; then
    if [[ $hostname == *.* ]]; then
      hostname="$hostname.com"
    else
      hostname="www.$hostname.com"
    fi
  elif [[ $hostname != "www."* && $hostname != *.*.* ]]; then
    hostname="www.$hostname"
  fi

  url="https://$hostname$suffix"
fi

if ! validate_url "$url"; then
  notify_error "$validation_error"
  exit 1
fi

clean_tracking_parameters "$url"
url="$cleaned_url"

if ! validate_url "$url"; then
  notify_error "$validation_error"
  exit 1
fi

if ! cmd_present omarchy-launch-webapp; then
  notify_error "Web-app launcher is unavailable"
  exit 1
fi

exec omarchy-launch-webapp "$url"
