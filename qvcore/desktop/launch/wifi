#!/bin/bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=qvcore/desktop/launch/lib
source "$script_dir/lib"

(($# == 0)) || {
  echo "Usage: qv launch wifi" >&2
  exit 2
}
qvos_launch_require impala rfkill
if ! rfkill unblock wifi; then
  echo "qvOS launch could not unblock Wi-Fi; opening its controls anyway." >&2
fi
exec "$script_dir/or-focus-tui" impala
