#!/bin/bash
set -euo pipefail

# qvos:contract=bin/qv-launch-app

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=qvcore/desktop/launch/lib
source "$script_dir/lib"

(($# > 0)) || {
  echo "Usage: qv launch or focus <window-pattern> [command [args...]]" >&2
  exit 2
}
pattern=$1
shift
if (($# == 0)); then
  set -- qv-launch-app -- "$pattern"
fi
qvos_launch_focus_or_run "$pattern" "$@"
