#!/bin/bash
set -euo pipefail

# qvos:contract=qvcore/controls/brightness

(($# == 0)) || {
  echo "Usage: qv system wake" >&2
  exit 2
}

desktop_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
controls_root=$(cd -- "$desktop_root/../controls" && pwd)
status=0

"$controls_root/brightness/display" on || status=1
"$controls_root/brightness/keyboard" restore || status=1

((status == 0))
