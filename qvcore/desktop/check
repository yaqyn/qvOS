#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/desktop/native-paths"
runtime_manifest="$root/qvcore/desktop/runtime-paths"
restart_root="$root/qvcore/desktop/restart"

fail() {
  printf 'qvOS desktop check: %s\n' "$1" >&2
  exit 1
}

mapfile -t native_paths < <(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest")
[[ $(printf '%s\n' "${native_paths[@]}" | sort -u) == $(printf '%s\n' "${native_paths[@]}") ]] ||
  fail "native desktop paths are not sorted and unique"

expected_runtime_paths=$'context/qvos-active-location\ncontext/qvos-launch-editor-here\ncontext/qvos-launch-terminal-here\nhyprland/qvos-toggle-special-window\nopen\nweb/qvos-localhost-open\nweb/qvos-website-open'
runtime_paths=$(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$runtime_manifest")
[[ $runtime_paths == "$expected_runtime_paths" ]] ||
  fail "desktop runtime payload inventory is incomplete or unordered"
while IFS= read -r runtime_path; do
  [[ -x $root/qvcore/desktop/$runtime_path && ! -L $root/qvcore/desktop/$runtime_path ]] ||
    fail "desktop runtime payload is unavailable or unsafe: $runtime_path"
done <<<"$runtime_paths"

declare -A helper_owners=(
  [hyprland-monitor-focused]=hyprland/focused-monitor
  [hyprland-monitor-focused-apple]=hyprland/focused-monitor-apple
  [hyprland-monitor-scaling-cycle]=hyprland/monitor-scaling-cycle
  [hyprland-monitor-watch]=hyprland/monitor-watch
  [hyprland-window-close-all]=hyprland/window-close-all
  [hyprland-window-gaps-toggle]=hyprland/window-gaps-toggle
  [hyprland-window-pop]=hyprland/window-pop
  [hyprland-window-single-square-aspect-toggle]=hyprland/window-single-square-aspect-toggle
  [hyprland-window-transparency-toggle]=hyprland/window-transparency-toggle
  [hyprland-workspace-layout-toggle]=hyprland/workspace-layout-toggle
  [launch-about]=launch/about
  [launch-audio]=launch/audio
  [launch-bluetooth]=launch/bluetooth
  [launch-browser]=launch/browser
  [launch-editor]=launch/editor
  [launch-or-focus]=launch/or-focus
  [launch-or-focus-tui]=launch/or-focus-tui
  [launch-or-focus-webapp]=launch/or-focus-webapp
  [launch-tui]=launch/tui
  [launch-webapp]=launch/webapp
  [launch-wifi]=launch/wifi
  [system-lock]=session/lock
  [system-logout]=session/logout
  [system-wake]=session/wake
)
for helper in "${!helper_owners[@]}"; do
  native_adapter="$root/bin/qv-$helper"
  compatibility_adapter="$root/bin/omarchy-$helper"
  owner="qvcore/desktop/${helper_owners[$helper]}"
  [[ -x $native_adapter && -x $compatibility_adapter && -x $root/$owner ]] ||
    fail "desktop helper owner or adapter is unavailable: $helper"
  (( $(wc -l <"$native_adapter") <= 12 )) ||
    fail "native desktop helper contains implementation: $helper"
  (( $(wc -l <"$compatibility_adapter") <= 6 )) ||
    fail "desktop helper compatibility adapter contains implementation: $helper"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native desktop helper lacks metadata: $helper"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "desktop helper compatibility adapter duplicates metadata: $helper"
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    grep -Fqx "exec \"\$QVOS_PATH/$owner\" \"\$@\"" "$adapter" ||
      fail "desktop helper adapter does not delegate directly: $helper"
  done
done
[[ -x $root/qvcore/desktop/session/logout-worker ]] ||
  fail "desktop logout worker is unavailable"
[[ -f $root/qvcore/desktop/launch/lib && ! -L $root/qvcore/desktop/launch/lib &&
  $(stat -c '%a' "$root/qvcore/desktop/launch/lib") == "644" ]] ||
  fail "desktop launch library is unavailable or unsafe"
[[ -f $root/qvcore/desktop/web/url-lib && ! -L $root/qvcore/desktop/web/url-lib &&
  $(stat -c '%a' "$root/qvcore/desktop/web/url-lib") == "644" ]] ||
  fail "desktop URL library is unavailable or unsafe"
if rg -n '\beval\b|bash[[:space:]]+-c[[:space:]]+.*\$' \
  "$root/qvcore/desktop/launch" --glob '!AGENTS.md'; then
  fail "desktop launch owner shell-parses caller input"
fi

while IFS= read -r inherited_path; do
  stem=${inherited_path##*/omarchy-restart-}
  owner="$restart_root/$stem"
  native_adapter="$root/bin/qv-restart-$stem"
  compatibility_adapter="$root/$inherited_path"
  [[ -x $owner && -x $native_adapter && -x $compatibility_adapter ]] ||
    fail "restart owner or adapter is unavailable: $stem"
  (($(wc -l <"$native_adapter") <= 14)) ||
    fail "native restart adapter contains implementation: $stem"
  (($(wc -l <"$compatibility_adapter") <= 8)) ||
    fail "restart compatibility adapter contains implementation: $stem"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native restart adapter lacks metadata: $stem"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "restart compatibility adapter duplicates metadata: $stem"
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    # shellcheck disable=SC2016
    grep -Fqx 'QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}' \
      "$adapter" ||
      fail "restart adapter lacks the source-root compatibility boundary: $stem"
    grep -Fqx "exec \"\$QVOS_PATH/qvcore/desktop/restart/$stem\" \"\$@\"" \
      "$adapter" ||
      fail "restart adapter does not delegate directly: $stem"
  done
done < <(printf '%s\n' "${native_paths[@]}" | grep '^bin/omarchy-restart-')

[[ -f $restart_root/process-lib && ! -L $restart_root/process-lib &&
  $(stat -c '%a' "$restart_root/process-lib") == "644" ]] ||
  fail "shared restart process library is unavailable or unsafe"
if rg -n '\b(pkill|killall)\b' "$restart_root" --glob '!process-lib'; then
  fail "restart owner bypasses the self-safe process helper"
fi

if rg -n 'omarchy-restart-' \
  "$root/qvcore" \
  --glob '!**/AGENTS.md' \
  --glob '!**/README.md' \
  --glob '!**/native-paths' \
  --glob '!**/owner-contracts.psv' \
  --glob '!**/desktop/check'; then
  fail "native qvOS source still calls a restart compatibility command"
fi
if rg -n 'omarchy-hyprland-monitor-focused' \
  "$root/qvcore" \
  --glob '!**/AGENTS.md' \
  --glob '!**/native-paths' \
  --glob '!**/owner-contracts.psv' \
  --glob '!**/desktop/check'; then
  fail "native qvOS source still calls a monitor-helper compatibility command"
fi
if rg -n 'omarchy-(hyprland-window-close-all|system-(lock|logout|wake))' \
  "$root/qvcore/config/files" \
  "$root/qvcore/menu" \
  "$root/qvcore/power" \
  "$root/config/hypr" \
  "$root/bin/omarchy-menu" \
  --glob '!**/AGENTS.md'; then
  fail "native qvOS source still calls a session compatibility command"
fi
if rg -n 'omarchy-hyprland-(monitor-scaling-cycle|window-gaps-toggle|window-pop|window-single-square-aspect-toggle|window-transparency-toggle|workspace-layout-toggle)' \
  "$root/qvcore/menu" \
  "$root/config/hypr" \
  "$root/bin/omarchy-menu" \
  --glob '!**/AGENTS.md'; then
  fail "native qvOS source still calls a Hyprland-control compatibility command"
fi
if rg -n 'omarchy-launch-(about|audio|bluetooth|browser|editor|or-focus|or-focus-tui|or-focus-webapp|tui|webapp|wifi)' \
  "$root/qvcore" \
  "$root/config/hypr" \
  "$root/config/waybar" \
  "$root/bin/omarchy-menu" \
  --glob '!**/AGENTS.md' \
  --glob '!**/desktop/check' \
  --glob '!**/native-paths' \
  --glob '!**/owner-contracts.psv' \
  --glob '!**/config/migrate-runtime-root' \
  --glob '!**/tui/task/selectable-owner'; then
  fail "native qvOS source still calls a launch compatibility command"
fi
grep -Fqx 'exec-once = uwsm-app -- omarchy-hyprland-monitor-watch' \
  "$root/default/hypr/autostart.conf" ||
  fail "inherited autostart no longer uses the retained monitor-watch compatibility seam"
if rg -n '\b(pkill|killall)\b' "$root/qvcore/desktop/session"; then
  fail "desktop session owner bypasses exact process matching"
fi
# shellcheck disable=SC2016
grep -Fq 'exec {cmdline_fd}<"/proc/$process/cmdline"' \
  "$root/qvcore/desktop/context/qvos-active-location" ||
  fail "desktop context lacks race-safe procfs access"

printf 'qvOS desktop runtime ownership check passed.\n'
