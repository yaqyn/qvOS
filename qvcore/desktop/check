#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/desktop/native-paths"
retired_manifest="$root/qvcore/desktop/retired-paths"
runtime_manifest="$root/qvcore/desktop/runtime-paths"
restart_root="$root/qvcore/desktop/restart"

fail() {
  printf 'qvOS desktop check: %s\n' "$1" >&2
  exit 1
}

mapfile -t native_paths < <(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest")
[[ $(printf '%s\n' "${native_paths[@]}" | sort -u) == $(printf '%s\n' "${native_paths[@]}") ]] ||
  fail "native desktop paths are not sorted and unique"

expected_runtime_paths=$'context/qvos-active-location\ncontext/qvos-launch-editor-here\ncontext/qvos-launch-terminal-here\nhyprland/qvos-runtime-config\nhyprland/qvos-toggle-special-window\nopen\nweb/qvos-localhost-open\nweb/qvos-website-open'
runtime_paths=$(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$runtime_manifest")
[[ $runtime_paths == "$expected_runtime_paths" ]] ||
  fail "desktop runtime payload inventory is incomplete or unordered"
while IFS= read -r runtime_path; do
  [[ -x $root/qvcore/desktop/$runtime_path && ! -L $root/qvcore/desktop/$runtime_path ]] ||
    fail "desktop runtime payload is unavailable or unsafe: $runtime_path"
done <<<"$runtime_paths"

declare -A helper_owners=(
  [hyprland-monitor-focused]=hyprland/focused-monitor
  [hyprland-monitor-focused-apple]=hyprland/focused-monitor-apple
  [hyprland-monitor-scaling-cycle]=hyprland/monitor-scaling-cycle
  [hyprland-monitor-watch]=hyprland/monitor-watch
  [hyprland-window-close-all]=hyprland/window-close-all
  [hyprland-window-gaps-toggle]=hyprland/window-gaps-toggle
  [hyprland-window-pop]=hyprland/window-pop
  [hyprland-window-single-square-aspect-toggle]=hyprland/window-single-square-aspect-toggle
  [hyprland-window-transparency-toggle]=hyprland/window-transparency-toggle
  [hyprland-workspace-layout-toggle]=hyprland/workspace-layout-toggle
  [launch-about]=launch/about
  [launch-audio]=launch/audio
  [launch-bluetooth]=launch/bluetooth
  [launch-browser]=launch/browser
  [launch-editor]=launch/editor
  [launch-or-focus]=launch/or-focus
  [launch-or-focus-tui]=launch/or-focus-tui
  [launch-or-focus-webapp]=launch/or-focus-webapp
  [launch-tui]=launch/tui
  [launch-webapp]=launch/webapp
  [launch-wifi]=launch/wifi
  [system-lock]=session/lock
  [system-logout]=session/logout
  [system-wake]=session/wake
  [toggle-idle]=session/toggle-idle
  [toggle-nightlight]=session/toggle-nightlight
  [webapp-install]=webapp/install
  [webapp-remove]=webapp/remove
)
for helper in "${!helper_owners[@]}"; do
  native_adapter="$root/bin/qv-$helper"
  compatibility_adapter="$root/bin/omarchy-$helper"
  owner="qvcore/desktop/${helper_owners[$helper]}"
  [[ -x $native_adapter && -x $compatibility_adapter && -x $root/$owner ]] ||
    fail "desktop helper owner or adapter is unavailable: $helper"
  (( $(wc -l <"$native_adapter") <= 12 )) ||
    fail "native desktop helper contains implementation: $helper"
  (( $(wc -l <"$compatibility_adapter") <= 6 )) ||
    fail "desktop helper compatibility adapter contains implementation: $helper"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native desktop helper lacks metadata: $helper"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "desktop helper compatibility adapter duplicates metadata: $helper"
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    grep -Fqx "exec \"\$QVOS_PATH/$owner\" \"\$@\"" "$adapter" ||
      fail "desktop helper adapter does not delegate directly: $helper"
  done
done
if rg -n 'OMARCHY_LOCK_ONLY' "$root/qvcore/desktop" \
  --glob '!AGENTS.md' --glob '!check'; then
  fail "desktop owner accepts an inherited lock environment"
fi
[[ -x $root/qvcore/desktop/session/logout-worker ]] ||
  fail "desktop logout worker is unavailable"
[[ -f $root/qvcore/desktop/launch/lib && ! -L $root/qvcore/desktop/launch/lib &&
  $(stat -c '%a' "$root/qvcore/desktop/launch/lib") == "644" ]] ||
  fail "desktop launch library is unavailable or unsafe"
[[ -f $root/qvcore/desktop/web/url-lib && ! -L $root/qvcore/desktop/web/url-lib &&
  $(stat -c '%a' "$root/qvcore/desktop/web/url-lib") == "644" ]] ||
  fail "desktop URL library is unavailable or unsafe"
[[ -f $root/qvcore/desktop/webapp/lib && ! -L $root/qvcore/desktop/webapp/lib &&
  $(stat -c '%a' "$root/qvcore/desktop/webapp/lib") == "644" ]] ||
  fail "desktop Web App library is unavailable or unsafe"
for adapter in "$root/bin/qv-webapp-remove-all" "$root/bin/omarchy-webapp-remove-all"; do
  [[ -x $adapter ]] || fail "Web App remove-all adapter is unavailable"
  (($(wc -l <"$adapter") <= 8)) ||
    fail "Web App remove-all adapter contains implementation"
  # shellcheck disable=SC2016
  grep -Fqx 'exec "$QVOS_PATH/qvcore/desktop/webapp/remove" --all "$@"' \
    "$adapter" || fail "Web App remove-all adapter does not delegate directly"
done
rg -q '^# qv:summary=' "$root/bin/qv-webapp-remove-all" ||
  fail "native Web App remove-all adapter lacks metadata"
! rg -q '^# (qv|omarchy):' "$root/bin/omarchy-webapp-remove-all" ||
  fail "Web App remove-all compatibility adapter duplicates metadata"
if rg -n '\beval\b|bash[[:space:]]+-c[[:space:]]+.*\$' \
  "$root/qvcore/desktop/launch" --glob '!AGENTS.md'; then
  fail "desktop launch owner shell-parses caller input"
fi
runtime_config="$root/qvcore/desktop/hyprland/qvos-runtime-config"
for mode in config device monitor window workspace-layout; do
  grep -Fqx "$mode)" "$runtime_config" ||
    fail "Hyprland runtime config mode is missing: $mode"
done
runtime_eval_call="hyprctl eval \"\$expression\""
[[ $(grep -Fc "$runtime_eval_call" "$runtime_config") == 1 ]] ||
  fail "Hyprland runtime config bypasses its bounded Lua evaluator"
runtime_dispatch_call="hyprctl dispatch \"\$expression\""
[[ $(grep -Fc "$runtime_dispatch_call" "$runtime_config") == 1 ]] ||
  fail "Hyprland runtime config bypasses its bounded Lua dispatcher"

while IFS= read -r inherited_path; do
  stem=${inherited_path##*/omarchy-restart-}
  owner="$restart_root/$stem"
  native_adapter="$root/bin/qv-restart-$stem"
  compatibility_adapter="$root/$inherited_path"
  [[ -x $owner && -x $native_adapter && -x $compatibility_adapter ]] ||
    fail "restart owner or adapter is unavailable: $stem"
  (($(wc -l <"$native_adapter") <= 14)) ||
    fail "native restart adapter contains implementation: $stem"
  (($(wc -l <"$compatibility_adapter") <= 8)) ||
    fail "restart compatibility adapter contains implementation: $stem"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native restart adapter lacks metadata: $stem"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "restart compatibility adapter duplicates metadata: $stem"
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    # shellcheck disable=SC2016
    grep -Fqx 'QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}' \
      "$adapter" ||
      fail "restart adapter lacks the native source-root boundary: $stem"
    grep -Fqx "exec \"\$QVOS_PATH/qvcore/desktop/restart/$stem\" \"\$@\"" \
      "$adapter" ||
      fail "restart adapter does not delegate directly: $stem"
  done
done < <(printf '%s\n' "${native_paths[@]}" | grep '^bin/omarchy-restart-')

[[ -f $restart_root/process-lib && ! -L $restart_root/process-lib &&
  $(stat -c '%a' "$restart_root/process-lib") == "644" ]] ||
  fail "shared restart process library is unavailable or unsafe"
[[ -f $restart_root/user-unit-lib && ! -L $restart_root/user-unit-lib &&
  $(stat -c '%a' "$restart_root/user-unit-lib") == "644" ]] ||
  fail "shared restart user-unit library is unavailable or unsafe"
[[ -x $restart_root/monitor-watch &&
  -x $root/bin/qv-restart-monitor-watch ]] ||
  fail "native monitor-watch restart owner is unavailable"
# shellcheck disable=SC2016
grep -Fqx 'exec "$QVOS_PATH/qvcore/desktop/restart/monitor-watch" "$@"' \
  "$root/bin/qv-restart-monitor-watch" ||
  fail "native monitor-watch restart adapter bypasses its owner"
rg -q '^# qv:summary=' "$root/bin/qv-restart-monitor-watch" ||
  fail "native monitor-watch restart adapter lacks metadata"
if rg -n '\b(pkill|killall)\b' "$restart_root" --glob '!process-lib'; then
  fail "restart owner bypasses the self-safe process helper"
fi

if rg -n 'omarchy-restart-' \
  "$root/qvcore" \
  --glob '!**/AGENTS.md' \
  --glob '!**/README.md' \
  --glob '!**/native-paths' \
  --glob '!**/owner-contracts.psv' \
  --glob '!**/desktop/check' \
  --glob '!**/menu/check' \
  --glob '!**/menu/install'; then
  fail "native qvOS source still calls a restart compatibility command"
fi
if rg -n 'omarchy-hyprland-monitor-focused' \
  "$root/qvcore" \
  --glob '!**/AGENTS.md' \
  --glob '!**/native-paths' \
  --glob '!**/owner-contracts.psv' \
  --glob '!**/desktop/check'; then
  fail "native qvOS source still calls a monitor-helper compatibility command"
fi
if rg -n 'omarchy-(hyprland-window-close-all|system-(lock|logout|wake))' \
  "$root/qvcore/config/files" \
  "$root/qvcore/menu" \
  "$root/qvcore/power" \
  "$root/qvcore/config/files/hypr" \
  --glob '!**/AGENTS.md'; then
  fail "native qvOS source still calls a session compatibility command"
fi
if rg -n 'omarchy-hyprland-(monitor-scaling-cycle|window-gaps-toggle|window-pop|window-single-square-aspect-toggle|window-transparency-toggle|workspace-layout-toggle)' \
  "$root/qvcore/menu" \
  "$root/qvcore/config/files/hypr" \
  --glob '!**/AGENTS.md'; then
  fail "native qvOS source still calls a Hyprland-control compatibility command"
fi
if rg -n 'omarchy-launch-(about|audio|bluetooth|browser|editor|or-focus|or-focus-tui|or-focus-webapp|tui|webapp|wifi)' \
  "$root/qvcore" \
  "$root/qvcore/config/files/hypr" \
  "$root/qvcore/config/files/waybar" \
  --glob '!**/AGENTS.md' \
  --glob '!**/desktop/check' \
  --glob '!**/native-paths' \
  --glob '!**/owner-contracts.psv' \
  --glob '!**/tui/task/selectable-owner' \
  --glob '!**/desktop/webapp/lib'; then
  fail "native qvOS source still calls a launch compatibility command"
fi
if rg -n 'omarchy-webapp-(install|remove(-all)?)' \
  "$root/qvcore" \
  --glob '!**/AGENTS.md' \
  --glob '!**/desktop/check' \
  --glob '!**/native-paths' \
  --glob '!**/owner-contracts.psv' \
  --glob '!**/desktop/webapp/lib' \
  --glob '!**/tui/task/selectable-owner'; then
  fail "native qvOS source still calls a Web App compatibility command"
fi
[[ ! -e $root/qvcore/desktop/webapp/migrate &&
  ! -L $root/qvcore/desktop/webapp/migrate ]] ||
  fail "pre-release Web App migration owner remains"
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == \
  $'applications/\nbin/omarchy-webapp-handler-hey\nbin/omarchy-webapp-handler-zoom' ]] ||
  fail "retired Web App handler inventory is incomplete"
[[ ! -e $root/applications && ! -L $root/applications ]] ||
  fail "retired inherited application payload remains"
[[ -x $root/qvcore/desktop/applications/install ]] ||
  fail "native fixed application owner is unavailable"
expected_application_files=$'Alacritty.desktop\nhidden/avahi-discover.desktop\nhidden/bssh.desktop\nhidden/btop.desktop\nhidden/bvnc.desktop\nhidden/cmake-gui.desktop\nhidden/cups.desktop\nhidden/dropbox.desktop\nhidden/electron34.desktop\nhidden/electron36.desktop\nhidden/electron37.desktop\nhidden/fcitx5-configtool.desktop\nhidden/fcitx5-wayland-launcher.desktop\nhidden/foot-server.desktop\nhidden/footclient.desktop\nhidden/java-java-openjdk.desktop\nhidden/jconsole-java-openjdk.desktop\nhidden/jshell-java-openjdk.desktop\nhidden/kbd-layout-viewer5.desktop\nhidden/kcm_fcitx5.desktop\nhidden/kcm_kaccounts.desktop\nhidden/kvantummanager.desktop\nhidden/limine-snapper-restore.desktop\nhidden/lstopo.desktop\nhidden/org.fcitx.Fcitx5.desktop\nhidden/org.fcitx.fcitx5-config-qt.desktop\nhidden/org.fcitx.fcitx5-migrator.desktop\nhidden/org.fcitx.fcitx5-qt5-gui-wrapper.desktop\nhidden/org.fcitx.fcitx5-qt6-gui-wrapper.desktop\nhidden/qv4l2.desktop\nhidden/qvidcap.desktop\nhidden/uuctl.desktop\nhidden/wiremix.desktop\nhidden/xgps.desktop\nhidden/xgpsspeed.desktop\nicons/imv.png\nimv.desktop\ninstall\nmpv.desktop'
actual_application_files=$(find "$root/qvcore/desktop/applications" -type f \
  -printf '%P\n' | sort)
[[ $actual_application_files == "$expected_application_files" ]] ||
  fail "fixed application source inventory changed"
expected_applications=$'Alacritty.desktop\nimv.desktop\nmpv.desktop'
actual_applications=$(find "$root/qvcore/desktop/applications" -maxdepth 1 \
  -type f -name '*.desktop' -printf '%f\n' | sort)
[[ $actual_applications == "$expected_applications" ]] ||
  fail "fixed desktop application inventory changed"
[[ $(find "$root/qvcore/desktop/applications/hidden" -maxdepth 1 \
  -type f -name '*.desktop' | wc -l) == 34 ]] ||
  fail "hidden desktop application inventory changed"
for hidden_entry in "$root"/qvcore/desktop/applications/hidden/*.desktop; do
  hidden_name=${hidden_entry##*/}
  hidden_name=${hidden_name%.desktop}
  [[ $(<"$hidden_entry") == \
    $'[Desktop Entry]\nType=Application\nName='"$hidden_name"$'\nHidden=true' ]] ||
    fail "invalid hidden desktop application entry: ${hidden_entry#"$root/"}"
done
[[ $(find "$root/qvcore/desktop/applications/icons" -maxdepth 1 \
  -type f -printf '%f\n') == "imv.png" ]] ||
  fail "fixed desktop icon inventory changed"
if rg -ni '(typora|https?://|--app=|(omarchy|qv)-(launch-webapp|webapp-handler))' \
  "$root/qvcore/desktop/applications" \
  --glob '*.desktop' --glob '*.png'; then
  fail "fresh fixed application payload contains a retired app or Web App"
fi
for handler in hey zoom; do
  for path in \
    "$root/bin/qv-webapp-handler-$handler" \
    "$root/bin/omarchy-webapp-handler-$handler" \
    "$root/qvcore/desktop/webapp/handler-$handler"; do
    [[ ! -e $path && ! -L $path ]] ||
      fail "retired service-specific Web App handler remains: ${path#"$root/"}"
  done
done
if rg -n 'qv-launch-webapp[[:space:]]+"https?://|uwsm-app -- Telegram -- "https?://' \
  "$root/qvcore/config/files/hypr/bindings.lua"; then
  fail "fresh qvOS contains fixed Web App destinations"
fi
grep -Fqx 'qv.autostart("qv-restart-monitor-watch")' \
  "$root/qvcore/config/base/hypr/autostart.lua" ||
  fail "native autostart bypasses the monitor-watch owner"
grep -Fqx 'qv.autostart("! qv-toggle-enabled waybar-off && qv-restart-waybar")' \
  "$root/qvcore/config/base/hypr/autostart.lua" ||
  fail "native autostart bypasses the Waybar lifecycle owner"
if rg -n '\b(pkill|killall)\b' "$root/qvcore/desktop/session"; then
  fail "desktop session owner bypasses exact process matching"
fi
if rg -n 'omarchy-toggle-(idle|nightlight)' \
  "$root/qvcore" "$root/qvcore/config/files" \
  --glob '!**/AGENTS.md' --glob '!**/check' \
  --glob '!**/native-paths' --glob '!**/owner-contracts.psv'; then
  fail "native qvOS source calls a desktop-toggle compatibility route"
fi
# shellcheck disable=SC2016
grep -Fq 'exec {cmdline_fd}<"/proc/$process/cmdline"' \
  "$root/qvcore/desktop/context/qvos-active-location" ||
  fail "desktop context lacks race-safe procfs access"

printf 'qvOS desktop runtime ownership check passed.\n'
