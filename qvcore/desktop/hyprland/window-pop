#!/bin/bash
set -euo pipefail

(($# <= 4)) || {
  echo "Usage: qv hyprland window pop [width height [x y]]" >&2
  exit 2
}
width=${1:-1300}
height=${2:-900}
x=${3:-}
y=${4:-}
[[ $width =~ ^[1-9][0-9]{0,4}$ && $height =~ ^[1-9][0-9]{0,4}$ ]] || {
  echo "Window width and height must be positive integers." >&2
  exit 2
}
((10#$width >= 100 && 10#$width <= 32768 &&
  10#$height >= 100 && 10#$height <= 32768)) || {
  echo "Window width and height must be between 100 and 32768 pixels." >&2
  exit 2
}
if [[ -n $x || -n $y ]]; then
  [[ -n $x && -n $y && $x =~ ^-?[0-9]{1,5}$ && $y =~ ^-?[0-9]{1,5}$ ]] || {
    echo "Window x and y positions must be supplied together as integers." >&2
    exit 2
  }
  for coordinate in "$x" "$y"; do
    magnitude=${coordinate#-}
    ((10#$magnitude <= 65535)) || {
      echo "Window positions must be between -65535 and 65535." >&2
      exit 2
    }
  done
fi

active_window=$(hyprctl activewindow -j) || {
  echo "Could not read the active Hyprland window." >&2
  exit 1
}
window_record=$(jq -er '
  if type == "object" and
    (.address | type) == "string" and
    (.address | test("^0x[0-9A-Fa-f]+$")) and
    .address != "0x0" and
    (.pinned | type) == "boolean"
  then [.address, (.pinned | tostring)] | @tsv
  else error("active window") end
' <<<"$active_window" 2>/dev/null) || {
  echo "No valid active Hyprland window was found." >&2
  exit 1
}
IFS=$'\t' read -r address pinned <<<"$window_record"
runtime_config="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/qvos-runtime-config"
if [[ -n $x ]]; then
  exec "$runtime_config" window pop "$address" "$pinned" "$width" "$height" "$x" "$y"
else
  exec "$runtime_config" window pop "$address" "$pinned" "$width" "$height"
fi
