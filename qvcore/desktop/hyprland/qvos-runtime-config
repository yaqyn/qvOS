#!/bin/bash
set -euo pipefail

fail() {
  printf 'qvOS Hyprland runtime config: %s\n' "$1" >&2
  exit "${2:-1}"
}

run_lua() {
  local expression=$1

  command -v hyprctl >/dev/null 2>&1 || fail "Hyprland control is unavailable"
  hyprctl eval "$expression" >/dev/null ||
    fail "Hyprland rejected the runtime configuration"
}

run_dispatch() {
  local expression=$1

  command -v hyprctl >/dev/null 2>&1 || fail "Hyprland control is unavailable"
  hyprctl dispatch "$expression" >/dev/null ||
    fail "Hyprland rejected the runtime window action"
}

case ${1:-} in
config)
  (($# == 4)) || fail "usage: qvos-runtime-config config <section> <key> <value>" 2
  section=$2
  key=$3
  value=$4
  case "$section.$key" in
  cursor.inactive_timeout)
    [[ $value =~ ^[0-9]+([.][0-9]+)?$ ]] || fail "invalid numeric value" 2
    awk -v value="$value" 'BEGIN { exit !(value >= 0 && value <= 86400) }' ||
      fail "cursor inactivity timeout is out of range" 2
    literal=$value
    ;;
  cursor.zoom_factor)
    [[ $value =~ ^[0-9]+([.][0-9]+)?$ ]] || fail "invalid numeric value" 2
    awk -v value="$value" 'BEGIN { exit !(value >= 1 && value <= 10) }' ||
      fail "cursor zoom factor is out of range" 2
    literal=$value
    ;;
  debug.suppress_errors)
    [[ $value == "true" || $value == "false" ]] || fail "invalid Boolean value" 2
    literal=$value
    ;;
  *) fail "unsupported setting: $section.$key" 2 ;;
  esac
  run_lua "hl.config({ $section = { $key = $literal } })"
  ;;
device)
  (($# == 3)) || fail "usage: qvos-runtime-config device <name> <true|false>" 2
  device=$2
  enabled=$3
  [[ $device =~ ^[[:alnum:]_.:-]+$ ]] || fail "invalid device name" 2
  [[ $enabled == "true" || $enabled == "false" ]] || fail "invalid device state" 2
  run_lua "hl.device({ name = \"$device\", enabled = $enabled })"
  ;;
monitor)
  (($# == 5)) || fail "usage: qvos-runtime-config monitor <output> <mode> <position> <scale>" 2
  output=$2
  mode=$3
  position=$4
  scale=$5
  [[ $output =~ ^[[:alnum:]_.:-]+$ ]] || fail "invalid monitor name" 2
  [[ $mode == "preferred" || $mode =~ ^[0-9]+x[0-9]+(@[0-9]+([.][0-9]+)?)?$ ]] ||
    fail "invalid monitor mode" 2
  [[ $position == "auto" || $position =~ ^-?[0-9]+x-?[0-9]+$ ]] ||
    fail "invalid monitor position" 2
  [[ $scale == "auto" || $scale =~ ^[0-9]+([.][0-9]+)?$ ]] ||
    fail "invalid monitor scale" 2
  if [[ $scale == "auto" ]]; then
    scale_literal='"auto"'
  else
    scale_literal=$scale
  fi
  run_lua "hl.monitor({ output = \"$output\", mode = \"$mode\", position = \"$position\", scale = $scale_literal })"
  ;;
window)
  (($# == 2)) || fail "usage: qvos-runtime-config window tiled" 2
  [[ $2 == "tiled" ]] || fail "unsupported window state: $2" 2
  run_dispatch 'hl.dsp.window.float({ action = "disable" })'
  ;;
workspace-layout)
  (($# == 3)) || fail "usage: qvos-runtime-config workspace-layout <workspace> <layout>" 2
  workspace=$2
  layout=$3
  [[ $workspace =~ ^[[:alnum:]_.:+/-]+$ ]] || fail "invalid workspace selector" 2
  [[ $layout == "dwindle" || $layout == "master" || $layout == "scrolling" ]] ||
    fail "invalid workspace layout" 2
  run_lua "hl.workspace_rule({ workspace = \"$workspace\", layout = \"$layout\" })"
  ;;
*)
  fail "usage: qvos-runtime-config {config|device|monitor|window|workspace-layout} ..." 2
  ;;
esac
