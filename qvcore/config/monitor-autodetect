#!/bin/bash
set -euo pipefail

monitor_config="$HOME/.config/hypr/monitors.lua"
monitor_config_dir=${monitor_config%/*}
reload_attempts=20
mode=${1:---apply}

fail() {
  printf 'qvOS display detection: %s\n' "$1" >&2
  exit 1
}

case $mode in
--apply)
  ;;
--restore-preflight)
  if [[ -L $monitor_config_dir || -L $monitor_config ]]; then
    fail "refusing to restore through a symbolic-link monitor config"
  fi
  exit 0
  ;;
*)
  fail "usage: monitor-autodetect [--apply|--restore-preflight]"
  ;;
esac

[[ -f $monitor_config ]] ||
  fail "the Hyprland monitor config is missing"

mapfile -t monitor_directives < <(
  grep -E '^[[:space:]]*hl\.monitor\(\{' "$monitor_config"
)

if ((${#monitor_directives[@]} != 1)) ||
  ! grep -Fqx '  output = "",' "$monitor_config" ||
  ! grep -Fqx '  mode = "preferred",' "$monitor_config" ||
  ! grep -Fqx '  position = "auto",' "$monitor_config" ||
  ! grep -Fqx '  scale = "auto",' "$monitor_config"; then
  printf 'Display configuration: Preserved custom layout\n'
  exit 0
fi

[[ ! -L $monitor_config ]] ||
  fail "refusing to update a symbolic-link monitor config"

command -v hyprctl >/dev/null 2>&1 ||
  fail "Hyprland control is unavailable"
command -v jq >/dev/null 2>&1 ||
  fail "JSON parsing is unavailable"

if ! hyprctl reload >/dev/null; then
  fail "Hyprland could not reload the restored configuration"
fi
if ! config_errors=$(hyprctl configerrors); then
  fail "Hyprland could not validate the restored configuration"
fi
[[ -z $config_errors ]] ||
  fail "Hyprland rejected the restored configuration: $config_errors"

monitor_record=""
for ((attempt = 0; attempt < reload_attempts; attempt++)); do
  if monitor_json=$(hyprctl monitors -j 2>/dev/null); then
    monitor_record=$(
      jq -er '
        (
          [.[] | select(
            .disabled != true and
            (.name | test("^(eDP|LVDS|DSI)-"))
          )][0] //
          [.[] | select(.disabled != true and .focused == true)][0] //
          [.[] | select(.disabled != true)][0]
        ) as $monitor |
        [
          $monitor.name,
          ($monitor.width | tostring),
          ($monitor.height | tostring),
          (
            $monitor.scale |
            tonumber |
            if . == floor then floor else . end |
            tostring
          )
        ] |
        @tsv
      ' <<<"$monitor_json" 2>/dev/null
    ) || true
  fi
  [[ -n $monitor_record ]] && break
  sleep 0.1
done
[[ -n $monitor_record ]] ||
  fail "Hyprland did not report an active display"

IFS=$'\t' read -r monitor_name monitor_width monitor_height monitor_scale \
  <<<"$monitor_record"
if [[ ! $monitor_scale =~ ^[0-9]+([.][0-9]+)?$ ]] ||
  ! jq -en --arg scale "$monitor_scale" \
    '($scale | tonumber) > 0' >/dev/null; then
  fail "Hyprland reported an invalid display scale"
fi

mapfile -t toolkit_scale_directives < <(
  grep -E \
    '^[[:space:]]*hl\.env\("GDK_SCALE",[[:space:]]*"[0-9]+([.][0-9]+)?"\)' \
    "$monitor_config"
)
if ((${#toolkit_scale_directives[@]} != 1)); then
  fail "the adaptive monitor config must have exactly one toolkit scale"
fi

original_config=$(mktemp)
trap 'rm -f -- "$original_config"' EXIT
cp -a -- "$monitor_config" "$original_config"

rollback_scale() {
  local rollback_errors

  cp -a -- "$original_config" "$monitor_config" || return 1
  hyprctl reload >/dev/null || return 1
  rollback_errors=$(hyprctl configerrors) || return 1
  [[ -z $rollback_errors ]]
}

fail_after_rollback() {
  local reason=$1

  if rollback_scale; then
    fail "$reason"
  else
    fail "$reason; the previous monitor config could not be restored"
  fi
}

sed -i -E \
  "s|^([[:space:]]*hl\\.env\\(\"GDK_SCALE\",[[:space:]]*)\"[0-9]+([.][0-9]+)?\"\\)|\\1\"$monitor_scale\")|" \
  "$monitor_config"

if ! hyprctl reload >/dev/null; then
  fail_after_rollback "Hyprland could not reload the detected display scale"
fi
if ! config_errors=$(hyprctl configerrors); then
  fail_after_rollback "Hyprland could not validate the detected display scale"
fi
if [[ -n $config_errors ]]; then
  fail_after_rollback \
    "Hyprland rejected the detected display scale: $config_errors"
fi

printf 'Display: %s - %sx%s\n' \
  "$monitor_name" \
  "$monitor_width" \
  "$monitor_height"
printf 'Scale: %sx\n' "$monitor_scale"
