#!/bin/bash
set -euo pipefail

battery_threshold=10
runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$UID}
[[ $runtime_dir == /* && -d $runtime_dir && ! -L $runtime_dir && -O $runtime_dir ]] || {
  echo "Refusing unsafe qvOS battery notification runtime: $runtime_dir" >&2
  exit 1
}
notification_flag="$runtime_dir/qvos-battery-notified"
legacy_notification_flag="$runtime_dir/omarchy_battery_notified"
power_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../power" && pwd)
battery_sample=$("$power_root/battery-info" sample)
IFS=$'\t' read -r battery_level battery_state <<<"$battery_sample"

[[ ! -L $notification_flag && ! -L $legacy_notification_flag ]] || {
  echo "Refusing unsafe qvOS battery notification state." >&2
  exit 1
}
for state_file in "$notification_flag" "$legacy_notification_flag"; do
  [[ ! -e $state_file || (-f $state_file && -O $state_file) ]] || {
    echo "Refusing unsafe qvOS battery notification state: $state_file" >&2
    exit 1
  }
done
if [[ -f $legacy_notification_flag ]]; then
  if [[ -e $notification_flag ]]; then
    rm -f -- "$legacy_notification_flag"
  else
    mv -- "$legacy_notification_flag" "$notification_flag"
  fi
fi
[[ ! -e $notification_flag ]] || chmod 0600 -- "$notification_flag"

send_notification() {
  local level=$1

  notify-send \
    -u critical \
    "󱐋 Time to recharge!" \
    "Battery is down to ${level}%" \
    -i battery-caution \
    -t 30000
  if ! qv-hook battery-low "$level"; then
    echo "qvOS battery monitor: a custom battery-low hook failed." >&2
  fi
}

if [[ $battery_level =~ ^[0-9]+$ ]] &&
  [[ $battery_state == "discharging" ]] &&
  (( battery_level <= battery_threshold )); then
  if [[ ! -f $notification_flag ]]; then
    send_notification "$battery_level"
    install -m 0600 /dev/null "$notification_flag"
  fi
else
  rm -f -- "$notification_flag" "$legacy_notification_flag"
fi
