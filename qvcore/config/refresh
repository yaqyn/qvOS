#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
if (($# != 1)); then
  printf 'Usage: qv refresh config <config-path>\n' >&2
  exit 2
fi

config_path=$1
[[ $config_path =~ ^[A-Za-z0-9][A-Za-z0-9@._/-]*$ &&
  $config_path != *..* ]] || {
  printf 'qvOS config refresh: invalid config path: %s\n' "$config_path" >&2
  exit 2
}

source_root="$QVOS_PATH/qvcore/config/files"
source_file="$source_root/$config_path"
target_file="$HOME/.config/$config_path"
target_dir=${target_file%/*}
backup_file=""
backup_suffix=0
staged_file=""

fail() {
  printf 'qvOS config refresh: %s\n' "$1" >&2
  exit "${2:-1}"
}

cleanup() {
  [[ -z $staged_file ]] || rm -f -- "$staged_file"
}
trap cleanup EXIT

if [[ ! -f $source_file || -L $source_file ]]; then
  fail "unknown config: $config_path" 2
fi
canonical_source_root=$(readlink -f -- "$source_root") ||
  fail "could not resolve the config source root"
canonical_source=$(readlink -f -- "$source_file") ||
  fail "could not resolve config: $config_path"
[[ $canonical_source == "$canonical_source_root/"* ]] ||
  fail "config escapes its source root: $config_path" 2

if [[ -e $target_file || -L $target_file ]]; then
  [[ -f $target_file || -L $target_file ]] ||
    fail "refusing non-file config target: $target_file"
  cmp -s "$source_file" "$target_file" && exit 0
fi

mkdir -p "$target_dir"
staged_file=$(mktemp "$target_dir/.qvos-refresh.XXXXXX")
install -m "$(stat -c '%a' -- "$source_file")" "$source_file" "$staged_file"

if [[ -e $target_file || -L $target_file ]]; then
  backup_file="$target_file.bak.$(date +%s)"
  while [[ -e $backup_file || -L $backup_file ]]; do
    ((backup_suffix += 1))
    backup_file="$target_file.bak.$(date +%s).$backup_suffix"
  done
  mv -- "$target_file" "$backup_file"
fi

if ! mv -- "$staged_file" "$target_file"; then
  if [[ -n $backup_file ]] && ! mv -- "$backup_file" "$target_file"; then
    fail "could not install $config_path or restore its backup"
  fi
  fail "could not install $config_path"
fi
staged_file=""
