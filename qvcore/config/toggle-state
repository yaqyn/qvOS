#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
local_root="$HOME/.local"
state_parent="$local_root/state"
qvos_state_root="$state_parent/qvos"
target_root="$qvos_state_root/toggles"
hypr_root="$target_root/hypr"
flags_source="$QVOS_PATH/qvcore/config/toggles/flags.lua"
flags_target="$hypr_root/flags.lua"

fail() {
  printf 'qvOS toggle state: %s\n' "$1" >&2
  exit 1
}

safe_directory() {
  [[ -d $1 && ! -L $1 && -O $1 ]]
}

ensure_directory() {
  local mode=$1
  local path=$2

  if [[ -e $path || -L $path ]]; then
    safe_directory "$path" || fail "refusing unsafe directory: $path"
  else
    install -d -m "$mode" "$path"
  fi
}

[[ -f $flags_source && ! -L $flags_source ]] ||
  fail "missing native toggle-state seed"

safe_directory "$HOME" || fail "refusing unsafe home directory: $HOME"
ensure_directory 0755 "$local_root"
ensure_directory 0700 "$state_parent"
ensure_directory 0700 "$qvos_state_root"
ensure_directory 0700 "$target_root"
ensure_directory 0700 "$hypr_root"

if [[ -e $flags_target || -L $flags_target ]]; then
  [[ -f $flags_target && ! -L $flags_target && -O $flags_target ]] ||
    fail "refusing unsafe toggle-state seed: $flags_target"
else
  install -m 0600 "$flags_source" "$flags_target"
fi

while IFS= read -r -d '' entry; do
  if [[ -d $entry ]]; then
    [[ ! -L $entry && -O $entry ]] || fail "refusing unsafe toggle directory: $entry"
    chmod 0700 -- "$entry"
  else
    [[ -f $entry && ! -L $entry && -O $entry ]] || fail "refusing unsafe toggle file: $entry"
    chmod 0600 -- "$entry"
  fi
done < <(find -P "$target_root" -print0)
