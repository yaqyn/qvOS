#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
bindings="$root/qvcore/config/files/hypr/bindings.lua"
hyprland="$root/qvcore/config/files/hypr/hyprland.lua"
input="$root/qvcore/config/files/hypr/input.lua"
base="$root/qvcore/config/base/hypr"
autostart="$base/autostart.lua"
windows="$base/windows.lua"
native_manifest="$root/qvcore/config/native-paths"
retired_manifest="$root/qvcore/config/retired-paths"
retired_hypr_manifest="$root/qvcore/config/retired-hypr-layer.psv"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

[[ ! -e $root/default/hypr && ! -L $root/default/hypr ]] ||
  fail "inherited Hyprland base remains"
[[ ! -e $root/config && ! -L $root/config ]] ||
  fail "retired top-level config source remains"
[[ ! -e $root/default/wireplumber && ! -L $root/default/wireplumber ]] ||
  fail "inherited WirePlumber defaults remain"
[[ ! -e $root/default/xcompose && ! -L $root/default/xcompose ]] ||
  fail "inherited XCompose default remains"
[[ ! -e $root/default/omarchy-skill && ! -L $root/default/omarchy-skill &&
  ! -e $root/default/pi && ! -L $root/default/pi ]] ||
  fail "inherited assistant configuration remains"
[[ ! -e $root/qvcore/config/files/hypr/qv.conf &&
  ! -L $root/qvcore/config/files/hypr/qv.conf &&
  ! -e $root/qvcore/config/files/hypr/qv &&
  ! -L $root/qvcore/config/files/hypr/qv ]] ||
  fail "retired qvOS Hyprland overlay remains"
[[ -f $bindings && ! -L $bindings ]] ||
  fail "native qvOS binding source is unavailable"
for name in autostart bindings envs hyprland input looknfeel monitors; do
  [[ -f $root/qvcore/config/files/hypr/$name.lua &&
    ! -L $root/qvcore/config/files/hypr/$name.lua &&
    ! -e $root/qvcore/config/files/hypr/$name.conf ]] ||
    fail "Hyprland user config format did not converge: $name"
done
[[ $(find "$base" -maxdepth 1 -type f -printf '%f\n' | sort) == \
  $'autostart.lua\nenvs.lua\nlooknfeel.lua\nruntime.lua\nwindows.lua' ]] ||
  fail "native Hyprland base inventory changed"
[[ ! -e $root/qvcore/config/files/systemd/user/omarchy-battery-monitor.service ]] ||
  fail "inherited battery monitor service remains"
[[ ! -e $root/qvcore/config/files/systemd/user/omarchy-battery-monitor.timer ]] ||
  fail "inherited battery monitor timer remains"
[[ ! -e $root/qvcore/config/files/omarchy &&
  ! -L $root/qvcore/config/files/omarchy ]] ||
  fail "inherited config namespace remains"
[[ -f $root/qvcore/config/files/qvos/extensions/menu.sh &&
  ! -L $root/qvcore/config/files/qvos/extensions/menu.sh ]] ||
  fail "native personal menu-extension source is unavailable"
[[ -f $root/qvcore/config/files/hypr/hypridle.conf &&
  ! -L $root/qvcore/config/files/hypr/hypridle.conf ]] ||
  fail "specialized native Hypridle source is unavailable"
for source_path in \
  xcompose \
  wireplumber/wireplumber.conf.d/alsa-soft-mixer.conf \
  wireplumber/wireplumber.conf.d/bluetooth-a2dp-autoconnect.conf; do
  [[ -f $root/qvcore/config/files/$source_path &&
    ! -L $root/qvcore/config/files/$source_path ]] ||
    fail "native desktop config source is unavailable: $source_path"
done
[[ $(<"$root/qvcore/config/files/autostart/org.fcitx.Fcitx5.desktop") == \
  $'[Desktop Entry]\nType=Application\nName=Fcitx 5\nHidden=true' ]] ||
  fail "Fcitx autostart suppressor is not a valid desktop entry"
grep -Fqx '<?xml version="1.0" encoding="UTF-8"?>' \
  "$root/qvcore/config/files/xfce4/xfconf/xfce-perchannel-xml/thunar.xml" ||
  fail "Thunar settings do not use the supported XML version"

[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$native_manifest") == $'bin/omarchy-battery-monitor\nbin/omarchy-hw-recover-internal-monitor\nbin/omarchy-hyprland-monitor-internal\nbin/omarchy-hyprland-monitor-internal-mirror\nbin/omarchy-hyprland-toggle\nbin/omarchy-hyprland-toggle-disabled\nbin/omarchy-hyprland-toggle-enabled\nbin/omarchy-refresh-config\nbin/omarchy-refresh-hypridle\nbin/omarchy-refresh-hyprland\nbin/omarchy-refresh-hyprlock\nbin/omarchy-refresh-hyprsunset\nbin/omarchy-refresh-swayosd\nbin/omarchy-toggle\nbin/omarchy-toggle-enabled\nbin/omarchy-toggle-touchpad\nbin/omarchy-toggle-touchscreen\nbin/omarchy-tz-select' ]] ||
  fail "native config inventory changed"
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == \
  $'config/\ndefault/hypr/\ndefault/omarchy-skill/\ndefault/pi/\ndefault/wireplumber/\ndefault/xcompose' ]] ||
  fail "retired config inventory changed"
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_hypr_manifest") == \
  $'qv.conf|51609b3bfb93e29350f57a527176b08c3c322d02b2d5b7cb8b583437a9849d0e\nqv/looknfeel.conf|200b286673249f4b340ba8b77b68718e7a1bc5a531e287d041618c1af8867f3a\nqv/windows.conf|588592b7f9bb36d46c963d80ab54bf01fbc79b0f2fd38cd75f4644c6f0d91a91' ]] ||
  fail "retired Hyprland payload policy changed"

[[ ! -e $root/qvcore/config/files/Typora && ! -L $root/qvcore/config/files/Typora ]] ||
  fail "retired Typora configuration source remains"
! rg -qi 'typora' "$windows" ||
  fail "fresh Hyprland configuration still loads Typora"

# shellcheck disable=SC2016
grep -Fqx '"$QVOS_PATH/qvcore/config/refresh" hypr/hypridle.conf' \
  "$root/qvcore/config/refresh-hypridle" ||
  fail "Hypridle refresh bypasses the singular native source"
if rg -n --glob '!**/AGENTS.md' --glob '!**/check' \
  -- '--owned|\$QVOS_PATH/config' \
  "$root/qvcore/config" "$root/qvcore/install"; then
  fail "alternate or retired config source selection remains"
fi
for installer_path in \
  config/xcompose.sh \
  config/hardware/asus/fix-audio-mixer.sh \
  config/hardware/bluetooth.sh; do
  if rg -n 'QVOS_PATH[^[:space:]]*default/(wireplumber|xcompose)' \
    "$root/qvcore/install/$installer_path"; then
    fail "desktop config installer reads a retired source: $installer_path"
  fi
done
grep -Fq 'qvcore/config/files/xcompose' \
  "$root/qvcore/install/config/xcompose.sh" ||
  fail "XCompose installer bypasses its native source"
[[ $(grep -Fc 'local/share/qvos/default/xcompose' \
  "$root/qvcore/install/config/xcompose.sh") == "1" ]] ||
  fail "XCompose installer has an unexpected inherited path surface"
[[ $(grep -Fc 'local/share/omarchy/default/xcompose' \
  "$root/qvcore/install/config/xcompose.sh") == "1" ]] ||
  fail "XCompose installer omits the original installed-root migration"

[[ $(grep -Fc 'require("~/.config/hypr/bindings.lua")' "$hyprland") == 1 ]] ||
  fail "native binding source is not included exactly once"
for source_path in runtime envs looknfeel windows autostart; do
  grep -Fqx \
    "require(\"~/.local/share/qvos/qvcore/config/base/hypr/$source_path.lua\")" \
    "$hyprland" || fail "native Hyprland base source: $source_path"
done
grep -Fqx 'require("~/.config/hypr/input.lua")' "$hyprland" ||
  fail "native user input source"
for wake_option in key_press_enables_dpms mouse_move_enables_dpms; do
  grep -Fqx "    $wake_option = true," "$input" ||
    fail "native input DPMS wake default: $wake_option"
done
if rg -q 'default/hypr|qvcore/bindings\.(conf|lua)|~/.config/hypr/qv(\.conf|/)' \
  "$hyprland"; then
  fail "retired Hyprland source or overlay remains active"
fi
if rg -q 'qv-launch-webapp[[:space:]]+"https?://|uwsm-app -- Telegram -- "https?://' \
  "$bindings"; then
  fail "fresh qvOS bindings contain fixed web-service destinations"
fi
if rg -qi 'https?://|youtube|discord|match:class .*\bzoom\b|Nautilus|davinci|jetbrains|1password|org\.omarchy\.(bluetui|impala|wiremix|btop|terminal|bash)' \
  "$windows"; then
  fail "retired service-specific window rules remain"
fi
grep -Fqx 'qv.window_rule("tag +floating-window", { class = [[^org\.qvos\.(bluetui|impala|wiremix|btop|terminal)$]] })' \
  "$windows" || fail "native terminal application identities"
grep -Fqx 'for workspace_id = 1, 5 do' "$windows" ||
  fail "native persistent workspace catalog"
grep -Fqx '  hl.workspace_rule({ workspace = tostring(workspace_id), persistent = true })' \
  "$windows" || fail "native persistent workspace policy"
for command in qv-toggle-enabled qv-powerprofiles-init qv-restart-monitor-watch; do
  grep -Fq "$command" "$autostart" ||
    fail "native autostart route: $command"
done
if rg -n 'qv\.autostart\(".*omarchy-' "$autostart"; then
  fail "native autostart calls a compatibility command"
fi

duplicate_bindings=$(
  sed -n 's/^qv\.bind({ keys = \[\[\([^]]*\)\]\].*/\1/p' "$bindings" |
    sort |
    uniq -d |
    grep -Fvx 'F9' || true
)
[[ -z $duplicate_bindings ]] || fail "duplicate modifier and key pairs: $duplicate_bindings"
[[ $(grep -Ec '^qv\.bind\(\{ keys = \[\[F9\]\], description = \[\[(Start|Stop) dictation \(push-to-talk\)\]\]' "$bindings") == 2 ]] ||
  fail "F9 press/release exception is incomplete"
if ! grep -Fq 'description = [[Stop dictation (push-to-talk)]]' "$bindings" ||
  ! grep -Fq 'release = true' "$bindings"; then
  fail "F9 release binding is incomplete"
fi

grep -Fq 'Description=qvOS Battery Monitor Check' \
  "$root/qvcore/config/files/systemd/user/qvos-battery-monitor.service" ||
  fail "native battery monitor service identity"
grep -Fq 'Description=qvOS Battery Monitor Timer' \
  "$root/qvcore/config/files/systemd/user/qvos-battery-monitor.timer" ||
  fail "native battery monitor timer identity"
grep -Fqx 'qv.require_optional_wildcard("~/.local/state/qvos/toggles/hypr/*.lua")' "$hyprland" ||
  fail "native toggle-state source"
grep -Fq 'if load_error == absent_error then' \
  "$base/runtime.lua" || fail "missing toggle state is not safely optional"
grep -Fq 'ExecStart=%h/.local/share/qvos/qvcore/config/battery-monitor' \
  "$root/qvcore/config/files/systemd/user/qvos-battery-monitor.service" ||
  fail "native battery monitor owner"
grep -Fq 'ExecStart=%h/.local/share/qvos/qvcore/config/recover-internal-monitor' \
  "$root/qvcore/config/files/systemd/user/qvos-recover-internal-monitor.service" ||
  fail "native monitor recovery owner"

config_routes=(
  battery-monitor:battery-monitor
  hw-recover-internal-monitor:recover-internal-monitor
  hyprland-monitor-internal:monitor-internal
  hyprland-monitor-internal-mirror:monitor-internal-mirror
  hyprland-toggle:hyprland-toggle
  hyprland-toggle-disabled:hyprland-toggle-disabled
  hyprland-toggle-enabled:hyprland-toggle-enabled
  refresh-config:refresh
  refresh-hypridle:refresh-hypridle
  refresh-hyprland:refresh-hyprland
  refresh-hyprlock:refresh-hyprlock
  refresh-hyprsunset:refresh-hyprsunset
  refresh-swayosd:refresh-swayosd
  toggle:toggle
  toggle-enabled:toggle-enabled
  toggle-touchpad:toggle-touchpad
  toggle-touchscreen:toggle-touchscreen
  tz-select:timezone
)
for mapping in "${config_routes[@]}"; do
  route=${mapping%%:*}
  owner=${mapping#*:}
  native_adapter="$root/bin/qv-$route"
  compatibility_adapter="$root/bin/omarchy-$route"
  [[ -x $native_adapter && -x $compatibility_adapter &&
    -x $root/qvcore/config/$owner ]] ||
    fail "config adapter or owner mode: $route"
  (( $(wc -l <"$native_adapter") <= 12 )) ||
    fail "native config adapter contains implementation: $route"
  (( $(wc -l <"$compatibility_adapter") <= 6 )) ||
    fail "config compatibility adapter contains implementation: $route"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native config adapter lacks metadata: $route"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "config compatibility adapter duplicates metadata: $route"
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    grep -Fqx "exec \"\$QVOS_PATH/qvcore/config/$owner\" \"\$@\"" \
      "$adapter" || fail "config adapter owner: $route"
  done
done
for owner in neovim toggle-state user-services; do
  [[ -x $root/qvcore/config/$owner ]] || fail "config lifecycle owner mode: $owner"
done
for retired_owner in \
  finalize-hyprland-lua \
  hyprland-conf-profiles.psv \
  migrate-hyprland-lua; do
  [[ ! -e $root/qvcore/config/$retired_owner &&
    ! -L $root/qvcore/config/$retired_owner ]] ||
    fail "pre-release Hyprland convergence owner remains: $retired_owner"
done
if [[ -d $root/qvcore/config/migration/hyprland ]] &&
  find -P "$root/qvcore/config/migration/hyprland" -mindepth 1 -print -quit |
    grep -q .; then
  fail "pre-release Hyprland migration payload remains"
fi
[[ -f $root/qvcore/config/user-systemd-lib &&
  ! -L $root/qvcore/config/user-systemd-lib ]] ||
  fail "shared user-manager probe"
grep -Fq 'systemctl --user show-environment' \
  "$root/qvcore/config/user-systemd-lib" || fail "read-only user-manager probe"
for consumer in \
  qvcore/config/user-services \
  qvcore/menu/install \
  qvcore/power/install \
  qvcore/thunar/install; do
  # shellcheck disable=SC2016
  grep -Fq 'source "$QVOS_PATH/qvcore/config/user-systemd-lib"' \
    "$root/$consumer" || fail "shared user-manager consumer: $consumer"
  grep -Fq 'qvos_user_manager_is_active' "$root/$consumer" ||
    fail "bounded user-manager access: $consumer"
done
"$root/qvcore/config/assistant/check" >/dev/null ||
  fail "native assistant integration contract"
if rg -n 'omarchy-nvim-(setup|refresh)' \
  "$root/qvcore" --glob '!**/AGENTS.md' --glob '!**/check'; then
  fail "qvOS retains the provider Neovim command as an internal owner"
fi

if rg -n 'omarchy-(battery-monitor|hw-recover-internal-monitor|hyprland-monitor-internal(-mirror)?|hyprland-toggle(-disabled|-enabled)?|refresh-(config|hypridle|hyprland|hyprlock|hyprsunset|swayosd)|toggle-enabled|toggle-touchpad|toggle-touchscreen|tz-select)' \
  "$root/qvcore/config" \
  "$root/qvcore/menu" \
  "$root/qvcore/power" \
  "$root/qvcore/screensaver" \
  "$root/qvcore/tui" \
  "$bindings" \
  "$root/qvcore/config/files/waybar/config.jsonc" \
  "$root/qvcore/install/reinstall-configs" \
  --glob '!**/AGENTS.md' \
  --glob '!**/check' \
  --glob '!**/migrate-runtime-root' \
  --glob '!**/native-paths' \
  --glob '!**/owner-contracts.psv' \
  --glob '!**/retired-paths' \
  --glob '!**/user-services'; then
  fail "native qvOS source still calls a config compatibility command"
fi

if rg -n '\.local/state/omarchy/toggles|default/hypr/toggles|omarchy-(battery-monitor|recover-internal-monitor)\.(service|timer)' \
  "$root/bin" \
  "$root/qvcore/config/files" \
  "$root/qvcore/config/battery-monitor" \
  "$root/qvcore/config/hyprland-toggle" \
  "$root/qvcore/config/hyprland-toggle-disabled" \
  "$root/qvcore/config/hyprland-toggle-enabled" \
  "$root/qvcore/config/monitor-internal" \
  "$root/qvcore/config/monitor-internal-mirror" \
  "$root/qvcore/config/recover-internal-monitor" \
  "$root/qvcore/config/toggle" \
  "$root/qvcore/config/toggle-enabled" \
  "$root/qvcore/config/toggle-lib" \
  "$root/qvcore/config/toggle-touchpad" \
  "$root/qvcore/config/toggle-touchscreen" \
  "$root/qvcore/config/toggles"; then
  fail "retired toggle or user-service identity remains active"
fi

grep -Fq 'timedatectl list-timezones' "$root/qvcore/config/timezone" ||
  fail "timezone owner does not validate the selected inventory"

printf 'ok - qvOS config has singular native bindings, commands, and user services\n'
