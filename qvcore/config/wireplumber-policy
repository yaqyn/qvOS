#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
lock_root="$HOME/.local/state/qvos/config-backups/refresh"
staging=""

fail() {
  printf 'qvOS WirePlumber policy: %s\n' "$1" >&2
  exit "${2:-1}"
}

usage() {
  echo "Usage: wireplumber-policy <asus-soft-mixer|bluetooth-a2dp>" >&2
  exit 2
}

case ${1:-} in
asus-soft-mixer)
  policy=alsa-soft-mixer.conf
  ;;
bluetooth-a2dp)
  policy=bluetooth-a2dp-autoconnect.conf
  ;;
*) usage ;;
esac
(($# == 1)) || usage

source_file="$QVOS_PATH/qvcore/config/files/wireplumber/wireplumber.conf.d/$policy"
target_dir="$HOME/.config/wireplumber/wireplumber.conf.d"
target_file="$target_dir/$policy"

cleanup() {
  [[ -z $staging ]] || rm -f -- "$staging"
}
trap cleanup EXIT

safe_owned_directory() {
  local mode

  [[ -d $1 && ! -L $1 && -O $1 ]] || return 1
  mode=$(stat -c '%a' -- "$1") || return 1
  (( (8#$mode & 022) == 0 ))
}

safe_owned_file() {
  local mode

  [[ -f $1 && ! -L $1 && -O $1 ]] || return 1
  mode=$(stat -c '%a' -- "$1") || return 1
  (( (8#$mode & 022) == 0 ))
}

ensure_directory() {
  local mode=$1
  local directory=$2

  if [[ -e $directory || -L $directory ]]; then
    safe_owned_directory "$directory" ||
      fail "refusing unsafe directory: $directory"
  else
    install -d -m "$mode" -- "$directory"
  fi
}

ensure_lock_root() {
  local directory
  local -a directories=(
    "$HOME/.local"
    "$HOME/.local/state"
    "$HOME/.local/state/qvos"
    "$HOME/.local/state/qvos/config-backups"
    "$lock_root"
  )

  safe_owned_directory "$HOME" ||
    fail "refusing unsafe home directory: $HOME"
  for directory in "${directories[@]}"; do
    ensure_directory 0700 "$directory"
  done
  chmod 0700 -- \
    "$HOME/.local/state/qvos" \
    "$HOME/.local/state/qvos/config-backups" \
    "$lock_root"
}

[[ -f $source_file && ! -L $source_file ]] ||
  fail "missing or unsafe policy source: $source_file"
ensure_lock_root
exec {config_lock_fd}>"$lock_root/.lock"
chmod 0600 -- "$lock_root/.lock"
flock "$config_lock_fd"

ensure_directory 0755 "$HOME/.config"
ensure_directory 0755 "$HOME/.config/wireplumber"
ensure_directory 0755 "$target_dir"

if [[ -e $target_file || -L $target_file ]]; then
  safe_owned_file "$target_file" ||
    fail "refusing unsafe policy target: $target_file"
  if cmp -s -- "$source_file" "$target_file"; then
    exit 0
  fi
  printf 'Preserving the existing WirePlumber policy: %s\n' "$target_file"
  exit 0
fi

staging=$(mktemp "$target_dir/.qvos-wireplumber.XXXXXX")
install -m 0644 -- "$source_file" "$staging"
mv -Tn -- "$staging" "$target_file"
if [[ -e $staging || -L $staging ]]; then
  rm -f -- "$staging"
  staging=""
  safe_owned_file "$target_file" ||
    fail "a concurrent process installed an unsafe policy target"
  cmp -s -- "$source_file" "$target_file" ||
    fail "a concurrent process installed a different policy target"
  exit 0
fi
staging=""
