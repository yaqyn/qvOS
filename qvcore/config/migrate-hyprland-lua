#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
config_root="$HOME/.config/hypr"
toggle_root="$HOME/.local/state/qvos/toggles/hypr"
backup_root="$HOME/.local/state/qvos/hyprland/legacy-conf"
profile_manifest="$QVOS_PATH/qvcore/config/hyprland-conf-profiles.psv"
profile_root="$QVOS_PATH/qvcore/config/migration/hyprland"
theme_name_path="$HOME/.config/qvos/current/theme.name"
legacy_theme_path="$HOME/.config/qvos/current/theme/hyprland.conf"
legacy_theme_backup="$backup_root/theme/hyprland.conf"
config_names=(autostart bindings envs hyprland input looknfeel monitors)
declare -A config_profiles=()
declare -A toggle_profiles=()
declare -A toggle_inputs=()
declare -A seen_profile_rows=()

fail() {
  printf 'qvOS Hyprland Lua migration: %s\n' "$1" >&2
  exit 1
}

safe_directory() {
  [[ -d $1 && ! -L $1 && -O $1 ]]
}

safe_file() {
  [[ -f $1 && ! -L $1 && -O $1 ]]
}

ensure_directory() {
  local mode=$1
  local path=$2

  if [[ -e $path || -L $path ]]; then
    safe_directory "$path" || fail "refusing unsafe directory: $path"
  else
    install -d -m "$mode" -- "$path"
  fi
}

file_hash() {
  local value

  value=$(sha256sum -- "$1")
  printf '%s\n' "${value%% *}"
}

profile_for() {
  local kind=$1
  local name=$2
  local hash=$3
  local row_kind
  local row_name
  local row_hash
  local row_profile
  local row_extra

  while IFS='|' read -r row_kind row_name row_hash row_profile row_extra; do
    [[ -n $row_kind && $row_kind != \#* ]] || continue
    [[ -z ${row_extra:-} && $row_kind =~ ^(config|toggle)$ &&
      $row_name =~ ^[a-z][a-z0-9-]*$ && $row_hash =~ ^[0-9a-f]{64}$ &&
      $row_profile =~ ^[a-z][a-z0-9-]*$ ]] ||
      fail "invalid compatibility profile row: $row_kind|$row_name"
    if [[ $row_kind == "$kind" && $row_name == "$name" &&
      $row_hash == "$hash" ]]; then
      printf '%s\n' "$row_profile"
      return 0
    fi
  done <"$profile_manifest"
  return 1
}

validate_profile_manifest() {
  local key
  local row_kind
  local row_name
  local row_hash
  local row_profile
  local row_extra

  while IFS='|' read -r row_kind row_name row_hash row_profile row_extra; do
    [[ -n $row_kind && $row_kind != \#* ]] || continue
    [[ -z ${row_extra:-} && $row_kind =~ ^(config|toggle)$ &&
      $row_name =~ ^[a-z][a-z0-9-]*$ && $row_hash =~ ^[0-9a-f]{64}$ &&
      $row_profile =~ ^[a-z][a-z0-9-]*$ ]] ||
      fail "invalid compatibility profile row: $row_kind|$row_name"
    key="$row_kind|$row_name|$row_hash"
    [[ -z ${seen_profile_rows[$key]:-} ]] ||
      fail "duplicate compatibility profile row: $key"
    seen_profile_rows[$key]=1
  done <"$profile_manifest"
}

profile_source() {
  local kind=$1
  local name=$2
  local profile=$3

  if [[ $kind == "toggle" ]]; then
    [[ $profile == "default" ]] || return 1
    printf '%s\n' "$QVOS_PATH/qvcore/config/toggles/$name.lua"
    return 0
  fi

  case "$name:$profile" in
  monitors:one-x)
    printf '%s\n' "$profile_root/monitors-one-x.lua"
    ;;
  envs:nvidia-maxwell)
    printf '%s\n' "$profile_root/envs-nvidia-maxwell.lua"
    ;;
  envs:nvidia-turing)
    printf '%s\n' "$profile_root/envs-nvidia-turing.lua"
    ;;
  *:default)
    printf '%s\n' "$QVOS_PATH/qvcore/config/files/hypr/$name.lua"
    ;;
  *) return 1 ;;
  esac
}

legacy_input() {
  local active=$1
  local backup=$2

  if [[ -e $active || -L $active ]]; then
    safe_file "$active" || fail "refusing unsafe legacy config: $active"
    printf '%s\n' "$active"
  elif [[ -e $backup || -L $backup ]]; then
    safe_file "$backup" || fail "refusing unsafe legacy backup: $backup"
    printf '%s\n' "$backup"
  else
    return 1
  fi
}

validate_target() {
  local expected=$1
  local target=$2

  [[ -e $target || -L $target ]] || return 0
  safe_file "$target" || fail "refusing unsafe Lua config: $target"
  cmp -s -- "$expected" "$target" ||
    fail "preserving unrecognized Lua config: $target"
}

backup_file() {
  local source=$1
  local target=$2

  if [[ -e $target || -L $target ]]; then
    safe_file "$target" || fail "refusing unsafe legacy backup: $target"
    cmp -s -- "$source" "$target" || fail "legacy backup conflict: $target"
    return 0
  fi
  install -D -m 0600 -- "$source" "$target"
}

publish_file() {
  local mode=$1
  local source=$2
  local target=$3
  local temporary

  if [[ -e $target || -L $target ]]; then
    validate_target "$source" "$target"
    chmod "$mode" -- "$target"
    return 0
  fi
  temporary=$(mktemp "${target%/*}/.qvos-hyprland-lua.XXXXXX")
  if ! install -m "$mode" -- "$source" "$temporary" ||
    ! mv -f -- "$temporary" "$target"; then
    rm -f -- "$temporary"
    return 1
  fi
}

retire_file() {
  local active=$1
  local backup=$2
  local label=$3

  [[ -e $active || -L $active ]] || return 0
  safe_file "$active" || fail "$label changed during migration: $active"
  safe_file "$backup" || fail "missing $label backup: $backup"
  cmp -s -- "$active" "$backup" || fail "$label changed during migration: $active"
  rm -f -- "$active"
}

[[ -f $profile_manifest && ! -L $profile_manifest ]] ||
  fail "missing compatibility profile manifest"
validate_profile_manifest
for path in \
  "$HOME" \
  "$HOME/.config" \
  "$config_root" \
  "$HOME/.local" \
  "$HOME/.local/state" \
  "$HOME/.local/state/qvos" \
  "$HOME/.local/state/qvos/hyprland" \
  "$backup_root" \
  "$backup_root/config" \
  "$backup_root/theme" \
  "$backup_root/toggles" \
  "$HOME/.local/state/qvos/toggles" \
  "$toggle_root"; do
  [[ ! -e $path && ! -L $path ]] || safe_directory "$path" ||
    fail "refusing unsafe directory: $path"
done
if [[ -e $legacy_theme_path || -L $legacy_theme_path ]]; then
  safe_file "$legacy_theme_path" || fail "refusing unsafe legacy theme config"
  if [[ -e $legacy_theme_backup || -L $legacy_theme_backup ]]; then
    safe_file "$legacy_theme_backup" || fail "refusing unsafe legacy theme backup"
    cmp -s -- "$legacy_theme_path" "$legacy_theme_backup" ||
      fail "legacy theme backup conflict: $legacy_theme_backup"
  fi
fi

# Resolve and validate the complete conversion before changing active files.
for name in "${config_names[@]}"; do
  active="$config_root/$name.conf"
  backup="$backup_root/config/$name.conf"
  input=$(legacy_input "$active" "$backup" || true)
  profile=default
  if [[ -n $input ]]; then
    hash=$(file_hash "$input")
    profile=$(profile_for config "$name" "$hash" || true)
    [[ -n $profile ]] || fail "preserving customized legacy config: $active"
  fi
  source=$(profile_source config "$name" "$profile") ||
    fail "unsupported replacement profile: $name:$profile"
  [[ -f $source && ! -L $source ]] || fail "missing Lua replacement: $source"
  validate_target "$source" "$config_root/$name.lua"
  config_profiles[$name]=$profile
done

if [[ -d $toggle_root ]]; then
  while IFS= read -r -d '' active; do
    safe_file "$active" || fail "refusing unsafe legacy toggle: $active"
    filename=${active##*/}
    name=${filename%.conf}
    [[ $name =~ ^[a-z][a-z0-9-]*$ ]] || fail "invalid legacy toggle name: $filename"
    hash=$(file_hash "$active")
    profile=$(profile_for toggle "$name" "$hash" || true)
    [[ -n $profile ]] || fail "preserving customized legacy toggle: $active"
    source=$(profile_source toggle "$name" "$profile") ||
      fail "unsupported toggle replacement: $name:$profile"
    [[ -f $source && ! -L $source ]] || fail "missing Lua toggle replacement: $source"
    validate_target "$source" "$toggle_root/$name.lua"
    toggle_profiles[$name]=$profile
    toggle_inputs[$name]=$active
  done < <(find -P "$toggle_root" -maxdepth 1 -type f -name '*.conf' -print0)
fi

if [[ -z ${toggle_profiles[flags]:-} ]]; then
  source="$QVOS_PATH/qvcore/config/toggles/flags.lua"
  validate_target "$source" "$toggle_root/flags.lua"
  toggle_profiles[flags]=default
fi

# Only create destination and backup directories after the complete preflight.
ensure_directory 0755 "$HOME/.config"
ensure_directory 0755 "$config_root"
ensure_directory 0755 "$HOME/.local"
ensure_directory 0700 "$HOME/.local/state"
ensure_directory 0700 "$HOME/.local/state/qvos"
ensure_directory 0700 "$HOME/.local/state/qvos/hyprland"
ensure_directory 0700 "$backup_root"
ensure_directory 0700 "$backup_root/config"
ensure_directory 0700 "$backup_root/theme"
ensure_directory 0700 "$backup_root/toggles"
ensure_directory 0700 "$HOME/.local/state/qvos/toggles"
ensure_directory 0700 "$toggle_root"

# Preserve exact legacy inputs before publishing any replacement.
for name in "${config_names[@]}"; do
  active="$config_root/$name.conf"
  [[ -e $active || -L $active ]] || continue
  backup_file "$active" "$backup_root/config/$name.conf"
done
for name in "${!toggle_inputs[@]}"; do
  backup_file "${toggle_inputs[$name]}" "$backup_root/toggles/$name.conf"
done
if [[ -e $legacy_theme_path || -L $legacy_theme_path ]]; then
  backup_file "$legacy_theme_path" "$legacy_theme_backup"
fi

# Publish all leaves except the entrypoint first.
for name in "${config_names[@]}"; do
  [[ $name == "hyprland" ]] && continue
  source=$(profile_source config "$name" "${config_profiles[$name]}")
  publish_file 0644 "$source" "$config_root/$name.lua"
done
for name in "${!toggle_profiles[@]}"; do
  source=$(profile_source toggle "$name" "${toggle_profiles[$name]}")
  publish_file 0600 "$source" "$toggle_root/$name.lua"
done

if [[ -e $theme_name_path || -L $theme_name_path ]]; then
  safe_file "$theme_name_path" || fail "refusing unsafe active theme name"
  theme_name=$(<"$theme_name_path")
else
  theme_name=Yaqyn
fi

# Refresh bundled theme input, but keep the already-active legacy theme leaf
# until the verified Lua entrypoint has replaced the old main config.
"$QVOS_PATH/qvcore/theme/install"
QVOS_THEME_SKIP_INTEGRATIONS=1 \
QVOS_THEME_RETAIN_LEGACY_HYPRLAND=1 \
  "$QVOS_PATH/qvcore/theme/set" "$theme_name"
source=$(profile_source config hyprland "${config_profiles[hyprland]}")

command -v Hyprland >/dev/null 2>&1 || fail "Hyprland is unavailable"
Hyprland --verify-config -c "$source" >/dev/null ||
  fail "the staged Lua configuration was rejected; legacy config remains active"
publish_file 0644 "$source" "$config_root/hyprland.lua"
Hyprland --verify-config -c "$config_root/hyprland.lua" >/dev/null ||
  fail "the published Lua configuration was rejected; legacy config remains active"

# Retire the old entrypoint before its theme fragment. Any interruption from
# here starts from the already-verified Lua tree; the fragment is then inert.
retire_file \
  "$config_root/hyprland.conf" \
  "$backup_root/config/hyprland.conf" \
  "legacy config"
retire_file "$legacy_theme_path" "$legacy_theme_backup" "legacy theme config"
Hyprland --verify-config -c "$config_root/hyprland.lua" >/dev/null ||
  fail "the final Lua configuration was rejected after retiring legacy theme state"

for name in "${config_names[@]}"; do
  [[ $name == "hyprland" ]] && continue
  active="$config_root/$name.conf"
  retire_file "$active" "$backup_root/config/$name.conf" "legacy config"
done
for name in "${!toggle_inputs[@]}"; do
  active=${toggle_inputs[$name]}
  retire_file "$active" "$backup_root/toggles/$name.conf" "legacy toggle"
done

printf 'Migrated Hyprland to native Lua; preserved legacy files under %s.\n' \
  "$backup_root"
printf 'The current desktop keeps its loaded settings; log in again to start from Lua.\n'
