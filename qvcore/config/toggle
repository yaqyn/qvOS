#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
# shellcheck source=qvcore/config/toggle-lib
source "$QVOS_PATH/qvcore/config/toggle-lib"

enabled_notification=""
disabled_notification=""

while (( $# > 1 )); do
  case $1 in
  --enabled-notification)
    (( $# >= 2 )) || exit 2
    enabled_notification=$2
    shift 2
    ;;
  --disabled-notification)
    (( $# >= 2 )) || exit 2
    disabled_notification=$2
    shift 2
    ;;
  *) break ;;
  esac
done

(( $# == 1 )) || {
  echo "Usage: qv toggle [--enabled-notification <text>] [--disabled-notification <text>] <flag-name>" >&2
  exit 2
}
flag_name=$1
qvos_toggle_validate_name "$flag_name" || {
  echo "Invalid qvOS toggle name: $flag_name" >&2
  exit 2
}
flag="$qvos_toggle_root/$flag_name"
qvos_toggle_lock
qvos_toggle_safe_file "$flag" || {
  echo "Refusing unsafe qvOS toggle file: $flag" >&2
  exit 1
}

if [[ -f $flag ]]; then
  qvos_toggle_remove "$flag"
  # shellcheck disable=SC2154
  if [[ -n $disabled_notification ]] &&
    ! notify-send -u low "$disabled_notification" {qvos_toggle_lock_fd}<&-; then
    echo "qvOS toggle changed, but its notification could not be shown." >&2
  fi
else
  qvos_toggle_write "$flag" </dev/null
  # shellcheck disable=SC2154
  if [[ -n $enabled_notification ]] &&
    ! notify-send -u low "$enabled_notification" {qvos_toggle_lock_fd}<&-; then
    echo "qvOS toggle changed, but its notification could not be shown." >&2
  fi
fi
