#!/bin/bash
set -euo pipefail

config_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
retired_qv_manifest="$config_dir/retired-hypr-layer.psv"
temporary=""
changed_files=0
uwsm_env="$HOME/.config/uwsm/env"
hyprland="$HOME/.config/hypr/hyprland.conf"
retire_qv_source=false

cleanup() {
  [[ -z $temporary ]] || rm -f -- "$temporary"
}
trap cleanup EXIT

validate_target_parent() {
  local target=$1
  local component
  local parent="$HOME"
  local relative
  local -a components=()

  [[ $target == "$HOME/"* && -d $HOME && ! -L $HOME && -O $HOME ]] ||
    return 1
  relative=${target#"$HOME/"}
  relative=${relative%/*}
  IFS=/ read -r -a components <<<"$relative"
  for component in "${components[@]}"; do
    [[ -n $component && $component != "." && $component != ".." ]] ||
      return 1
    parent+="/$component"
    [[ -d $parent && ! -L $parent && -O $parent ]] || return 1
  done
}

rewrite_literals() {
  local target=$1
  shift
  local -a old_literals=()
  local -a new_literals=()
  local backup
  local filtered
  local index
  local line

  [[ ! -e $target && ! -L $target ]] && return 0
  validate_target_parent "$target" || {
    echo "Refusing linked or foreign qvOS config parent: $target" >&2
    return 1
  }
  [[ -f $target && ! -L $target && -O $target ]] || {
    echo "Refusing unsafe qvOS runtime-root config: $target" >&2
    return 1
  }
  (($# > 0 && $# % 2 == 0)) || return 2
  while (($# > 0)); do
    old_literals+=("$1")
    new_literals+=("$2")
    shift 2
  done

  temporary=$(mktemp "$(dirname -- "$target")/.qvos-runtime-root.XXXXXX")
  while IFS= read -r line || [[ -n $line ]]; do
    for index in "${!old_literals[@]}"; do
      line=${line//"${old_literals[$index]}"/"${new_literals[$index]}"}
    done
    printf '%s\n' "$line"
  done <"$target" >"$temporary"

  if [[ $target == "$hyprland" ]]; then
    filtered=$(mktemp "$(dirname -- "$target")/.qvos-runtime-root.XXXXXX")
    awk '
      $0 == "source = ~/.config/hypr/input.conf" {
        if (input_source_seen) {
          next
        }
        input_source_seen = 1
      }
      { print }
    ' "$temporary" >"$filtered"
    mv -f -- "$filtered" "$temporary"
  fi

  if [[ $target == "$uwsm_env" ]]; then
    filtered=$(mktemp "$(dirname -- "$target")/.qvos-runtime-root.XXXXXX")
    awk '
      $0 == "# qvOS PATH begin" {
        buffering = 1
        count = 1
        lines[count] = $0
        next
      }
      buffering {
        lines[++count] = $0
        if ($0 == "# qvOS PATH end") {
          if (count != 3 || lines[2] != "export PATH=\"$HOME/.local/share/qvos/bin:$PATH\"") {
            for (line_number = 1; line_number <= count; line_number++) {
              print lines[line_number]
            }
          }
          delete lines
          buffering = 0
          count = 0
        }
        next
      }
      { print }
      END {
        if (buffering) {
          for (line_number = 1; line_number <= count; line_number++) {
            print lines[line_number]
          }
        }
      }
    ' "$temporary" >"$filtered"
    mv -f -- "$filtered" "$temporary"
  fi

  chmod --reference="$target" "$temporary"
  if cmp -s "$temporary" "$target"; then
    rm -f -- "$temporary"
    temporary=""
    return 0
  fi

  backup="$target.bak.$(date +%s%N)"
  cp -a -- "$target" "$backup"
  mv -f -- "$temporary" "$target"
  temporary=""
  ((changed_files += 1))
}

retire_stock_qv_layer() {
  local expected_hash
  local extra
  local installed_hash
  local relative
  local target
  local source_line='source = ~/.config/hypr/qv.conf'

  [[ -f $hyprland && ! -L $hyprland && -O $hyprland ]] || return 0
  grep -Fqx "$source_line" "$hyprland" || return 0
  [[ -f $retired_qv_manifest && ! -L $retired_qv_manifest ]] || {
    echo "Missing qvOS retired Hyprland manifest: $retired_qv_manifest" >&2
    return 1
  }

  while IFS='|' read -r relative expected_hash extra; do
    [[ -n $relative && $relative != \#* ]] || continue
    [[ -z ${extra:-} && $relative =~ ^qv(\.conf|/[a-z]+\.conf)$ &&
      $expected_hash =~ ^[0-9a-f]{64}$ ]] || {
      echo "Invalid qvOS retired Hyprland manifest row: $relative" >&2
      return 1
    }
    target="$HOME/.config/hypr/$relative"
    [[ ! -e $target && ! -L $target ]] && continue
    if ! validate_target_parent "$target"; then
      printf 'Preserving the custom qvOS Hyprland layer: %s\n' "$target" >&2
      return 0
    fi
    if [[ ! -f $target || -L $target || ! -O $target ]]; then
      printf 'Preserving the custom qvOS Hyprland layer: %s\n' "$target" >&2
      return 0
    fi
    installed_hash=$(sha256sum -- "$target")
    installed_hash=${installed_hash%% *}
    if [[ $installed_hash != "$expected_hash" ]]; then
      printf 'Preserving the custom qvOS Hyprland layer: %s\n' "$target" >&2
      return 0
    fi
  done <"$retired_qv_manifest"

  retire_qv_source=true
}

retire_stock_qv_layer

