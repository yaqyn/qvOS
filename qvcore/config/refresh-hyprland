#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
export QVOS_PATH

# qvos:contract=qvcore/config/files/hypr/bindings.lua
# qvos:contract=qvcore/config/files/hypr/hyprland.lua
# qvos:contract=qvcore/config/files/hypr/input.lua
# qvos:contract=qvcore/config/base/hypr
# qvos:contract=qvcore/config/keyboard-layout
# qvos:contract=bin/qv-launch-app

"$QVOS_PATH/qvcore/config/monitor-autodetect" --restore-preflight

config_owner="$QVOS_PATH/qvcore/config/refresh"
config_paths=(
  hypr/autostart.lua
  hypr/bindings.lua
  hypr/looknfeel.lua
  hypr/hyprland.lua
  hypr/monitors.lua
  hypr/input.lua
)

for config_path in "${config_paths[@]}"; do
  [[ -f $QVOS_PATH/qvcore/config/files/$config_path ]] || {
    printf 'Missing qvOS Hyprland config source: %s\n' "$config_path" >&2
    exit 1
  }
done

for config_path in "${config_paths[@]}"; do
  "$config_owner" "$config_path"
done

"$QVOS_PATH/qvcore/config/keyboard-layout"

"$QVOS_PATH/qvcore/config/monitor-autodetect"
