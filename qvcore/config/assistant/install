#!/bin/bash
set -euo pipefail

script_path=$(/usr/bin/readlink -f -- "${BASH_SOURCE[0]}")
source_dir=$(cd -- "$(/usr/bin/dirname -- "$script_path")" && pwd)
QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
expected_source="$QVOS_PATH/qvcore/config/assistant"
skill_source="$source_dir/qvos"
pi_source="$source_dir/pi-system-theme.ts"
hash_manifest="$source_dir/pi-managed-hashes"
pi_target="$HOME/.pi/agent/extensions/qvos-system-theme.ts"
temporary=""
managed_hashes=()
skill_dirs=(
  "$HOME/.agents/skills"
  "$HOME/.claude/skills"
  "$HOME/.codex/skills"
  "$HOME/.pi/agent/skills"
)
managed_directories=(
  "$HOME/.agents"
  "$HOME/.agents/skills"
  "$HOME/.claude"
  "$HOME/.claude/skills"
  "$HOME/.codex"
  "$HOME/.codex/skills"
  "$HOME/.pi"
  "$HOME/.pi/agent"
  "$HOME/.pi/agent/extensions"
  "$HOME/.pi/agent/skills"
)
cleanup() {
  [[ -z $temporary || ! -e $temporary ]] || /usr/bin/rm -rf -- "$temporary"
}
trap cleanup EXIT

fail() {
  printf 'qvOS assistant integration: %s\n' "$1" >&2
  exit 1
}

[[ -d $HOME && ! -L $HOME && -O $HOME ]] || fail "unsafe home directory"
[[ $(/usr/bin/realpath -m -- "$expected_source") == "$source_dir" ]] ||
  fail "QVOS_PATH does not match this assistant owner"
[[ -d $skill_source && ! -L $skill_source &&
  -f $skill_source/SKILL.md && ! -L $skill_source/SKILL.md ]] ||
  fail "unsafe qvOS skill source"
[[ -f $pi_source && ! -L $pi_source ]] || fail "unsafe Pi theme source"
[[ -f $hash_manifest && ! -L $hash_manifest ]] ||
  fail "unsafe Pi payload manifest"

mapfile -t managed_hashes < <(
  /usr/bin/sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$hash_manifest"
)
(( ${#managed_hashes[@]} > 0 )) || fail "empty Pi payload manifest"
[[ $(printf '%s\n' "${managed_hashes[@]}" | /usr/bin/sort -u) == \
  $(printf '%s\n' "${managed_hashes[@]}") ]] ||
  fail "Pi payload manifest is not sorted and unique"
for hash in "${managed_hashes[@]}"; do
  [[ $hash =~ ^[0-9a-f]{64}$ ]] || fail "invalid managed Pi payload hash"
done
pi_source_hash=$(/usr/bin/sha256sum -- "$pi_source")
pi_source_hash=${pi_source_hash%% *}
printf '%s\n' "${managed_hashes[@]}" | /usr/bin/grep -Fqx "$pi_source_hash" ||
  fail "current Pi source is absent from its managed payload manifest"

validate_directory() {
  local directory=$1

  [[ ! -e $directory && ! -L $directory ]] && return 0
  [[ -d $directory && ! -L $directory && -O $directory ]] ||
    fail "unsafe assistant directory: $directory"
}

validate_skill_link() {
  local path=$1
  local target

  [[ ! -e $path && ! -L $path ]] && return 0
  [[ -L $path ]] || fail "refusing a non-link assistant skill: $path"
  target=$(/usr/bin/readlink -- "$path")
  [[ $target == "$skill_source" ]] ||
    fail "refusing a foreign assistant skill link: $path"
}

pi_file_is_managed() {
  local path=$1
  local hash

  [[ -f $path && ! -L $path && -O $path ]] || return 1
  [[ $(/usr/bin/stat -c '%a' -- "$path") == "644" ]] || return 1
  hash=$(/usr/bin/sha256sum -- "$path")
  hash=${hash%% *}
  printf '%s\n' "${managed_hashes[@]}" | /usr/bin/grep -Fqx "$hash"
}

for directory in "${managed_directories[@]}"; do
  validate_directory "$directory"
done
for skill_dir in "${skill_dirs[@]}"; do
  validate_skill_link "$skill_dir/qvos"
done
[[ ! -e $pi_target && ! -L $pi_target ]] || pi_file_is_managed "$pi_target" ||
  fail "refusing a modified or unsafe Pi theme extension: $pi_target"

for directory in "${managed_directories[@]}"; do
  [[ -d $directory ]] || /usr/bin/install -d -m 0755 "$directory"
done

for skill_dir in "${skill_dirs[@]}"; do
  native_link="$skill_dir/qvos"
  if [[ -L $native_link && $(/usr/bin/readlink -- "$native_link") == \
    "$skill_source" ]]; then
    continue
  fi
  temporary=$(/usr/bin/mktemp -d "$skill_dir/.qvos-skill.XXXXXX")
  /usr/bin/ln -s -- "$skill_source" "$temporary/qvos"
  /usr/bin/mv -Tf -- "$temporary/qvos" "$native_link"
  /usr/bin/rmdir -- "$temporary"
  temporary=""
done

if ! pi_file_is_managed "$pi_target" ||
  ! /usr/bin/cmp -s "$pi_source" "$pi_target"; then
  temporary=$(/usr/bin/mktemp "$HOME/.pi/agent/extensions/.qvos-theme.XXXXXX")
  /usr/bin/install -m 0644 "$pi_source" "$temporary"
  /usr/bin/mv -f -- "$temporary" "$pi_target"
  temporary=""
fi
