#!/bin/bash
set -euo pipefail

config_root="$HOME/.config/hypr"
toggle_root="$HOME/.local/state/qvos/toggles/hypr"
backup_root="$HOME/.local/state/qvos/hyprland/legacy-conf"
legacy_theme="$HOME/.config/qvos/current/theme/hyprland.conf"
legacy_theme_backup="$backup_root/theme/hyprland.conf"
autogenerated_stub_hash=de900c9facfb6df53f0f3c64b0b156f92081b8628e081eba347609c509624177
config_names=(autostart bindings envs hyprland input looknfeel monitors)

warn() {
  printf 'qvOS Hyprland Lua finalizer: %s\n' "$1" >&2
}

safe_file() {
  [[ -f $1 && ! -L $1 && -O $1 ]]
}

retire_exact_file() {
  local active=$1
  local backup=$2

  [[ -e $active || -L $active ]] || return 0
  if ! safe_file "$active" || ! safe_file "$backup" ||
    ! cmp -s -- "$active" "$backup"; then
    warn "preserving unrecognized legacy config: $active"
    return 0
  fi
  rm -f -- "$active"
}

[[ $HOME == /* && $HOME != *$'\n'* && $HOME != *$'\r'* ]] || {
  warn "HOME is not a safe absolute path"
  exit 1
}
safe_file "$config_root/hyprland.lua" || {
  warn "native Lua entrypoint is missing or unsafe"
  exit 1
}
command -v Hyprland >/dev/null 2>&1 || {
  warn "Hyprland is unavailable"
  exit 1
}
Hyprland --verify-config -c "$config_root/hyprland.lua" >/dev/null || {
  warn "native Lua configuration was rejected"
  exit 1
}

legacy_main="$config_root/hyprland.conf"
if safe_file "$legacy_main"; then
  current_hash=$(sha256sum -- "$legacy_main")
  if [[ ${current_hash%% *} == "$autogenerated_stub_hash" ]]; then
    rm -f -- "$legacy_main"
  fi
fi

for name in "${config_names[@]}"; do
  retire_exact_file \
    "$config_root/$name.conf" \
    "$backup_root/config/$name.conf"
done
retire_exact_file "$legacy_theme" "$legacy_theme_backup"

if [[ -d $toggle_root && ! -L $toggle_root && -O $toggle_root ]]; then
  while IFS= read -r -d '' active; do
    name=${active##*/}
    name=${name%.conf}
    [[ $name =~ ^[a-z][a-z0-9-]*$ ]] || {
      warn "preserving invalid legacy toggle name: $active"
      continue
    }
    retire_exact_file "$active" "$backup_root/toggles/$name.conf"
  done < <(find -P "$toggle_root" -maxdepth 1 -type f -name '*.conf' -print0)
fi
