#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
# shellcheck source=qvcore/config/toggle-lib
source "$QVOS_PATH/qvcore/config/toggle-lib"

state_conf="$qvos_hypr_toggle_root/touchscreen-disabled.lua"
device=$(qv-hw-touchscreen)

[[ $device =~ ^[[:alnum:]_.:-]+$ ]] || {
  echo "No touchscreen device found" >&2
  exit 1
}

enable() {
  "$QVOS_PATH/qvcore/desktop/hyprland/qvos-runtime-config" \
    device "$device" true
  qvos_toggle_remove "$state_conf"
  "$QVOS_PATH/bin/qv-swayosd-client" \
    --custom-icon device-support-touch-symbolic \
    --custom-message "Touchscreen enabled"
}

disable() {
  "$QVOS_PATH/qvcore/desktop/hyprland/qvos-runtime-config" \
    device "$device" false
  printf 'qv.device("%s", false)\n' "$device" |
    qvos_toggle_write "$state_conf"
  "$QVOS_PATH/bin/qv-swayosd-client" \
    --custom-icon touch-disabled-symbolic \
    --custom-message "Touchscreen disabled"
}

case ${1:-toggle} in
on) enable ;;
off) disable ;;
toggle)
  if [[ -f $state_conf ]]; then
    enable
  else
    disable
  fi
  ;;
*)
  echo "Usage: qv toggle touchscreen [on|off|toggle]" >&2
  exit 2
  ;;
esac
