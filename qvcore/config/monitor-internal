#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
# shellcheck source=qvcore/config/toggle-lib
source "$QVOS_PATH/qvcore/config/toggle-lib"

toggle_name="internal-monitor-disable"
mirror_toggle_name="internal-monitor-mirror"
toggle_flag="$qvos_hypr_toggle_root/$toggle_name.conf"
internal=$(hyprctl monitors -j | jq -r '[.[] | select(.name | contains("eDP")).name][0] // empty')

enable() {
  if "$QVOS_PATH/qvcore/config/hyprland-toggle-enabled" "$toggle_name"; then
    "$QVOS_PATH/qvcore/config/hyprland-toggle" \
      --disabled-notification "󰍹    Laptop display enabled" \
      "$toggle_name"
  fi
}

disable() {
  [[ -n $internal ]] || {
    echo "No internal laptop display found" >&2
    return 1
  }
  if ! qv-hw-external-monitors; then
    notify-send -u low "󰍹    Can't disable the only active display"
    return 1
  fi
  if "$QVOS_PATH/qvcore/config/hyprland-toggle-disabled" "$toggle_name" &&
    "$QVOS_PATH/qvcore/config/hyprland-toggle-disabled" "$mirror_toggle_name"; then
    printf 'monitor=%s,disable\n' "$internal" | qvos_toggle_write "$toggle_flag"
    notify-send -u low "󰍹    Laptop display disabled"
    hyprctl reload
  fi
}

recover() {
  if ! qv-hw-external-monitors &&
    "$QVOS_PATH/qvcore/config/hyprland-toggle-enabled" "$toggle_name"; then
    "$QVOS_PATH/qvcore/config/hyprland-toggle" "$toggle_name"
  fi
}

case ${1:-} in
on) enable ;;
off) disable ;;
toggle)
  if "$QVOS_PATH/qvcore/config/hyprland-toggle-enabled" "$toggle_name"; then
    enable
  else
    disable
  fi
  ;;
recover) recover ;;
*)
  echo "Usage: qv hyprland monitor internal <on|off|toggle|recover>" >&2
  exit 2
  ;;
esac
