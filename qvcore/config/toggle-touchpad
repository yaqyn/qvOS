#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
# shellcheck source=qvcore/config/toggle-lib
source "$QVOS_PATH/qvcore/config/toggle-lib"

state_conf="$qvos_hypr_toggle_root/touchpad-disabled.conf"
device=$(qv-hw-touchpad)

[[ -n $device && $device != *$'\n'* && $device != *$'\r'* ]] || {
  echo "No touchpad device found" >&2
  exit 1
}

enable() {
  hyprctl keyword "device[$device]:enabled" true >/dev/null
  qvos_toggle_remove "$state_conf"
  "$QVOS_PATH/bin/qv-swayosd-client" \
    --custom-icon input-touchpad-symbolic \
    --custom-message "Touchpad enabled"
}

disable() {
  hyprctl keyword "device[$device]:enabled" false >/dev/null
  printf 'device {\n  name = %s\n  enabled = false\n}\n' "$device" |
    qvos_toggle_write "$state_conf"
  "$QVOS_PATH/bin/qv-swayosd-client" \
    --custom-icon touchpad-disabled-symbolic \
    --custom-message "Touchpad disabled"
}

case ${1:-toggle} in
on) enable ;;
off) disable ;;
toggle)
  if [[ -f $state_conf ]]; then
    enable
  else
    disable
  fi
  ;;
*)
  echo "Usage: qv toggle touchpad [on|off|toggle]" >&2
  exit 2
  ;;
esac
