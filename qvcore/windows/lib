# shellcheck shell=bash

qvos_windows_require_safe_path() {
  local path=$1
  local kind=$2

  if [[ -L $path ]]; then
    echo "Refusing symlinked Windows $kind: $path" >&2
    return 1
  fi
  if [[ -e $path ]]; then
    case $kind in
    directory)
      [[ -d $path ]] || {
        echo "Windows path is not a directory: $path" >&2
        return 1
      }
      ;;
    file)
      [[ -f $path ]] || {
        echo "Windows path is not a regular file: $path" >&2
        return 1
      }
      ;;
    *)
      echo "Unknown Windows path kind: $kind" >&2
      return 2
      ;;
    esac
  fi
}

qvos_windows_require_owned_path() {
  local path=$1
  local owner

  [[ -e $path ]] || return 0
  owner=$(stat -c '%u' -- "$path")
  [[ $owner == "$(id -u)" ]] || {
    echo "Refusing Windows path owned by another user: $path" >&2
    return 1
  }
}

qvos_windows_valid_username() {
  [[ $1 =~ ^[A-Za-z][A-Za-z0-9._-]{0,31}$ ]]
}

qvos_windows_valid_password() {
  local password=$1

  (( ${#password} >= 8 && ${#password} <= 64 )) &&
    [[ $password =~ ^[A-Za-z0-9@%+=:,.!?_-]+$ ]]
}

qvos_windows_valid_timezone() {
  [[ $1 =~ ^[A-Za-z0-9_+.-]+(/[A-Za-z0-9_+.-]+)*$ && $1 != *..* ]]
}

qvos_windows_compose_value() {
  local index=$1
  local key=$2
  local -n destination=$3
  local prefix="      $key: \""
  local line=${compose_lines[$index]}

  [[ $line == "$prefix"*'"' ]] || {
    echo "Windows VM configuration has an invalid $key field." >&2
    return 1
  }
  destination=${line#"$prefix"}
  destination=${destination%"\""}
  [[ $destination != *'"'* ]] || {
    echo "Windows VM configuration has an invalid $key value." >&2
    return 1
  }
}

# The caller owns these feature paths and parsed-value destinations.
# shellcheck disable=SC2154
qvos_windows_load_compose() {
  local repair_mode=$1
  local compose_mode
  local version
  local ram_size
  local cpu_cores
  local disk_size
  local timezone
  local arguments
  local storage_mapping="$storage_dir:/storage"
  local shared_mapping="$shared_dir:/shared"
  local container_prefix="    container_name: "

  qvos_windows_require_safe_path "$config_dir" directory
  qvos_windows_require_safe_path "$compose_file" file
  [[ -f $compose_file ]] || {
    echo "Windows VM is not configured. Run: qv windows install" >&2
    return 1
  }
  qvos_windows_require_owned_path "$config_dir"
  qvos_windows_require_owned_path "$compose_file"

  compose_mode=$(stat -c '%a' -- "$compose_file")
  if [[ $compose_mode != "600" ]]; then
    if [[ $repair_mode == "true" ]]; then
      chmod 0600 -- "$compose_file"
    else
      echo "Windows VM configuration permissions are unsafe (expected 0600)." >&2
      return 1
    fi
  fi

  mapfile -t compose_lines <"$compose_file"
  (( ${#compose_lines[@]} == 27 )) || {
    echo "Refusing an unrecognized Windows VM Compose configuration." >&2
    return 1
  }

  [[ ${compose_lines[3]} == "$container_prefix"* ]] || {
    echo "Windows VM configuration has an invalid container identity." >&2
    return 1
  }
  qvos_windows_compose_container=${compose_lines[3]#"$container_prefix"}
  if [[ $qvos_windows_compose_container != "$container_name" ]]; then
    echo "Refusing an unrecognized Windows VM container identity." >&2
    return 1
  fi

  [[ ${compose_lines[0]} == "services:" &&
    ${compose_lines[1]} == "  windows:" &&
    ${compose_lines[2]} == "    image: dockurr/windows" &&
    ${compose_lines[4]} == "    environment:" &&
    ${compose_lines[13]} == "    devices:" &&
    ${compose_lines[14]} == "      - /dev/kvm" &&
    ${compose_lines[15]} == "      - /dev/net/tun" &&
    ${compose_lines[16]} == "    cap_add:" &&
    ${compose_lines[17]} == "      - NET_ADMIN" &&
    ${compose_lines[18]} == "    ports:" &&
    ${compose_lines[19]} == "      - 127.0.0.1:8006:8006" &&
    ${compose_lines[20]} == "      - 127.0.0.1:3389:3389/tcp" &&
    ${compose_lines[21]} == "      - 127.0.0.1:3389:3389/udp" &&
    ${compose_lines[22]} == "    volumes:" &&
    (${compose_lines[23]} == "      - $storage_mapping" ||
      ${compose_lines[23]} == "      - \"$storage_mapping\"") &&
    (${compose_lines[24]} == "      - $shared_mapping" ||
      ${compose_lines[24]} == "      - \"$shared_mapping\"") &&
    ${compose_lines[25]} == "    restart: unless-stopped" &&
    ${compose_lines[26]} == "    stop_grace_period: 2m" ]] || {
    echo "Refusing a Windows VM configuration outside the qvOS security profile." >&2
    return 1
  }

  qvos_windows_compose_value 5 VERSION version
  qvos_windows_compose_value 6 RAM_SIZE ram_size
  qvos_windows_compose_value 7 CPU_CORES cpu_cores
  qvos_windows_compose_value 8 DISK_SIZE disk_size
  qvos_windows_compose_value 9 USERNAME windows_user
  qvos_windows_compose_value 10 PASSWORD windows_password
  qvos_windows_compose_value 11 TZ timezone
  qvos_windows_compose_value 12 ARGUMENTS arguments

  [[ $version == "11" ]] &&
    [[ $ram_size =~ ^(2|4|8|16|32|64)G$ ]] &&
    [[ $cpu_cores =~ ^[0-9]+$ ]] && (( 10#$cpu_cores > 0 && 10#$cpu_cores <= 65535 )) &&
    [[ $disk_size =~ ^(32|64|128|256|512)G$ ]] &&
    qvos_windows_valid_username "$windows_user" &&
    qvos_windows_valid_password "$windows_password" &&
    qvos_windows_valid_timezone "$timezone" &&
    [[ $arguments == "-rtc base=localtime,clock=host,driftfix=slew" ]] || {
    windows_password=
    echo "Refusing invalid values in the Windows VM configuration." >&2
    return 1
  }
}
