#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
source "$QVOS_PATH/qvcore/windows/lib"

config_dir="$HOME/.config/windows"
compose_file="$config_dir/docker-compose.yml"
storage_dir="$HOME/.windows"
shared_dir="$HOME/Windows"
desktop_file="$HOME/.local/share/applications/windows-vm.desktop"
container_name=qvos-windows
legacy_container_name=omarchy-windows
legacy_desktop_exec='Exec=uwsm app -- omarchy-windows-vm launch'
native_desktop_exec='Exec=uwsm app -- qv-windows-vm launch'
windows_user=
windows_password=
qvos_windows_compose_container=

fail() {
  echo "$1" >&2
  return 1
}

stage_replacement() {
  local source=$1
  local old_line=$2
  local new_line=$3
  local -n destination=$4
  local directory=${source%/*}
  local base=${source##*/}
  local count

  count=$(grep -Fxc -- "$old_line" "$source" || true)
  (( count == 1 )) || fail "Refusing an ambiguous Windows identity in $source"
  destination=$(mktemp "$directory/.$base.qvos-stage.XXXXXX")
  chmod "$(stat -c '%a' -- "$source")" "$destination"
  awk -v old="$old_line" -v new="$new_line" \
    '{ print $0 == old ? new : $0 }' "$source" >"$destination"
}

backup_file() {
  local source=$1
  local -n destination=$2

  destination=$(mktemp "$source.qvos-backup.XXXXXX")
  if ! cp -p -- "$source" "$destination"; then
    rm -f -- "$destination"
    destination=
    return 1
  fi
}

container_exists() {
  docker container inspect "$1" >/dev/null 2>&1
}

main() {
  local check_only=false
  local compose_stage=
  local desktop_stage=
  local compose_backup=
  local desktop_backup=
  local compose_published=false
  local desktop_published=false
  local container_renamed=false
  local legacy_exists=false
  local native_exists=false
  local legacy_compose=false
  local migrated=false
  local repair_mode=false
  local rollback_failed=false
  local status=0

  case ${1:-} in
  "") ;;
  --check) check_only=true ;;
  *) fail "Usage: qvcore/windows/reconcile [--check]"; return 2 ;;
  esac
  (( $# <= 1 )) || {
    fail "Usage: qvcore/windows/reconcile [--check]"
    return 2
  }
  qvos_windows_require_safe_path "$config_dir" directory
  qvos_windows_require_safe_path "$compose_file" file
  qvos_windows_require_safe_path "$desktop_file" file
  qvos_windows_require_owned_path "$config_dir"
  qvos_windows_require_owned_path "$compose_file"
  qvos_windows_require_owned_path "$desktop_file"

  if [[ -f $compose_file ]]; then
    if [[ $check_only == "false" ]] &&
      grep -Fqx -- "    container_name: $container_name" "$compose_file"; then
      repair_mode=true
    fi
    qvos_windows_load_compose "$repair_mode" true
    windows_password=
    if [[ $qvos_windows_compose_container == "$legacy_container_name" ]]; then
      legacy_compose=true
      if [[ $check_only == "true" ]]; then
        fail "Windows VM still uses the retired container identity."
        return 1
      fi
      if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
        echo "Windows identity migration deferred until Docker is available." >&2
        return 0
      fi
      container_exists "$legacy_container_name" && legacy_exists=true
      container_exists "$container_name" && native_exists=true
      if [[ $legacy_exists == "true" && $native_exists == "true" ]]; then
        fail "Both legacy and native Windows containers exist; refusing automatic migration."
        return 1
      fi
      if ! stage_replacement "$compose_file" \
        "    container_name: $legacy_container_name" \
        "    container_name: $container_name" compose_stage; then
        [[ -z $compose_stage ]] || rm -f -- "$compose_stage"
        return 1
      fi
    fi
  fi

  if [[ -f $desktop_file ]] && grep -Fqx -- "$legacy_desktop_exec" "$desktop_file"; then
    if [[ $check_only == "true" ]]; then
      fail "Windows desktop launcher still uses the compatibility command."
      return 1
    fi
    if ! stage_replacement "$desktop_file" "$legacy_desktop_exec" \
      "$native_desktop_exec" desktop_stage; then
      [[ -z $compose_stage ]] || rm -f -- "$compose_stage"
      [[ -z $desktop_stage ]] || rm -f -- "$desktop_stage"
      return 1
    fi
  fi

  [[ $check_only == "false" ]] || return 0
  if [[ -z $compose_stage && -z $desktop_stage ]]; then
    return 0
  fi

  if [[ -n $compose_stage ]]; then
    if ! backup_file "$compose_file" compose_backup; then
      rm -f -- "$compose_stage"
      [[ -z $desktop_stage ]] || rm -f -- "$desktop_stage"
      return 1
    fi
  fi
  if [[ -n $desktop_stage ]]; then
    if ! backup_file "$desktop_file" desktop_backup; then
      [[ -z $compose_stage ]] || rm -f -- "$compose_stage"
      rm -f -- "$desktop_stage"
      return 1
    fi
  fi

  if [[ $legacy_compose == "true" && $legacy_exists == "true" ]]; then
    if docker rename "$legacy_container_name" "$container_name"; then
      container_renamed=true
    else
      status=$?
    fi
  fi
  if (( status == 0 )) && [[ -n $compose_stage ]]; then
    if mv -f -- "$compose_stage" "$compose_file"; then
      compose_stage=
      compose_published=true
    else
      status=$?
    fi
  fi
  if (( status == 0 )) && [[ -n $desktop_stage ]]; then
    if mv -f -- "$desktop_stage" "$desktop_file"; then
      desktop_stage=
      desktop_published=true
    else
      status=$?
    fi
  fi

  if (( status != 0 )); then
    if [[ $desktop_published == "true" ]] &&
      ! cp -p -- "$desktop_backup" "$desktop_file"; then
      rollback_failed=true
    fi
    if [[ $compose_published == "true" ]] &&
      ! cp -p -- "$compose_backup" "$compose_file"; then
      rollback_failed=true
    fi
    if [[ $container_renamed == "true" ]]; then
      if ! docker rename "$container_name" "$legacy_container_name" >/dev/null 2>&1; then
        rollback_failed=true
      fi
    fi
    [[ -z $desktop_stage ]] || rm -f -- "$desktop_stage"
    [[ -z $compose_stage ]] || rm -f -- "$compose_stage"
    if [[ $rollback_failed == "true" ]]; then
      fail "Windows identity migration and rollback both failed; inspect the saved qvOS backups."
    else
      fail "Could not migrate the Windows identity; restored its prior state."
    fi
    return "$status"
  fi

  [[ $compose_published == "false" ]] || migrated=true
  [[ $desktop_published == "false" ]] || migrated=true
  if [[ $migrated == "true" ]]; then
    echo "Migrated Windows VM internals to qvOS identity."
  fi
}

main "$@"
