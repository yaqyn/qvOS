#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
OMARCHY_PATH=$QVOS_PATH
branding_file="$HOME/.config/omarchy/branding/about.txt"

case "${1:-}" in
image)
  image=$(qv-menu-file "Logo image" "$HOME" "svg png")
  if [[ -n $image ]] &&
    qv-transcode-ascii \
      "$image" \
      "$branding_file" \
      --width 54 \
      --height 26 \
      --mode block; then
    omarchy-launch-about >/dev/null 2>&1
  fi
  ;;
text)
  omarchy-launch-editor "$branding_file" >/dev/null 2>&1 &&
    omarchy-launch-about >/dev/null 2>&1
  ;;
reset)
  cp "$OMARCHY_PATH/qvcore/branding/icon.txt" "$branding_file"
  omarchy-launch-about >/dev/null 2>&1
  ;;
*)
  echo "Usage: omarchy-branding-about <image|text|reset>" >&2
  exit 1
  ;;
esac
