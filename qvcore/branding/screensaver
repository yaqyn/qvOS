#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
OMARCHY_PATH=$QVOS_PATH
branding_file="$HOME/.config/omarchy/branding/screensaver.txt"

case "${1:-}" in
image)
  image=$(qv-menu-file "Logo image" "$HOME" "svg png")
  if [[ -n $image ]] &&
    qv-transcode-ascii "$image" "$branding_file"; then
    qv-launch-screensaver force >/dev/null 2>&1
  fi
  ;;
text)
  omarchy-launch-editor "$branding_file" >/dev/null 2>&1 &&
    qv-launch-screensaver force >/dev/null 2>&1
  ;;
reset)
  cp "$OMARCHY_PATH/qvcore/branding/logo.txt" "$branding_file"
  qv-launch-screensaver force >/dev/null 2>&1
  ;;
*)
  echo "Usage: omarchy-branding-screensaver <image|text|reset>" >&2
  exit 1
  ;;
esac
