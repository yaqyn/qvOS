#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/branding/native-paths"
retired_manifest="$root/qvcore/branding/retired-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

mapfile -t native_paths < <(
  sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest"
)

if ((${#native_paths[@]} > 0)); then
  [[ $(printf '%s\n' "${native_paths[@]}" | sort -u) == $(printf '%s\n' "${native_paths[@]}") ]] ||
    fail "native branding paths are not sorted and unique"
fi

for path in "${native_paths[@]}"; do
  [[ -f $root/$path && ! -L $root/$path ]] ||
    fail "native branding path is missing or unsafe: $path"
  git -C "$root" cat-file -e "upstream/master:$path" ||
    fail "native branding path is not inherited: $path"
  git -C "$root" diff --quiet upstream/master -- "$path" &&
    fail "native branding path no longer differs from upstream: $path"
done

mapfile -t retired_paths < <(
  sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest"
)
[[ $(printf '%s\n' "${retired_paths[@]}" | sort -u) == \
  $(printf '%s\n' "${retired_paths[@]}") ]] ||
  fail "retired branding paths are not sorted and unique"
for path in "${retired_paths[@]}"; do
  [[ ! -e $root/$path && ! -L $root/$path ]] ||
    fail "retired inherited branding path remains: $path"
  git -C "$root" cat-file -e "upstream/master:$path" ||
    fail "retired branding path is not inherited: $path"
done

declare -A branding_routes=(
  [branding-about]=about
  [branding-screensaver]=screensaver
  [refresh-fastfetch]=refresh-fastfetch
  [show-logo]=show-logo
)
for route in "${!branding_routes[@]}"; do
  owner="qvcore/branding/${branding_routes[$route]}"
  native_adapter="$root/bin/qv-$route"
  compatibility_adapter="$root/bin/omarchy-$route"

  [[ -x $native_adapter && -x $compatibility_adapter && -x $root/$owner ]] ||
    fail "branding adapter or owner is not executable: $route"
  (( $(wc -l <"$native_adapter") <= 12 )) ||
    fail "native branding adapter contains implementation: $route"
  (( $(wc -l <"$compatibility_adapter") <= 5 )) ||
    fail "branding compatibility adapter contains implementation: $route"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native branding adapter lacks metadata: $route"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "branding compatibility adapter duplicates metadata: $route"
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    grep -Fqx "exec \"\$QVOS_PATH/$owner\" \"\$@\"" "$adapter" ||
      fail "branding adapter does not delegate directly: $route"
  done
done

for owner in about install lib refresh-fastfetch screensaver show-logo; do
  [[ -f $root/qvcore/branding/$owner && ! -L $root/qvcore/branding/$owner ]] ||
    fail "missing native branding owner: $owner"
done
for owner in about install refresh-fastfetch screensaver show-logo; do
  [[ -x $root/qvcore/branding/$owner ]] || fail "branding owner mode: $owner"
done
[[ -f $root/qvcore/branding/terminal-art.txt &&
  ! -L $root/qvcore/branding/terminal-art.txt ]] ||
  fail "missing qvOS terminal art"

expected_assets=$'qv-mark-dark.svg\nqv-mark-light.svg\nqvos-wordmark-dark.svg\nqvos-wordmark-light.svg'
[[ $(find "$root/qvcore/branding/assets" -maxdepth 1 -type f -printf '%f\n' | sort) == \
  "$expected_assets" ]] || fail "qvOS vector asset inventory"
for asset in "$root"/qvcore/branding/assets/*.svg; do
  grep -Fq '<svg ' "$asset" || fail "invalid qvOS vector asset: $asset"
  if rg -n -i '<script|javascript:|xlink:href|[[:space:]]href=' "$asset"; then
    fail "external or executable qvOS vector asset: $asset"
  fi
done

[[ ! -e $root/qvcore/config/files/fastfetch ]] ||
  fail "duplicate Fastfetch branding overlay remains"
[[ ! -e $root/qvcore/config/files/omarchy/branding ]] ||
  fail "legacy branding config source remains"
grep -Fq '"source": "~/.config/qvos/branding/about.txt"' \
  "$root/config/fastfetch/config.jsonc" ||
  fail "Fastfetch bypasses native qvOS branding state"

for frontend in qv omarchy; do
  for route in 'branding about' 'branding screensaver' 'branding logo'; do
    "$root/bin/$frontend" commands --json | jq -e \
      --arg route "$frontend $route" '
        [.commands[] | select(.route == $route and (.binary | startswith("qv-")))] |
        length == 1
      ' >/dev/null || fail "$frontend $route route does not prefer qvOS"
  done
done

if rg -n 'omarchy-branding-(about|screensaver)|omarchy-(refresh-fastfetch|show-logo)' \
  "$root/qvcore/branding" "$root/qvcore/menu" \
  --glob '!**/AGENTS.md' --glob '!**/check' --glob '!**/native-paths'; then
  fail "native qvOS source calls a branding compatibility route"
fi

if rg -n '^# omarchy:summary=.*Omarchy' "$root/bin" "$root/qvcore"; then
  fail "public command help still brands qvOS as Omarchy"
fi

identity_paths=(
  bin/omarchy
  bin/omarchy-debug
  bin/omarchy-dev-benchmark
  bin/omarchy-dev-bin-metadata
  bin/omarchy-launch-floating-terminal-with-presentation
  bin/qv-menu
  bin/omarchy-refresh-config
  bin/omarchy-reinstall
  bin/omarchy-reinstall-configs
  bin/omarchy-update-available
  bin/qv-windows-vm
  boot.sh
  config/fastfetch/config.jsonc
  config/systemd/user/qvos-battery-monitor.service
  config/systemd/user/qvos-battery-monitor.timer
  config/waybar/config.jsonc
  default/chromium/extensions/copy-url/manifest.json
  default/elephant/omarchy_background_selector.lua
  default/elephant/omarchy_themes.lua
  default/elephant/omarchy_unlocks.lua
  default/omarchy-skill/SKILL.md
  qvcore/install/first-run/welcome.sh
  qvcore/install/config/hardware/apple/fix-suspend-nvme.sh
  qvcore/install/helpers/logging.sh
  qvcore/install/helpers/presentation.sh
  qvcore/install/preflight/guard.sh
  qvcore/boot/limine/default.conf
  qvcore/boot/limine/limine.conf
  qvcore/boot/plymouth/omarchy.plymouth
  qvcore/boot/plymouth/omarchy.script
  qvcore/boot/sddm/metadata.desktop
  qvcore/boot/wayland-sessions/omarchy.desktop
  qvcore/install/helpers/errors
  qvcore/presentation/run
  qvcore/update/qvos-update
  qvcore/windows/command
)

for path in "${identity_paths[@]}"; do
  [[ -f $root/$path ]] || fail "missing visible identity source: $path"
  if rg -n 'Omarchy' "$root/$path"; then
    fail "visible identity source still exposes Omarchy: $path"
  fi
done

# shellcheck disable=SC2016
grep -Fqx 'QVOS_REF="${QVOS_REF:-${OMARCHY_REF:-OS}}"' "$root/boot.sh" ||
  fail "online installer does not default to the qvOS product branch"
# shellcheck disable=SC2016
grep -Fqx 'QVOS_REPO="${QVOS_REPO:-${OMARCHY_REPO:-Yaqyn-qvOS/qvOS}}"' \
  "$root/boot.sh" ||
  fail "online installer does not default to the qvOS repository"

grep -Fqx 'NamePretty = "qvOS"' \
  "$root/qvcore/menu/elephant/qvos_menu.lua" ||
  fail "qvOS menu provider label"
grep -Fq '"qvOS Source"' "$root/qvcore/menu/elephant/qvos_menu.lua" ||
  fail "qvOS learning destination"
grep -Fq 'Name=qvOS (Hyprland uwsm)' \
  "$root/qvcore/boot/wayland-sessions/omarchy.desktop" ||
  fail "qvOS session label"
grep -Fq 'Description=qvOS Battery Monitor Check' \
  "$root/config/systemd/user/qvos-battery-monitor.service" ||
  fail "qvOS battery service label"

printf 'ok - qvOS singularly owns visible identity, terminal art, and branding state\n'
