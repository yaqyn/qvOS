#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)}

(( $# == 0 )) || {
  echo "Usage: qv refresh limine" >&2
  exit 2
}

echo "Resetting limine config"

if sudo test -f /boot/limine.conf; then
  sudo cp -a -- \
    /boot/limine.conf \
    "/boot/limine.conf.bak.$(date +%s)"
fi
sudo install -m 0644 \
  "$QVOS_PATH/qvcore/boot/limine/limine.conf" \
  /boot/limine.conf

sudo limine-update
if [[ -d /sys/firmware/efi ]]; then
  qvos_uki=/boot/EFI/Linux/qvos_linux.efi
  if sudo test -L "$qvos_uki" || ! sudo test -f "$qvos_uki" ||
    ! sudo test -s "$qvos_uki"; then
    echo "Error: failed to create the qvOS UKI at $qvos_uki" >&2
    exit 1
  fi

  machine_id=$(</etc/machine-id)
  for legacy_uki in \
    /boot/EFI/Linux/omarchy_linux.efi \
    "/boot/EFI/Linux/${machine_id}_linux.efi"; do
    if sudo test -e "$legacy_uki" || sudo test -L "$legacy_uki"; then
      if sudo test -L "$legacy_uki" || ! sudo test -f "$legacy_uki"; then
        echo "Preserving modified or unsafe legacy UKI: $legacy_uki" >&2
      else
        sudo rm -f -- "$legacy_uki"
      fi
    fi
  done
fi
sudo limine-snapper-sync
