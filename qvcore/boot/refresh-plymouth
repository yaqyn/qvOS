#!/bin/bash
set -euo pipefail

# qvos:contract=qvcore/boot/plymouth

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)}}

(( $# == 0 )) || {
  echo "Usage: qv refresh plymouth" >&2
  exit 2
}

"$QVOS_PATH/qvcore/boot/sync-theme" plymouth
sudo plymouth-set-default-theme omarchy

if command -v limine-mkinitcpio &>/dev/null; then
  sudo limine-mkinitcpio
else
  sudo mkinitcpio -P
fi
