#!/bin/bash
set -euo pipefail

# qvos:contract=qvcore/boot/logo.png

QVOS_PATH=${QVOS_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)}
# shellcheck source=qvcore/boot/install-lib disable=SC1091
source "$QVOS_PATH/qvcore/boot/install-lib"
qvos_boot_init

staging=
backup=
target=
committed=false
published=false
theme_kind=boot

cleanup() {
  local status=$?

  trap - EXIT
  if [[ -n $staging ]] && qvos_boot_root_exists "$staging"; then
    sudo rm -rf -- "$staging" || status=1
  fi
  if [[ $committed == "false" && $published == "true" && -n $target ]] &&
    qvos_boot_root_exists "$target"; then
    if sudo rm -rf -- "$target"; then
      published=false
    else
      status=1
    fi
  fi
  if [[ -n $backup ]] && qvos_boot_root_exists "$backup"; then
    if [[ $committed == "false" ]]; then
      if [[ -n $target ]] && ! qvos_boot_root_exists "$target"; then
        sudo mv -- "$backup" "$target" || status=1
      else
        echo "Could not restore the prior qvOS $theme_kind theme; backup retained at $backup" >&2
        status=1
      fi
    else
      sudo rm -rf -- "$backup" || status=1
    fi
  fi
  exit "$status"
}
trap cleanup EXIT

usage() {
  echo "Usage: ${0##*/} <plymouth|sddm>" >&2
  exit 2
}

(( $# == 1 )) || usage
case $1 in
plymouth)
  theme_kind=plymouth
  source_dir="$QVOS_PATH/qvcore/boot/plymouth"
  target=$(qvos_boot_path /usr/share/plymouth/themes/qvos)
  ;;
sddm)
  theme_kind=sddm
  source_dir="$QVOS_PATH/qvcore/boot/sddm"
  target=$(qvos_boot_path /usr/share/sddm/themes/qvos)
  ;;
*) usage ;;
esac

logo_source="$QVOS_PATH/qvcore/boot/logo.png"
[[ -f $logo_source && ! -L $logo_source ]] || {
  echo "qvOS boot logo source is unavailable: $logo_source" >&2
  exit 1
}

[[ -d $source_dir && ! -L $source_dir ]] || {
  echo "qvOS boot theme source is unavailable: $source_dir" >&2
  exit 1
}
if [[ -n $(find "$source_dir" -mindepth 1 -maxdepth 1 ! -type f -print -quit) ]]; then
  echo "qvOS boot theme contains an unsupported entry" >&2
  exit 1
fi
[[ ! -e $source_dir/logo.png && ! -L $source_dir/logo.png ]] || {
  echo "qvOS boot theme duplicates the shared logo: $source_dir/logo.png" >&2
  exit 1
}

mapfile -d '' -t payloads < <(
  find "$source_dir" -mindepth 1 -maxdepth 1 -type f -print0 | sort -z
)
(( ${#payloads[@]} > 0 )) || {
  echo "qvOS boot theme is empty: $source_dir" >&2
  exit 1
}

parent=${target%/*}
sudo install -d -m 0755 -- "$parent"
staging=$(sudo mktemp -d "$parent/.qvos-$1.XXXXXX")
[[ $staging == "$parent/.qvos-$1."* ]] || {
  echo "Unexpected boot theme staging path" >&2
  exit 1
}

for source_file in "${payloads[@]}"; do
  sudo install -m 0644 -- "$source_file" "$staging/${source_file##*/}"
done
# Both themes need the logo at runtime, but the repository keeps one master.
sudo install -m 0644 -- "$logo_source" "$staging/logo.png"
sudo chmod 0755 "$staging"

if qvos_boot_root_exists "$target"; then
  backup=$(sudo mktemp -d "$parent/.qvos-$1-backup.XXXXXX")
  [[ $backup == "$parent/.qvos-$1-backup."* ]] || {
    echo "Unexpected boot theme backup path" >&2
    exit 1
  }
  sudo rmdir -- "$backup"
  sudo mv -- "$target" "$backup"
fi

if ! sudo mv -- "$staging" "$target"; then
  if [[ -n $backup ]] && qvos_boot_root_exists "$backup"; then
    sudo mv -- "$backup" "$target"
    backup=
  fi
  exit 1
fi
staging=
published=true

case $1 in
plymouth)
  sudo plymouth-set-default-theme qvos
  ;;
sddm)
  qvos_boot_install_text \
    0644 \
    "$(qvos_boot_path /etc/sddm.conf.d/qvos.conf)" \
    $'[Theme]\nCurrent=qvos\n'
  ;;
esac
committed=true

if [[ -n $backup ]]; then
  sudo rm -rf -- "$backup"
  backup=
fi
