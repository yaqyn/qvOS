#!/bin/bash
set -euo pipefail

OMARCHY_PATH=${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)}
source "$OMARCHY_PATH/qvcore/boot/install-lib"
qvos_boot_init

[[ -n ${USER:-} && $USER =~ ^[[:alnum:]_.@-]+$ ]] || {
  echo "Refusing an invalid SDDM autologin user" >&2
  exit 1
}
id -u "$USER" >/dev/null 2>&1 || {
  echo "SDDM autologin user does not exist: $USER" >&2
  exit 1
}

"$OMARCHY_PATH/qvcore/boot/sync-theme" sddm

"$OMARCHY_PATH/qvcore/boot/install-sddm-session"
"$OMARCHY_PATH/qvcore/boot/install-sddm-wayland"

autologin_config=$(qvos_boot_path /etc/sddm.conf.d/autologin.conf)
if ! qvos_boot_root_exists "$autologin_config"; then
  printf -v autologin_content \
    '[Autologin]\nUser=%s\nSession=omarchy\n\n[Theme]\nCurrent=omarchy\n' \
    "$USER"
  qvos_boot_install_text 0644 "$autologin_config" "$autologin_content"
fi

pam_config=$(qvos_boot_path /etc/pam.d/sddm)
qvos_boot_require_regular "$pam_config"
sudo sed -i \
  -e '/-auth.*pam_gnome_keyring\.so/d' \
  -e '/-password.*pam_gnome_keyring\.so/d' \
  "$pam_config"

# Starting SDDM inside a manual install interrupts the active session.
sudo systemctl enable sddm.service
