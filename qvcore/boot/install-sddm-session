#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)}
# shellcheck source=qvcore/boot/install-lib disable=SC1091
source "$QVOS_PATH/qvcore/boot/install-lib"
qvos_boot_init

reconcile_sddm_autologin() {
  local target=$1
  local current
  local updated

  qvos_boot_root_exists "$target" || return 0
  current=$(qvos_boot_read_file "$target") || return 1
  updated=$(
    awk '
      $0 == "Session=hyprland-uwsm" {
        print "Session=qvos"
        next
      }
      { print }
    ' <<<"$current"
  )
  [[ $updated == "$current" ]] ||
    qvos_boot_install_text 0644 "$target" "$updated"$'\n'
}

launcher_source="$QVOS_PATH/qvcore/boot/session-start"
launcher_target=$(qvos_boot_path /usr/local/bin/qvos-session)
qvos_boot_install_file 0755 "$launcher_source" "$launcher_target"

session_source="$QVOS_PATH/qvcore/boot/wayland-sessions/qvos.desktop"
session_target=$(qvos_boot_path /usr/local/share/wayland-sessions/qvos.desktop)
qvos_boot_install_file \
  0644 \
  "$session_source" \
  "$session_target"

autologin_config=$(qvos_boot_path /etc/sddm.conf.d/autologin.conf)
reconcile_sddm_autologin "$autologin_config"
