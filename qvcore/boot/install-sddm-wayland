#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)}}
source "$QVOS_PATH/qvcore/boot/install-lib"
qvos_boot_init

hyprland_config=$(qvos_boot_path /usr/share/sddm/hyprland.conf)
wayland_config=$(qvos_boot_path /etc/sddm.conf.d/10-wayland.conf)
wayland_content=$'[General]\nDisplayServer=wayland\n\n[Wayland]\nCompositorCommand=start-hyprland -- --config /usr/share/sddm/hyprland.conf\n'

qvos_boot_install_file \
  0644 \
  "$QVOS_PATH/qvcore/boot/sddm-hyprland.conf" \
  "$hyprland_config"
qvos_boot_install_text 0644 "$wayland_config" "$wayland_content"
