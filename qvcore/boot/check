#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
native_manifest="$root/qvcore/boot/native-paths"
retired_manifest="$root/qvcore/boot/retired-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

expected_native_routes=(
  bin/omarchy-config-direct-boot
  bin/omarchy-plymouth-preview
  bin/omarchy-plymouth-reset
  bin/omarchy-plymouth-set
  bin/omarchy-refresh-limine
  bin/omarchy-refresh-plymouth
  bin/omarchy-refresh-sddm
)
expected_retired=(
  default/limine/
  default/plymouth/
  default/sddm/hyprland.conf
  default/sddm/omarchy/
  default/wayland-sessions/omarchy.desktop
)

mapfile -t native_paths < <(
  sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$native_manifest"
)
mapfile -t retired_paths < <(
  sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest"
)
[[ ${native_paths[*]} == "${expected_native_routes[*]}" ]] ||
  fail "native boot route inventory"
[[ ${retired_paths[*]} == "${expected_retired[*]}" ]] ||
  fail "retired inherited boot payload inventory"

for route in "${expected_native_routes[@]}"; do
  suffix=${route#bin/omarchy-}
  owner=$root/qvcore/boot/$suffix
  native_adapter=$root/bin/qv-$suffix
  compatibility_adapter=$root/$route
  [[ -x $native_adapter && -x $compatibility_adapter ]] ||
    fail "boot adapter mode: $suffix"
  [[ -x $owner ]] || fail "boot owner mode: $suffix"
  (( $(wc -l <"$native_adapter") <= 12 )) ||
    fail "native boot adapter contains implementation: $suffix"
  (( $(wc -l <"$compatibility_adapter") <= 6 )) ||
    fail "boot compatibility adapter contains implementation: $suffix"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native boot adapter lacks metadata: $suffix"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "boot compatibility adapter duplicates metadata: $suffix"
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    grep -Fqx "exec \"\$QVOS_PATH/qvcore/boot/$suffix\" \"\$@\"" "$adapter" ||
      fail "boot adapter owner: $suffix"
  done
  ! rg -q '^# (qv|omarchy):' "$owner" ||
    fail "boot owner duplicates CLI metadata: $suffix"
done

for retired in "${expected_retired[@]}"; do
  retired=${retired%/}
  [[ ! -e $root/$retired && ! -L $root/$retired ]] ||
    fail "retired inherited boot payload remains: $retired"
done

if rg -q '(OMARCHY_PATH[^\"]*|local/share/omarchy/)default/(limine|plymouth|sddm(/hyprland\.conf|/omarchy)|wayland-sessions/omarchy)|install/login/(all|limine-snapper|plymouth|sddm)\.sh' \
  "$root/bin" "$root/qvcore/boot" \
  "$root/qvcore/menu/elephant/qvos_unlocks.lua" \
  --glob '!check' --glob '!retired-paths'; then
  fail "active boot lifecycle still reads a retired inherited payload"
fi

# shellcheck disable=SC2016
grep -Fqx 'source "$QVOS_PATH/qvcore/boot/install"' \
  "$root/install.sh" || fail "native login stage wiring"
[[ -f $root/qvcore/boot/install && ! -x $root/qvcore/boot/install ]] ||
  fail "native login stage mode"
expected_install_stage=$'run_logged "$QVOS_PATH/qvcore/boot/install-plymouth"\nrun_logged "$QVOS_PATH/qvcore/boot/login/default-keyring.sh"\nrun_logged "$QVOS_PATH/qvcore/boot/install-sddm"\nrun_logged "$QVOS_PATH/qvcore/boot/login/hibernation.sh"\nrun_logged "$QVOS_PATH/qvcore/boot/install-limine-snapper"'
[[ $(<"$root/qvcore/boot/install") == "$expected_install_stage" ]] ||
  fail "native login stage order"
for login_owner in default-keyring.sh hibernation.sh; do
  [[ -f $root/qvcore/boot/login/$login_owner &&
    ! -x $root/qvcore/boot/login/$login_owner ]] ||
    fail "native login owner mode: $login_owner"
done
# shellcheck disable=SC2016
grep -Fqx '"$QVOS_PATH/qvcore/power/hibernation/setup" --force --no-rebuild' \
  "$root/qvcore/boot/login/hibernation.sh" ||
  fail "fresh install hibernation native owner"

for owner in \
  install-limine-snapper \
  install-plymouth \
  install-sddm \
  install-sddm-session \
  install-sddm-wayland \
  sync-theme; do
  [[ -x $root/qvcore/boot/$owner ]] || fail "native boot install owner mode: $owner"
done
grep -Fq 'qvcore/boot/limine/default.conf' \
  "$root/qvcore/boot/install-limine-snapper" || fail "fresh Limine defaults owner"
grep -Fq 'qvcore/boot/limine/limine.conf' \
  "$root/qvcore/boot/install-limine-snapper" || fail "fresh Limine config owner"
# shellcheck disable=SC2016
grep -Fqx '"$QVOS_PATH/qvcore/boot/sync-theme" plymouth' \
  "$root/qvcore/boot/install-plymouth" || fail "fresh Plymouth owner"
if rg -q 'mkinitcpio' "$root/qvcore/boot/install-plymouth"; then
  fail "fresh Plymouth stage performs a redundant image rebuild"
fi
# shellcheck disable=SC2016
grep -Fqx '"$QVOS_PATH/qvcore/boot/sync-theme" sddm' \
  "$root/qvcore/boot/install-sddm" || fail "fresh SDDM theme owner"
grep -Fq 'qvcore/boot/wayland-sessions/omarchy.desktop' \
  "$root/qvcore/boot/install-sddm-session" || fail "fresh Wayland session owner"
grep -Fq 'qvcore/boot/sddm-hyprland.conf' \
  "$root/qvcore/boot/install-sddm-wayland" || fail "fresh SDDM compositor owner"
grep -Fq "pam_gnome_keyring\\.so/d" \
  "$root/qvcore/boot/install-sddm" || fail "SDDM keyring compatibility"

compatibility_path_refs=$(
  # This intentionally matches the literal compatibility fallback expression.
  # shellcheck disable=SC2016
  rg -n 'OMARCHY_PATH' \
    "$root/qvcore/boot" \
    --glob '!AGENTS.md' \
    --glob '!check' \
    --glob '!native-paths' |
    grep -Fv 'QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-' || true
)
if [[ -n $compatibility_path_refs ]]; then
  printf '%s\n' "$compatibility_path_refs" >&2
  fail "native boot owner dereferences the compatibility source root"
fi
if rg -n \
  'omarchy-(config-direct-boot|plymouth-(preview|reset)|refresh-(limine|plymouth|sddm))|exec omarchy-plymouth-set([[:space:]]|$)' \
  "$root/qvcore/menu" \
  "$root/qvcore/tui" \
  "$root/qvcore/menu/elephant/qvos_unlocks.lua" \
  "$root/qvcore/theme/apply-plymouth" \
  "$root/qvcore/install/reinstall-configs" \
  --glob '!owner-contracts.psv'; then
  fail "native qvOS surface calls a boot compatibility route"
fi

printf 'ok - qvOS boot commands and payloads have one native owner\n'
