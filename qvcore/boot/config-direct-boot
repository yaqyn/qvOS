#!/bin/bash
set -euo pipefail

(( $# == 0 )) || {
  echo "Usage: qv config direct boot" >&2
  exit 2
}

if [[ ! -d /sys/firmware/efi ]]; then
  echo "Error: System is not booted in UEFI mode" >&2
  exit 1
fi

if ! efi_output=$(efibootmgr 2>/dev/null); then
  echo "Error: efibootmgr is not available or not functional" >&2
  exit 1
fi

bios_vendor=$(</sys/class/dmi/id/bios_vendor) || bios_vendor=
if grep -i "American Megatrends" <<<"$bios_vendor" >/dev/null; then
  echo "Error: American Megatrends firmware may not safely support custom EFI entries" >&2
  exit 1
fi

if grep -i "Apple" <<<"$bios_vendor" >/dev/null; then
  echo "Error: Apple firmware uses its own boot manager" >&2
  exit 1
fi

existing_entry=$(
  awk '
    /^Boot[0-9A-Fa-f]+\*? qvOS([[:space:]]|$)/ {
      print
      exit
    }
  ' <<<"$efi_output"
)

if [[ -n $existing_entry ]]; then
  boot_num=$(sed -n 's/^Boot\([0-9A-Fa-f]\+\).*/\1/p' <<<"$existing_entry")
  [[ -n $boot_num ]] || {
    echo "Error: Cannot parse the existing qvOS EFI entry" >&2
    exit 1
  }

  if gum confirm "Disable direct boot (remove qvOS EFI entry)?"; then
    echo "Removing EFI boot entry $boot_num"
    sudo efibootmgr --bootnum "$boot_num" --delete-bootnum >/dev/null
  fi

  exit 0
else
  mapfile -d '' -t uki_files < <(
    sudo find /boot/EFI/Linux/ -maxdepth 1 -type f \
      -name "qvos*.efi" -printf "%f\0" 2>/dev/null |
      sort -z
  )
  uki_file=${uki_files[0]:-}

  if [[ -z $uki_file ]]; then
    echo "Error: No qvOS UKI found in /boot/EFI/Linux/" >&2
    exit 1
  fi

  boot_source=$(findmnt -n -o SOURCE /boot)
  if [[ $boot_source =~ ^(.+)p([0-9]+)$ ]]; then
    disk=${BASH_REMATCH[1]}
    part=${BASH_REMATCH[2]}
  elif [[ $boot_source =~ ^(.+[^0-9])([0-9]+)$ ]]; then
    disk=${BASH_REMATCH[1]}
    part=${BASH_REMATCH[2]}
  else
    echo "Error: Cannot identify the boot disk and partition from $boot_source" >&2
    exit 1
  fi

  if gum confirm "Setup direct boot (so snapshot booting must be done via bios)?"; then
    echo "Creating EFI boot entry for $uki_file"

    sudo efibootmgr --create \
      --disk "$disk" \
      --part "$part" \
      --label "qvOS" \
      --loader "\\EFI\\Linux\\$uki_file"
  fi
fi
