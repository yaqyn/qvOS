#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)}
# shellcheck source=qvcore/boot/install-lib disable=SC1091
source "$QVOS_PATH/qvcore/boot/install-lib"
qvos_boot_init

defaults_staging=
qvos_resume_dropin=false
qvos_rtc_dropin=false

restore_mkinitcpio_hooks() {
  local active
  local disabled
  local hook
  local hook_dir
  local status=0

  hook_dir=$(qvos_boot_path /usr/share/libalpm/hooks)
  for hook in 90-mkinitcpio-install.hook 60-mkinitcpio-remove.hook; do
    active="$hook_dir/$hook"
    disabled="$active.disabled"
    qvos_boot_root_exists "$disabled" || continue

    if ! qvos_boot_require_regular "$disabled"; then
      status=1
      continue
    fi
    if qvos_boot_root_exists "$active"; then
      echo "Refusing to overwrite an active mkinitcpio hook: $active" >&2
      status=1
      continue
    fi
    sudo mv -- "$disabled" "$active" || status=1
  done
  return "$status"
}

cleanup() {
  local status=$?

  trap - EXIT
  [[ -z $defaults_staging ]] || rm -f -- "$defaults_staging"
  restore_mkinitcpio_hooks || status=1
  exit "$status"
}
trap cleanup EXIT

render_limine_defaults() {
  local cmdline=$1
  local output=$2
  local line
  local prefix
  local replacements=0
  local source="$QVOS_PATH/qvcore/boot/limine/default.conf"

  [[ -f $source && ! -L $source ]] || {
    echo "qvOS Limine defaults are unavailable" >&2
    return 1
  }
  : >"$output"
  while IFS= read -r line || [[ -n $line ]]; do
    while [[ $line == *@@CMDLINE@@* ]]; do
      prefix=${line%%@@CMDLINE@@*}
      printf '%s%s' "$prefix" "$cmdline" >>"$output"
      line=${line#*@@CMDLINE@@}
      ((replacements += 1))
    done
    printf '%s\n' "$line" >>"$output"
  done <"$source"

  (( replacements == 1 )) || {
    echo "qvOS Limine defaults must contain one cmdline placeholder" >&2
    return 1
  }
}

root_content_matches() {
  local content=$1
  local target=$2

  qvos_boot_root_exists "$target" || return 1
  qvos_boot_require_regular "$target" || return 1
  printf '%s' "$content" | sudo cmp -s -- - "$target"
}

root_file_matches() {
  local source=$1
  local target=$2

  [[ -f $source && ! -L $source ]] || return 1
  qvos_boot_root_exists "$target" || return 1
  qvos_boot_require_regular "$target" || return 1
  sudo cmp -s -- "$source" "$target"
}

append_limine_dropins() {
  local output=$1
  local dropin
  local dropin_dir
  local -a dropins=()

  dropin_dir=$(qvos_boot_path /etc/limine-entry-tool.d)
  if sudo test -d "$dropin_dir" && ! sudo test -L "$dropin_dir"; then
    mapfile -d '' -t dropins < <(
      sudo find "$dropin_dir" \
        -mindepth 1 -maxdepth 1 -type f -name '*.conf' -print0 |
        sort -z
    )
    for dropin in "${dropins[@]}"; do
      qvos_boot_read_file "$dropin" >>"$output"
    done
  fi
}

validate_qvos_limine_dropins() {
  local content
  local path
  local resume_pattern='^KERNEL_CMDLINE\[default\]\+=" resume=/dev/[A-Za-z0-9._/+:-]+ resume_offset=[1-9][0-9]*"$'

  path=$(qvos_boot_path /etc/limine-entry-tool.d/80-qvos-resume.conf)
  if qvos_boot_root_exists "$path"; then
    qvos_boot_require_regular "$path" || return 1
    content=$(qvos_boot_read_file "$path")
    [[ $content =~ $resume_pattern ]] || {
      echo "Error: invalid native qvOS Limine resume drop-in: $path" >&2
      return 1
    }
    qvos_resume_dropin=true
  fi

  path=$(qvos_boot_path /etc/limine-entry-tool.d/80-qvos-rtc-alarm.conf)
  if qvos_boot_root_exists "$path"; then
    qvos_boot_require_regular "$path" || return 1
    content=$(qvos_boot_read_file "$path")
    [[ $content == \
      'KERNEL_CMDLINE[default]+=" rtc_cmos.use_acpi_alarm=1"' ]] || {
      echo "Error: invalid native qvOS Limine RTC drop-in: $path" >&2
      return 1
    }
    qvos_rtc_dropin=true
  fi
}

qvos_limine_dropin_token() {
  local token=$1

  if [[ $qvos_resume_dropin == "true" ]] &&
    { [[ $token =~ ^resume=/dev/[A-Za-z0-9._/+:-]+$ ]] ||
      [[ $token =~ ^resume_offset=[1-9][0-9]*$ ]]; }; then
    return 0
  fi
  [[ $qvos_rtc_dropin == "true" &&
    $token == "rtc_cmos.use_acpi_alarm=1" ]]
}

validate_limine_cmdline_embedding() {
  local input=$1

  [[ $input != *'"'* && $input != *'$'* && $input != *'`'* &&
    $input != *\\\\* && ${input: -1} != "\\" ]]
}

sanitize_limine_cmdline() {
  local input=$1
  local token
  local -a retained=()
  local -a tokens=()

  read -r -a tokens <<<"$input"
  for token in "${tokens[@]}"; do
    qvos_limine_dropin_token "$token" || retained+=("$token")
  done

  local IFS=" "
  printf '%s\n' "${retained[*]}"
}

recover_limine_cmdline() {
  local defaults=$1
  local efi=$2
  local candidate

  qvos_boot_root_exists "$defaults" || return 1
  qvos_boot_require_regular "$defaults" || return 1
  if ! candidate=$(
    qvos_boot_read_file "$defaults" |
      awk '
        !found && /^KERNEL_CMDLINE\[default\]\+=".*"$/ {
          line = $0
          sub(/^KERNEL_CMDLINE\[default\]\+="/, "", line)
          sub(/"$/, "", line)
          print line
          found = 1
        }
        END { if (!found) exit 1 }
      '
  ); then
    return 1
  fi
  [[ -n $candidate && $candidate != *$'\n'* && $candidate != *$'\r'* &&
    $candidate != *@@CMDLINE@@* ]] || return 1

  defaults_staging=$(mktemp)
  chmod 0600 "$defaults_staging"
  render_limine_defaults "$candidate" "$defaults_staging"
  append_limine_dropins "$defaults_staging"
  if [[ $efi == "false" ]]; then
    sed -i '/^ENABLE_UKI=/d; /^ENABLE_LIMINE_FALLBACK=/d' "$defaults_staging"
  fi
  if ! sudo cmp -s -- "$defaults_staging" "$defaults"; then
    rm -f -- "$defaults_staging"
    defaults_staging=
    return 1
  fi
  rm -f -- "$defaults_staging"
  defaults_staging=
  recovered_cmdline=$candidate
}

install_limine() {
  local boot_config
  local boot_inputs_changed=false
  local candidate
  local cmdline
  local default_limine
  local efi=false
  local efi_output
  local hooks_config
  local limine_header_current=false
  local limine_header_size
  local mkinitcpio_hook_missing=false
  local legacy_hooks_config
  local legacy_hooks_content
  local legacy_uki
  local limine_config=
  local qvos_hooks_content
  local qvos_uki
  local recovered_cmdline=
  local rebuild_required=false
  local snapper_config
  local snapper_configs
  local thunderbolt_config
  local -a candidates
  local -a snapper_args=()

  validate_qvos_limine_dropins

  qvos_hooks_content=$'HOOKS=(base udev plymouth keyboard autodetect microcode modconf kms keymap consolefont block encrypt filesystems fsck btrfs-overlayfs)\nFILES+=(/etc/vconsole.conf)\n'
  legacy_hooks_content=${qvos_hooks_content%%$'\n'*}
  hooks_config=$(qvos_boot_path /etc/mkinitcpio.conf.d/qvos_hooks.conf)
  legacy_hooks_config=$(qvos_boot_path /etc/mkinitcpio.conf.d/omarchy_hooks.conf)
  thunderbolt_config=$(qvos_boot_path /etc/mkinitcpio.conf.d/thunderbolt_module.conf)
  root_content_matches "$qvos_hooks_content" "$hooks_config" ||
    boot_inputs_changed=true
  qvos_boot_install_text \
    0644 \
    "$hooks_config" \
    "$qvos_hooks_content"
  qvos_boot_remove_file_if_content \
    "$legacy_hooks_config" \
    "${qvos_hooks_content%$'\n'}" \
    "$legacy_hooks_content"
  root_content_matches $'MODULES+=(thunderbolt)\n' "$thunderbolt_config" ||
    boot_inputs_changed=true
  qvos_boot_install_text \
    0644 \
    "$thunderbolt_config" \
    $'MODULES+=(thunderbolt)\n'

  [[ ! -d $(qvos_boot_path /sys/firmware/efi) ]] || efi=true
  default_limine=$(qvos_boot_path /etc/default/limine)

  candidates=(
    /boot/EFI/arch-limine/limine.conf
    /boot/EFI/BOOT/limine.conf
    /boot/EFI/limine/limine.conf
    /boot/limine/limine.conf
    /boot/limine.conf
  )
  for candidate in "${candidates[@]}"; do
    candidate=$(qvos_boot_path "$candidate")
    if qvos_boot_root_exists "$candidate"; then
      qvos_boot_require_regular "$candidate"
      limine_config=$candidate
      break
    fi
  done
  [[ -n $limine_config ]] || {
    echo "Error: Limine config not found" >&2
    return 1
  }

  cmdline=$(
    qvos_boot_read_file "$limine_config" |
      awk '
        !found && /^[[:space:]]*cmdline:[[:space:]]*/ {
          sub(/^[[:space:]]*cmdline:[[:space:]]*/, "")
          print
          found = 1
        }
      '
  )
  if [[ -z $cmdline || $cmdline == *$'\r'* || $cmdline == *@@CMDLINE@@* ]]; then
    recover_limine_cmdline "$default_limine" "$efi" || {
      echo "Error: Limine kernel command line is missing or invalid" >&2
      return 1
    }
    cmdline=$recovered_cmdline
  fi
  (( ${#cmdline} <= 16384 )) || {
    echo "Error: Limine kernel command line is implausibly large" >&2
    return 1
  }
  validate_limine_cmdline_embedding "$cmdline" || {
    echo "Error: Limine kernel command line cannot be represented safely" >&2
    return 1
  }
  if ! cmdline=$(sanitize_limine_cmdline "$cmdline") || [[ -z $cmdline ]]; then
    echo "Error: Limine kernel command line has no safe base arguments" >&2
    return 1
  fi

  defaults_staging=$(mktemp)
  chmod 0600 "$defaults_staging"
  render_limine_defaults "$cmdline" "$defaults_staging"

  append_limine_dropins "$defaults_staging"

  if [[ $efi == "false" ]]; then
    sed -i '/^ENABLE_UKI=/d; /^ENABLE_LIMINE_FALLBACK=/d' "$defaults_staging"
  fi

  root_file_matches "$defaults_staging" "$default_limine" ||
    boot_inputs_changed=true
  qvos_boot_install_file 0644 "$defaults_staging" "$default_limine"
  rm -f -- "$defaults_staging"
  defaults_staging=

  boot_config=$(qvos_boot_path /boot/limine.conf)
  if qvos_boot_root_exists "$boot_config"; then
    qvos_boot_require_regular "$boot_config"
    limine_header_size=$(stat -c '%s' \
      "$QVOS_PATH/qvcore/boot/limine/limine.conf")
    if sudo cmp -s -n "$limine_header_size" -- \
      "$QVOS_PATH/qvcore/boot/limine/limine.conf" "$boot_config"; then
      limine_header_current=true
    fi
  fi
  if [[ $limine_header_current == "false" ]]; then
    qvos_boot_install_file \
      0644 \
      "$QVOS_PATH/qvcore/boot/limine/limine.conf" \
      "$boot_config"
  fi
  if [[ $limine_config != "$boot_config" ]]; then
    sudo rm -f -- "$limine_config"
  fi

  if "$QVOS_PATH/qvcore/packages/missing" limine-mkinitcpio-hook; then
    mkinitcpio_hook_missing=true
  fi
  "$QVOS_PATH/qvcore/packages/add" \
    inotify-tools \
    limine-mkinitcpio-hook \
    limine-snapper-sync

  [[ -z ${OMARCHY_CHROOT_INSTALL:-} ]] || snapper_args+=(--no-dbus)
  # Snapper reports an empty fresh-install inventory with a non-zero status.
  # The following create-config call remains authoritative and must surface a
  # real failure.
  snapper_configs=$(sudo snapper "${snapper_args[@]}" list-configs 2>/dev/null || true)
  if ! awk 'NR > 2 && $1 == "root" { found = 1 } END { exit !found }' \
    <<<"$snapper_configs"; then
    sudo snapper "${snapper_args[@]}" -c root create-config /
  fi
  snapper_config=$(qvos_boot_path /etc/snapper/configs/root)
  qvos_boot_install_file \
    0644 \
    "$QVOS_PATH/qvcore/boot/snapper-root.conf" \
    "$snapper_config"

  # Full qgroup accounting makes snapshot deletion and package updates slower.
  sudo btrfs quota disable / 2>/dev/null || true

  if declare -F chrootable_systemctl_enable >/dev/null; then
    chrootable_systemctl_enable limine-snapper-sync.service
  elif [[ -n ${OMARCHY_CHROOT_INSTALL:-} ]]; then
    sudo systemctl enable limine-snapper-sync.service
  else
    sudo systemctl enable --now limine-snapper-sync.service
  fi

  restore_mkinitcpio_hooks

  qvos_uki=$(qvos_boot_path /boot/EFI/Linux/qvos_linux.efi)
  # Package hooks normally build the UKI and entries once. Rebuild only if the
  # installed artifacts prove that did not happen, or when changed native boot
  # inputs cannot be covered by a newly installed mkinitcpio hook.
  if [[ $boot_inputs_changed == "true" &&
    $mkinitcpio_hook_missing == "false" ]]; then
    rebuild_required=true
  elif ! sudo grep -q '^/+' "$boot_config"; then
    rebuild_required=true
  elif [[ $efi == "true" ]] &&
    { ! qvos_boot_root_exists "$qvos_uki" || ! sudo test -s "$qvos_uki"; }; then
    rebuild_required=true
  fi
  if [[ $rebuild_required == "true" ]]; then
    sudo limine-update
  fi
  if ! sudo grep -q '^/+' "$boot_config"; then
    echo "Error: failed to add boot entries to $boot_config" >&2
    return 1
  fi
  if [[ $efi == "true" ]]; then
    if ! qvos_boot_root_exists "$qvos_uki" ||
      ! qvos_boot_require_regular "$qvos_uki" || ! sudo test -s "$qvos_uki"; then
      echo "Error: failed to create the qvOS UKI at $qvos_uki" >&2
      return 1
    fi

    legacy_uki=$(qvos_boot_path /boot/EFI/Linux/omarchy_linux.efi)
    if qvos_boot_root_exists "$legacy_uki"; then
      if sudo test -L "$legacy_uki" || ! sudo test -f "$legacy_uki"; then
        echo "Preserving modified or unsafe legacy UKI: $legacy_uki" >&2
      else
        sudo rm -f -- "$legacy_uki"
      fi
    fi
  fi

  if [[ $efi == "true" ]] && command -v efibootmgr &>/dev/null; then
    if efi_output=$(sudo efibootmgr 2>/dev/null); then
      while IFS= read -r bootnum; do
        sudo efibootmgr -b "$bootnum" -B >/dev/null 2>&1
      done < <(
        awk '
          /^Boot[[:xdigit:]]{4}\*?[[:space:]]+Arch Linux Limine/ {
            print substr($1, 5, 4)
          }
        ' <<<"$efi_output"
      )
    fi
  fi
}

limine_available=true
if [[ -n $QVOS_BOOT_SYSTEM_ROOT && ${QVOS_BOOT_TEST_NO_LIMINE:-} == "1" ]]; then
  limine_available=false
elif ! command -v limine &>/dev/null; then
  limine_available=false
fi

if [[ $limine_available == "true" ]]; then
  install_limine
fi

echo "Re-enabling mkinitcpio hooks..."
restore_mkinitcpio_hooks
trap - EXIT
echo "mkinitcpio hooks re-enabled"
