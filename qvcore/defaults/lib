#!/bin/bash

qvos_defaults_validate_target() {
  local target=$1
  local current
  local parent
  local existing

  [[ $target == /* && $target != "/" ]] || {
    echo "qvOS defaults: target must be an absolute user path." >&2
    return 1
  }

  current=$target
  while [[ $current != "/" ]]; do
    [[ ! -L $current ]] || {
      echo "qvOS defaults: refusing symbolic-link path: $current" >&2
      return 1
    }
    current=$(dirname -- "$current")
  done

  if [[ -e $target ]]; then
    [[ -f $target && -O $target ]] || {
      echo "qvOS defaults: refusing unsafe user file: $target" >&2
      return 1
    }
  fi

  parent=$(dirname -- "$target")
  existing=$parent
  while [[ ! -e $existing ]]; do
    existing=$(dirname -- "$existing")
  done
  [[ -d $existing && ! -L $existing && -O $existing ]] || {
    echo "qvOS defaults: refusing unsafe parent: $existing" >&2
    return 1
  }

  mkdir -p -- "$parent"
  [[ -d $parent && ! -L $parent && -O $parent ]] || {
    echo "qvOS defaults: could not establish a safe parent: $parent" >&2
    return 1
  }
}

qvos_defaults_atomic_write() {
  local target=$1
  local mode=$2
  local parent
  local temporary

  [[ $mode =~ ^[0-7]{3,4}$ ]] || {
    echo "qvOS defaults: invalid destination mode." >&2
    return 1
  }
  qvos_defaults_validate_target "$target" || return
  parent=$(dirname -- "$target")
  temporary=$(mktemp --tmpdir="$parent" .qvos-default.XXXXXX) || return

  if ! cat >"$temporary" ||
    ! chmod "$mode" "$temporary" ||
    ! mv -T -- "$temporary" "$target"; then
    rm -f -- "$temporary"
    echo "qvOS defaults: could not replace $target safely." >&2
    return 1
  fi
}

qvos_defaults_notify() {
  command -v -- notify-send >/dev/null 2>&1 || return 0
  notify-send -u low "$@" >/dev/null 2>&1 || true
}
