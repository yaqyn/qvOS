#!/bin/bash
set -euo pipefail

mode=${1:---all}
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/qvos"
runtime_root="$HOME/.local/lib/qvos"
legacy_enrollment_root="$state_root/qvcore"

usage() {
  echo "Usage: qvcore/install/migrate-structure [--all|--proton|--devel]" >&2
}

safe_parent() {
  local path=$1
  local stop=$2

  while [[ $path != "$stop" ]]; do
    [[ -d $path && ! -L $path && -O $path ]] || return 1
    path=$(dirname -- "$path")
  done
  [[ -d $stop && ! -L $stop && -O $stop ]]
}

migrate_marker() {
  local legacy=$1
  local target=$2
  local target_parent
  local legacy_present=false

  if [[ -e $legacy || -L $legacy ]]; then
    legacy_present=true
    [[ -f $legacy && ! -L $legacy && -O $legacy && ! -s $legacy ]] || {
      echo "Refusing unsafe legacy qvOS enrollment marker: $legacy" >&2
      return 1
    }
    safe_parent "$(dirname -- "$legacy")" "$state_root" || {
      echo "Refusing unsafe legacy qvOS enrollment parent: $legacy" >&2
      return 1
    }
  elif [[ ! -e $target && ! -L $target ]]; then
    return 0
  fi

  target_parent=$(dirname -- "$target")
  [[ $(dirname -- "$target_parent") == "$state_root" ]] || {
    echo "Refusing unexpected qvOS enrollment target: $target" >&2
    return 1
  }
  if [[ -e $target_parent || -L $target_parent ]]; then
    [[ -d $target_parent && ! -L $target_parent && -O $target_parent ]] || {
      echo "Refusing unsafe qvOS enrollment target parent: $target_parent" >&2
      return 1
    }
  else
    install -d -m 0700 "$target_parent"
  fi
  chmod 0700 "$target_parent"
  if [[ -e $target || -L $target ]]; then
    [[ -f $target && ! -L $target && -O $target && ! -s $target ]] || {
      echo "Refusing conflicting qvOS enrollment marker: $target" >&2
      return 1
    }
    if [[ $legacy_present == "true" ]]; then
      rm -f -- "$legacy"
    fi
  else
    mv -- "$legacy" "$target"
  fi
  chmod 0600 "$target"
}

migrate_devel_tools() {
  local legacy="$runtime_root/qvdev-tools"
  local target="$runtime_root/devel-tools"

  [[ ! -e $legacy && ! -L $legacy ]] && return 0
  [[ -d $legacy && ! -L $legacy && -O $legacy ]] || {
    echo "Refusing unsafe legacy Devel tool root: $legacy" >&2
    return 1
  }
  [[ -d $runtime_root && ! -L $runtime_root && -O $runtime_root ]] || {
    echo "Refusing unsafe qvOS runtime root: $runtime_root" >&2
    return 1
  }
  if [[ -e $target || -L $target ]]; then
    echo "Refusing conflicting Devel tool roots: $legacy and $target" >&2
    return 1
  fi
  mv -- "$legacy" "$target"
  chmod 0700 "$target"
}

cleanup_legacy_root() {
  [[ -d $legacy_enrollment_root && ! -L $legacy_enrollment_root &&
    -O $legacy_enrollment_root ]] || return 0
  rmdir -- "$legacy_enrollment_root" 2>/dev/null || true
}

case $mode in
--all)
  migrate_marker \
    "$legacy_enrollment_root/proton" \
    "$state_root/services/proton"
  migrate_marker \
    "$legacy_enrollment_root/qvdev" \
    "$state_root/development/devel"
  migrate_devel_tools
  cleanup_legacy_root
  ;;
--proton)
  migrate_marker \
    "$legacy_enrollment_root/proton" \
    "$state_root/services/proton"
  cleanup_legacy_root
  ;;
--devel)
  migrate_marker \
    "$legacy_enrollment_root/qvdev" \
    "$state_root/development/devel"
  migrate_devel_tools
  cleanup_legacy_root
  ;;
*)
  usage
  exit 2
  ;;
esac
