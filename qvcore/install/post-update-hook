#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
config_source="$QVOS_PATH/qvcore/config/files"
theme_name_path="$HOME/.config/qvos/current/theme.name"
current_theme="Yaqyn"

# shellcheck source=qvcore/install/desktop disable=SC1091
source "$QVOS_PATH/qvcore/install/desktop"

while IFS= read -r -d '' source_file; do
  config_path=${source_file#"$config_source/"}
  target_file="$HOME/.config/$config_path"
  if [[ ! -e $target_file && ! -L $target_file ]]; then
    install -D -m "$(stat -c '%a' "$source_file")" \
      "$source_file" "$target_file"
  fi
done < <(find "$config_source" -type f -print0 | sort -z)

# QVOS_PATH is initialized by this owner before the desktop subshell is sourced.
# shellcheck disable=SC2031
"$QVOS_PATH/qvcore/theme/config-root"

if [[ -f $theme_name_path ]]; then
  current_theme=$(<"$theme_name_path")
fi
# shellcheck disable=SC2031
"$QVOS_PATH/qvcore/theme/install"
if ! QVOS_THEME_SKIP_BACKGROUND=1 qv-theme-set "$current_theme"; then
  echo "The selected theme is no longer available; returning to Yaqyn." >&2
  QVOS_THEME_SKIP_BACKGROUND=1 qv-theme-set "Yaqyn"
fi
