#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
OMARCHY_PATH=$QVOS_PATH
config_source="$QVOS_PATH/qvcore/config/files"
theme_name_path="$HOME/.config/omarchy/current/theme.name"
current_theme="Yaqyn"

# shellcheck source=qvcore/install/desktop
source "$QVOS_PATH/qvcore/install/desktop"

while IFS= read -r -d '' source_file; do
  config_path=${source_file#"$config_source/"}
  target_file="$HOME/.config/$config_path"
  if [[ ! -e $target_file && ! -L $target_file ]]; then
    install -D -m "$(stat -c '%a' "$source_file")" \
      "$source_file" "$target_file"
  fi
done < <(find "$config_source" -type f -print0 | sort -z)

declare -A branding_sources=(
  ["$HOME/.config/omarchy/branding/about.txt"]="$QVOS_PATH/qvcore/branding/icon.txt"
  ["$HOME/.config/omarchy/branding/screensaver.txt"]="$QVOS_PATH/qvcore/branding/logo.txt"
)
for target_file in "${!branding_sources[@]}"; do
  if [[ ! -e $target_file ]]; then
    install -D -m 0644 "${branding_sources[$target_file]}" "$target_file"
  fi
done

if [[ -f $theme_name_path ]]; then
  current_theme=$(<"$theme_name_path")
fi
"$QVOS_PATH/qvcore/theme/install"
if ! OMARCHY_THEME_SKIP_BACKGROUND=1 omarchy-theme-set "$current_theme"; then
  echo "The selected theme is no longer available; returning to Yaqyn." >&2
  OMARCHY_THEME_SKIP_BACKGROUND=1 omarchy-theme-set "Yaqyn"
fi

hyprland_config="$HOME/.config/hypr/hyprland.conf"
qv_source='source = ~/.config/hypr/qv.conf'
if [[ -f $hyprland_config ]] &&
  ! grep -Fqx "$qv_source" "$hyprland_config"; then
  cp -a "$hyprland_config" "$hyprland_config.bak.$(date +%s)"
  printf '\n%s\n' "$qv_source" >>"$hyprland_config"
fi
