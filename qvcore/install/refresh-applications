#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}

(( $# == 0 )) || {
  echo "Usage: qv refresh applications" >&2
  exit 2
}

application_dir="$HOME/.local/share/applications"
"$QVOS_PATH/qvcore/desktop/applications/install"

if qv-cmd-present foot; then
  install -d -- "$application_dir"
  install -m 0644 "$QVOS_PATH/qvcore/software/foot.desktop" \
    "$application_dir/foot.desktop"
fi

"$QVOS_PATH/qvcore/install/packaging/webapps"
"$QVOS_PATH/qvcore/install/packaging/npx"

# The fixed payload adds one hicolor icon but does not own a complete local
# icon theme. Cache generation is an optional optimization and legitimately
# returns non-zero when the inherited system index is used.
gtk-update-icon-cache "$HOME/.local/share/icons/hicolor" &>/dev/null || true
update-desktop-database "$application_dir"
