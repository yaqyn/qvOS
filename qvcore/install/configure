# shellcheck shell=bash

(
  set -euo pipefail

  monitor_owner="$QVOS_PATH/qvcore/config/monitor-autodetect"

  for source_path in \
    "$monitor_owner" \
    "$QVOS_PATH/qvcore/shell/install"; do
    if [[ ! -e $source_path ]]; then
      echo "Missing qvOS configuration source: $source_path" >&2
      exit 1
    fi
  done

  # shellcheck disable=SC1091
  source "$QVOS_PATH/qvcore/install/config/mimetypes"
  # shellcheck source=qvcore/install/desktop
  source "$QVOS_PATH/qvcore/install/desktop"
)
