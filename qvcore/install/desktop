    qvcore/waybar/runtime-paths
    qvcore/weather/waybar
  )
  for source_path in "${required_sources[@]}"; do
    if [[ ! -f $QVOS_PATH/$source_path ]]; then
      echo "Missing qvOS desktop feature file: $QVOS_PATH/$source_path" >&2
      exit 1
    fi
  done

  publish_runtime_inventory() (
    set -euo pipefail
    export LC_ALL=C

    local source_root=$1
    local manifest=$2
    local runtime_root=$3
    local runtime_name=$4
    local backup=""
    local previous_path=""
    local restore=false
    local runtime_path
    local runtime_source
    local staged_count=0
    local stage

    [[ -f $manifest && ! -L $manifest ]] || {
      echo "Unsafe qvOS $runtime_name runtime manifest: $manifest" >&2
      exit 1
    }
    [[ ! -L $runtime_root ]] || {
      echo "Refusing symbolic-link qvOS $runtime_name runtime: $runtime_root" >&2
      exit 1
    }
    [[ ! -e $runtime_root || -d $runtime_root ]] || {
      echo "Refusing non-directory qvOS $runtime_name runtime: $runtime_root" >&2
      exit 1
    }

    stage=$(mktemp -d "$HOME/.local/lib/qvos/.${runtime_name}-stage.XXXXXX")
    # shellcheck disable=SC2329
    cleanup_runtime_stage() {
      local status=$?

      trap - EXIT
      [[ ! -d $stage ]] || rm -rf -- "$stage"
      if [[ $restore == "true" && ! -e $runtime_root && -d $backup ]]; then
        mv -- "$backup" "$runtime_root" || true
      fi
      exit "$status"
    }
    trap cleanup_runtime_stage EXIT

    while IFS= read -r runtime_path; do
      [[ $runtime_path == \#* || -z $runtime_path ]] && continue
      [[ $runtime_path =~ ^[a-z0-9][a-z0-9._/-]*$ &&
        $runtime_path != *..* ]] || {
        echo "Invalid qvOS $runtime_name runtime path: $runtime_path" >&2
        exit 1
      }
      [[ -z $previous_path || $runtime_path > "$previous_path" ]] || {
        echo "Unordered or duplicate qvOS $runtime_name runtime path: $runtime_path" >&2
        exit 1
      }
      previous_path=$runtime_path
      runtime_source="$source_root/$runtime_path"
      [[ -f $runtime_source && ! -L $runtime_source ]] || {
        echo "Unsafe qvOS $runtime_name runtime source: $runtime_source" >&2
        exit 1
      }
      install -D -m "$(stat -c '%a' -- "$runtime_source")" \
        "$runtime_source" "$stage/$runtime_path"
      ((staged_count += 1))
    done <"$manifest"
    ((staged_count > 0)) || {
      echo "Empty qvOS $runtime_name runtime manifest: $manifest" >&2
      exit 1
    }

    if [[ -d $runtime_root ]]; then
      backup=$(mktemp -d "$HOME/.local/lib/qvos/.${runtime_name}-backup.XXXXXX")
      rmdir -- "$backup"
      mv -- "$runtime_root" "$backup"
      restore=true
    fi
    mv -- "$stage" "$runtime_root"
    stage=""
    restore=false
    if [[ -n $backup ]]; then
      rm -rf -- "$backup"
      backup=""
    fi
    trap - EXIT
  )

  "$QVOS_PATH/qvcore/hooks/reconcile"

  "$QVOS_PATH/qvcore/branding/install"
  "$QVOS_PATH/qvcore/config/assistant/install"
  if { [[ -e $HOME/.config/helix/config.toml ||
    -L $HOME/.config/helix/config.toml ||
    -e $HOME/.config/helix/themes ||
    -L $HOME/.config/helix/themes ]]; } && qv-pkg-present helix; then
    if ! "$QVOS_PATH/qvcore/software/helix-install" --reconcile; then
      echo "qvOS preserved the current Helix configuration because it could not be reconciled." >&2
    fi
  fi

  "$QVOS_PATH/qvcore/config/toggle-state"
  "$QVOS_PATH/qvcore/config/user-services"

  publish_runtime_inventory \
    "$QVOS_PATH/qvcore/direct" \
    "$QVOS_PATH/qvcore/direct/runtime-paths" \
    "$HOME/.local/lib/qvos/direct" \
    direct
  publish_runtime_inventory \
    "$QVOS_PATH/qvcore/tmux" \
    "$QVOS_PATH/qvcore/tmux/runtime-paths" \
    "$HOME/.local/lib/qvos/tmux" \
    tmux

  "$QVOS_PATH/qvcore/waybar/install"

  publish_runtime_inventory \
    "$QVOS_PATH/qvcore/desktop" \
    "$QVOS_PATH/qvcore/desktop/runtime-paths" \
    "$HOME/.local/lib/qvos/desktop" \
    desktop

  thunar_source="$QVOS_PATH/qvcore/thunar"
  thunar_runtime="$HOME/.local/lib/qvos/thunar"
  preserved_thunar=$(mktemp -d)
  for feature in codex proton-drive-upload; do
    [[ -e $thunar_runtime/$feature ]] || continue
    cp -a "$thunar_runtime/$feature" "$preserved_thunar/$feature"
  done
  rm -rf -- "$thunar_runtime"
  install -d "$thunar_runtime"
  for feature in \
    actions.sh \
    install \
    launch \
    open-here \
    reconcile-default-actions \
    set-background \
    share \
    transcode; do
    cp -a "$thunar_source/$feature" "$thunar_runtime/$feature"
  done
  cp -a "$preserved_thunar/." "$thunar_runtime/"
  rm -rf -- "$preserved_thunar"

  "$thunar_runtime/install"

  for integration_owner in \
    "$QVOS_PATH/services/proton/manage" \
    "$QVOS_PATH/development/devel/manage"; do
    if [[ ! -e $integration_owner && ! -L $integration_owner ]]; then
      continue
    fi
    [[ -x $integration_owner && ! -L $integration_owner ]] || {
      echo "Unsafe qvOS integration owner: $integration_owner" >&2
      exit 1
    }
    "$integration_owner" reconcile
  done

  "$QVOS_PATH/qvcore/menu/install" --install

  QVOS_WAYBAR_SKIP_RESTART=1 \
    "$QVOS_PATH/qvcore/waybar/refresh" --reset

  if ! "$HOME/.local/lib/qvos/thunar/reconcile-default-actions"; then
    echo "qvOS preserved the current Thunar actions because they could not be reconciled." >&2
  fi

  "$QVOS_PATH/qvcore/tui/install" --build-if-available
  "$QVOS_PATH/qvcore/shell/install"
  "$QVOS_PATH/qvcore/screensaver/install"
  "$QVOS_PATH/qvcore/install/printing-policy"
  "$QVOS_PATH/qvcore/network/install"
  "$QVOS_PATH/qvcore/power/install"
  "$QVOS_PATH/qvcore/controls/install-root"
  "$QVOS_PATH/qvcore/security/install"
)
