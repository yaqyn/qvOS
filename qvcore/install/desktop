# shellcheck shell=bash

# Install qvOS-owned desktop helpers after base configuration.
(
  set -euo pipefail

  QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
  export QVOS_PATH

  mkdir -p "$HOME/.local/lib/qvos"

  for feature in branding desktop direct hooks network power screensaver security shell thunar tmux tui waybar windows; do
    feature_source="$QVOS_PATH/qvcore/$feature"
    if [[ ! -d $feature_source ]]; then
      echo "Missing qvOS desktop feature source: $feature_source" >&2
      exit 1
    fi
  done

  required_sources=(
    qvcore/desktop/context/qvos-active-location
    qvcore/desktop/context/qvos-launch-editor-here
    qvcore/desktop/context/qvos-launch-terminal-here
