    qvcore/shell/aliases
    qvcore/shell/install
    qvcore/software/helix-install
    qvcore/software/foot.desktop
    qvcore/software/terminal-install
    qvcore/software/voxtype-config.toml
    qvcore/software/zed-install
    qvcore/theme/set-zed
    qvcore/thunar/actions.sh
    qvcore/thunar/codex
    qvcore/thunar/install
    qvcore/thunar/launch
    qvcore/thunar/open-here
    qvcore/thunar/proton-drive-upload
    qvcore/thunar/reconcile-default-actions
    qvcore/thunar/set-background
    qvcore/thunar/share
    qvcore/thunar/transcode
    qvcore/tui/install
    qvcore/tui/launch
    qvcore/tui/owner-resolver
    qvcore/tui/selection-owner
    qvcore/tui/action/choices.psv
    qvcore/tui/action/forms.psv
    qvcore/tui/action/font-launch
    qvcore/tui/action/font-run
    qvcore/tui/action/launch
    qvcore/tui/action/post-actions.psv
    qvcore/tui/action/post-run
    qvcore/tui/action/run
    qvcore/tui/action/run-installer
    qvcore/tui/action/rollback-owner
    qvcore/tui/action/terminal-launch
    qvcore/tui/action/terminal-run
    qvcore/tui/success-guidance.psv
    qvcore/tui/task/actions.psv
    qvcore/tui/task/launch
    qvcore/tui/task/run
    qvcore/tui/task/selectable-owner
    qvcore/tui/task/selections.psv
    qvcore/tui/update/launch
    qvcore/tui/update/run
    qvcore/update/reboot-request
    qvcore/windows/command
    qvcore/windows/lib
    qvcore/windows/manage
    qvcore/windows/launch
    qvcore/windows/reconcile
    qvcore/tmux/qvos-tmux
    qvcore/waybar/clock.sh
    qvcore/waybar/idle-status
    qvcore/waybar/install
    qvcore/waybar/notification-status
    qvcore/waybar/post-update-hook
    qvcore/waybar/prayer-data.sh
    qvcore/waybar/prayerbar.sh
    qvcore/waybar/refresh
    qvcore/waybar/retired-paths
    qvcore/waybar/runtime-paths
    qvcore/weather/waybar
  )
  for source_path in "${required_sources[@]}"; do
    if [[ ! -f $QVOS_PATH/$source_path ]]; then
      echo "Missing qvOS desktop feature file: $QVOS_PATH/$source_path" >&2
      exit 1
    fi
  done

  "$QVOS_PATH/qvcore/install/migrate-structure" --all
  "$QVOS_PATH/qvcore/hooks/reconcile"

  "$QVOS_PATH/qvcore/branding/install"
  "$QVOS_PATH/qvcore/config/assistant/install"
  "$QVOS_PATH/qvcore/config/neovim"

  "$QVOS_PATH/qvcore/config/toggle-state"
  "$QVOS_PATH/qvcore/config/user-services"

  "$QVOS_PATH/qvcore/config/migrate-runtime-root"
  "$QVOS_PATH/qvcore/install/cleanup-obsolete"
  "$QVOS_PATH/qvcore/windows/reconcile"

  for feature in direct tmux; do
    feature_source="$QVOS_PATH/qvcore/$feature"
    feature_runtime="$HOME/.local/lib/qvos/$feature"

    rm -rf -- "$feature_runtime"
    cp -a "$feature_source" "$feature_runtime"
  done

  "$QVOS_PATH/qvcore/waybar/install"

  desktop_source="$QVOS_PATH/qvcore/desktop"
  desktop_runtime="$HOME/.local/lib/qvos/desktop"
  desktop_stage=$(mktemp -d "$HOME/.local/lib/qvos/.desktop-stage.XXXXXX")
  desktop_backup=""
  desktop_restore=false

  # shellcheck disable=SC2329
  cleanup_desktop_stage() {
    local status=$?

    if [[ -n $desktop_stage && -d $desktop_stage ]]; then
      rm -rf -- "$desktop_stage"
    fi
    if [[ $desktop_restore == "true" && ! -e $desktop_runtime && -d $desktop_backup ]]; then
      mv -- "$desktop_backup" "$desktop_runtime" || true
    fi
    exit "$status"
  }
  trap cleanup_desktop_stage EXIT

  [[ ! -L $desktop_runtime ]] || {
    echo "Refusing symbolic-link qvOS desktop runtime: $desktop_runtime" >&2
    exit 1
  }
  [[ ! -e $desktop_runtime || -d $desktop_runtime ]] || {
    echo "Refusing non-directory qvOS desktop runtime: $desktop_runtime" >&2
    exit 1
  }

  while IFS= read -r runtime_path; do
    [[ $runtime_path == \#* || -z $runtime_path ]] && continue
    [[ $runtime_path =~ ^[a-z0-9][a-z0-9._/-]*$ && $runtime_path != *..* ]] || {
      echo "Invalid qvOS desktop runtime path: $runtime_path" >&2
      exit 1
    }
    runtime_source="$desktop_source/$runtime_path"
    [[ -f $runtime_source && ! -L $runtime_source ]] || {
      echo "Unsafe qvOS desktop runtime source: $runtime_source" >&2
      exit 1
    }
    install -D -m "$(stat -c '%a' -- "$runtime_source")" \
      "$runtime_source" "$desktop_stage/$runtime_path"
  done <"$desktop_source/runtime-paths"

  if [[ -d $desktop_runtime ]]; then
    desktop_backup=$(mktemp -d "$HOME/.local/lib/qvos/.desktop-backup.XXXXXX")
    rmdir -- "$desktop_backup"
    mv -- "$desktop_runtime" "$desktop_backup"
    desktop_restore=true
  fi
  mv -- "$desktop_stage" "$desktop_runtime"
  desktop_stage=""
  desktop_restore=false
  if [[ -n $desktop_backup ]]; then
    rm -rf -- "$desktop_backup"
    desktop_backup=""
  fi
  trap - EXIT

  thunar_source="$QVOS_PATH/qvcore/thunar"
  thunar_runtime="$HOME/.local/lib/qvos/thunar"
  preserved_thunar=$(mktemp -d)
  for feature in codex proton-drive-upload; do
    [[ -e $thunar_runtime/$feature ]] || continue
    cp -a "$thunar_runtime/$feature" "$preserved_thunar/$feature"
  done
  rm -rf -- "$thunar_runtime"
  install -d "$thunar_runtime"
  for feature in \
    actions.sh \
    install \
    launch \
    open-here \
    reconcile-default-actions \
    set-background \
    share \
    transcode; do
    cp -a "$thunar_source/$feature" "$thunar_runtime/$feature"
  done
  cp -a "$preserved_thunar/." "$thunar_runtime/"
  rm -rf -- "$preserved_thunar"

  "$thunar_runtime/install"

  for integration_owner in \
    "$QVOS_PATH/services/proton/manage" \
    "$QVOS_PATH/development/devel/manage"; do
    if [[ ! -e $integration_owner && ! -L $integration_owner ]]; then
      continue
    fi
    [[ -x $integration_owner && ! -L $integration_owner ]] || {
      echo "Unsafe qvOS integration owner: $integration_owner" >&2
      exit 1
    }
    "$integration_owner" reconcile
  done

  "$QVOS_PATH/qvcore/menu/install" --install

  QVOS_WAYBAR_SKIP_RESTART=1 \
    "$QVOS_PATH/qvcore/waybar/refresh" --reset

  if ! "$HOME/.local/lib/qvos/thunar/reconcile-default-actions"; then
    echo "qvOS preserved the current Thunar actions because they could not be reconciled." >&2
  fi

  "$QVOS_PATH/qvcore/tui/install" --build-if-available
  "$QVOS_PATH/qvcore/shell/install"
  "$QVOS_PATH/qvcore/screensaver/install"
  "$QVOS_PATH/qvcore/network/install"
  "$QVOS_PATH/qvcore/power/install"
  "$QVOS_PATH/qvcore/security/install"
)
