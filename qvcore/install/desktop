    qvcore/desktop/session/logout-worker
    qvcore/desktop/session/wake
    qvcore/desktop/web/qvos-localhost-open
    qvcore/desktop/web/url-lib
    qvcore/desktop/web/qvos-website-open
    qvcore/desktop/webapp/install
    qvcore/desktop/webapp/lib
    qvcore/desktop/webapp/migrate
    qvcore/desktop/webapp/remove
    qvcore/direct/manifest.tsv
    qvcore/direct/post-update-hook
    qvcore/direct/tool
    qvcore/direct/update
    qvcore/install/cleanup-obsolete
    qvcore/install/migrate-structure
    qvcore/install/post-update-hook
    qvcore/install/retire-inherited-system-policy
    qvcore/config/migrate-runtime-root
    qvcore/config/neovim
    qvcore/config/retired-neovim-signatures.psv
    qvcore/config/retired-hypr-layer.psv
    qvcore/config/assistant/install
    qvcore/config/files/xcompose
    qvcore/config/files/wireplumber/wireplumber.conf.d/alsa-soft-mixer.conf
    qvcore/config/files/wireplumber/wireplumber.conf.d/bluetooth-a2dp-autoconnect.conf
    qvcore/branding/install
    qvcore/branding/lib
    qvcore/branding/terminal-art.txt
    qvcore/hooks/reconcile
    qvcore/hardware/framework16-qmk-hid.rules
    qvcore/config/toggle-state
    qvcore/config/user-services
    qvcore/controls/notification/mako-core.ini
    qvcore/controls/retired-paths
    qvcore/menu/concepts.psv
    qvcore/menu/elephant/qvos_background_selector.lua
    qvcore/menu/elephant/qvos_themes.lua
    qvcore/menu/elephant/qvos_unlocks.lua
    qvcore/menu/elephant/qvos_menu.lua
    qvcore/menu/base
    qvcore/menu/menu
    qvcore/menu/routes
    qvcore/menu/font-install
    qvcore/menu/install
