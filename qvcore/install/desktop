# shellcheck shell=bash

# Install qvOS-owned desktop helpers after Omarchy config.
(
  set -euo pipefail

  mkdir -p "$HOME/.local/share/qvos"

  for feature in desktop direct power screensaver security shell thunar tmux tui waybar windows; do
    feature_source="$OMARCHY_PATH/qvcore/$feature"
    if [[ ! -d $feature_source ]]; then
      echo "Missing qvOS desktop feature source: $feature_source" >&2
      exit 1
    fi
  done

  required_sources=(
    qvcore/desktop/context/qvos-active-location
    qvcore/desktop/context/qvos-launch-editor-here
    qvcore/desktop/context/qvos-launch-terminal-here
    qvcore/desktop/hyprland/qvos-toggle-special-window
    qvcore/desktop/open
    qvcore/desktop/web/qvos-localhost-open
    qvcore/desktop/web/qvos-website-open
    qvcore/direct/manifest.tsv
    qvcore/direct/post-update-hook
    qvcore/direct/tool
    qvcore/direct/update
    qvcore/install/cleanup-obsolete
    qvcore/install/migrate-structure
    qvcore/install/post-update-hook
    qvcore/menu/concepts.psv
    qvcore/menu/elephant/omarchy_unlocks.lua
    qvcore/menu/elephant/qvos_menu.lua
    qvcore/menu/extension.sh
    qvcore/menu/font-install
    qvcore/menu/install
    qvcore/menu/search-intents.psv
    qvcore/menu/software-actions.psv
    qvcore/menu/software-install
    qvcore/menu/software-installer-state
    qvcore/menu/software-installers.psv
    qvcore/menu/software-state
    qvcore/menu/steam-remove
    qvcore/menu/terminal-action
    qvcore/menu/wait-for-elephant
    qvcore/menu/walker-elephant-ready.conf
    qvcore/menu/walker-provider-set.toml
    qvcore/menu/walker-subtext.css
    qvcore/power/inhibit-sleep
    qvcore/power/battery-protection
    qvcore/power/battery-protection-backend
    qvcore/power/battery-protection-hwdb
    qvcore/power/battery-protection-lib
    qvcore/power/install
    qvcore/power/qvos-battery-full-charge-once.service
    qvcore/power/suspend-if-safe
    qvcore/screensaver/alacritty.toml
    qvcore/screensaver/install
    qvcore/screensaver/omarchy-launch-screensaver
    qvcore/screensaver/qvos-launch-screensaver
    qvcore/screensaver/qvos-screensaver
    qvcore/security/60-qvos-security.conf
    qvcore/security/boot-mount
    qvcore/security/dev-share
    qvcore/security/dev-share-firewall
    qvcore/security/install
    qvcore/shell/aliases
    qvcore/shell/install
    qvcore/thunar/actions.sh
    qvcore/thunar/codex
    qvcore/thunar/launch
    qvcore/thunar/open-here
    qvcore/thunar/proton-drive-upload
    qvcore/thunar/reconcile-default-actions
    qvcore/thunar/set-background
    qvcore/thunar/share
    qvcore/thunar/transcode
    qvcore/tui/install
    qvcore/tui/launch
    qvcore/tui/owner-resolver
    qvcore/tui/selection-owner
    qvcore/tui/action/choices.psv
    qvcore/tui/action/forms.psv
    qvcore/tui/action/font-launch
    qvcore/tui/action/font-run
    qvcore/tui/action/launch
    qvcore/tui/action/post-actions.psv
    qvcore/tui/action/post-run
    qvcore/tui/action/run
    qvcore/tui/action/run-installer
    qvcore/tui/action/rollback-owner
    qvcore/tui/action/terminal-launch
    qvcore/tui/action/terminal-run
    qvcore/tui/success-guidance.psv
    qvcore/tui/task/actions.psv
    qvcore/tui/task/launch
    qvcore/tui/task/run
    qvcore/tui/task/selectable-owner
    qvcore/tui/task/selections.psv
    qvcore/tui/update/launch
    qvcore/tui/update/run
    qvcore/update/reboot-request
    qvcore/windows/command
    qvcore/windows/lib
    qvcore/windows/manage
    qvcore/windows/launch
    qvcore/tmux/qvos-tmux
    qvcore/waybar/clock.sh
    qvcore/waybar/overrides.jsonc
    qvcore/waybar/post-update-hook
    qvcore/waybar/prayer-data.sh
    qvcore/waybar/prayerbar.sh
    qvcore/waybar/refresh
  )
  for source_path in "${required_sources[@]}"; do
    if [[ ! -f $OMARCHY_PATH/$source_path ]]; then
      echo "Missing qvOS desktop feature file: $OMARCHY_PATH/$source_path" >&2
      exit 1
    fi
  done

  "$OMARCHY_PATH/qvcore/install/migrate-structure" --all

  "$OMARCHY_PATH/qvcore/install/cleanup-obsolete"

  for feature in desktop direct tmux waybar windows; do
    feature_source="$OMARCHY_PATH/qvcore/$feature"
    feature_runtime="$HOME/.local/share/qvos/$feature"

    rm -rf -- "$feature_runtime"
    cp -a "$feature_source" "$feature_runtime"
  done

  thunar_source="$OMARCHY_PATH/qvcore/thunar"
  thunar_runtime="$HOME/.local/share/qvos/thunar"
  preserved_thunar=$(mktemp -d)
  for feature in codex proton-drive-upload; do
    [[ -e $thunar_runtime/$feature ]] || continue
    cp -a "$thunar_runtime/$feature" "$preserved_thunar/$feature"
  done
  rm -rf -- "$thunar_runtime"
  install -d "$thunar_runtime"
  for feature in \
    actions.sh \
    launch \
    open-here \
    reconcile-default-actions \
    set-background \
    share \
    transcode; do
    cp -a "$thunar_source/$feature" "$thunar_runtime/$feature"
  done
  cp -a "$preserved_thunar/." "$thunar_runtime/"
  rm -rf -- "$preserved_thunar"

  for integration_owner in \
    "$OMARCHY_PATH/services/proton/manage" \
    "$OMARCHY_PATH/development/devel/manage"; do
    if [[ ! -e $integration_owner && ! -L $integration_owner ]]; then
      continue
    fi
    [[ -x $integration_owner && ! -L $integration_owner ]] || {
      echo "Unsafe qvOS integration owner: $integration_owner" >&2
      exit 1
    }
    "$integration_owner" reconcile
  done

  "$OMARCHY_PATH/qvcore/menu/install" --install

  install -D -m 0644 \
    "$OMARCHY_PATH/qvcore/install/post-update-hook" \
    "$HOME/.config/omarchy/hooks/post-update.d/qvos-base"
  install -D -m 0644 \
    "$OMARCHY_PATH/qvcore/direct/post-update-hook" \
    "$HOME/.config/omarchy/hooks/post-update.d/qvos-direct-tools"
  install -D -m 0644 \
    "$OMARCHY_PATH/qvcore/waybar/post-update-hook" \
    "$HOME/.config/omarchy/hooks/post-update.d/qvos-waybar-overrides"
  QVOS_WAYBAR_SKIP_RESTART=1 \
    "$OMARCHY_PATH/qvcore/waybar/refresh" --reset

  if ! "$HOME/.local/share/qvos/thunar/reconcile-default-actions"; then
    echo "qvOS preserved the current Thunar actions because they could not be reconciled." >&2
  fi

  "$OMARCHY_PATH/qvcore/tui/install" --build-if-available
  "$OMARCHY_PATH/qvcore/shell/install"
  "$OMARCHY_PATH/qvcore/screensaver/install"
  "$OMARCHY_PATH/qvcore/power/install"
  "$OMARCHY_PATH/qvcore/security/install"
)
