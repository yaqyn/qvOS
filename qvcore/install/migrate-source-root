#!/bin/bash
set -euo pipefail

local_root="$HOME/.local"
share_root="$local_root/share"
canonical_source="$share_root/qvos"
compat_source="$share_root/omarchy"
lock_dir="$share_root/.qvos-source-migration.lock"

fail() {
  echo "$1" >&2
  exit 1
}

validate_checkout() {
  local source="$1"

  [[ -d $source && ! -L $source && $(stat -c %u -- "$source") == "$EUID" ]] ||
    fail "The installed qvOS source is missing, linked, or has unexpected ownership."
  [[ -d $source/.git && ! -L $source/.git ]] ||
    fail "The installed qvOS source has no safe Git metadata."
  [[ $(git -C "$source" branch --show-current 2>/dev/null || true) == "OS" ]] ||
    fail "The installed qvOS source is not on branch OS."
}

if (( EUID == 0 )); then
  fail "qvOS source migration must run as the desktop user, not root."
fi
[[ -d $HOME && ! -L $HOME && $(stat -c %u -- "$HOME") == "$EUID" ]] ||
  fail "qvOS source migration requires a safe user home."
[[ -d $local_root && ! -L $local_root && $(stat -c %u -- "$local_root") == "$EUID" ]] ||
  fail "qvOS source migration requires a safe user data directory."
[[ -d $share_root && ! -L $share_root && $(stat -c %u -- "$share_root") == "$EUID" ]] ||
  fail "qvOS source migration requires a safe user share directory."

if ! mkdir -- "$lock_dir" 2>/dev/null; then
  fail "Another qvOS source migration is active."
fi
cleanup() {
  rmdir -- "$lock_dir" 2>/dev/null || true
}
trap cleanup EXIT

if [[ -d $canonical_source && ! -L $canonical_source ]]; then
  validate_checkout "$canonical_source"
  if [[ -L $compat_source && $(readlink -- "$compat_source") == "qvos" ]]; then
    exit 0
  fi
  [[ ! -e $compat_source && ! -L $compat_source ]] ||
    fail "The inherited source path conflicts with the canonical qvOS source."
  ln -s qvos "$compat_source"
  exit 0
fi

[[ ! -e $canonical_source && ! -L $canonical_source ]] ||
  fail "The canonical qvOS source path is unsafe."
validate_checkout "$compat_source"

mv -- "$compat_source" "$canonical_source"
if ! ln -s qvos "$compat_source"; then
  mv -- "$canonical_source" "$compat_source"
  fail "Could not create the inherited source compatibility link; restored the prior source."
fi

echo "Migrated qvOS source to $canonical_source."
