#!/bin/bash
set -euo pipefail

install_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
retired_hypr_manifest="$install_dir/../config/retired-hypr-layer.psv"

cleanup_retired_hypr_config() {
  local expected_hash=$1
  local relative=$2
  local config_root="$HOME/.config/hypr"
  local hyprland="$config_root/hyprland.conf"
  local installed_hash
  local target="$config_root/$relative"

  [[ -d $HOME && ! -L $HOME && -O $HOME ]] || return 0
  [[ -d $HOME/.config && ! -L $HOME/.config && -O $HOME/.config ]] ||
    return 0
  [[ -d $config_root && ! -L $config_root && -O $config_root ]] ||
    return 0
  if [[ -e $hyprland || -L $hyprland ]]; then
    [[ -f $hyprland && ! -L $hyprland && -O $hyprland ]] || return 0
    ! grep -Fqx 'source = ~/.config/hypr/qv.conf' "$hyprland" || return 0
  fi
  if [[ $relative == */* ]]; then
    [[ -d $config_root/qv && ! -L $config_root/qv && -O $config_root/qv ]] ||
      return 0
  fi
  [[ -f $target && ! -L $target && -O $target ]] || return 0
  installed_hash=$(sha256sum -- "$target")
  installed_hash=${installed_hash%% *}
  [[ $installed_hash == "$expected_hash" ]] || return 0
  rm -f -- "$target"
}

[[ -f $retired_hypr_manifest && ! -L $retired_hypr_manifest ]] || {
  echo "Missing qvOS retired Hyprland manifest: $retired_hypr_manifest" >&2
  exit 1
}
while IFS='|' read -r retired_path retired_hash retired_extra; do
  [[ -n $retired_path && $retired_path != \#* ]] || continue
  [[ -z ${retired_extra:-} &&
    $retired_path =~ ^qv(\.conf|/[a-z]+\.conf)$ &&
    $retired_hash =~ ^[0-9a-f]{64}$ ]] || {
    echo "Invalid qvOS retired Hyprland manifest row: $retired_path" >&2
    exit 1
  }
  cleanup_retired_hypr_config "$retired_hash" "$retired_path"
done <"$retired_hypr_manifest"
if [[ -d $HOME && ! -L $HOME && -O $HOME &&
  -d $HOME/.config && ! -L $HOME/.config && -O $HOME/.config &&
  -d $HOME/.config/hypr && ! -L $HOME/.config/hypr && -O $HOME/.config/hypr &&
  -d $HOME/.config/hypr/qv && ! -L $HOME/.config/hypr/qv &&
  -O $HOME/.config/hypr/qv ]]; then
  rmdir -- "$HOME/.config/hypr/qv" 2>/dev/null || true
fi

cleanup_retired_nautilus_extension() {
  local expected_hash=$1
  local extension_name=$2
  local cache
  local cache_dir="$HOME/.local/share/nautilus-python/extensions/__pycache__"
  local extension_dir="$HOME/.local/share/nautilus-python/extensions"
  local extension_path="$extension_dir/$extension_name.py"
  local installed_hash
  local nautilus_root="${extension_dir%/extensions}"

  [[ -d $nautilus_root && ! -L $nautilus_root && -O $nautilus_root ]] ||
    return 0
  [[ -d $extension_dir && ! -L $extension_dir && -O $extension_dir ]] ||
    return 0
  [[ -f $extension_path && ! -L $extension_path && -O $extension_path ]] ||
    return 0
  installed_hash=$(sha256sum -- "$extension_path")
  installed_hash=${installed_hash%% *}
  [[ $installed_hash == "$expected_hash" ]] || return 0

  rm -f -- "$extension_path"
  if [[ -d $cache_dir && ! -L $cache_dir && -O $cache_dir ]]; then
    while IFS= read -r -d '' cache; do
      [[ -f $cache && ! -L $cache && -O $cache ]] || continue
      rm -f -- "$cache"
    done < <(
      find -P "$cache_dir" -maxdepth 1 -type f \
        -name "$extension_name.cpython-*.pyc" -print0
    )
    rmdir -- "$cache_dir" 2>/dev/null || true
  fi
  rmdir -- "$extension_dir" 2>/dev/null || true
  rmdir -- "$nautilus_root" 2>/dev/null || true
}

cleanup_retired_nautilus_extension \
  c5b2ddaf1bb5ae6fa3b21da8ae13215877db504effe6d088db3b1618bb47205a \
  localsend
cleanup_retired_nautilus_extension \
  4f4428a741325d9c776f3c28884c8a21e96bcd52c65949b16dca21ea1d5ae819 \
  transcode

legacy_thunar_helper="$HOME/.local/lib/qvos/defaults/qvos-launch-thunar"
[[ ! -e $legacy_thunar_helper && ! -L $legacy_thunar_helper ]] || exit 0
legacy_share_helper="$HOME/.local/share/qvos/defaults/qvos-launch-thunar"

legacy_desktop="$HOME/.local/share/applications/thunar.desktop"
if [[ -f $legacy_desktop && ! -L $legacy_desktop && -O $legacy_desktop ]]; then
  desktop_exec_count=0
  legacy_exec_count=0
  while IFS= read -r desktop_line; do
    [[ $desktop_line == Exec=* ]] || continue
    ((desktop_exec_count += 1))
    desktop_command=${desktop_line#Exec=}
    if [[ $desktop_command == "$legacy_share_helper "* ||
      $desktop_command == "$legacy_thunar_helper "* ]]; then
      ((legacy_exec_count += 1))
    fi
  done <"$legacy_desktop"
  if ((desktop_exec_count > 0 && desktop_exec_count == legacy_exec_count)); then
    rm -f -- "$legacy_desktop"
  fi
fi

legacy_user_unit="$HOME/.config/systemd/user/thunar.service"
if [[ -f $legacy_user_unit && ! -L $legacy_user_unit && -O $legacy_user_unit ]]; then
  normalized_unit=$(awk '
    /^[[:space:]]*($|#)/ { next }
    { print }
  ' "$legacy_user_unit")
  for helper in "$legacy_share_helper" "$legacy_thunar_helper"; do
    expected_unit=$(printf '%s\n' \
      '[Unit]' \
      'Description=Thunar file manager' \
      'Documentation=man:Thunar(1)' \
      '[Service]' \
      'Type=dbus' \
      "ExecStart=$helper --daemon" \
      'BusName=org.xfce.FileManager' \
      'KillMode=process')
    if [[ $normalized_unit == "$expected_unit" ]]; then
      rm -f -- "$legacy_user_unit"
      break
    fi
  done
fi

legacy_service_dir="$HOME/.local/share/dbus-1/services"
legacy_service_names=(
  'org.freedesktop.FileManager1|org.freedesktop.FileManager1.service'
  'org.xfce.FileManager|org.xfce.FileManager.service'
  'org.xfce.Thunar|org.xfce.Thunar.service'
)
for legacy_service in "${legacy_service_names[@]}"; do
  service_bus_name=${legacy_service%%|*}
  service_filename=${legacy_service#*|}
  service_path="$legacy_service_dir/$service_filename"
  [[ -f $service_path && ! -L $service_path && -O $service_path ]] || continue
  for helper in "$legacy_share_helper" "$legacy_thunar_helper"; do
    expected_service=$(printf \
      '[D-BUS Service]\nName=%s\nExec=%s --gapplication-service' \
      "$service_bus_name" "$helper")
    if [[ $(<"$service_path") == "$expected_service" ]]; then
      rm -f -- "$service_path"
      break
    fi
  done
done

legacy_plugin_dir="$HOME/.local/lib/qvos/defaults/thunarx-3"
if [[ -d $legacy_plugin_dir && ! -L $legacy_plugin_dir && -O $legacy_plugin_dir ]]; then
  plugins_safe=true
  while IFS= read -r -d '' legacy_plugin; do
    plugin_name=${legacy_plugin##*/}
    if [[ ! -L $legacy_plugin ||
      $(readlink -- "$legacy_plugin") != "/usr/lib/thunarx-3/$plugin_name" ]]; then
      plugins_safe=false
      break
    fi
  done < <(find "$legacy_plugin_dir" -mindepth 1 -maxdepth 1 -print0)
  if [[ $plugins_safe == "true" ]]; then
    find "$legacy_plugin_dir" -mindepth 1 -maxdepth 1 -type l -delete
    rmdir -- "$legacy_plugin_dir" 2>/dev/null || true
  fi
fi
rmdir -- "$HOME/.local/lib/qvos/defaults" 2>/dev/null || true
