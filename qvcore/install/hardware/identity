#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
system_root=${QVOS_INSTALL_HARDWARE_SYSTEM_ROOT:-}
testing=${QVOS_INSTALL_HARDWARE_TESTING:-}
udevadm_command=${QVOS_INSTALL_UDEVADM:-/usr/bin/udevadm}
systemctl_command=${QVOS_INSTALL_SYSTEMCTL:-/usr/bin/systemctl}
expected_uid=0
expected_gid=0
installed_created=false
active_staging=

z13_source="$QVOS_PATH/qvcore/install/hardware/asus/z13-touchpad.rules"
z13_target="$system_root/etc/udev/rules.d/99-qvos-asus-z13-touchpad.rules"

apple_source="$QVOS_PATH/qvcore/install/hardware/apple/qvos-nvme-suspend-fix.service"
apple_target="$system_root/etc/systemd/system/qvos-nvme-suspend-fix.service"
apple_service=qvos-nvme-suspend-fix.service

fail() {
  printf 'qvOS hardware identity: %s\n' "$1" >&2
  exit 1
}

usage() {
  echo "Usage: qvcore/install/hardware/identity <z13|apple-nvme>" >&2
  exit 2
}

case ${1:-} in
z13 | apple-nvme) operation=$1 ;;
*) usage ;;
esac
(( $# == 1 )) || usage

if [[ -n $system_root ]]; then
  [[ $testing == "1" ]] || fail "a custom system root is valid only in tests"
  canonical_root=$(/usr/bin/realpath -m -- "$system_root")
  [[ $system_root == /tmp/* && $system_root == "$canonical_root" ]] ||
    fail "the test system root must be canonical and beneath /tmp"
  [[ -d $system_root && ! -L $system_root && -O $system_root ]] ||
    fail "the test system root is unavailable or unsafe"
  root_mode=$(/usr/bin/stat -c '%a' -- "$system_root")
  (( (8#$root_mode & 022) == 0 )) ||
    fail "the test system root is writable by other users"
  expected_uid=$(/usr/bin/id -u)
  expected_gid=$(/usr/bin/id -g)
elif [[ $testing == "1" ]]; then
  fail "test mode requires a custom system root"
fi

validate_command() {
  local command_path=$1
  local expected=$2

  [[ $command_path == "$expected" ]] && return 0
  [[ $testing == "1" && $command_path == /tmp/* &&
    -f $command_path && -x $command_path && ! -L $command_path ]] ||
    fail "unsafe command override: $command_path"
}

validate_command "$udevadm_command" /usr/bin/udevadm
validate_command "$systemctl_command" /usr/bin/systemctl

as_root() {
  if [[ -n $system_root ]] || (( EUID == 0 )); then
    "$@"
  else
    /usr/bin/sudo -- "$@"
  fi
}

cleanup_staging() {
  [[ -z $active_staging ]] || as_root /usr/bin/rm -f -- "$active_staging" || true
}
trap cleanup_staging EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

root_exists() {
  local path=$1

  as_root /usr/bin/test -e "$path" || as_root /usr/bin/test -L "$path"
}

directory_is_safe() {
  local path=$1
  local mode

  as_root /usr/bin/test -d "$path" || return 1
  as_root /usr/bin/test ! -L "$path" || return 1
  [[ $(as_root /usr/bin/stat -c '%u:%g' -- "$path") == \
    "$expected_uid:$expected_gid" ]] || return 1
  mode=$(as_root /usr/bin/stat -c '%a' -- "$path") || return 1
  (( (8#$mode & 022) == 0 ))
}

ensure_directory() {
  local path=$1
  local parent

  if root_exists "$path"; then
    directory_is_safe "$path" || fail "unsafe managed directory: $path"
    return
  fi
  parent=${path%/*}
  [[ -n $parent ]] || parent=/
  ensure_directory "$parent"
  as_root /usr/bin/install -d -o "$expected_uid" -g "$expected_gid" \
    -m 0755 -- "$path"
}

source_is_safe() {
  local source=$1

  [[ -f $source && ! -L $source ]]
}

file_matches() {
  local source=$1
  local target=$2
  local mode=$3

  as_root /usr/bin/test -f "$target" || return 1
  as_root /usr/bin/test ! -L "$target" || return 1
  [[ $(as_root /usr/bin/stat -c '%u:%g:%a' -- "$target") == \
    "$expected_uid:$expected_gid:${mode#0}" ]] || return 1
  as_root /usr/bin/cmp -s -- "$source" "$target"
}

install_managed() {
  local source=$1
  local target=$2
  local mode=$3
  local parent=${target%/*}
  local basename=${target##*/}
  local staging=

  installed_created=false
  source_is_safe "$source" || fail "unsafe managed source: $source"
  if root_exists "$target"; then
    file_matches "$source" "$target" "$mode" || {
      printf 'Refusing modified or unsafe qvOS hardware policy: %s\n' \
        "$target" >&2
      return 1
    }
    return
  fi

  ensure_directory "$parent"
  staging=$(as_root /usr/bin/mktemp --tmpdir="$parent" \
    ".${basename}.qvos.XXXXXX") || return 1
  active_staging=$staging
  if ! as_root /usr/bin/install -o "$expected_uid" -g "$expected_gid" \
    -m "$mode" -- "$source" "$staging" ||
    ! as_root /usr/bin/mv -f -- "$staging" "$target"; then
    as_root /usr/bin/rm -f -- "$staging" || true
    active_staging=
    return 1
  fi
  active_staging=
  installed_created=true
}

remove_created() {
  local source=$1
  local target=$2
  local mode=$3

  file_matches "$source" "$target" "$mode" || return 0
  as_root /usr/bin/rm -f -- "$target"
}

reload_udev() {
  as_root "$udevadm_command" control --reload-rules
}

systemctl_action() {
  as_root "$systemctl_command" "$@"
}

service_enabled() {
  systemctl_action is-enabled --quiet "$1"
}

rollback_z13() {
  local created=$1

  [[ $created == "false" ]] || remove_created "$z13_source" "$z13_target" 0644
  reload_udev >/dev/null 2>&1 || true
}

install_z13() {
  local target_created=false

  install_managed "$z13_source" "$z13_target" 0644 ||
    fail "could not install the native ASUS Z13 touchpad policy"
  target_created=$installed_created
  if ! reload_udev; then
    rollback_z13 "$target_created"
    fail "could not activate the native ASUS Z13 touchpad policy"
  fi
}

rollback_apple() {
  local created=$1
  local native_enabled_before=$2

  if [[ $native_enabled_before == "false" ]]; then
    systemctl_action disable "$apple_service" >/dev/null 2>&1 || true
  fi
  [[ $created == "false" ]] || remove_created "$apple_source" "$apple_target" 0644
  systemctl_action daemon-reload >/dev/null 2>&1 || true
}

install_apple() {
  local native_enabled_before=false
  local target_created=false

  service_enabled "$apple_service" && native_enabled_before=true

  install_managed "$apple_source" "$apple_target" 0644 ||
    fail "could not install the native Apple NVMe suspend policy"
  target_created=$installed_created
  if ! systemctl_action daemon-reload; then
    rollback_apple "$target_created" "$native_enabled_before"
    fail "could not load the native Apple NVMe suspend policy"
  fi

  if [[ ${QVOS_CHROOT_INSTALL:-} != "1" ]]; then
    if ! systemctl_action enable --now "$apple_service"; then
      rollback_apple "$target_created" "$native_enabled_before"
      fail "could not enable the native Apple NVMe suspend policy"
    fi
  elif ! systemctl_action enable "$apple_service"; then
    rollback_apple "$target_created" "$native_enabled_before"
    fail "could not enable the native Apple NVMe suspend policy"
  fi

  if ! service_enabled "$apple_service"; then
    rollback_apple "$target_created" "$native_enabled_before"
    fail "native Apple NVMe suspend service did not remain enabled"
  fi
}

case $operation in
z13)
  if qv-hw-asus-rog && qv-hw-match "GZ302"; then
    install_z13
  fi
  ;;
apple-nvme)
  product_name_path="$system_root/sys/class/dmi/id/product_name"
  nvme_device="$system_root/sys/bus/pci/devices/0000:01:00.0/d3cold_allowed"
  product_name=$(/usr/bin/cat -- "$product_name_path" 2>/dev/null || true)
  if [[ $product_name =~ ^MacBook(8,1|9,1|10,1)$|^MacBookPro(13,[123]|14,[123])$ ]]; then
    echo "Detected MacBook model: $product_name"
    if [[ -f $nvme_device && ! -L $nvme_device ]]; then
      install_apple
    else
      echo "Warning: NVMe device not found at expected PCI address (0000:01:00.0)"
      echo "This fix may not be needed for this MacBook model"
    fi
  fi
  ;;
esac
