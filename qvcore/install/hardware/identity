#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
system_root=${QVOS_INSTALL_HARDWARE_SYSTEM_ROOT:-}
testing=${QVOS_INSTALL_HARDWARE_TESTING:-}
udevadm_command=${QVOS_INSTALL_UDEVADM:-/usr/bin/udevadm}
systemctl_command=${QVOS_INSTALL_SYSTEMCTL:-/usr/bin/systemctl}
expected_uid=0
expected_gid=0
installed_created=false
active_staging=

z13_source="$QVOS_PATH/qvcore/install/hardware/asus/z13-touchpad.rules"
z13_target="$system_root/etc/udev/rules.d/99-qvos-asus-z13-touchpad.rules"
asus_b9406_touchpad_source="$QVOS_PATH/qvcore/install/hardware/asus/b9406-touchpad.quirks"
asus_b9406_touchpad_target="$system_root/usr/share/libinput/99-qvos-asus-b9406-touchpad.quirks"
asus_b9406_display_source="$QVOS_PATH/qvcore/install/hardware/asus/b9406-display.conf"
asus_b9406_display_target="$system_root/etc/limine-entry-tool.d/90-qvos-asus-b9406-display.conf"
asus_ptl_backlight_source="$QVOS_PATH/qvcore/install/hardware/asus/ptl-backlight.conf"
asus_ptl_backlight_target="$system_root/etc/limine-entry-tool.d/90-qvos-asus-ptl-backlight.conf"

apple_source="$QVOS_PATH/qvcore/install/hardware/apple/qvos-nvme-suspend-fix.service"
apple_target="$system_root/etc/systemd/system/qvos-nvme-suspend-fix.service"
apple_service=qvos-nvme-suspend-fix.service
apple_spi_macbook8_source="$QVOS_PATH/qvcore/install/hardware/apple/spi-macbook8.conf"
apple_spi_modern_source="$QVOS_PATH/qvcore/install/hardware/apple/spi-modern.conf"
apple_spi_target="$system_root/etc/mkinitcpio.conf.d/qvos-apple-spi.conf"

intel_fred_source="$QVOS_PATH/qvcore/install/hardware/intel/fred.conf"
intel_fred_target="$system_root/etc/limine-entry-tool.d/90-qvos-intel-fred.conf"
intel_wifi_source="$QVOS_PATH/qvcore/install/hardware/intel/iwlwifi-disable-eht.conf"
intel_wifi_target="$system_root/etc/modprobe.d/qvos-intel-wifi7-eht.conf"

hid_apple_source="$QVOS_PATH/qvcore/install/hardware/input/hid-apple-fkeys.conf"
hid_apple_target="$system_root/etc/modprobe.d/qvos-hid-apple-fkeys.conf"
synaptics_source="$QVOS_PATH/qvcore/install/hardware/input/psmouse-synaptics.conf"
synaptics_target="$system_root/etc/modprobe.d/qvos-psmouse-synaptics.conf"

nvidia_modprobe_source="$QVOS_PATH/qvcore/install/hardware/nvidia/modprobe.conf"
nvidia_modprobe_target="$system_root/etc/modprobe.d/qvos-nvidia.conf"
nvidia_mkinitcpio_source="$QVOS_PATH/qvcore/install/hardware/nvidia/mkinitcpio.conf"
nvidia_mkinitcpio_target="$system_root/etc/mkinitcpio.conf.d/qvos-nvidia.conf"

lenovo_yoga_source="$QVOS_PATH/qvcore/install/hardware/lenovo/yoga-pro7-bass.conf"
lenovo_yoga_target="$system_root/etc/modprobe.d/qvos-lenovo-yoga-pro7-bass.conf"

tuxedo_source="$QVOS_PATH/qvcore/install/hardware/tuxedo/blacklist-clevo-xsm-wmi.conf"
tuxedo_target="$system_root/etc/modprobe.d/qvos-tuxedo-backlight.conf"

surface_target="$system_root/etc/mkinitcpio.conf.d/qvos-surface-keyboard.conf"
surface_generated_source=

fail() {
  printf 'qvOS hardware identity: %s\n' "$1" >&2
  exit 1
}

usage() {
  echo "Usage: qvcore/install/hardware/identity <apple-nvme|apple-spi-keyboard|asus-b9406-display|asus-b9406-touchpad|asus-ptl-backlight|hid-apple-fkeys|intel-fred|intel-wifi7-eht|lenovo-yoga-pro7-bass|nvidia-boot|surface-keyboard|synaptics-ps2|tuxedo-backlight|z13>" >&2
  exit 2
}

case ${1:-} in
apple-nvme | apple-spi-keyboard | asus-b9406-display | asus-b9406-touchpad | asus-ptl-backlight | hid-apple-fkeys | intel-fred | intel-wifi7-eht | lenovo-yoga-pro7-bass | nvidia-boot | surface-keyboard | synaptics-ps2 | tuxedo-backlight | z13) operation=$1 ;;
*) usage ;;
esac
(( $# == 1 )) || usage

if [[ -n $system_root ]]; then
  [[ $testing == "1" ]] || fail "a custom system root is valid only in tests"
  canonical_root=$(/usr/bin/realpath -m -- "$system_root")
  [[ $system_root == /tmp/* && $system_root == "$canonical_root" ]] ||
    fail "the test system root must be canonical and beneath /tmp"
  [[ -d $system_root && ! -L $system_root && -O $system_root ]] ||
    fail "the test system root is unavailable or unsafe"
  root_mode=$(/usr/bin/stat -c '%a' -- "$system_root")
  (( (8#$root_mode & 022) == 0 )) ||
    fail "the test system root is writable by other users"
  expected_uid=$(/usr/bin/id -u)
  expected_gid=$(/usr/bin/id -g)
elif [[ $testing == "1" ]]; then
  fail "test mode requires a custom system root"
fi

validate_command() {
  local command_path=$1
  local expected=$2

  [[ $command_path == "$expected" ]] && return 0
  [[ $testing == "1" && $command_path == /tmp/* &&
    -f $command_path && -x $command_path && ! -L $command_path ]] ||
    fail "unsafe command override: $command_path"
}

validate_command "$udevadm_command" /usr/bin/udevadm
validate_command "$systemctl_command" /usr/bin/systemctl

as_root() {
  if [[ -n $system_root ]] || (( EUID == 0 )); then
    "$@"
  else
    /usr/bin/sudo -- "$@"
  fi
}

cleanup_staging() {
  [[ -z $active_staging ]] || as_root /usr/bin/rm -f -- "$active_staging" || true
  [[ -z $surface_generated_source ]] ||
    /usr/bin/rm -f -- "$surface_generated_source" || true
}
trap cleanup_staging EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

root_exists() {
  local path=$1

  as_root /usr/bin/test -e "$path" || as_root /usr/bin/test -L "$path"
}

directory_is_safe() {
  local path=$1
  local mode

  as_root /usr/bin/test -d "$path" || return 1
  as_root /usr/bin/test ! -L "$path" || return 1
  [[ $(as_root /usr/bin/stat -c '%u:%g' -- "$path") == \
    "$expected_uid:$expected_gid" ]] || return 1
  mode=$(as_root /usr/bin/stat -c '%a' -- "$path") || return 1
  (( (8#$mode & 022) == 0 ))
}

ensure_directory() {
  local path=$1
  local parent

  if root_exists "$path"; then
    directory_is_safe "$path" || fail "unsafe managed directory: $path"
    return
  fi
  parent=${path%/*}
  [[ -n $parent ]] || parent=/
  ensure_directory "$parent"
  as_root /usr/bin/install -d -o "$expected_uid" -g "$expected_gid" \
    -m 0755 -- "$path"
}

source_is_safe() {
  local source=$1

  [[ -f $source && ! -L $source ]]
}

file_matches() {
  local source=$1
  local target=$2
  local mode=$3

  as_root /usr/bin/test -f "$target" || return 1
  as_root /usr/bin/test ! -L "$target" || return 1
  [[ $(as_root /usr/bin/stat -c '%u:%g:%a' -- "$target") == \
    "$expected_uid:$expected_gid:${mode#0}" ]] || return 1
  as_root /usr/bin/cmp -s -- "$source" "$target"
}

install_managed() {
  local source=$1
  local target=$2
  local mode=$3
  local parent=${target%/*}
  local basename=${target##*/}
  local staging=

  installed_created=false
  source_is_safe "$source" || fail "unsafe managed source: $source"
  if root_exists "$target"; then
    file_matches "$source" "$target" "$mode" || {
      printf 'Refusing modified or unsafe qvOS hardware policy: %s\n' \
        "$target" >&2
      return 1
    }
    return
  fi

  ensure_directory "$parent"
  staging=$(as_root /usr/bin/mktemp --tmpdir="$parent" \
    ".${basename}.qvos.XXXXXX") || return 1
  active_staging=$staging
  if ! as_root /usr/bin/install -o "$expected_uid" -g "$expected_gid" \
    -m "$mode" -- "$source" "$staging" ||
    ! as_root /usr/bin/mv -f -- "$staging" "$target"; then
    as_root /usr/bin/rm -f -- "$staging" || true
    active_staging=
    return 1
  fi
  active_staging=
  installed_created=true
}

remove_created() {
  local source=$1
  local target=$2
  local mode=$3

  file_matches "$source" "$target" "$mode" || return 0
  as_root /usr/bin/rm -f -- "$target"
}

reload_udev() {
  as_root "$udevadm_command" control --reload-rules
}

systemctl_action() {
  as_root "$systemctl_command" "$@"
}

service_enabled() {
  systemctl_action is-enabled --quiet "$1"
}

rollback_z13() {
  local created=$1

  [[ $created == "false" ]] || remove_created "$z13_source" "$z13_target" 0644
  reload_udev >/dev/null 2>&1 || true
}

install_z13() {
  local target_created=false

  install_managed "$z13_source" "$z13_target" 0644 ||
    fail "could not install the native ASUS Z13 touchpad policy"
  target_created=$installed_created
  if ! reload_udev; then
    rollback_z13 "$target_created"
    fail "could not activate the native ASUS Z13 touchpad policy"
  fi
}

rollback_apple() {
  local created=$1
  local native_enabled_before=$2

  if [[ $native_enabled_before == "false" ]]; then
    systemctl_action disable "$apple_service" >/dev/null 2>&1 || true
  fi
  [[ $created == "false" ]] || remove_created "$apple_source" "$apple_target" 0644
  systemctl_action daemon-reload >/dev/null 2>&1 || true
}

install_apple() {
  local native_enabled_before=false
  local target_created=false

  service_enabled "$apple_service" && native_enabled_before=true

  install_managed "$apple_source" "$apple_target" 0644 ||
    fail "could not install the native Apple NVMe suspend policy"
  target_created=$installed_created
  if ! systemctl_action daemon-reload; then
    rollback_apple "$target_created" "$native_enabled_before"
    fail "could not load the native Apple NVMe suspend policy"
  fi

  if [[ ${QVOS_CHROOT_INSTALL:-} != "1" ]]; then
    if ! systemctl_action enable --now "$apple_service"; then
      rollback_apple "$target_created" "$native_enabled_before"
      fail "could not enable the native Apple NVMe suspend policy"
    fi
  elif ! systemctl_action enable "$apple_service"; then
    rollback_apple "$target_created" "$native_enabled_before"
    fail "could not enable the native Apple NVMe suspend policy"
  fi

  if ! service_enabled "$apple_service"; then
    rollback_apple "$target_created" "$native_enabled_before"
    fail "native Apple NVMe suspend service did not remain enabled"
  fi
}

install_static_policy() {
  local name=$1
  local source=$2
  local target=$3

  install_managed "$source" "$target" 0644 ||
    fail "could not install the native $name policy"
}

install_nvidia_boot() {
  local modprobe_created=false

  install_managed "$nvidia_modprobe_source" "$nvidia_modprobe_target" 0644 ||
    fail "could not install the native NVIDIA modprobe policy"
  modprobe_created=$installed_created
  if ! install_managed \
    "$nvidia_mkinitcpio_source" "$nvidia_mkinitcpio_target" 0644; then
    [[ $modprobe_created == "false" ]] ||
      remove_created "$nvidia_modprobe_source" "$nvidia_modprobe_target" 0644
    fail "could not install the native NVIDIA initramfs policy"
  fi
}

kernel_config_state() {
  local option=$1
  local config
  local line
  local -a configs=()
  local -a states=()

  shopt -s nullglob
  configs=("$system_root/usr/lib/modules"/*/build/.config)
  shopt -u nullglob
  for config in "${configs[@]}"; do
    [[ -r $config ]] || continue
    line=$(/usr/bin/grep -Fm1 -- "$option=" "$config" || true)
    case $line in
    "$option=y") states+=(y) ;;
    "$option=m") states+=(m) ;;
    esac
  done
  (( ${#states[@]} > 0 )) || return 1
  mapfile -t states < <(/usr/bin/printf '%s\n' "${states[@]}" | /usr/bin/sort -u)
  (( ${#states[@]} == 1 )) || return 1
  printf '%s\n' "${states[0]}"
}

generate_surface_keyboard_policy() {
  local config_state
  local model
  local module
  local pinctrl_module
  local platform
  local input_driver
  local modules_path="$system_root/proc/modules"
  local -a pinctrl_modules=()
  local -a policy_modules=()

  [[ -r $modules_path && ! -L $modules_path ]] ||
    fail "the loaded-module inventory is unavailable for this Surface"
  while read -r module _; do
    case $module in
    pinctrl_amd | pinctrl_cannonlake | pinctrl_icelake | \
      pinctrl_sunrisepoint | pinctrl_tigerlake)
      pinctrl_modules+=("$module")
      ;;
    esac
  done <"$modules_path"
  if (( ${#pinctrl_modules[@]} == 1 )); then
    pinctrl_module=${pinctrl_modules[0]}
    if [[ $pinctrl_module == "pinctrl_amd" ]]; then
      platform=amd
    else
      platform=intel
    fi
  elif (( ${#pinctrl_modules[@]} == 0 )) &&
    /usr/bin/grep -m1 -Eq \
      '^vendor_id[[:space:]]*:[[:space:]]*AuthenticAMD$' \
      "$system_root/proc/cpuinfo" 2>/dev/null; then
    config_state=$(kernel_config_state CONFIG_PINCTRL_AMD || true)
    [[ $config_state == "y" ]] ||
      fail "the AMD Surface pin-controller is neither loaded nor built into the installed kernel"
    pinctrl_module=
    platform=amd
  else
    fail "expected one supported Surface pin-controller module, found ${#pinctrl_modules[@]}"
  fi

  model=$(/usr/bin/cat -- \
    "$system_root/sys/class/dmi/id/product_name" 2>/dev/null || true)
  case $model in
  "Surface Laptop" | "Surface Laptop 2") input_driver=surface_kbd ;;
  "Surface Laptop 3" | "Surface Laptop 4" | "Surface Book 3" | \
    "Surface Laptop Studio" | "Surface Laptop Studio 2")
    input_driver=surface_hid
    ;;
  *) fail "unsupported Surface keyboard model: ${model:-unknown}" ;;
  esac

  [[ -z $pinctrl_module ]] || policy_modules+=("$pinctrl_module")
  if [[ $platform == "intel" ]]; then
    policy_modules+=(intel_lpss intel_lpss_pci)
  fi
  policy_modules+=(
    8250_dw
    surface_aggregator
    surface_aggregator_registry
    surface_aggregator_hub
    surface_hid_core
    "$input_driver"
  )

  surface_generated_source=$(/usr/bin/mktemp \
    /tmp/qvos-surface-keyboard.XXXXXX) ||
    fail "could not stage the Surface keyboard policy"
  /usr/bin/chmod 0600 -- "$surface_generated_source"
  printf 'MODULES=(%s)\n' "${policy_modules[*]}" >"$surface_generated_source"
}

install_surface_keyboard() {
  generate_surface_keyboard_policy
  install_static_policy \
    "Surface keyboard initramfs" "$surface_generated_source" "$surface_target"
}

case $operation in
z13)
  if qv-hw-asus-rog && qv-hw-match "GZ302"; then
    install_z13
  fi
  ;;
apple-nvme)
  product_name_path="$system_root/sys/class/dmi/id/product_name"
  nvme_device="$system_root/sys/bus/pci/devices/0000:01:00.0/d3cold_allowed"
  product_name=$(/usr/bin/cat -- "$product_name_path" 2>/dev/null || true)
  if [[ $product_name =~ ^MacBook(8,1|9,1|10,1)$|^MacBookPro(13,[123]|14,[123])$ ]]; then
    echo "Detected MacBook model: $product_name"
    if [[ -f $nvme_device && ! -L $nvme_device ]]; then
      install_apple
    else
      echo "Warning: NVMe device not found at expected PCI address (0000:01:00.0)"
      echo "This fix may not be needed for this MacBook model"
    fi
  fi
  ;;
apple-spi-keyboard)
  if "$QVOS_PATH/bin/qv-hw-apple-spi-keyboard"; then
    product_name=$(/usr/bin/cat -- \
      "$system_root/sys/class/dmi/id/product_name" 2>/dev/null || true)
    if [[ $product_name == "MacBook8,1" ]]; then
      apple_spi_source=$apple_spi_macbook8_source
    else
      apple_spi_source=$apple_spi_modern_source
    fi
    install_static_policy \
      "Apple SPI keyboard" "$apple_spi_source" "$apple_spi_target"
  fi
  ;;
asus-b9406-display)
  if "$QVOS_PATH/bin/qv-hw-asus-expertbook-b9406"; then
    install_static_policy \
      "ASUS B9406 display" \
      "$asus_b9406_display_source" "$asus_b9406_display_target"
  fi
  ;;
asus-b9406-touchpad)
  if "$QVOS_PATH/bin/qv-hw-asus-expertbook-b9406"; then
    install_static_policy \
      "ASUS B9406 touchpad" \
      "$asus_b9406_touchpad_source" "$asus_b9406_touchpad_target"
  fi
  ;;
asus-ptl-backlight)
  if "$QVOS_PATH/bin/qv-hw-asus-expertbook-b9406" ||
    "$QVOS_PATH/bin/qv-hw-asus-zenbook-ux5406aa"; then
    install_static_policy \
      "ASUS Panther Lake backlight" \
      "$asus_ptl_backlight_source" "$asus_ptl_backlight_target"
  fi
  ;;
hid-apple-fkeys)
  install_static_policy \
    "hid_apple function-key" "$hid_apple_source" "$hid_apple_target"
  ;;
intel-fred)
  if "$QVOS_PATH/bin/qv-hw-intel-ptl"; then
    install_static_policy \
      "Intel Panther Lake FRED" "$intel_fred_source" "$intel_fred_target"
  fi
  ;;
intel-wifi7-eht)
  if "$QVOS_PATH/bin/qv-hw-intel-wifi7-eht"; then
    install_static_policy \
      "Intel Wi-Fi 7 EHT" "$intel_wifi_source" "$intel_wifi_target"
  fi
  ;;
lenovo-yoga-pro7-bass)
  if "$QVOS_PATH/bin/qv-hw-lenovo-yoga-pro7"; then
    install_static_policy \
      "Lenovo Yoga Pro 7 bass" "$lenovo_yoga_source" "$lenovo_yoga_target"
  fi
  ;;
nvidia-boot)
  if "$QVOS_PATH/bin/qv-hw-nvidia-gsp" ||
    "$QVOS_PATH/bin/qv-hw-nvidia-without-gsp"; then
    install_nvidia_boot
  fi
  ;;
surface-keyboard)
  if "$QVOS_PATH/bin/qv-hw-surface-sam-keyboard"; then
    install_surface_keyboard
  fi
  ;;
synaptics-ps2)
  if "$QVOS_PATH/bin/qv-hw-synaptics-ps2"; then
    install_static_policy \
      "Synaptics PS/2" "$synaptics_source" "$synaptics_target"
  fi
  ;;
tuxedo-backlight)
  if "$QVOS_PATH/bin/qv-hw-tuxedo"; then
    install_static_policy \
      "Tuxedo backlight" "$tuxedo_source" "$tuxedo_target"
  fi
  ;;
esac
