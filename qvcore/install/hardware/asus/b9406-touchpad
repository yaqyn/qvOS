# shellcheck shell=bash

(
  set -euo pipefail

  if omarchy-hw-asus-expertbook-b9406; then
    quirk_file="/usr/share/libinput/99-qvos-asus-b9406-touchpad.quirks"
    legacy_file="/etc/libinput/asus-expertbook-b9406.quirks"

    sudo install -D -m 0644 /dev/stdin "$quirk_file" <<'QUIRK'
[ASUS ExpertBook B9406 Touchpad]
MatchBus=i2c
MatchVendor=0x093A
MatchProduct=0x4F05
MatchDMIModalias=dmi:*svnASUS*:pn*B9406*
AttrEventCode=-ABS_MT_PRESSURE;-ABS_PRESSURE;
QUIRK
    sudo rm -f -- "$legacy_file"
  fi
)
