#!/bin/bash
set -euo pipefail
umask 077

system_root=${QVOS_REBOOT_POLICY_SYSTEM_ROOT:-}
testing=${QVOS_REBOOT_POLICY_TESTING:-}
policy_path=/etc/sudoers.d/99-qvos-installer-reboot
target="$system_root$policy_path"
target_uid=0
target_gid=0
candidate=
staging=

fail() {
  printf 'qvOS installer reboot policy: %s\n' "$1" >&2
  exit 1
}

as_root() {
  if [[ -n $system_root ]] || (( EUID == 0 )); then
    "$@"
  else
    /usr/bin/sudo -- "$@"
  fi
}

cleanup() {
  [[ -z $candidate ]] || /usr/bin/rm -f -- "$candidate"
  [[ -z $staging ]] || as_root /usr/bin/rm -f -- "$staging" || true
}
trap cleanup EXIT

if [[ -n $system_root ]]; then
  [[ $testing == "1" ]] ||
    fail "a custom system root is valid only in tests"
  canonical_root=$(/usr/bin/realpath -m -- "$system_root")
  [[ $system_root == /tmp/* && $system_root == "$canonical_root" &&
    -d $system_root && ! -L $system_root && -O $system_root ]] ||
    fail "the test system root is unavailable or unsafe"
  root_mode=$(/usr/bin/stat -c '%a' -- "$system_root")
  (( (8#$root_mode & 022) == 0 )) ||
    fail "the test system root is writable by other users"
  target_uid=$(/usr/bin/id -u)
  target_gid=$(/usr/bin/id -g)
  desktop_user=${QVOS_REBOOT_POLICY_USER:-${USER:-}}
elif [[ $testing == "1" || -n ${QVOS_REBOOT_POLICY_USER:-} ]]; then
  fail "test overrides require a custom system root"
else
  desktop_user=${USER:-}
fi

[[ $desktop_user =~ ^[a-z_][a-z0-9_-]*[$]?$ &&
  $desktop_user != "root" ]] ||
  fail "cannot validate the desktop account"

root_exists() {
  as_root /usr/bin/test -e "$1" || as_root /usr/bin/test -L "$1"
}

directory_is_safe() {
  local directory=$1
  local mode

  as_root /usr/bin/test -d "$directory" || return 1
  as_root /usr/bin/test ! -L "$directory" || return 1
  [[ $(as_root /usr/bin/stat -c '%u:%g' -- "$directory") == \
    "$target_uid:$target_gid" ]] || return 1
  mode=$(as_root /usr/bin/stat -c '%a' -- "$directory") || return 1
  (( (8#$mode & 022) == 0 ))
}

policy_directory=${target%/*}
if root_exists "$policy_directory"; then
  directory_is_safe "$policy_directory" ||
    fail "the sudoers directory is unsafe"
else
  directory_is_safe "${policy_directory%/*}" ||
    fail "the sudoers parent directory is unsafe"
  as_root /usr/bin/install -d -o "$target_uid" -g "$target_gid" \
    -m 0750 -- "$policy_directory"
fi

candidate=$(/usr/bin/mktemp)
printf '%s ALL=(ALL) NOPASSWD: /usr/bin/reboot\n' "$desktop_user" \
  >"$candidate"
/usr/bin/chmod 0440 "$candidate"
/usr/bin/visudo -cf "$candidate" >/dev/null ||
  fail "the generated sudoers policy is invalid"

policy_matches() {
  local policy=$1

  as_root /usr/bin/test -f "$policy" || return 1
  as_root /usr/bin/test ! -L "$policy" || return 1
  [[ $(as_root /usr/bin/stat -c '%u:%g:%a' -- "$policy") == \
    "$target_uid:$target_gid:440" ]] || return 1
  as_root /usr/bin/cmp -s -- "$candidate" "$policy" || return 1
  as_root /usr/bin/visudo -cf "$policy" >/dev/null
}

if root_exists "$target"; then
  policy_matches "$target" ||
    fail "refusing a modified or unsafe reboot policy at $policy_path"
  exit 0
fi

staging=$(as_root /usr/bin/mktemp --tmpdir="$policy_directory" \
  '.99-qvos-installer-reboot.XXXXXX')
if ! as_root /usr/bin/install -o "$target_uid" -g "$target_gid" -m 0440 \
  -- "$candidate" "$staging" ||
  ! as_root /usr/bin/visudo -cf "$staging" >/dev/null ||
  ! as_root /usr/bin/mv -f -- "$staging" "$target"; then
  fail "could not publish the installer reboot policy"
fi
staging=

policy_matches "$target" ||
  fail "the installed reboot policy did not validate"
