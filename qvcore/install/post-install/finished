#!/bin/bash
set -euo pipefail

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
install_log=${QVOS_INSTALL_LOG_FILE:-/var/log/qvos-install.log}
completion_marker=${QVOS_INSTALL_COMPLETION_MARKER:-/var/tmp/qvos-install-completed}
tui="${QVOS_TUI_BIN:-}"
if [[ -z $tui ]]; then
  tui=$(command -v qvos-tui || true)
fi

remove_installer_sudoers() {
  local actual
  local expected
  local policy

  [[ -n ${USER:-} && $USER =~ ^[[:alnum:]_.@-]+$ ]] || {
    echo "qvOS install: cannot validate the temporary installer policy user" >&2
    return 1
  }
  printf -v expected \
    '%s\n' \
    'root ALL=(ALL:ALL) NOPASSWD: ALL' \
    '%wheel ALL=(ALL:ALL) NOPASSWD: ALL' \
    "$USER ALL=(ALL:ALL) NOPASSWD: ALL"
  expected=${expected%$'\n'}

  for policy in \
    /etc/sudoers.d/99-qvos-installer \
    /etc/sudoers.d/99-omarchy-installer; do
    sudo test -e "$policy" || sudo test -L "$policy" || continue
    if sudo test -L "$policy" || ! sudo test -f "$policy"; then
      printf 'qvOS install: unsafe installer policy: %s\n' "$policy" >&2
      return 1
    fi
    actual=$(sudo cat -- "$policy") || return 1
    [[ $actual == "$expected" ]] || {
      printf 'qvOS install: modified installer policy: %s\n' "$policy" >&2
      return 1
    }
    sudo rm -f -- "$policy" &>/dev/null
  done
}

echo_in_style() {
  printf '%s\n' "$1" |
    tte --canvas-width 0 --anchor-text c --frame-rate 640 print
}

mark_install_complete() {
  if [[ -L $completion_marker ]] ||
    [[ -e $completion_marker && ! -f $completion_marker ]]; then
    printf 'qvOS install: unsafe completion marker: %s\n' \
      "$completion_marker" >&2
    return 1
  fi
  : >"$completion_marker"
}

if [[ -n ${OMARCHY_CHROOT_INSTALL:-} && -n $tui && -x $tui ]]; then
  QVOS_TUI_FULLSCREEN=1 "$tui" --iso-finished
  remove_installer_sudoers
  mark_install_complete
  exit 0
fi

clear
printf '\n'
tte \
  -i "$QVOS_PATH/qvcore/branding/terminal-art.txt" \
  --canvas-width 0 \
  --anchor-text c \
  --frame-rate 920 \
  laseretch
printf '\n'

total_time=""
if [[ -f $install_log ]]; then
  total_time=$(
    tail -n 20 "$install_log" |
      sed -n 's/^Total:[[:space:]]*//p' |
      tail -n 1
  )
fi

if [[ -n $total_time ]]; then
  printf '\n'
  echo_in_style "Installed in $total_time"
else
  echo_in_style "Finished installing"
fi

remove_installer_sudoers

if ! gum confirm \
  --padding "0 0 0 $((${PADDING_LEFT:-0} + 32))" \
  --show-help=false \
  --default \
  --affirmative "Reboot Now" \
  --negative "" \
  ""; then
  exit 0
fi

clear
if [[ -n ${OMARCHY_CHROOT_INSTALL:-} ]]; then
  mark_install_complete
else
  sudo reboot 2>/dev/null
fi
