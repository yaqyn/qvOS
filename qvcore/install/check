#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qvcore/install/native-paths"
retired_manifest="$root/qvcore/install/retired-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

for owner in \
  refresh-applications \
  reinstall \
  reinstall-configs \
  reinstall-packages \
  reinstall-source \
  source-root \
  system-tuning; do
  [[ -x $root/qvcore/install/$owner ]] || fail "install owner mode: $owner"
done
[[ ! -e $root/qvcore/install/cleanup-obsolete &&
  ! -L $root/qvcore/install/cleanup-obsolete ]] ||
  fail "pre-release obsolete-state convergence owner remains"
[[ ! -e $root/qvcore/install/retire-inherited-system-policy &&
  ! -L $root/qvcore/install/retire-inherited-system-policy ]] ||
  fail "pre-release inherited system-policy cleanup owner remains"
[[ ! -e $root/qvcore/install/migrate-structure &&
  ! -L $root/qvcore/install/migrate-structure ]] ||
  fail "pre-release Services and Development structure migrator remains"

declare -A route_owners=(
  [first-run]=qvcore/install/first-run/run
  [refresh-applications]=qvcore/install/refresh-applications
  [reinstall]=qvcore/install/reinstall
  [reinstall-configs]=qvcore/install/reinstall-configs
  [reinstall-git]=qvcore/install/reinstall-source
  [reinstall-pkgs]=qvcore/install/reinstall-packages
)
for route in "${!route_owners[@]}"; do
  native_adapter="$root/bin/qv-$route"
  compatibility_adapter="$root/bin/omarchy-$route"
  owner="$root/${route_owners[$route]}"
  [[ -x $native_adapter && -x $compatibility_adapter && -x $owner ]] ||
    fail "install owner or adapter mode: $route"
  (( $(wc -l <"$native_adapter") <= 10 )) ||
    fail "native install adapter contains implementation: $route"
  (( $(wc -l <"$compatibility_adapter") <= 5 )) ||
    fail "install compatibility adapter contains implementation: $route"
  rg -q '^# qv:summary=' "$native_adapter" ||
    fail "native install adapter lacks metadata: $route"
  ! rg -q '^# (qv|omarchy):' "$compatibility_adapter" ||
    fail "install compatibility adapter duplicates metadata: $route"
  for adapter in "$native_adapter" "$compatibility_adapter"; do
    grep -Fqx "exec \"\$QVOS_PATH/${route_owners[$route]}\" \"\$@\"" "$adapter" ||
      fail "install adapter owner: $route"
  done
done
for owner in prepare root run gnome-theme icons; do
  [[ -x $root/qvcore/install/first-run/$owner ]] ||
    fail "first-run owner mode: $owner"
done
for owner in npx resolve webapps; do
  [[ -x $root/qvcore/install/packaging/$owner ]] ||
    fail "packaging owner mode: $owner"
done
[[ ! -e $root/qvcore/install/packaging/nvim.sh ]] ||
  fail "retired provider Neovim setup stage remains"
if rg -n 'omarchy-(nvim|walker)([[:space:]]|$)' \
  "$root/qvcore/install/packaging" \
  --glob '!AGENTS.md' --glob '!check'; then
  fail "fresh installation retains a branded application package"
fi
[[ -f $root/qvcore/install/packaging/base &&
  ! -x $root/qvcore/install/packaging/base ]] ||
  fail "base packaging owner mode"
[[ -x $root/qvcore/install/post-install/finished ]] ||
  fail "post-install presentation owner mode"

[[ ! -e $root/install && ! -L $root/install ]] ||
  fail "inherited install tree remains"
[[ ! -e $root/default && ! -L $root/default ]] ||
  fail "inherited default source tree remains"
expected_retired=$'bin/omarchy-npx-install\nbin/omarchy-remove-preinstalls\ndefault/gpg/\ndefault/nautilus-python/\ndefault/systemd/faster-shutdown.conf\ndefault/systemd/user@.service.d/faster-shutdown.conf\ninstall/'
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == "$expected_retired" ]] ||
  fail "retired install and Nautilus source inventory"
[[ ! -e $root/default/nautilus-python && ! -L $root/default/nautilus-python ]] ||
  fail "retired Nautilus extension source remains"
[[ ! -e $root/default/gpg && ! -L $root/default/gpg ]] ||
  fail "retired global GnuPG source remains"
for retired_policy in \
  default/systemd/faster-shutdown.conf \
  default/systemd/user@.service.d/faster-shutdown.conf; do
  [[ ! -e $root/$retired_policy && ! -L $root/$retired_policy ]] ||
    fail "retired fast-shutdown source remains: $retired_policy"
done
for inventory in "$manifest" "$retired_manifest"; do
  [[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$inventory") == $(
    sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$inventory" | sort -u
  ) ]] || fail "install path inventory is not sorted and unique: $inventory"
done

declare -A expected_runtime=(
  [direct]=$'manifest.tsv\npost-update-hook\ntool\nupdate'
  [tmux]='qvos-tmux'
)
for feature in direct tmux; do
  runtime_manifest="$root/qvcore/$feature/runtime-paths"
  runtime_paths=$(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$runtime_manifest")
  [[ $runtime_paths == "${expected_runtime[$feature]}" ]] ||
    fail "$feature runtime inventory is incomplete or unordered"
  while IFS= read -r runtime_path; do
    [[ -f $root/qvcore/$feature/$runtime_path &&
      ! -L $root/qvcore/$feature/$runtime_path ]] ||
      fail "$feature runtime source is unavailable or unsafe: $runtime_path"
  done <<<"$runtime_paths"
done

if find "$root/qvcore/install" -type f -name '*.sh' -perm /111 -print -quit |
  grep -q .; then
  fail "sourced native install leaf is executable"
fi
for owner in run errors chroot.sh logging.sh presentation.sh; do
  [[ -f $root/qvcore/install/helpers/$owner &&
    ! -x $root/qvcore/install/helpers/$owner ]] ||
    fail "native helper owner mode: $owner"
done
expected_helper_stage=$'# shellcheck shell=bash\n# shellcheck disable=SC1091\n\nsource "$QVOS_INSTALL/helpers/chroot.sh"\nsource "$QVOS_INSTALL/helpers/presentation.sh"\nsource "$QVOS_PATH/qvcore/install/helpers/errors"\nsource "$QVOS_INSTALL/helpers/logging.sh"'
[[ $(<"$root/qvcore/install/helpers/run") == "$expected_helper_stage" ]] ||
  fail "native install helper stage order"
grep -Fq \
  "bash -Ee -o pipefail -c 'script=\$1; set --; source \"\$script\"'" \
  "$root/qvcore/install/helpers/logging.sh" ||
  fail "installer leaf runner is not fail-fast"

# shellcheck disable=SC2016
grep -Fqx 'export QVOS_INSTALL="$QVOS_PATH/qvcore/install"' "$root/install.sh" ||
  fail "native installer stage root"
if rg -n 'OMARCHY_(PATH|INSTALL|REPO|REF)' \
  "$root/install.sh" \
  "$root/boot.sh" \
  "$root/qvcore/install/preflight/show-env.sh"; then
  fail "native installer accepts a retired product-source environment"
fi
# shellcheck disable=SC2016
grep -Fqx 'export QVOS_INSTALL_LOG_FILE="${QVOS_INSTALL_LOG_FILE:-/var/log/qvos-install.log}"' \
  "$root/install.sh" || fail "native installer log identity"
grep -Fqx 'export QVOS_ONLINE_INSTALL=true' "$root/boot.sh" ||
  fail "native online installer identity"
# shellcheck disable=SC2016
for stage in \
  'source "$QVOS_PATH/qvcore/install/helpers/run"' \
  'source "$QVOS_INSTALL/preflight/all.sh"' \
  'source "$QVOS_INSTALL/packaging/all.sh"' \
  'source "$QVOS_PATH/qvcore/install/config/run"' \
  'source "$QVOS_PATH/qvcore/boot/install"' \
  'source "$QVOS_PATH/qvcore/install/post-install/run"'; do
  grep -Fqx "$stage" "$root/install.sh" || fail "native install stage: $stage"
done

for stage in helpers/run config/run preflight/all.sh packaging/all.sh post-install/run; do
  [[ -f $root/qvcore/install/$stage && ! -x $root/qvcore/install/$stage ]] ||
    fail "native sourced stage mode: $stage"
done
if rg -n 'OMARCHY_INSTALL|QVOS_PATH=.*OMARCHY_PATH' \
  "$root/qvcore/install" --glob '!AGENTS.md' --glob '!check'; then
  fail "native install orchestration accepts an inherited source root"
fi
if rg -n 'OMARCHY_(MIRROR|USER_NAME|USER_EMAIL)' \
  "$root/boot.sh" "$root/qvcore/install" \
  --glob '!AGENTS.md' --glob '!check'; then
  fail "native installer accepts inherited provider or user metadata"
fi
if rg -n 'omarchy-pkg-add' \
  "$root/qvcore/install" --glob '!AGENTS.md' --glob '!check'; then
  fail "native installer calls the package compatibility frontend"
fi
# shellcheck disable=SC2016
grep -Fqx 'run_logged "$QVOS_PATH/qvcore/install/configure"' \
  "$root/qvcore/install/config/run" || fail "qvOS configuration stage"
# shellcheck disable=SC2016
grep -Fqx 'run_logged "$QVOS_PATH/qvcore/config/toggle-state"' \
  "$root/qvcore/install/config/run" || fail "native qvOS toggle-state stage"
# shellcheck disable=SC2016
grep -Fqx '"$QVOS_PATH/qvcore/branding/system-identity"' \
  "$root/qvcore/install/config/branding.sh" ||
  fail "fresh install does not activate the native system identity"
grep -Fq 'mise use -g node@lts' "$root/qvcore/install/config/mise-work.sh" ||
  fail "online installation does not select Node.js LTS"
if rg -n 'QVOS_MISE_MODE|migrate-node-lts|qvos_mise_migrate_node_lts|node@latest|mise trust ~' \
  "$root/qvcore/install/config/mise-work.sh"; then
  fail "Mise setup retains a migration mode, moving Current, or foreign trust"
fi
# shellcheck disable=SC2016
grep -Fqx 'run_logged "$QVOS_PATH/qvcore/controls/install-root"' \
  "$root/qvcore/install/config/run" ||
  fail "bounded Apple display privilege stage"
[[ ! -e $root/qvcore/install/config/sudoless-asdcontrol.sh ]] ||
  fail "raw passwordless asdcontrol installer remains"
if rg -n 'NOPASSWD:.*asdcontrol|sudo[[:space:]]+asdcontrol' \
  "$root/qvcore/install" "$root/qvcore/controls" \
  --glob '!AGENTS.md' --glob '!check' --glob '!install-root'; then
  fail "raw passwordless Apple display control remains"
fi
if rg -n 'config/(gpg|fast-shutdown|unmount-fuse)\.sh|default/(gpg|systemd)' \
  "$root/qvcore/install/config/run" "$root/qvcore/install/config"; then
  fail "fresh install retains inherited global policy"
fi
for retired_leaf in gpg.sh fast-shutdown.sh unmount-fuse.sh; do
  [[ ! -e $root/qvcore/install/config/$retired_leaf ]] ||
    fail "retired installer policy leaf remains: $retired_leaf"
done
[[ ! -e $root/qvcore/install/config/timezones.sh ]] ||
  fail "retired passwordless timezone policy owner remains"
if rg -n '99-omarchy-nofile|90-omarchy-file-watchers|omarchy-tzupdate' \
  "$root/qvcore/install" --glob '!AGENTS.md' --glob '!check'; then
  fail "fresh install creates a retired system-policy identity"
fi
for tuning_source in \
  qvcore/install/system/nofile.conf \
  qvcore/install/system/file-watchers.conf \
  qvcore/install/system/network.conf \
  qvcore/install/system/plocate-ac-only.conf \
  qvcore/install/system/power-key.conf; do
  [[ -f $root/$tuning_source && ! -L $root/$tuning_source ]] ||
    fail "native system-tuning source: $tuning_source"
done
for tuning_stage in \
  'ssh-flakiness.sh|network' \
  'plocate-ac-only.sh|plocate'; do
  stage=${tuning_stage%%|*}
  operation=${tuning_stage#*|}
  expected_stage="\"\$QVOS_PATH/qvcore/install/system-tuning\" $operation"
  grep -Fqx "$expected_stage" "$root/qvcore/install/config/$stage" ||
    fail "system tuning stage bypasses its native owner: $stage"
done
if rg -n '99-sysctl\.conf|plocate-updatedb\.service\.d/ac-only\.conf' \
  "$root/qvcore/install/config"; then
  fail "fresh install retains generic system tuning targets"
fi
# shellcheck disable=SC2016
grep -Fqx 'run_logged "$QVOS_INSTALL/config/power-key.sh"' \
  "$root/qvcore/install/config/run" || fail "native power-key install stage"
# shellcheck disable=SC2016
[[ $(<"$root/qvcore/install/config/power-key.sh") == \
  '"$QVOS_PATH/qvcore/install/system-tuning" power-key' ]] ||
  fail "power-key stage bypasses its native owner"
for retired_power_leaf in \
  qvcore/install/config/hardware/ignore-power-button.sh \
  qvcore/install/config/hardware/usb-autosuspend.sh; do
  [[ ! -e $root/$retired_power_leaf && ! -L $root/$retired_power_leaf ]] ||
    fail "retired global hardware policy remains: $retired_power_leaf"
done
if rg -n 'HandlePowerKey=.*ignore|disable-usb-autosuspend|usbcore autosuspend=-1' \
  "$root/qvcore/install/config" --glob '!power-key.sh'; then
  fail "fresh install directly edits logind or globally disables USB autosuspend"
fi
[[ -x $root/qvcore/install/hardware/identity ]] ||
  fail "native hardware identity owner mode"
for hardware_source in \
  qvcore/install/hardware/asus/z13-touchpad \
  qvcore/install/hardware/asus/z13-touchpad.rules \
  qvcore/install/hardware/apple/nvme-suspend \
  qvcore/install/hardware/apple/qvos-nvme-suspend-fix.service \
  qvcore/install/hardware/apple/spi-macbook8.conf \
  qvcore/install/hardware/apple/spi-modern.conf \
  qvcore/install/hardware/asus/b9406-display.conf \
  qvcore/install/hardware/asus/b9406-touchpad.quirks \
  qvcore/install/hardware/asus/ptl-backlight.conf \
  qvcore/install/hardware/input/hid-apple-fkeys.conf \
  qvcore/install/hardware/input/psmouse-synaptics.conf \
  qvcore/install/hardware/intel/fred.conf \
  qvcore/install/hardware/intel/iwlwifi-disable-eht.conf \
  qvcore/install/hardware/nvidia/env-gsp.lua \
  qvcore/install/hardware/nvidia/env-legacy.lua \
  qvcore/install/hardware/nvidia/mkinitcpio.conf \
  qvcore/install/hardware/nvidia/modprobe.conf \
  qvcore/install/hardware/lenovo/yoga-pro7-bass.conf \
  qvcore/install/hardware/tuxedo/blacklist-clevo-xsm-wmi.conf; do
  [[ -f $root/$hardware_source && ! -L $root/$hardware_source ]] ||
    fail "native hardware identity source: $hardware_source"
done
for retired_hardware_leaf in \
  qvcore/install/config/hardware/asus/fix-z13-touchpad.sh \
  qvcore/install/config/hardware/apple/fix-suspend-nvme.sh; do
  [[ ! -e $root/$retired_hardware_leaf ]] ||
    fail "retired hardware identity leaf remains: $retired_hardware_leaf"
done
if rg -n '99-omarchy-asus-z13-touchpad|omarchy-nvme-suspend-fix' \
  "$root/qvcore/install" --glob '!AGENTS.md' --glob '!check'; then
  fail "fresh install creates a retired hardware-policy identity"
fi
# shellcheck disable=SC2016
grep -Fqx 'run_logged "$QVOS_PATH/qvcore/install/hardware/asus/z13-touchpad"' \
  "$root/qvcore/install/config/run" || fail "native ASUS Z13 install stage"
# shellcheck disable=SC2016
grep -Fqx 'run_logged "$QVOS_PATH/qvcore/install/hardware/apple/nvme-suspend"' \
  "$root/qvcore/install/config/run" || fail "native Apple NVMe install stage"
# shellcheck disable=SC2016
for stage_contract in \
  'qvcore/install/config/hardware/asus/fix-asus-ptl-b9406-display.sh|"$QVOS_PATH/qvcore/install/hardware/identity" asus-b9406-display' \
  'qvcore/install/config/hardware/asus/fix-asus-ptl-display-backlight.sh|"$QVOS_PATH/qvcore/install/hardware/identity" asus-ptl-backlight' \
  'qvcore/install/config/hardware/fix-fkeys.sh|"$QVOS_PATH/qvcore/install/hardware/identity" hid-apple-fkeys' \
  'qvcore/install/config/hardware/fix-synaptic-touchpad.sh|"$QVOS_PATH/qvcore/install/hardware/identity" synaptics-ps2' \
  'qvcore/install/config/hardware/intel/fred.sh|"$QVOS_PATH/qvcore/install/hardware/identity" intel-fred' \
  'qvcore/install/config/hardware/intel/fix-wifi7-eht.sh|"$QVOS_PATH/qvcore/install/hardware/identity" intel-wifi7-eht' \
  'qvcore/install/config/hardware/lenovo/fix-yoga-pro7-bass-speakers.sh|"$QVOS_PATH/qvcore/install/hardware/identity" lenovo-yoga-pro7-bass' \
  'qvcore/install/config/hardware/fix-surface-keyboard.sh|"$QVOS_PATH/qvcore/install/hardware/identity" surface-keyboard' \
  'qvcore/install/hardware/asus/b9406-touchpad|"$QVOS_PATH/qvcore/install/hardware/identity" asus-b9406-touchpad'; do
  stage=${stage_contract%%|*}
  expected_call=${stage_contract#*|}
  [[ $(<"$root/$stage") == "$expected_call" ]] ||
    fail "hardware stage bypasses its native owner: $stage"
done
# shellcheck disable=SC2016
grep -Fq 'if "$QVOS_PATH/bin/qv-hw-apple-spi-keyboard"; then' \
  "$root/qvcore/install/config/hardware/apple/fix-spi-keyboard.sh" ||
  fail "Apple SPI install stage bypasses its native detector"
# shellcheck disable=SC2016
grep -Fq '"$QVOS_PATH/qvcore/install/hardware/identity" apple-spi-keyboard' \
  "$root/qvcore/install/config/hardware/apple/fix-spi-keyboard.sh" ||
  fail "Apple SPI install stage bypasses its native policy owner"
# shellcheck disable=SC2016
grep -Fq 'if "$QVOS_PATH/bin/qv-hw-tuxedo"; then' \
  "$root/qvcore/install/config/hardware/fix-tuxedo-backlight.sh" ||
  fail "Tuxedo install stage bypasses its native detector"
# shellcheck disable=SC2016
grep -Fq '"$QVOS_PATH/qvcore/install/hardware/identity" tuxedo-backlight' \
  "$root/qvcore/install/config/hardware/fix-tuxedo-backlight.sh" ||
  fail "Tuxedo install stage bypasses its native policy owner"
# shellcheck disable=SC2016
grep -Fq '"$QVOS_PATH/qvcore/install/hardware/identity" nvidia-boot' \
  "$root/qvcore/install/config/hardware/nvidia.sh" ||
  fail "NVIDIA install stage bypasses its native boot-policy owner"
if rg -n '/etc/default/limine|sudo[[:space:]]+tee|modprobe[[:space:]]+psmouse' \
  "$root/qvcore/install/config/hardware/apple/fix-spi-keyboard.sh" \
  "$root/qvcore/install/config/hardware/asus/fix-asus-ptl-b9406-display.sh" \
  "$root/qvcore/install/config/hardware/asus/fix-asus-ptl-display-backlight.sh" \
  "$root/qvcore/install/config/hardware/fix-fkeys.sh" \
  "$root/qvcore/install/config/hardware/fix-synaptic-touchpad.sh" \
  "$root/qvcore/install/config/hardware/intel/fred.sh" \
  "$root/qvcore/install/config/hardware/intel/fix-wifi7-eht.sh"; then
  fail "hardware policy retains direct, transient, or duplicated root mutation"
fi
if rg -n 'sudo[[:space:]]+tee|qv-hw-match[[:space:]]+"Yoga Pro 7' \
  "$root/qvcore/install/config/hardware/lenovo/fix-yoga-pro7-bass-speakers.sh"; then
  fail "Lenovo audio setup bypasses bounded native policy ownership"
fi
grep -Fq 'qvos-surface-keyboard.conf' \
  "$root/qvcore/install/hardware/identity" ||
  fail "Surface keyboard policy lacks a native installed identity"
if rg -n 'sudo[[:space:]]+tee|(/lib|/usr/lib)/modules/.+\.ko' \
  "$root/qvcore/install/config/hardware/fix-tuxedo-backlight.sh"; then
  fail "Tuxedo hardware policy retains direct or destructive root mutation"
fi
if rg -n 'sudo[[:space:]]+tee|/etc/(modprobe\.d|mkinitcpio\.conf\.d)/nvidia\.conf|(^|[[:space:]])exit[[:space:]]+[0-9]+' \
  "$root/qvcore/install/config/hardware/nvidia.sh"; then
  fail "NVIDIA setup retains direct boot writes or exits the sourced installer"
fi
if rg -n '(/lib|/usr/lib)/modules/.+\.ko|sudo[[:space:]]+rm.+\.ko' \
  "$root/qvcore/install/config/hardware"; then
  fail "fresh hardware setup deletes an unverified kernel module"
fi
[[ ! -e $root/qvcore/install/config/hardware/apple/fix-t2.sh ]] ||
  fail "retired unsigned T2 configuration owner remains"
[[ ! -e $root/qvcore/install/config/hardware/intel/ptl-kernel.sh ]] ||
  fail "retired Panther Lake kernel replacement remains"
if rg -n 'arch-mact2|linux-(ptl|t2)|apple-t2|t2fanrd|tiny-dfr|vulkan-asahi|pacman[[:space:]]+-Rdd' \
  "$root/qvcore/install/config" \
  "$root/qvcore/install/packaging" \
  "$root/qvcore/install/post-install" \
  --glob '!AGENTS.md'; then
  fail "fresh install retains an unsupported T2 repository or package"
fi
[[ ! -e $root/qvcore/install/config/omarchy-toggles.sh ]] ||
  fail "retired inherited toggle-state stage"
[[ ! -e $root/qvcore/install/config/fix-powerprofilesctl-shebang.sh &&
  ! -L $root/qvcore/install/config/fix-powerprofilesctl-shebang.sh ]] ||
  fail "retired package-executable power-profile patch remains"
if rg -n '/usr/bin/powerprofilesctl|fix-powerprofilesctl-shebang' \
  "$root/qvcore/install/config"; then
  fail "fresh install mutates the package-owned power-profile executable"
fi
# shellcheck disable=SC2016
grep -Fqx '"$QVOS_PATH/qvcore/security/docker-policy"' \
  "$root/qvcore/install/config/docker.sh" ||
  fail "Docker install stage bypasses its security policy owner"
if rg -n '/etc/(docker|systemd/(resolved\.conf\.d|system/docker\.service\.d))|sudo[[:space:]]+(tee|mkdir)' \
  "$root/qvcore/install/config/docker.sh"; then
  fail "Docker install stage retains direct root configuration ownership"
fi
[[ ! -e $root/qvcore/install/config/nautilus-python ]] ||
  fail "retired Nautilus configuration owner"
[[ ! -e $root/qvcore/install/config/walker-elephant.sh ]] ||
  fail "retired duplicate Walker configuration owner"
if rg -n 'walker-restart\.hook|default/walker/(walker\.desktop|restart\.conf)' \
  "$root/qvcore/install"; then
  fail "unsafe or duplicate Walker install lifecycle remains"
fi
for walker_source in \
  qvcore/config/files/autostart/walker.desktop \
  qvcore/config/files/systemd/user/app-walker@autostart.service.d/restart.conf; do
  [[ -f $root/$walker_source && ! -L $root/$walker_source ]] ||
    fail "native Walker startup source: $walker_source"
done
if rg -n 'Nautilus action icons|nautilus-python/extensions' \
  "$root/qvcore/install/config" \
  "$root/qvcore/install/first-run" \
  "$root/qvcore/install/post-install"; then
  fail "Nautilus install integration remains"
fi
show_env="$root/qvcore/install/preflight/show-env.sh"
for variable in QVOS_PATH QVOS_INSTALL QVOS_USER_NAME QVOS_USER_EMAIL; do
  grep -Fq "$variable" "$show_env" ||
    fail "native install environment reporting: $variable"
done
if rg -n 'env \|.*QVOS_USER_(NAME|EMAIL)' "$show_env"; then
  fail "native install log exposes personal identity"
fi
if rg -n \
  'OMARCHY_(INSTALL_LOG_FILE|ONLINE_INSTALL|START_TIME|END_TIME|START_EPOCH|END_EPOCH|DURATION|MINS|SECS)|/var/(log/omarchy-install\.log|tmp/omarchy-install-completed)' \
  "$root/boot.sh" \
  "$root/install.sh" \
  "$root/qvcore/install" \
  "$root/qvcore/tui/iso_progress.go"; then
  fail "retired Omarchy installer identity remains active"
fi
