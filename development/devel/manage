#!/bin/bash
set -euo pipefail

# qvos:contract=development/devel/packages.tsv
# qvos:contract=qvcore/direct/tool
# qvos:contract=qvcore/install/migrate-structure
# qvos:contract=qvcore/thunar/actions.sh
# qvos:contract=qvcore/thunar/codex

component_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source_root="$(cd -- "$component_dir/../.." && pwd)"
qvcore_dir="$source_root/qvcore"
package_manifest="$component_dir/packages.tsv"
direct_tool="$qvcore_dir/direct/tool"
state_file="${XDG_STATE_HOME:-$HOME/.local/state}/qvos/development/devel"
thunar_actions_source="$qvcore_dir/thunar/actions.sh"
thunar_codex_source="$qvcore_dir/thunar/codex"
thunar_codex_runtime="$HOME/.local/share/qvos/thunar/codex"
thunar_codex_command="/bin/bash -c '\"\$HOME/.local/share/qvos/thunar/codex\" \"\$1\"' qvos-thunar %f"
assume_yes=0

# shellcheck source=/dev/null
source "$thunar_actions_source"

usage() {
  echo "Usage: development/devel/manage <install|remove> [--yes]" >&2
}

package_ready() {
  local package=$1
  local commands=$2
  local command_name
  local command_list=()

  omarchy-pkg-present "$package" || return 1
  read -r -a command_list <<<"$commands"
  for command_name in "${command_list[@]}"; do
    if [[ $command_name == /* ]]; then
      [[ -x $command_name ]] || return 1
    else
      omarchy-cmd-present "$command_name" || return 1
    fi
  done
}

codex_action_matches() {
  qvos_thunar_action_matches \
    "qvos-codex-here" \
    "utilities-terminal" \
    "Open Codex Here" \
    "$thunar_codex_command" \
    "Start Codex safely in this folder." \
    "*" \
    directories
}

integration_ready() {
  [[ -x $thunar_codex_runtime ]] &&
    cmp -s "$thunar_codex_source" "$thunar_codex_runtime" &&
    codex_action_matches
}

reconcile_integration() {
  [[ -f $state_file ]] || return 0

  install_integration
  integration_ready || {
    echo "Devel Codex workbench reconciliation failed." >&2
    return 1
  }
}

install_integration() {
  install -d "$HOME/.local/share/qvos/thunar"
  install -m 0755 "$thunar_codex_source" "$thunar_codex_runtime"
  qvos_thunar_ensure_action \
    "qvos-codex-here" \
    "utilities-terminal" \
    "Open Codex Here" \
    "$thunar_codex_command" \
    "Start Codex safely in this folder." \
    "*" \
    directories
}

remove_integration() {
  qvos_thunar_remove_action "qvos-codex-here"
  rm -f "$thunar_codex_runtime"
}

verify_packages() {
  local source
  local package
  local label
  local commands
  local extra

  while IFS=$'\t' read -r source package label commands extra; do
    [[ -n $source && $source != "#"* ]] || continue
    [[ $source == "pacman" || $source == "aur" ]] &&
      [[ -n $package && -n $label && -n $commands && -z ${extra:-} ]] || {
      echo "Invalid Devel package manifest entry: $package" >&2
      return 1
    }
    package_ready "$package" "$commands" || {
      echo "Devel package verification failed: $label" >&2
      return 1
    }
  done <"$package_manifest"
}

verify_direct_tools() {
  local tool_id

  while IFS= read -r tool_id; do
    "$direct_tool" verify "$tool_id" || {
      echo "Devel direct-tool verification failed: $tool_id" >&2
      return 1
    }
  done < <("$direct_tool" list-scope devel)
}

install_stack() {
  local source
  local package
  local label
  local commands
  local extra
  local missing=()
  local tool_id

  [[ -f $package_manifest && -x $direct_tool ]] || {
    echo "Devel source is incomplete." >&2
    return 1
  }

  while IFS=$'\t' read -r source package label commands extra; do
    [[ -n $source && $source != "#"* ]] || continue
    if ! package_ready "$package" "$commands"; then
      missing+=("$package")
    fi
  done <"$package_manifest"
  if ((${#missing[@]} > 0)); then
    omarchy-pkg-add "${missing[@]}"
  fi

  while IFS= read -r tool_id; do
    if ! "$direct_tool" installed "$tool_id"; then
      "$direct_tool" install "$tool_id"
    fi
  done < <("$direct_tool" list-scope devel)

  install_integration
  verify_packages
  verify_direct_tools
  integration_ready || {
    echo "Devel Codex workbench integration verification failed." >&2
    return 1
  }

  install -d -m 0700 "$(dirname -- "$state_file")"
  install -m 0600 /dev/null "$state_file"
  echo "Devel is installed."
}

remove_stack() {
  local source
  local package
  local label
  local commands
  local extra
  local installed_packages=()
  local direct_tools=()
  local index

  if [[ ! -f $state_file ]]; then
    echo "Devel is not enrolled; nothing was changed."
    return
  fi

  while IFS=$'\t' read -r source package label commands extra; do
    [[ -n $source && $source != "#"* ]] || continue
    omarchy-pkg-present "$package" && installed_packages+=("$package")
  done <"$package_manifest"
  if ((${#installed_packages[@]} > 0)); then
    for command in pacman omarchy-pkg-drop gum; do
      command -v "$command" >/dev/null 2>&1 || {
        echo "Devel removal requires: $command" >&2
        return 1
      }
    done
    pacman -Rs --print "${installed_packages[@]}" >/dev/null || {
      echo "Pacman could not prepare the Devel removal transaction." >&2
      return 1
    }
  fi
  mapfile -t direct_tools < <("$direct_tool" list-scope devel)

  echo "Devel packages, direct tools and Codex workbench integration will be removed."
  echo "qvOS Codex, projects, credentials and personal files will be preserved."
  if ((assume_yes == 0)); then
    gum confirm "Remove the enrolled Devel workstation?" || {
      echo "Devel removal canceled; nothing was changed."
      return 130
    }
  fi

  remove_integration
  for ((index = ${#direct_tools[@]} - 1; index >= 0; index--)); do
    "$direct_tool" remove "${direct_tools[$index]}"
  done
  if ((${#installed_packages[@]} > 0)); then
    omarchy-pkg-drop "${installed_packages[@]}"
  fi

  for package in "${installed_packages[@]}"; do
    omarchy-pkg-missing "$package" || {
      echo "Devel removal failed: $package remains installed." >&2
      return 1
    }
  done
  for tool_id in "${direct_tools[@]}"; do
    if "$direct_tool" installed "$tool_id"; then
      echo "Devel removal failed: $tool_id remains installed." >&2
      return 1
    fi
  done
  rm -f "$state_file"
  echo "Removed Devel; qvOS Codex, projects, credentials and personal files were preserved."
}

if (($# < 1 || $# > 2)); then
  usage
  exit 2
fi
case $1 in
install | reconcile | remove) ;;
*)
  usage
  exit 2
  ;;
esac
if (($# == 2)); then
  [[ $2 == "--yes" && $1 == "remove" ]] || {
    usage
    exit 2
  }
  assume_yes=1
fi

"$qvcore_dir/install/migrate-structure" --devel

if [[ $1 == "install" ]]; then
  install_stack
elif [[ $1 == "reconcile" ]]; then
  reconcile_integration
else
  remove_stack
fi
