#!/bin/bash
set -euo pipefail

qvos_source="$OMARCHY_PATH/qv/launcher/elephant/omarchy_unlocks.lua"
omarchy_source="$OMARCHY_PATH/default/elephant"
runtime_dir="$HOME/.local/share/qvos/launcher/elephant"
menus_dir="$HOME/.config/elephant/menus"
omarchy_providers=(
  omarchy_background_selector.lua
  omarchy_themes.lua
)

[[ -f $qvos_source ]] || {
  echo "Missing qvOS launcher provider: $qvos_source" >&2
  exit 1
}
for provider in "${omarchy_providers[@]}"; do
  if [[ ! -f $omarchy_source/$provider ]]; then
    echo "Missing Omarchy launcher provider: $omarchy_source/$provider" >&2
    exit 1
  fi
done

rm -rf -- "$runtime_dir"
mkdir -p "$runtime_dir" "$menus_dir"
install -m 0644 "$qvos_source" "$runtime_dir/omarchy_unlocks.lua"
ln -snf \
  "$runtime_dir/omarchy_unlocks.lua" \
  "$menus_dir/omarchy_unlocks.lua"
for provider in "${omarchy_providers[@]}"; do
  ln -snf \
    "$omarchy_source/$provider" \
    "$menus_dir/$provider"
done
