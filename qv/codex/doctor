#!/bin/bash
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
capability_registry="$script_dir/capabilities.tsv"
canonical_codex="$HOME/.local/bin/codex"
codex_state_root="${CODEX_HOME:-$HOME/.codex}"
standalone_root="$HOME/.codex/packages/standalone"
command_search_path="${QVOS_CODEX_COMMAND_PATH:-$PATH}"
json_output=0
check_mode=0
work_dir=""

cleanup() {
  if [[ -n $work_dir && -d $work_dir ]]; then
    rm -rf -- "$work_dir"
  fi
}
trap cleanup EXIT

usage() {
  echo "Usage: qv codex doctor [--json] [--check]" >&2
}

bool_json() {
  if (($1)); then
    printf 'true'
  else
    printf 'false'
  fi
}

resolve_command() {
  local capability=$1

  if [[ $capability == /* ]]; then
    [[ -x $capability ]] && printf '%s\n' "$capability"
  else
    (
      PATH=$command_search_path
      type -P -- "$capability" 2>/dev/null
    )
  fi
}

validate_registry() {
  awk -F '\t' '
    /^#/ || NF == 0 { next }
    NF != 5 { invalid = 1; next }
    $2 !~ /^(base|qvcore|project|avoid)$/ { invalid = 1 }
    $1 == "" || $3 == "" || $4 == "" || $5 == "" { invalid = 1 }
    seen[$1]++ { invalid = 1 }
    END { exit invalid }
  ' "$capability_registry"
}

unique_command_paths() {
  local capability=$1
  local command_path
  local command_paths
  local -A seen=()

  [[ $capability != /* ]] || return 0
  command_paths=$(
    PATH=$command_search_path
    type -a -p -- "$capability" 2>/dev/null
  )
  while IFS= read -r command_path; do
    if [[ -n $command_path && -z ${seen[$command_path]+x} ]]; then
      printf '%s\n' "$command_path"
      seen[$command_path]=1
    fi
  done <<<"$command_paths"
}

capability_is_ready() {
  local capability=$1
  local capabilities_file=$2

  jq -e --arg capability "$capability" \
    'select(.command == $capability and .present == true)' \
    "$capabilities_file" >/dev/null
}

if (($# > 2)); then
  usage
  exit 2
fi

while (($#)); do
  case $1 in
  --json)
    json_output=1
    ;;
  --check)
    check_mode=1
    ;;
  *)
    usage
    exit 2
    ;;
  esac
  shift
done

if [[ ! -f $capability_registry ]] || ! validate_registry; then
  echo "qvOS Codex capability contract is unavailable or invalid: $capability_registry" >&2
  exit 1
fi

if ! type -P jq >/dev/null 2>&1; then
  echo "qvOS Codex doctor requires the base command: jq" >&2
  exit 1
fi

work_dir=$(mktemp -d)
capabilities_file="$work_dir/capabilities.ndjson"
duplicates_file="$work_dir/duplicates.ndjson"
codex_doctor_file="$work_dir/codex-doctor.json"
: >"$capabilities_file"
: >"$duplicates_file"

base_total=0
base_ready=0
qvdev_total=0
qvdev_ready=0
avoid_present=0
duplicate_count=0

while IFS=$'\t' read -r capability layer profile owner repair extra; do
  [[ -n $capability && $capability != "#"* ]] || continue
  [[ -z ${extra:-} ]] || continue

  resolved_path=$(resolve_command "$capability" || true)
  present=0
  [[ -n $resolved_path ]] && present=1

  case $layer in
  base)
    base_total=$((base_total + 1))
    ((present)) && base_ready=$((base_ready + 1))
    if ((present)); then
      capability_status="ready"
    else
      capability_status="missing"
    fi
    ;;
  qvcore)
    if [[ $profile == "qvdev" ]]; then
      qvdev_total=$((qvdev_total + 1))
      ((present)) && qvdev_ready=$((qvdev_ready + 1))
    fi
    if ((present)); then
      capability_status="ready"
    else
      capability_status="missing"
    fi
    ;;
  project)
    if ((present)); then
      capability_status="present"
    else
      capability_status="project-managed"
    fi
    ;;
  avoid)
    if ((present)); then
      capability_status="avoid-present"
      avoid_present=$((avoid_present + 1))
    else
      capability_status="avoided"
    fi
    ;;
  esac

  jq -cn \
    --arg command "$capability" \
    --arg layer "$layer" \
    --arg profile "$profile" \
    --arg owner "$owner" \
    --arg status "$capability_status" \
    --arg path "$resolved_path" \
    --arg repair "$repair" \
    --argjson present "$(bool_json "$present")" \
    '{
      command: $command,
      layer: $layer,
      profile: $profile,
      owner: $owner,
      status: $status,
      present: $present,
      path: (if $path == "" then null else $path end),
      repair: (
        if $status == "ready" or $status == "present" or $status == "avoided"
        then null
        else $repair
        end
      )
    }' >>"$capabilities_file"

  mapfile -t command_paths < <(unique_command_paths "$capability")
  if ((${#command_paths[@]} > 1)); then
    duplicate_count=$((duplicate_count + 1))
    printf '%s\n' "${command_paths[@]}" |
      jq -Rsc \
        --arg command "$capability" \
        '{
          command: $command,
          paths: (split("\n") | map(select(length > 0)))
        }' >>"$duplicates_file"
  fi
done <"$capability_registry"

canonical_ready=0
canonical_real=""
canonical_version=""
canonical_owner="missing"
if [[ -x $canonical_codex ]]; then
  canonical_real=$(readlink -f -- "$canonical_codex" 2>/dev/null || true)
  canonical_version=$(
    "$canonical_codex" --version 2>/dev/null |
      awk 'NR == 1 { print $NF }'
  )
  if [[ $canonical_real == "$standalone_root/"* &&
    -n $canonical_version ]]; then
    canonical_ready=1
    canonical_owner="openai-standalone"
  else
    canonical_owner="unrecognized"
  fi
fi

codex_doctor_ready=0
codex_doctor_status="unavailable"
codex_doctor_counts='{}'
codex_doctor_findings='[]'
if ((canonical_ready)); then
  timeout --foreground --kill-after=5s 60s \
    env -u CODEX_MANAGED_BY_NPM -u CODEX_MANAGED_PACKAGE_ROOT \
    "$canonical_codex" doctor --json >"$codex_doctor_file" 2>/dev/null
  if jq -e '
    .schemaVersion == 1
    and (.overallStatus | type == "string")
    and ((.checks | type) == "array" or (.checks | type) == "object")
  ' "$codex_doctor_file" >/dev/null 2>&1; then
    codex_doctor_status=$(jq -r '.overallStatus' "$codex_doctor_file")
    codex_doctor_counts=$(
      jq -c '
        reduce .checks[].status as $status (
          {};
          .[$status] = ((.[$status] // 0) + 1)
        )
      ' "$codex_doctor_file"
    )
    codex_doctor_findings=$(
      jq -c '
        [
          .checks[]
          | select(.status != "ok")
          | {
              id,
              status,
              summary,
              remediation: (.remediation // null)
            }
        ]
      ' "$codex_doctor_file"
    )
    if [[ $codex_doctor_status == "ok" ||
      $codex_doctor_status == "warning" ]]; then
      codex_doctor_ready=1
    fi
  fi
fi

sandbox_ready=0
if ((canonical_ready)) &&
  timeout --foreground --kill-after=5s 20s \
    env -u CODEX_MANAGED_BY_NPM -u CODEX_MANAGED_PACKAGE_ROOT \
    "$canonical_codex" sandbox /usr/bin/true >/dev/null 2>&1; then
  sandbox_ready=1
fi

user_namespace_limit=0
if [[ -r /proc/sys/user/max_user_namespaces ]]; then
  read -r user_namespace_limit </proc/sys/user/max_user_namespaces
  [[ $user_namespace_limit =~ ^[0-9]+$ ]] || user_namespace_limit=0
fi

github_ready=0
infisical_ready=0
proton_pass_ready=0
proton_pass_root="$HOME/.local/share/qvos-codex/proton-pass"
if type -P gh >/dev/null 2>&1 &&
  timeout --foreground 15s gh auth status --hostname github.com >/dev/null 2>&1; then
  github_ready=1
fi
if type -P infisical >/dev/null 2>&1 &&
  timeout --foreground 15s \
    infisical user get token --silent >/dev/null 2>&1; then
  infisical_ready=1
fi
if type -P pass-cli >/dev/null 2>&1; then
  if timeout --foreground 15s \
    env \
    XDG_DATA_HOME="$proton_pass_root/data" \
    XDG_CONFIG_HOME="$proton_pass_root/config" \
    XDG_CACHE_HOME="$proton_pass_root/cache" \
    PROTON_PASS_AGENT_REASON="Verify qvOS Codex credential readiness" \
    pass-cli info --output json >/dev/null 2>&1 &&
    timeout --foreground 15s \
      env \
      XDG_DATA_HOME="$proton_pass_root/data" \
      XDG_CONFIG_HOME="$proton_pass_root/config" \
      XDG_CACHE_HOME="$proton_pass_root/cache" \
      PROTON_PASS_AGENT_REASON="Verify qvOS Codex credential readiness" \
      pass-cli test >/dev/null 2>&1; then
    proton_pass_ready=1
  fi
fi

mcp_configured_count=0
if [[ -r $codex_state_root/config.toml ]]; then
  mcp_configured_count=$(
    awk '/^\[mcp_servers\.[^]]+\]$/ { count++ } END { print count + 0 }' \
      "$codex_state_root/config.toml"
  )
fi
mcp_ready=0
if [[ -s $codex_doctor_file ]] &&
  jq -e '
    any(.checks[]; .id == "mcp.config" and .status == "ok")
  ' "$codex_doctor_file" >/dev/null 2>&1; then
  mcp_ready=1
fi

skill_count=0
if [[ -d $codex_state_root/skills ]]; then
  skill_count=$(
    find "$codex_state_root/skills" -mindepth 2 -maxdepth 4 \
      -type f -name SKILL.md -printf '.\n' 2>/dev/null |
      wc -l
  )
fi

session_bytes=0
session_files=0
if [[ -d $codex_state_root/sessions ]]; then
  session_bytes=$(
    du -sb "$codex_state_root/sessions" 2>/dev/null |
      awk 'NR == 1 { print $1 + 0 }'
  )
  session_files=$(
    find "$codex_state_root/sessions" -type f -name '*.jsonl' \
      -printf '.\n' 2>/dev/null |
      wc -l
  )
fi

wayland_session=0
hyprland_session=0
[[ -n ${WAYLAND_DISPLAY:-} ]] && wayland_session=1
[[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && hyprland_session=1
wayland_total=7
wayland_ready=0
for capability in grim slurp satty wl-copy wl-paste wtype hyprctl; do
  if capability_is_ready "$capability" "$capabilities_file"; then
    wayland_ready=$((wayland_ready + 1))
  fi
done

foundation_total=$((base_total + 3))
foundation_ready_count=$((base_ready +
  canonical_ready +
  codex_doctor_ready +
  sandbox_ready))
foundation_repairable=0
((foundation_ready_count == foundation_total)) || foundation_repairable=1

report_status="ready"
if ((foundation_repairable)); then
  report_status="repairable"
elif [[ $codex_doctor_status == "warning" ]] ||
  ((duplicate_count > 0 || avoid_present > 0)); then
  report_status="warning"
fi

capabilities_json=$(jq -s '.' "$capabilities_file")
duplicates_json=$(jq -s '.' "$duplicates_file")
missing_base_json=$(
  jq -s '
    [
      .[]
      | select(.layer == "base" and .present == false)
      | {command, owner, repair}
    ]
  ' "$capabilities_file"
)

report_json=$(
  jq -n \
    --arg status "$report_status" \
    --arg canonical_path "$canonical_codex" \
    --arg resolved_path "$canonical_real" \
    --arg owner "$canonical_owner" \
    --arg version "$canonical_version" \
    --arg doctor_status "$codex_doctor_status" \
    --argjson doctor_counts "$codex_doctor_counts" \
    --argjson doctor_findings "$codex_doctor_findings" \
    --argjson capabilities "$capabilities_json" \
    --argjson duplicates "$duplicates_json" \
    --argjson missing_base "$missing_base_json" \
    --argjson foundation_ready "$(bool_json "$((foundation_repairable == 0))")" \
    --argjson foundation_ready_count "$foundation_ready_count" \
    --argjson foundation_total "$foundation_total" \
    --argjson base_ready "$base_ready" \
    --argjson base_total "$base_total" \
    --argjson canonical_ready "$(bool_json "$canonical_ready")" \
    --argjson doctor_ready "$(bool_json "$codex_doctor_ready")" \
    --argjson sandbox_ready "$(bool_json "$sandbox_ready")" \
    --argjson user_namespace_limit "$user_namespace_limit" \
    --argjson qvdev_ready "$qvdev_ready" \
    --argjson qvdev_total "$qvdev_total" \
    --argjson wayland_session "$(bool_json "$wayland_session")" \
    --argjson hyprland_session "$(bool_json "$hyprland_session")" \
    --argjson wayland_ready "$wayland_ready" \
    --argjson wayland_total "$wayland_total" \
    --argjson github_ready "$(bool_json "$github_ready")" \
    --argjson infisical_ready "$(bool_json "$infisical_ready")" \
    --argjson proton_pass_ready "$(bool_json "$proton_pass_ready")" \
    --argjson mcp_ready "$(bool_json "$mcp_ready")" \
    --argjson mcp_configured_count "$mcp_configured_count" \
    --argjson skill_count "$skill_count" \
    --argjson session_bytes "$session_bytes" \
    --argjson session_files "$session_files" \
    '{
      schema_version: 1,
      status: $status,
      foundation: {
        ready: $foundation_ready,
        ready_count: $foundation_ready_count,
        total: $foundation_total,
        base_capabilities: {
          ready: $base_ready,
          total: $base_total,
          missing: $missing_base
        }
      },
      installation: {
        canonical_path: $canonical_path,
        resolved_path: (
          if $resolved_path == "" then null else $resolved_path end
        ),
        owner: $owner,
        version: (if $version == "" then null else $version end),
        ready: $canonical_ready,
        install_route: "qvOS base installation",
        update_route: "automatic direct-tool update"
      },
      codex_doctor: {
        ready: $doctor_ready,
        status: $doctor_status,
        counts: $doctor_counts,
        findings: $doctor_findings
      },
      sandbox: {
        ready: $sandbox_ready,
        bubblewrap: (
          any($capabilities[]; .command == "bwrap" and .present == true)
        ),
        user_namespace_limit: $user_namespace_limit,
        proof: "codex sandbox /usr/bin/true"
      },
      profiles: {
        qvdev: {
          status: (
            if $qvdev_ready == $qvdev_total then "ready"
            elif $qvdev_ready == 0 then "missing"
            else "partial"
            end
          ),
          ready: $qvdev_ready,
          total: $qvdev_total,
          install_route: "omarchy install qvcore qvdev"
        },
        browser: {
          status: "planned",
          available: false,
          planned_phase: 2,
          install_route: null
        },
        documents: {
          status: "planned",
          available: false,
          planned_phase: 4,
          install_route: null
        }
      },
      wayland: {
        session: $wayland_session,
        hyprland_session: $hyprland_session,
        automation_commands: {
          ready: $wayland_ready,
          total: $wayland_total
        }
      },
      credentials: {
        github: $github_ready,
        infisical: $infisical_ready,
        proton_pass: $proton_pass_ready
      },
      extensions: {
        mcp_config_ready: $mcp_ready,
        mcp_configured_count: $mcp_configured_count,
        skill_count: $skill_count
      },
      session_storage: {
        bytes: $session_bytes,
        rollout_files: $session_files,
        retention: "informational-only"
      },
      shadowed_commands: $duplicates,
      capabilities: $capabilities
    }'
)

if ((json_output)); then
  jq '.' <<<"$report_json"
else
  printf 'qvOS Codex doctor: %s\n' "$report_status"
  printf '  Foundation      %d/%d ready\n' \
    "$foundation_ready_count" "$foundation_total"
  printf '  Canonical Codex %s (%s)\n' \
    "$canonical_owner" "${canonical_version:-missing}"
  printf '  Codex doctor    %s\n' "$codex_doctor_status"
  printf '  Linux sandbox   %s\n' \
    "$([[ $sandbox_ready == "1" ]] && echo "ready" || echo "missing")"
  printf '  qvDEV           %d/%d commands ready\n' \
    "$qvdev_ready" "$qvdev_total"
  printf '  Browser         planned for Phase 2\n'
  printf '  Documents       planned for Phase 4\n'
  printf '  Wayland tools   %d/%d ready\n' \
    "$wayland_ready" "$wayland_total"
  printf '  MCP / skills    %d configured / %d installed\n' \
    "$mcp_configured_count" "$skill_count"
  printf '  Rollout storage %d bytes across %d files\n' \
    "$session_bytes" "$session_files"

  if ((base_ready != base_total)); then
    echo ""
    echo "Missing guaranteed base capabilities:"
    jq -r '
      select(.layer == "base" and .present == false)
      | "  \(.command): \(.repair)"
    ' "$capabilities_file"
  fi

  if ((duplicate_count)); then
    echo ""
    echo "Shadowed commands:"
    jq -r '"  \(.command): \(.paths | join(", "))"' \
      "$duplicates_file"
  fi

  if ((avoid_present)); then
    echo ""
    echo "Commands that should stay absent:"
    jq -r '
      select(.status == "avoid-present")
      | "  \(.command): \(.repair)"
    ' "$capabilities_file"
  fi
fi

if ((check_mode && foundation_repairable)); then
  exit 1
fi
