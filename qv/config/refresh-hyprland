#!/bin/bash
set -euo pipefail

# qvos:contract=config/hypr/bindings.conf
# qvos:contract=config/hypr/hyprland.conf
# qvos:contract=qv/config/files/hypr/input.conf
# qvos:contract=qv/config/files/hypr/qv.conf
# qvos:contract=qv/config/files/hypr/qv/looknfeel.conf
# qvos:contract=qv/config/files/hypr/qv/windows.conf

"$OMARCHY_PATH/qv/config/monitor-autodetect" --restore-preflight

omarchy-refresh-config hypr/autostart.conf
omarchy-refresh-config hypr/bindings.conf
omarchy-refresh-config hypr/input.conf
omarchy-refresh-config hypr/looknfeel.conf
omarchy-refresh-config hypr/hyprland.conf
omarchy-refresh-config hypr/monitors.conf

config_owner="$OMARCHY_PATH/qv/config/refresh"
config_paths=(
  hypr/input.conf
  hypr/qv.conf
  hypr/qv/looknfeel.conf
  hypr/qv/windows.conf
)

for config_path in "${config_paths[@]}"; do
  [[ -f $OMARCHY_PATH/qv/config/files/$config_path ]] || {
    printf 'Missing qvOS Hyprland config source: %s\n' "$config_path" >&2
    exit 1
  }
done

for config_path in "${config_paths[@]}"; do
  "$config_owner" "$config_path"
done

"$OMARCHY_PATH/qv/config/monitor-autodetect"

bash "$OMARCHY_PATH/install/config/detect-keyboard-layout.sh"
