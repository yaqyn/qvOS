#!/bin/bash
set -euo pipefail

# Render the qvOS-colored TTE screensaver.

screen_text="$HOME/.config/omarchy/branding/screensaver.txt"
effect_count=15
effect_pid=""
terminal_state="$(stty -g 2>/dev/null || true)"
cursor_position="$(hyprctl cursorpos -j 2>/dev/null || true)"

cleanup() {
  local status=$?

  trap - EXIT
  if [[ -n $effect_pid ]] && kill -0 "$effect_pid" 2>/dev/null; then
    kill "$effect_pid" 2>/dev/null || true
    wait "$effect_pid" 2>/dev/null || true
  fi
  [[ -n $terminal_state ]] && stty "$terminal_state" 2>/dev/null || true

  return "$status"
}

close_screensaver_windows() {
  local address

  while IFS= read -r address; do
    [[ -n $address ]] || continue
    hyprctl dispatch closewindow "address:$address" >/dev/null 2>&1 || true
  done < <(hyprctl clients -j 2>/dev/null | jq -r '.[] | select((.class // "") == "org.omarchy.screensaver") | .address' 2>/dev/null || true)
}

input_detected() {
  local current_position

  if read -r -s -n 1 -t 0.25; then
    return 0
  fi

  current_position="$(hyprctl cursorpos -j 2>/dev/null || true)"
  if [[ -n $cursor_position && -n $current_position && $current_position != "$cursor_position" ]]; then
    return 0
  fi
  cursor_position="$current_position"

  return 1
}

trap cleanup EXIT
trap 'exit 0' SIGINT SIGTERM SIGHUP SIGQUIT

if [[ ! -f "$screen_text" ]]; then
  notify-send -u normal "qvOS screensaver branding is not installed"
  exit 1
fi

fixed_effect="${QVOS_SCREENSAVER_EFFECT_INDEX:-}"
if [[ -n $fixed_effect ]] && { [[ ! $fixed_effect =~ ^[0-9]+$ ]] || ((fixed_effect >= effect_count)); }; then
  printf 'qvos-screensaver: effect index must be 0-%d\n' "$((effect_count - 1))" >&2
  exit 2
fi

frame_rate="${QVOS_SCREENSAVER_FRAME_RATE:-144}"
if [[ ! $frame_rate =~ ^[0-9]+$ ]] || ((frame_rate < 1 || frame_rate > 240)); then
  printf 'qvos-screensaver: frame rate must be 1-240\n' >&2
  exit 2
fi

run_qvos_effect() {
  local effect_index="$1"
  local common=(
    tte
    -i "$screen_text"
    --frame-rate "$frame_rate"
    --canvas-width 0
    --canvas-height 0
    --reuse-canvas
    --anchor-canvas c
    --anchor-text c
    --terminal-background-color 000000
    --existing-color-handling ignore
    --no-eol
    --no-restore-cursor
  )

  local mono_dim=(060606 0a0a0a 101010 161616 1c1c1c 242424 2c2c2c 343434 404040 4c4c4c)
  local mono_light=(4c4c4c 5a5a5a 686868 787878 8a8a8a a0a0a0 b8b8b8 d0d0d0)
  local red=(520000 650000 7a0000 8a0000)
  local mono_red=(060606 0a0a0a 101010 161616 1c1c1c 242424 2c2c2c 343434 404040 4c4c4c 5a5a5a 686868 787878 8a8a8a a0a0a0 b8b8b8 650000)
  local rain_palette=(0a0a0a 101010 161616 1c1c1c 242424 2c2c2c 343434 404040 4c4c4c 5a5a5a 686868 787878)
  local final=(--final-gradient-stops d00000 b80000 8a0000 650000 --final-gradient-steps 12 --final-gradient-direction vertical)
  local final_slow=(--final-gradient-stops d00000 b80000 8a0000 650000 --final-gradient-steps 12 --final-gradient-frames 2 --final-gradient-direction vertical)

  case "$effect_index" in
  0)
    exec "${common[@]}" rings \
      --ring-colors "${mono_dim[@]}" "${red[@]}" \
      --ring-gap 0.1 \
      --spin-duration 140 \
      --spin-speed 0.5-1.4 \
      --disperse-duration 140 \
      --spin-disperse-cycles 3 \
      "${final[@]}"
    ;;
  1)
    exec "${common[@]}" rain \
      --rain-symbols o . , '*' '|' \
      --rain-colors "${rain_palette[@]}" \
      --movement-speed 0.28-0.65 \
      --movement-easing linear \
      "${final[@]}"
    ;;
  2)
    exec "${common[@]}" matrix \
      --highlight-color a0a0a0 \
      --rain-color-gradient "${mono_red[@]}" \
      --rain-symbols 0 1 q v O S + - . '|' _ \
      --rain-fall-delay-range 2-9 \
      --rain-column-delay-range 2-7 \
      --rain-time 4 \
      --symbol-swap-chance 0.004 \
      --color-swap-chance 0.001 \
      --resolve-delay 2 \
      --final-gradient-stops e02020 b00000 8a0000 650000 \
      --final-gradient-steps 18 \
      --final-gradient-frames 3 \
      --final-gradient-direction vertical
    ;;
  3)
    exec "${common[@]}" decrypt \
      --typing-speed 2 \
      --ciphertext-colors "${mono_red[@]}" \
      "${final[@]}"
    ;;
  4)
    exec "${common[@]}" sweep \
      --sweep-symbols █ ▓ ▒ ░ \
      --first-sweep-direction column_right_to_left \
      --second-sweep-direction column_left_to_right \
      "${final[@]}"
    ;;
  5)
    exec "${common[@]}" spray \
      --spray-position center \
      --spray-volume 0.01 \
      --movement-speed-range 0.7-1.4 \
      --movement-easing out_expo \
      "${final[@]}"
    ;;
  6)
    exec "${common[@]}" binarypath \
      --binary-colors "${mono_red[@]}" \
      "${final[@]}"
    ;;
  7)
    exec "${common[@]}" blackhole \
      --blackhole-color 000000 \
      --star-colors "${mono_light[@]}" "${red[@]}" \
      "${final[@]}"
    ;;
  8)
    exec "${common[@]}" burn \
      --starting-color 303030 \
      --burn-colors "${mono_dim[@]}" "${red[@]}" \
      "${final[@]}"
    ;;
  9)
    exec "${common[@]}" errorcorrect \
      --error-color 7a0000 \
      --correct-color 8c8c8c \
      "${final[@]}"
    ;;
  10)
    exec "${common[@]}" laseretch \
      --cool-gradient-stops "${mono_dim[@]}" \
      --laser-gradient-stops 686868 a0a0a0 650000 \
      --spark-gradient-stops "${mono_light[@]}" "${red[@]}" \
      "${final_slow[@]}"
    ;;
  11)
    exec "${common[@]}" overflow \
      --overflow-gradient-stops "${mono_red[@]}" \
      "${final[@]}"
    ;;
  12)
    exec "${common[@]}" smoke \
      --starting-color 444444 \
      --smoke-symbols ░ ▒ ▓ ▒ ░ \
      --smoke-gradient-stops "${mono_dim[@]}" "${red[@]}" \
      "${final[@]}"
    ;;
  13)
    exec "${common[@]}" thunderstorm \
      --storm-time 6 \
      --lightning-color 707070 \
      --glowing-text-color 8a0000 \
      --text-glow-time 7 \
      --raindrop-symbols . , '|' \
      --spark-symbols . '*' + \
      --spark-glow-color b80000 \
      --spark-glow-time 14 \
      "${final_slow[@]}"
    ;;
  14)
    exec "${common[@]}" waves \
      --wave-symbols ▁ ▂ ▃ ▄ ▅ ▆ ▇ █ ▇ ▆ ▅ ▄ ▃ ▂ ▁ \
      --wave-gradient-stops "${mono_red[@]}" \
      --wave-gradient-steps 8 \
      "${final[@]}"
    ;;
  esac
}

printf '\033]11;rgb:00/00/00\007'

stty -echo 2>/dev/null || true

last_effect=-1
while true; do
  if [[ -n $fixed_effect ]]; then
    effect_index="$fixed_effect"
  else
    effect_index=$((RANDOM % effect_count))
    while ((effect_count > 1 && effect_index == last_effect)); do
      effect_index=$((RANDOM % effect_count))
    done
  fi
  last_effect="$effect_index"

  run_qvos_effect "$effect_index" &
  effect_pid=$!

  while kill -0 "$effect_pid" 2>/dev/null; do
    if input_detected; then
      close_screensaver_windows
      exit 0
    fi
  done

  if ! wait "$effect_pid"; then
    effect_pid=""
    close_screensaver_windows
    notify-send -u critical "qvOS Screensaver" "Animation effect failed" >/dev/null 2>&1 || true
    exit 1
  fi
  effect_pid=""
done
