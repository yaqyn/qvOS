#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qv/browser/native-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest") == $'bin/omarchy-install-browser\nbin/omarchy-remove-browser' ]] ||
  fail "native browser inventory"

for operation in install remove; do
  adapter="$root/bin/omarchy-$operation-browser"
  owner="$root/qv/browser/$operation"
  [[ -x $adapter && -x $owner ]] ||
    fail "browser $operation adapter or owner mode"
  (( $(wc -l <"$adapter") <= 10 )) ||
    fail "browser $operation compatibility adapter contains implementation"
  # shellcheck disable=SC2016
  grep -Fqx "exec \"\$OMARCHY_PATH/qv/browser/$operation\" \"\$@\"" \
    "$adapter" ||
    fail "browser $operation compatibility adapter"
done

grep -Fq 'qv/browser/setup-policy' "$root/qv/browser/install" ||
  fail "browser installer bypasses policy ownership"
if rg -n 'rm[[:space:]]+-rf[[:space:]]+.*etc/(brave|opt)' \
  "$root/qv/browser/remove"; then
  fail "browser removal recursively deletes shared policy"
fi
grep -Fq 'remove_firefox_wayland_if_unused' "$root/qv/browser/remove" ||
  fail "Firefox-family Wayland cleanup ownership"

printf 'ok - optional browsers have one exact install and removal lifecycle\n'
