#!/bin/bash
set -euo pipefail

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
catalog="$OMARCHY_PATH/qv/core/catalog.tsv"

usage() {
  echo "Usage: omarchy install qvcore <proton|qvdev>" >&2
}

component_known() {
  local wanted=$1

  awk -F '\t' -v wanted="$wanted" '
    $1 !~ /^#/ && NF == 3 && $1 == wanted { found = 1 }
    END { exit !found }
  ' "$catalog"
}

if (($# != 1)); then
  usage
  exit 2
fi

[[ -f $catalog ]] || {
  echo "Missing qvCORE catalog: $catalog" >&2
  exit 1
}
component_known "$1" || {
  usage
  exit 2
}

component_script="$OMARCHY_PATH/qv/core/$1.sh"
[[ -x $component_script ]] || {
  echo "Missing qvCORE stack owner: $component_script" >&2
  exit 1
}

exec "$component_script" install
