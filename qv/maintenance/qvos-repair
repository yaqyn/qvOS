#!/bin/bash
set -euo pipefail

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
export OMARCHY_PATH
assume_yes=0
repair_mode="interactive"
health_check=0
config_paths=()
missing_packages=()
missing_configs=()
drifted_configs=()
runtime_ready=0
runtime_issues=""

usage() {
  echo "Usage: qvos-repair [--status [--check]|--reset] [--yes]" >&2
}

print_items() {
  local item

  for item in "$@"; do
    printf '    - %s\n' "$item"
  done
}

for argument in "$@"; do
  case $argument in
  --status)
    [[ $repair_mode == "interactive" ]] || {
      usage
      exit 2
    }
    repair_mode="status"
    ;;
  --check)
    ((health_check == 0)) || {
      usage
      exit 2
    }
    health_check=1
    ;;
  --reset)
    [[ $repair_mode == "interactive" ]] || {
      usage
      exit 2
    }
    repair_mode="reset"
    ;;
  --yes) assume_yes=1 ;;
  *)
    usage
    exit 2
    ;;
  esac
done

if ((health_check)) && [[ $repair_mode != "status" ]]; then
  usage
  exit 2
fi
if [[ $repair_mode == "status" ]] && ((assume_yes)); then
  usage
  exit 2
fi

operation_name="qvOS repair"
if [[ $repair_mode == "status" ]]; then
  operation_name="qvOS health"
fi
required_commands=(git omarchy-pkg-present)
if [[ $repair_mode != "status" ]]; then
  required_commands+=(omarchy-pkg-add)
fi
for command in "${required_commands[@]}"; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "$operation_name requires the qvOS base command: $command" >&2
    exit 1
  fi
done

branch=$(git -C "$OMARCHY_PATH" branch --show-current 2>/dev/null || true)
if [[ $branch != "OS" ]]; then
  echo "$operation_name requires the live qvOS checkout on branch OS; found '${branch:-none}'." >&2
  exit 1
fi

required_sources=(
  qv/config/files
  qv/install/desktop
  qv/install/desktop-status
  qv/install/packaging/base.packages
  qv/config/refresh
)

for source_path in "${required_sources[@]}"; do
  if [[ ! -e $OMARCHY_PATH/$source_path ]]; then
    echo "qvOS repair source is missing: $OMARCHY_PATH/$source_path" >&2
    exit 1
  fi
done

mapfile -t config_paths < <(
  cd "$OMARCHY_PATH/qv/config/files"
  find . -type f -printf '%P\n' | sort
)

mapfile -t base_packages < <(
  sed '/^[[:space:]]*#/d;/^[[:space:]]*$/d' \
    "$OMARCHY_PATH/qv/install/packaging/base.packages"
)
for package in "${base_packages[@]}"; do
  if ! omarchy-pkg-present "$package"; then
    missing_packages+=("$package")
  fi
done

for config_path in "${config_paths[@]}"; do
  source_config="$OMARCHY_PATH/qv/config/files/$config_path"
  user_config="$HOME/.config/$config_path"

  if [[ ! -f $user_config ]]; then
    missing_configs+=("$config_path")
  elif ! cmp -s "$source_config" "$user_config"; then
    drifted_configs+=("$config_path")
  fi
done

if runtime_issues=$("$OMARCHY_PATH/qv/install/desktop-status" 2>&1); then
  runtime_ready=1
fi

if [[ $repair_mode == "status" ]]; then
  echo "qvOS health: Inspect"
else
  echo "qvOS repair: Inspect"
fi
echo ""
echo "qvOS Health"
echo ""
printf '  Removed default packages:    %d\n' "${#missing_packages[@]}"
printf '  Missing qvOS config files:   %d\n' "${#missing_configs[@]}"
printf '  Customized qvOS config:      %d\n' "${#drifted_configs[@]}"
if ((runtime_ready)); then
  echo "  qvOS-owned runtime:          Ready"
else
  echo "  qvOS-owned runtime:          Needs repair"
fi

if ((${#missing_packages[@]} > 0)); then
  echo ""
  echo "Safe repair preserves removed default packages as user choice."
  echo "Reset reinstalls them from the original qvOS package manifest."
  print_items "${missing_packages[@]}"
fi
if ((${#missing_configs[@]} > 0)); then
  echo ""
  echo "Safe repair and reset restore these missing qvOS config files:"
  print_items "${missing_configs[@]}"
fi
if ((${#drifted_configs[@]} > 0)); then
  echo ""
  echo "Safe repair preserves customized qvOS config."
  echo "Reset restores tracked qvOS config and creates timestamped backups."
  print_items "${drifted_configs[@]}"
fi
if ((runtime_ready == 0)); then
  echo ""
  echo "qvOS runtime repair plan:"
  while IFS= read -r issue; do
    [[ -n $issue ]] && printf '    - %s\n' "$issue"
  done <<<"$runtime_issues"
fi

if [[ $repair_mode == "status" ]]; then
  echo ""
  if ((${#missing_configs[@]} == 0 && runtime_ready)); then
    echo "qvOS is healthy; no changes were made."
    exit
  fi
  echo "qvOS needs repair; no changes were made."
  ((health_check == 0)) || exit 1
  exit
fi

if [[ $repair_mode == "interactive" ]] && ((assume_yes == 0)); then
  echo ""
  selection=$(
    gum choose \
      --header "Choose a qvOS repair action" \
      "Safe repair — preserve removed packages and customized config" \
      "Restore qvOS defaults — reinstall packages and reset qvOS config" \
      "Cancel"
  ) || exit $?
  case $selection in
  "Safe repair"*) repair_mode="repair" ;;
  "Restore qvOS defaults"*) repair_mode="reset" ;;
  *)
    echo "qvOS repair canceled."
    exit 130
    ;;
  esac
elif [[ $repair_mode == "interactive" ]]; then
  repair_mode="repair"
fi

if [[ $repair_mode == "reset" ]] && ((assume_yes == 0)); then
  echo ""
  gum confirm \
    "Restore original qvOS packages and qvOS-owned config from the repository?" ||
    exit 130
fi

echo "qvOS repair: Source"
echo "  branch OS verified"

echo "qvOS repair: Packages"
if [[ $repair_mode == "reset" ]] && ((${#missing_packages[@]} > 0)); then
  omarchy-pkg-add "${missing_packages[@]}"
elif ((${#missing_packages[@]} > 0)); then
  printf '  preserved %d intentionally removable default package(s)\n' \
    "${#missing_packages[@]}"
else
  echo "  base package set already present"
fi
if [[ $repair_mode == "reset" ]]; then
  for package in "${missing_packages[@]}"; do
    if ! omarchy-pkg-present "$package"; then
      echo "qvOS default package restore failed: $package" >&2
      exit 1
    fi
  done
fi

echo "qvOS repair: Runtime"
QVOS_DESKTOP_MODE="$repair_mode" \
  bash -c 'source "$1"' _ "$OMARCHY_PATH/qv/install/desktop"

echo "qvOS repair: Config"
restored_hyprland=0
for config_path in "${missing_configs[@]}"; do
  "$OMARCHY_PATH/qv/config/refresh" "$config_path"
  [[ $config_path == hypr/* ]] && restored_hyprland=1
done
if [[ $repair_mode == "reset" ]]; then
  for config_path in "${drifted_configs[@]}"; do
    "$OMARCHY_PATH/qv/config/refresh" "$config_path"
    [[ $config_path == hypr/* ]] && restored_hyprland=1
  done
fi

for config_path in "${missing_configs[@]}"; do
  if ! cmp -s \
    "$OMARCHY_PATH/qv/config/files/$config_path" \
    "$HOME/.config/$config_path"; then
    echo "qvOS config repair failed: $config_path" >&2
    exit 1
  fi
done
if [[ $repair_mode == "reset" ]]; then
  for config_path in "${drifted_configs[@]}"; do
    if ! cmp -s \
      "$OMARCHY_PATH/qv/config/files/$config_path" \
      "$HOME/.config/$config_path"; then
      echo "qvOS config restore failed: $config_path" >&2
      exit 1
    fi
  done
fi

if ((restored_hyprland)); then
  hyprctl reload
  if [[ -n $(hyprctl configerrors) ]]; then
    echo "Hyprland reported config errors after qvOS repair." >&2
    hyprctl configerrors >&2
    exit 1
  fi
fi

if ! "$OMARCHY_PATH/qv/install/desktop-status"; then
  echo "qvOS runtime verification failed after repair." >&2
  exit 1
fi

echo "qvOS repair: Complete"
if [[ $repair_mode == "repair" ]] && ((${#drifted_configs[@]} > 0)); then
  printf '  preserved %d customized qvOS config file(s)\n' \
    "${#drifted_configs[@]}"
fi
if [[ $repair_mode == "repair" ]] && ((${#missing_packages[@]} > 0)); then
  printf '  preserved %d removed default package(s)\n' \
    "${#missing_packages[@]}"
fi
if [[ $repair_mode == "reset" ]]; then
  echo "qvOS defaults restore is complete."
else
  echo "qvOS safe repair is complete."
fi
