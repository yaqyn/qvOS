#!/bin/bash
set -euo pipefail

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
catalog="$OMARCHY_PATH/qv/maintenance/inherited-extras.tsv"
mode="${1:---status}"
detected_packages=()
declare -A package_category=()
declare -A package_description=()

usage() {
  echo "Usage: qvos-cleanup-inherited [--status|--apply]" >&2
}

if (($# > 1)); then
  usage
  exit 2
fi
case $mode in
--status | --apply) ;;
*)
  usage
  exit 2
  ;;
esac

if [[ ! -f $catalog ]]; then
  echo "Missing qvOS inherited-extra catalog: $catalog" >&2
  exit 1
fi

while IFS=$'\t' read -r category package description; do
  [[ -n $category && $category != "#"* ]] || continue
  if [[ -z $package || -z $description ]]; then
    echo "Invalid inherited-extra catalog entry for: $category" >&2
    exit 1
  fi

  package_category[$package]=$category
  package_description[$package]=$description
  if omarchy-pkg-present "$package"; then
    detected_packages+=("$package")
  fi
done <"$catalog"

echo "Inherited Omarchy extra-package review"
echo ""
echo "This command never changes bindings, config files, web apps, or TUI launchers."
if ((${#detected_packages[@]} == 0)); then
  echo "No reviewed inherited package candidates were detected."
  exit 0
fi

printf 'Detected %d reviewed candidate(s):\n' "${#detected_packages[@]}"
for package in "${detected_packages[@]}"; do
  printf '  %-10s %-22s %s\n' \
    "${package_category[$package]}" \
    "$package" \
    "${package_description[$package]}"
done

if [[ $mode == "--status" ]]; then
  echo ""
  echo 'Run "omarchy qvos cleanup inherited --apply" to choose packages for removal.'
  exit 0
fi

options=()
for package in "${detected_packages[@]}"; do
  options+=(
    "${package_category[$package]}  $package — ${package_description[$package]}:$package"
  )
done

echo ""
if selections=$(gum choose \
  --no-limit \
  --label-delimiter ":" \
  --header "Choose inherited packages to remove; Esc keeps everything" \
  "${options[@]}"); then
  :
else
  echo "Inherited-extra cleanup canceled; nothing was removed."
  exit 130
fi

selected_packages=()
declare -A selected_package=()
while IFS= read -r package; do
  [[ -n $package ]] || continue
  if [[ -z ${package_category[$package]+known} ]]; then
    echo "Unknown inherited-extra selection: $package" >&2
    exit 1
  fi
  if [[ -z ${selected_package[$package]+selected} ]]; then
    selected_packages+=("$package")
    selected_package[$package]=1
  fi
done <<<"$selections"

if ((${#selected_packages[@]} == 0)); then
  echo "No inherited packages selected; nothing was removed."
  exit 0
fi

echo ""
printf 'Selected for removal:\n'
printf '  %s\n' "${selected_packages[@]}"
gum confirm \
  "Remove these ${#selected_packages[@]} explicitly selected package(s)?" ||
  {
    echo "Inherited-extra cleanup canceled; nothing was removed."
    exit 130
  }

omarchy-pkg-drop "${selected_packages[@]}"
for package in "${selected_packages[@]}"; do
  if omarchy-pkg-present "$package"; then
    echo "Inherited-extra removal failed: $package remains installed." >&2
    exit 1
  fi
done

echo "Removed ${#selected_packages[@]} selected inherited package(s)."
