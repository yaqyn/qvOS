#!/bin/bash

set -euo pipefail

command_name="${1:-This upstream maintenance command}"

cat >&2 <<EOF
Blocked on qvOS: $command_name

This upstream Omarchy workflow is incompatible with qvOS ownership and could
replace qvOS source, packages, configs, or bindings.

Use "omarchy qvos repair" for qvOS, "omarchy qvcore repair" for managed
qvCORE setups, or "omarchy qvos software" for all personal software,
including qvCORE-curated applications.
EOF

exit 1
