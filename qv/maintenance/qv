#!/bin/bash
set -euo pipefail

case ${1:-} in
codex)
  shift
  case ${1:-} in
  doctor)
    shift
    runtime_doctor="$HOME/.local/share/qvos/codex/doctor"
    if [[ ! -x $runtime_doctor ]]; then
      echo "qvOS Codex doctor runtime is unavailable: $runtime_doctor" >&2
      exit 1
    fi
    exec "$runtime_doctor" "$@"
    ;;
  *)
    echo "Usage: qv codex doctor [--json] [--check]" >&2
    exit 2
    ;;
  esac
  ;;
repair)
  shift
  runtime_repair="$HOME/.local/share/qvos/maintenance/qvos-repair"
  if [[ ! -x $runtime_repair ]]; then
    echo "qvOS recovery runtime is unavailable: $runtime_repair" >&2
    exit 1
  fi
  exec "$runtime_repair" "$@"
  ;;
system)
  shift
  runtime_system="$HOME/.local/share/qvos/maintenance/qvos-system"
  if [[ ! -x $runtime_system ]]; then
    echo "qvOS system runtime is unavailable: $runtime_system" >&2
    exit 1
  fi
  exec "$runtime_system" "$@"
  ;;
esac

exec omarchy "$@"
