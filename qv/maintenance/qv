#!/bin/bash
set -euo pipefail

case ${1:-} in
repair)
  shift
  runtime_repair="$HOME/.local/share/qvos/maintenance/qvos-repair"
  if [[ ! -x $runtime_repair ]]; then
    echo "qvOS recovery runtime is unavailable: $runtime_repair" >&2
    exit 1
  fi
  exec "$runtime_repair" "$@"
  ;;
system)
  shift
  runtime_system="$HOME/.local/share/qvos/maintenance/qvos-system"
  if [[ ! -x $runtime_system ]]; then
    echo "qvOS system runtime is unavailable: $runtime_system" >&2
    exit 1
  fi
  exec "$runtime_system" "$@"
  ;;
esac

exec omarchy "$@"
