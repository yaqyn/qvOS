#!/bin/bash
set -euo pipefail

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
runtime_repair="$HOME/.local/share/qvos/maintenance/qvos-repair"
source_repair="$OMARCHY_PATH/qv/maintenance/qvos-repair"
software_owner="$OMARCHY_PATH/qv/maintenance/personal-software"

usage() {
  echo "Usage: qvos-system [--status|--repair|--software]" >&2
}

repair_owner() {
  if [[ -x $runtime_repair ]]; then
    printf '%s' "$runtime_repair"
  elif [[ -x $source_repair ]]; then
    printf '%s' "$source_repair"
  else
    echo "qvOS recovery engine is unavailable." >&2
    return 1
  fi
}

plain_choose() {
  local options=("$@")
  local index
  local answer

  echo "qvOS System" >/dev/tty
  for index in "${!options[@]}"; do
    printf '  %d) %s\n' "$((index + 1))" "${options[$index]}" >/dev/tty
  done
  printf '> ' >/dev/tty
  IFS= read -r answer </dev/tty
  [[ $answer =~ ^[0-9]+$ ]] || return 1
  ((answer >= 1 && answer <= ${#options[@]})) || return 1
  printf '%s' "${options[$((answer - 1))]}"
}

choose_action() {
  local options=(
    "Check system health"
    "Repair & recovery"
    "Cancel"
  )

  if command -v gum >/dev/null 2>&1; then
    gum choose --header "qvOS System" "${options[@]}"
  else
    plain_choose "${options[@]}"
  fi
}

run_status() {
  local owner

  owner=$(repair_owner)
  exec "$owner" --status
}

run_repair() {
  local owner

  owner=$(repair_owner)
  exec "$owner"
}

run_software() {
  if [[ ! -x $software_owner ]]; then
    echo "qvOS Personal Software is unavailable: $software_owner" >&2
    return 1
  fi
  exec "$software_owner" --remove-standalone
}

if (($# > 1)); then
  usage
  exit 2
fi

case ${1:-} in
"") ;;
--status) run_status ;;
--repair) run_repair ;;
--software) run_software ;;
*)
  usage
  exit 2
  ;;
esac

selection=$(choose_action) || exit 130
case $selection in
"Check system health") run_status ;;
"Repair & recovery") run_repair ;;
*)
  echo "qvOS System canceled."
  exit 130
  ;;
esac
