#!/bin/bash
set -euo pipefail

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/qvos/software"
baseline="$state_dir/baseline.tsv"
baseline_owner="$OMARCHY_PATH/qv/maintenance/personal-software-baseline"
qvcore_catalog="$OMARCHY_PATH/qv/core/catalog.tsv"
qvcore_ownership="$OMARCHY_PATH/qv/core/software-ownership.tsv"
qvcore_removal_groups="$OMARCHY_PATH/qv/core/software-removal-groups"
protected_user_bin_policy="$OMARCHY_PATH/qv/maintenance/protected-user-bin"
qvcore_owner_dir=${QVOS_PERSONAL_QVCORE_OWNER_DIR:-$OMARCHY_PATH/qv/core}
user_bin_dir=${QVOS_PERSONAL_USER_BIN_DIR:-$HOME/.local/bin}
applications_dir=${QVOS_PERSONAL_APPLICATIONS_DIR:-$HOME/Applications}
system_bin_dir=${QVOS_PERSONAL_SYSTEM_BIN_DIR:-/usr/local/bin}
mode="status"
requested_scope="all"
assume_yes=0

declare -A baseline_item=()
declare -A foreign_package=()
declare -A qvos_package=()
declare -A qvos_npx_wrapper=()
declare -A qvos_protected_user_bin=()
declare -A qvcore_owner=()
declare -A qvcore_component_name=()
declare -a grouped_components=()
declare -A grouped_component_count=()
declare -A grouped_component_present=()
declare -A grouped_component_preservation=()
declare -A grouped_component_removable=()
declare -a entry_ids=()
declare -A entry_source=()
declare -A entry_name=()
declare -A entry_detail=()
declare -A entry_kind=()
declare -A entry_value=()
declare -A entry_removable=()
declare -A entry_cleanup_owner=()
declare -A entry_scope=()

usage() {
  echo "Usage: personal-software [--status|--remove|--remove-standalone|--remove-qvcore|--initialize] [--yes]" >&2
}

valid_field() {
  local value=$1

  [[ -n $value && $value != *$'\t'* && $value != *$'\n'* ]]
}

baseline_has() {
  local kind=$1
  local name=$2

  [[ -n ${baseline_item["$kind"$'\t'"$name"]+present} ]]
}

add_entry() {
  local source=$1
  local name=$2
  local detail=$3
  local kind=$4
  local value=$5
  local removable=$6
  local cleanup_owner=${7:-}
  local scope=${8:-standalone}
  local id="entry-$((${#entry_ids[@]} + 1))"

  entry_ids+=("$id")
  entry_source[$id]=$source
  entry_name[$id]=$name
  entry_detail[$id]=$detail
  entry_kind[$id]=$kind
  entry_value[$id]=$value
  entry_removable[$id]=$removable
  entry_cleanup_owner[$id]=$cleanup_owner
  entry_scope[$id]=$scope
}

list_bun_globals() {
  local manifest="$HOME/.bun/install/global/package.json"

  [[ -f $manifest ]] || return 0
  jq -r '
    [
      (.dependencies // {}),
      (.devDependencies // {}),
      (.optionalDependencies // {})
    ]
    | add
    | keys[]?
  ' "$manifest"
}

list_npm_globals() {
  local inventory

  command -v npm >/dev/null 2>&1 || return 0
  inventory=$(npm ls --global --depth=0 --json 2>/dev/null || true)
  [[ -n $inventory ]] || return 0

  if ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$inventory"; then
    echo "Could not read the npm global-package inventory." >&2
    return 1
  fi

  jq -r '.dependencies // {} | keys[]?' <<<"$inventory"
}

load_baseline() {
  local kind name extra

  while IFS=$'\t' read -r kind name extra; do
    [[ -n $kind && $kind != "#"* ]] || continue
    if [[ -z $name || -n $extra ]] || ! valid_field "$kind" || ! valid_field "$name"; then
      echo "Invalid qvOS personal-software baseline entry." >&2
      exit 1
    fi
    case $kind in
    pacman | bun | npm | user-bin | application | system-bin) ;;
    *)
      echo "Unknown qvOS personal-software baseline type: $kind" >&2
      exit 1
      ;;
    esac
    baseline_item["$kind"$'\t'"$name"]=1
  done <"$baseline"
}

load_qvos_owners() {
  local manifest installer package command extra

  for manifest in \
    "$OMARCHY_PATH/qv/install/packaging/base.packages" \
    "$OMARCHY_PATH/qv/install/packaging/other.packages"; do
    while IFS= read -r package; do
      [[ -n $package ]] && qvos_package[$package]=1
    done < <(sed '/^[[:space:]]*#/d;/^[[:space:]]*$/d' "$manifest")
  done

  while read -r installer package command extra; do
    [[ $installer == "omarchy-npx-install" && -n $package && -z $extra ]] ||
      continue
    command=${command:-$package}
    [[ -n $command ]] && qvos_npx_wrapper[$command]=1
  done < <(
    sed '/^[[:space:]]*#/d;/^[[:space:]]*$/d' \
      "$OMARCHY_PATH/qv/install/packaging/npx"
  )
}

load_protected_user_bin() {
  local name extra

  while read -r name extra; do
    [[ -n $name && $name != "#"* ]] || continue
    if [[ -n $extra ]] || ! valid_field "$name" ||
      [[ $name == */* ]]; then
      echo "Invalid qvOS protected user command: $name" >&2
      exit 1
    fi
    qvos_protected_user_bin[$name]=1
  done <"$protected_user_bin_policy"
}

grouped_qvcore_component() {
  [[ -n ${grouped_component_present["policy:$1"]+grouped} ]]
}

record_grouped_component_item() {
  local component=$1
  local removable=$2

  grouped_component_count[$component]=$((
    ${grouped_component_count[$component]:-0} + 1
  ))
  grouped_component_present[$component]=1
  if ((removable == 0)); then
    grouped_component_removable[$component]=0
  elif [[ -z ${grouped_component_removable[$component]+known} ]]; then
    grouped_component_removable[$component]=1
  fi
}

add_grouped_qvcore_entries() {
  local component

  for component in "${grouped_components[@]}"; do
    [[ -n ${grouped_component_present[$component]+present} ]] || continue
    add_entry \
      "qvCORE · Setup" \
      "${qvcore_component_name[$component]}" \
      "${grouped_component_count[$component]} local component(s) installed; coordinated removal; ${grouped_component_preservation[$component]}" \
      qvcore-setup \
      "$component" \
      "${grouped_component_removable[$component]}" \
      "" \
      qvcore
  done
}

load_qvcore_owners() {
  local type component label icon kind name extra

  while IFS=$'\t' read -r type component label icon extra; do
    [[ -n $type && $type != "#"* ]] || continue
    if [[ $type != "app" && $type != "setup" ]] ||
      [[ -z $component || -z $label || -z $icon || -n $extra ]] ||
      [[ -n ${qvcore_component_name[$component]+known} ]]; then
      echo "Invalid qvCORE catalog entry." >&2
      exit 1
    fi
    qvcore_component_name[$component]=$label
  done <"$qvcore_catalog"

  while IFS=$'\t' read -r component preservation extra; do
    [[ -n $component && $component != "#"* ]] || continue
    if [[ -z $preservation || -n $extra ]] ||
      [[ -z ${qvcore_component_name[$component]+known} ]] ||
      [[ -n ${grouped_component_present["policy:$component"]+known} ]] ||
      ! valid_field "$preservation"; then
      echo "Invalid qvCORE grouped software-removal owner: $component" >&2
      exit 1
    fi
    if [[ ! -x $qvcore_owner_dir/$component.sh ]]; then
      echo "Missing qvCORE grouped software-removal owner: $component" >&2
      exit 1
    fi
    grouped_components+=("$component")
    grouped_component_present["policy:$component"]=1
    grouped_component_preservation[$component]=$preservation
  done <"$qvcore_removal_groups"

  while IFS=$'\t' read -r component kind name extra; do
    [[ -n $component && $component != "#"* ]] || continue
    if [[ -z ${qvcore_component_name[$component]+known} ]]; then
      echo "Unknown qvCORE software owner: $component" >&2
      exit 1
    fi
    if [[ -z $name || -n $extra ]] ||
      ! valid_field "$kind" || ! valid_field "$name"; then
      echo "Invalid qvCORE software ownership entry." >&2
      exit 1
    fi
    case $kind in
    pacman | user-bin) ;;
    *)
      echo "Unknown qvCORE software ownership type: $kind" >&2
      exit 1
      ;;
    esac
    if [[ -n ${qvcore_owner["$kind"$'\t'"$name"]+known} ]]; then
      echo "Duplicate qvCORE software ownership entry: $kind $name" >&2
      exit 1
    fi
    qvcore_owner["$kind"$'\t'"$name"]=$component
  done <"$qvcore_ownership"
}

scan_pacman() {
  local package source required_by description detail removable component scope
  local cleanup_owner

  while IFS= read -r package; do
    [[ -n $package ]] && foreign_package[$package]=1
  done < <(pacman -Qqm | sort -u)

  while IFS= read -r package; do
    [[ -n $package ]] || continue
    [[ -z ${qvos_package[$package]+owned} ]] || continue
    component=${qvcore_owner["pacman"$'\t'"$package"]:-}
    if [[ -z $component ]] && baseline_has pacman "$package"; then
      continue
    fi

    source="Pacman"
    [[ -z ${foreign_package[$package]+foreign} ]] || source="AUR/foreign"
    required_by=$(expac -Q '%N' "$package" 2>/dev/null || true)
    description=$(expac -Q '%d' "$package" 2>/dev/null || true)
    detail=${description:-explicit package}
    removable=1
    cleanup_owner=""
    scope="package"
    if [[ -n $component ]]; then
      scope="qvcore"
      if [[ $source == "AUR/foreign" ]]; then
        source="qvCORE · AUR"
      else
        source="qvCORE · Pacman"
      fi
      detail="${qvcore_component_name[$component]}; $detail"
      case $component in
      warp | share | codex | proton)
        detail="$detail; integration cleanup included"
        cleanup_owner=$component
        ;;
      esac
    fi
    if [[ -n $required_by ]]; then
      detail="$detail; required by $required_by"
      removable=0
    fi
    if [[ -n $component ]] && grouped_qvcore_component "$component"; then
      record_grouped_component_item "$component" "$removable"
      continue
    fi

    add_entry \
      "$source" "$package" "$detail" pacman "$package" "$removable" \
      "$cleanup_owner" "$scope"
  done < <(pacman -Qqe | sort -u)
}

scan_bun() {
  local package

  while IFS= read -r package; do
    valid_field "$package" || continue
    baseline_has bun "$package" && continue
    add_entry "Bun global" "$package" "registered global package" \
      bun "$package" 1
  done < <(list_bun_globals | sort -u)
}

scan_npm() {
  local package

  while IFS= read -r package; do
    valid_field "$package" || continue
    case $package in
    npm | corepack) continue ;;
    esac
    baseline_has npm "$package" && continue
    add_entry "npm global" "$package" "registered global package" \
      npm "$package" 1
  done < <(list_npm_globals | sort -u)
}

npx_wrapper_package() {
  local path=$1
  local command_name=$2
  local package wrapped_command

  grep -q 'npx_bin=' "$path" 2>/dev/null || return 1
  package=$(sed -nE 's/^package="([^"]+)"$/\1/p' "$path" | head -1)
  wrapped_command=$(sed -nE 's/^command="([^"]+)"$/\1/p' "$path" | head -1)

  [[ $wrapped_command == "$command_name" ]] || return 1
  [[ $package =~ ^[@a-zA-Z0-9][@a-zA-Z0-9/_.+-]*$ ]] || return 1
  printf '%s\n' "$package"
}

qvos_owned_path() {
  local path=$1
  local target

  target=$(readlink -f -- "$path" 2>/dev/null || true)
  [[ $target == "$OMARCHY_PATH/"* ||
    $target == "$HOME/.local/share/qvos/"* ]]
}

scan_user_bin() {
  local path name package component cleanup_owner

  [[ -d $user_bin_dir ]] || return 0
  while IFS= read -r -d '' path; do
    [[ -x $path ]] || continue
    name=${path##*/}
    valid_field "$name" || continue
    [[ -z ${qvos_protected_user_bin[$name]+owned} ]] || continue
    [[ -z ${qvos_npx_wrapper[$name]+owned} ]] || continue
    qvos_owned_path "$path" && continue
    component=${qvcore_owner["user-bin"$'\t'"$name"]:-}
    if [[ -z $component ]] && baseline_has user-bin "$name"; then
      continue
    fi
    if [[ -n $component ]]; then
      if grouped_qvcore_component "$component"; then
        record_grouped_component_item "$component" 1
        continue
      fi
      cleanup_owner=""
      case $component in
      codex | proton)
        cleanup_owner=$component
        ;;
      esac
      add_entry "qvCORE · Direct" "$name" \
        "${qvcore_component_name[$component]}; $path${cleanup_owner:+; integration cleanup included}" \
        user-path "$path" 1 "$cleanup_owner" qvcore
      continue
    fi

    if package=$(npx_wrapper_package "$path" "$name"); then
      add_entry "npx wrapper" "$name" "runs $package on demand" \
        user-path "$path" 1
    else
      add_entry "Standalone" "$name" "$path" user-path "$path" 1
    fi
  done < <(
    find "$user_bin_dir" \
      -mindepth 1 \
      -maxdepth 1 \
      \( -type f -o -type l \) \
      -print0 |
      sort -z
  )
}

scan_applications() {
  local path name

  [[ -d $applications_dir ]] || return 0
  while IFS= read -r -d '' path; do
    name=${path##*/}
    [[ $name == *.AppImage || -x $path ]] || continue
    valid_field "$name" || continue
    baseline_has application "$name" && continue
    add_entry "AppImage" "$name" "$path" user-path "$path" 1
  done < <(
    find "$applications_dir" \
      -mindepth 1 \
      -maxdepth 1 \
      \( -type f -o -type l \) \
      -print0 |
      sort -z
  )
}

scan_system_bin() {
  local path name

  [[ -d $system_bin_dir ]] || return 0
  while IFS= read -r -d '' path; do
    [[ -x $path ]] || continue
    name=${path##*/}
    valid_field "$name" || continue
    baseline_has system-bin "$name" && continue
    pacman -Qo "$path" &>/dev/null && continue
    add_entry "System standalone" "$name" "$path" system-path "$path" 1
  done < <(
    find "$system_bin_dir" \
      -mindepth 1 \
      -maxdepth 1 \
      \( -type f -o -type l \) \
      -print0 |
      sort -z
  )
}

filter_entries_by_scope() {
  local scope=$1
  local id
  local filtered_ids=()

  [[ $scope != "all" ]] || return 0

  for id in "${entry_ids[@]}"; do
    [[ ${entry_scope[$id]} == "$scope" ]] || continue
    filtered_ids+=("$id")
  done
  entry_ids=("${filtered_ids[@]}")
}

print_inventory() {
  local id protection
  local removable_count=0

  case $requested_scope in
  standalone)
    echo "qvOS Standalone Tools"
    echo ""
    echo "Standalone commands, global packages, and AppImages outside package ownership."
    ;;
  qvcore)
    echo "Installed qvCORE Software"
    echo ""
    echo "qvCORE-curated applications and coordinated setups."
    ;;
  *)
    echo "qvOS Personal Software"
    echo ""
    echo "Personal software outside current qvOS base ownership."
    echo "qvCORE-curated software remains visible even if the baseline captured it."
    echo "npx execution caches are ignored; persistent wrappers are listed."
    echo "Standalone discovery is limited to standard executable locations."
    ;;
  esac
  echo ""
  echo "Bindings, web apps, and personal data are never changed."
  echo "Selected qvCORE software may clean only its qvOS-owned integration."
  echo ""

  if ((${#entry_ids[@]} == 0)); then
    case $requested_scope in
    standalone) echo "No removable standalone tools were detected." ;;
    qvcore) echo "No installed qvCORE software was detected." ;;
    *) echo "No personal software additions were detected." ;;
    esac
    return
  fi

  printf 'Detected %d personal software item(s):\n' "${#entry_ids[@]}"
  for id in "${entry_ids[@]}"; do
    protection=""
    if ((entry_removable[$id])); then
      removable_count=$((removable_count + 1))
    else
      protection=" [protected]"
    fi
    printf '  %-18s %-28s %s%s\n' \
      "${entry_source[$id]}" \
      "${entry_name[$id]}" \
      "${entry_detail[$id]}" \
      "$protection"
  done
  echo ""
  printf '%d item(s) can be selected for removal.\n' "$removable_count"
}

for argument in "$@"; do
  case $argument in
  --status)
    [[ $mode == "status" ]] || {
      usage
      exit 2
    }
    ;;
  --remove)
    [[ $mode == "status" ]] || {
      usage
      exit 2
    }
    mode="remove"
    ;;
  --remove-standalone)
    [[ $mode == "status" ]] || {
      usage
      exit 2
    }
    mode="remove"
    requested_scope="standalone"
    ;;
  --remove-qvcore)
    [[ $mode == "status" ]] || {
      usage
      exit 2
    }
    mode="remove"
    requested_scope="qvcore"
    ;;
  --initialize)
    [[ $mode == "status" ]] || {
      usage
      exit 2
    }
    mode="initialize"
    ;;
  --yes) assume_yes=1 ;;
  *)
    usage
    exit 2
    ;;
  esac
done

if [[ $mode != "initialize" ]] && ((assume_yes)); then
  usage
  exit 2
fi

for source_path in \
  "$baseline_owner" \
  "$protected_user_bin_policy" \
  "$qvcore_catalog" \
  "$qvcore_ownership" \
  "$qvcore_removal_groups" \
  "$OMARCHY_PATH/qv/install/packaging/base.packages" \
  "$OMARCHY_PATH/qv/install/packaging/other.packages" \
  "$OMARCHY_PATH/qv/install/packaging/npx"; do
  if [[ ! -f $source_path ]]; then
    echo "Missing qvOS personal-software source: $source_path" >&2
    exit 1
  fi
done

if [[ $mode == "initialize" ]]; then
  if [[ -f $baseline ]]; then
    echo "qvOS personal-software tracking is already initialized."
    exit
  fi
  if ((assume_yes == 0)); then
    gum confirm \
      "Record currently installed software as the qvOS tracking baseline?" ||
      exit 130
  fi
  exec "$baseline_owner" --capture
fi

if [[ ! -f $baseline ]]; then
  echo "qvOS Personal Software"
  echo ""
  echo "This installation predates personal-software tracking."
  echo "qvOS will not guess which existing packages or files belong to you."
  echo ""
  echo 'Run "omarchy qvos software --initialize" to record the current system.'
  echo "Software installed afterward will appear in this inventory."
  exit
fi

for command in expac jq pacman; do
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "qvOS personal-software inventory requires: $command" >&2
    exit 1
  fi
done

load_baseline
load_qvos_owners
load_protected_user_bin
load_qvcore_owners
scan_pacman
scan_bun
scan_npm
scan_user_bin
scan_applications
scan_system_bin
add_grouped_qvcore_entries
filter_entries_by_scope "$requested_scope"
print_inventory

if [[ $mode != "remove" ]]; then
  exit 0
fi

options=()
for id in "${entry_ids[@]}"; do
  ((entry_removable[$id])) || continue
  options+=(
    "${entry_source[$id]}  ${entry_name[$id]} — ${entry_detail[$id]}:$id"
  )
done

if ((${#options[@]} == 0)); then
  case $requested_scope in
  standalone) echo "No removable standalone tools were detected." ;;
  qvcore) echo "No removable qvCORE software was detected." ;;
  *) echo "No removable personal software was detected." ;;
  esac
  exit
fi

case $requested_scope in
standalone) selection_header="Choose standalone tools to remove; Esc keeps everything" ;;
qvcore) selection_header="Choose qvCORE software to remove; Esc keeps everything" ;;
*) selection_header="Choose personal software to remove; Esc keeps everything" ;;
esac

echo ""
if selections=$(gum choose \
  --no-limit \
  --height 20 \
  --label-delimiter ":" \
  --header "$selection_header" \
  "${options[@]}"); then
  :
else
  echo "Personal software removal canceled; nothing was changed."
  exit 130
fi

selected_ids=()
declare -A selected_id=()
while IFS= read -r id; do
  [[ -n $id ]] || continue
  if [[ -z ${entry_kind[$id]+known} ]] || ((entry_removable[$id] == 0)); then
    echo "Unknown or protected personal-software selection: $id" >&2
    exit 1
  fi
  if [[ -z ${selected_id[$id]+selected} ]]; then
    selected_ids+=("$id")
    selected_id[$id]=1
  fi
done <<<"$selections"

if ((${#selected_ids[@]} == 0)); then
  echo "No personal software selected; nothing was removed."
  exit
fi

declare -A required_command=()
for id in "${selected_ids[@]}"; do
  case ${entry_kind[$id]} in
  pacman)
    required_command[omarchy-pkg-drop]=1
    required_command[sudo]=1
    ;;
  bun)
    required_command[bun]=1
    ;;
  npm)
    required_command[npm]=1
    ;;
  user-path)
    required_command[gio]=1
    ;;
  system-path)
    required_command[rm]=1
    required_command[sudo]=1
    ;;
  qvcore-setup)
    component=${entry_value[$id]}
    if [[ ! -x $qvcore_owner_dir/$component.sh ]]; then
      echo "Missing qvCORE removal owner: $component" >&2
      exit 1
    fi
    "$qvcore_owner_dir/$component.sh" --remove --check
    ;;
  esac
done
for command in omarchy-pkg-drop bun npm gio rm sudo; do
  [[ -n ${required_command[$command]+needed} ]] || continue
  if ! command -v "$command" >/dev/null 2>&1; then
    echo "Personal software removal requires: $command" >&2
    exit 1
  fi
done

selected_packages=()
cleanup_components=()
declare -A cleanup_component=()
for id in "${selected_ids[@]}"; do
  [[ ${entry_kind[$id]} == "pacman" ]] || continue
  selected_packages+=("${entry_value[$id]}")
done
for id in "${selected_ids[@]}"; do
  component=${entry_cleanup_owner[$id]}
  [[ -n $component ]] || continue
  if [[ ! -x $qvcore_owner_dir/$component.sh ]]; then
    echo "Missing qvCORE cleanup owner: $component" >&2
    exit 1
  fi
  if [[ -z ${cleanup_component[$component]+selected} ]]; then
    cleanup_components+=("$component")
    cleanup_component[$component]=1
  fi
done
if ((${#selected_packages[@]} > 0)); then
  if ! pacman -Rs --print "${selected_packages[@]}" >/dev/null; then
    echo "Pacman could not prepare the selected removal transaction." >&2
    exit 1
  fi
fi

echo ""
echo "Selected for removal:"
for id in "${selected_ids[@]}"; do
  printf '  %-18s %s\n' "${entry_source[$id]}" "${entry_name[$id]}"
done
echo ""
echo "Pacman/AUR may also clean dependencies made unused by these selections."
echo "User-owned standalone files move to Trash; system paths remove only the exact file."
if ((${#cleanup_components[@]} > 0)); then
  echo "Selected qvCORE software will clean its integration first."
fi
gum confirm \
  "Remove these ${#selected_ids[@]} explicitly selected item(s)?" ||
  {
    echo "Personal software removal canceled; nothing was changed."
    exit 130
  }

for component in "${cleanup_components[@]}"; do
  "$qvcore_owner_dir/$component.sh" --prepare-remove
done

for id in "${selected_ids[@]}"; do
  [[ ${entry_kind[$id]} == "qvcore-setup" ]] || continue
  component=${entry_value[$id]}
  "$qvcore_owner_dir/$component.sh" --remove --yes
done

if ((${#selected_packages[@]} > 0)); then
  omarchy-pkg-drop "${selected_packages[@]}"
fi

for id in "${selected_ids[@]}"; do
  kind=${entry_kind[$id]}
  value=${entry_value[$id]}
  case $kind in
  pacman | qvcore-setup) ;;
  bun)
    bun remove --global "$value"
    ;;
  npm)
    npm uninstall --global "$value"
    ;;
  user-path)
    gio trash "$value"
    ;;
  system-path)
    sudo rm -- "$value"
    ;;
  *)
    echo "Unknown personal-software removal owner: $kind" >&2
    exit 1
    ;;
  esac
done

for id in "${selected_ids[@]}"; do
  kind=${entry_kind[$id]}
  value=${entry_value[$id]}
  case $kind in
  pacman)
    if pacman -Q "$value" &>/dev/null; then
      echo "Personal software removal failed: $value remains installed." >&2
      exit 1
    fi
    ;;
  bun)
    if list_bun_globals | grep -Fxq "$value"; then
      echo "Bun global removal failed: $value remains installed." >&2
      exit 1
    fi
    ;;
  npm)
    if list_npm_globals | grep -Fxq "$value"; then
      echo "npm global removal failed: $value remains installed." >&2
      exit 1
    fi
    ;;
  user-path | system-path)
    if [[ -e $value || -L $value ]]; then
      echo "Standalone removal failed: $value remains present." >&2
      exit 1
    fi
    ;;
  qvcore-setup) ;;
  esac
done

printf 'Removed %d selected personal software item(s).\n' \
  "${#selected_ids[@]}"
