#!/bin/bash
set -euo pipefail

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
mode=interactive

usage() {
  echo "Usage: omarchy-qvos-update [-y|--check]" >&2
}

if (($# > 1)); then
  usage
  exit 2
fi
case ${1:-} in
"") ;;
-y) mode=noninteractive ;;
--check) mode=check ;;
*)
  usage
  exit 2
  ;;
esac

preflight() {
  local branch
  local source_status

  branch=$(git -C "$OMARCHY_PATH" branch --show-current 2>/dev/null || true)
  if [[ $branch != "OS" ]]; then
    echo "qvOS update requires the live checkout on branch OS; found '${branch:-none}'." >&2
    return 1
  fi
  source_status=$(git -C "$OMARCHY_PATH" status --porcelain=v1 --untracked-files=all 2>/dev/null) || {
    echo "qvOS update cannot inspect the live source checkout." >&2
    return 1
  }
  if [[ -n $source_status ]]; then
    echo "qvOS update requires a clean live source checkout." >&2
    return 1
  fi
  if ! command -v omarchy-update >/dev/null 2>&1; then
    echo "qvOS update cannot find its update engine." >&2
    return 1
  fi
}

if [[ $mode == "interactive" ]]; then
  tui=${QVOS_TUI_BINARY:-}
  if [[ -z $tui ]]; then
    tui=$(command -v qvos-tui || true)
  fi
  if [[ -n $tui && -x $tui ]]; then
    exec "$tui" --update
  fi
fi

preflight

if [[ $mode == "check" ]]; then
  exit 0
fi

if [[ $mode == "interactive" ]]; then
  gum style --border normal --padding "1 2" \
    "Ready to update qvOS?" \
    "" \
    "• The qvOS update engine will update qvOS and system packages" \
    "• Press Ctrl+C to stop the update if needed" \
    "• Make sure you're connected to power or have a full battery" \
    "" \
    "What's new: https://github.com/Yaqyn-qvOS/qvOS/commits/OS"

  echo
  if ! gum confirm "Continue with qvOS update?"; then
    echo "qvOS update cancelled."
    exit 130
  fi
fi

omarchy-update -y
echo -e "\e[32m\nqvOS update is complete.\e[0m"
