#!/bin/bash
set -euo pipefail

owner_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=qv/power/battery-protection-lib
source "$owner_dir/battery-protection-lib"

usage() {
  echo "Usage: omarchy battery protection [status|enable [balanced|plugged-in]|disable|full-charge-once|report]" >&2
}

preset_label() {
  case $1 in
  balanced) printf 'Balanced' ;;
  plugged-in) printf 'Mostly plugged in' ;;
  *) printf 'Unknown' ;;
  esac
}

inspect_supported_state() {
  if ! discover_batteries; then
    printf 'Battery Protection: Unsupported\n'
    printf 'Reason: %s\n' "$DISCOVERY_REASON"
    return 3
  fi
  if ! analyze_capability; then
    printf 'Battery Protection: Unsupported\n'
    printf 'Reason: %s\n' "$DISCOVERY_REASON"
    return 3
  fi
  observe_mode
}

status_command() {
  local classification
  local inspect_status=0
  local configuration_state
  local configuration_matches=false
  local now
  local override_matches=false
  local recovery_due=false

  inspect_supported_state || inspect_status=$?
  if ((inspect_status != 0)); then
    return "$inspect_status"
  fi
  if ! read_intent || ! read_override; then
    echo "Battery Protection: Requested but drifted"
    echo "Reason: qvOS state is malformed or has unsafe permissions"
    return 1
  fi
  configuration_state=$(hwdb_state)
  if [[ $CAPABILITY_SHAPE == "firmware" && $configuration_state == "absent" ]] ||
    [[ $CAPABILITY_SHAPE != "firmware" && $configuration_state == "qvos" ]]; then
    configuration_matches=true
  fi
  now=$(date +%s)
  if [[ -n $OVERRIDE_PRESET ]] &&
    { ! ac_online || all_batteries_full || ((OVERRIDE_DEADLINE <= now)); }; then
    recovery_due=true
  fi
  if [[ $recovery_due == "false" && -n $OVERRIDE_PRESET &&
    $INTENT_STATE == "enabled" &&
    $OVERRIDE_PRESET == "$INTENT_PRESET" &&
    $OVERRIDE_SHAPE == "$INTENT_SHAPE" ]] &&
    service_is_enabled && service_is_active; then
    override_matches=true
  fi

  if [[ $INTENT_STATE == "enabled" ]]; then
    if [[ $override_matches == "true" && $OBSERVED_MODE == "disabled" &&
      $configuration_matches == "true" ]]; then
      classification="Temporary full-charge override"
    elif [[ -z $OVERRIDE_PRESET && $OBSERVED_MODE == "enabled" &&
      $INTENT_SHAPE == "$CAPABILITY_SHAPE" &&
      $configuration_matches == "true" ]] &&
      verify_mode_once enabled "$INTENT_PRESET" "$INTENT_SHAPE"; then
      classification="Enabled - $(preset_label "$INTENT_PRESET")"
    else
      classification="Requested but drifted"
    fi
  elif [[ $INTENT_STATE == "disabled" ]]; then
    if [[ -z $OVERRIDE_PRESET && $OBSERVED_MODE == "disabled" &&
      $configuration_state == "absent" ]]; then
      classification="Disabled"
    elif [[ -z $OVERRIDE_PRESET && $OBSERVED_MODE == "enabled" ]]; then
      classification="External or unmanaged enablement"
    else
      classification="Requested but drifted"
    fi
  elif [[ -n $OVERRIDE_PRESET || $configuration_state == "qvos" ]]; then
    classification="Requested but drifted"
  elif [[ $OBSERVED_MODE == "enabled" ]]; then
    classification="External or unmanaged enablement"
  elif [[ $OBSERVED_MODE == "disabled" ]]; then
    classification="Unmanaged"
  else
    classification="Requested but drifted"
  fi

  printf 'Battery Protection: %s\n' "$classification"
  printf 'Hardware: %s\n' "$CAPABILITY_DESCRIPTION"
  if [[ $OBSERVED_MODE == "drift" ]]; then
    printf 'Reason: %s\n' "$OBSERVED_REASON"
  elif [[ $CAPABILITY_SHAPE == "end-only" ]]; then
    printf 'Charging restarts at a firmware-controlled level.\n'
  fi
}

report_command() {
  local index
  local active_type
  local manager
  local status_result=0

  status_command || status_result=$?
  if ((status_result != 0)); then
    return "$status_result"
  fi
  printf 'Batteries: %d\n' "${#BATTERY_OBJECTS[@]}"
  for index in "${!BATTERY_OBJECTS[@]}"; do
    printf 'Battery %d:\n' "$((index + 1))"
    printf '  UPower support: yes\n'
    printf '  Supported settings mask: %s\n' "${BATTERY_MASKS[$index]}"
    printf '  UPower enabled: %s\n' "${BATTERY_ENABLED[$index]}"
    case $CAPABILITY_SHAPE in
    firmware)
      active_type=$(active_charge_type "${BATTERY_PATHS[$index]}" || printf 'unavailable')
      printf '  Kernel charge mode: %s\n' "$active_type"
      printf '  Firmware range: approximately 50-60%%\n'
      ;;
    start-end)
      printf '  UPower thresholds: %s-%s%%\n' \
        "${BATTERY_START[$index]}" "${BATTERY_END[$index]}"
      printf '  Kernel thresholds: %s-%s%%\n' \
        "$(<"${BATTERY_PATHS[$index]}/charge_control_start_threshold")" \
        "$(<"${BATTERY_PATHS[$index]}/charge_control_end_threshold")"
      ;;
    end-only)
      printf '  UPower end threshold: %s%%\n' "${BATTERY_END[$index]}"
      printf '  Kernel end threshold: %s%%\n' \
        "$(<"${BATTERY_PATHS[$index]}/charge_control_end_threshold")"
      printf '  Restart threshold: firmware-controlled\n'
      ;;
    esac
  done
  printf 'qvOS hwdb override: %s\n' "$(hwdb_state)"
  if manager=$(conflicting_manager); then
    printf 'Conflicting charging manager: %s\n' "$manager"
  else
    printf 'Conflicting charging manager: none active\n'
  fi
  printf 'Report privacy: serials, DMI data, and native paths omitted\n'
}

confirm_action() {
  local prompt="$1"

  if [[ ${QVOS_POWER_TESTING:-} == "1" ]]; then
    [[ ${QVOS_POWER_CONFIRM:-no} == "yes" ]] && return 0
    echo "Battery Protection change canceled."
    return 130
  fi
  [[ -t 0 && -t 1 ]] ||
    {
      echo "Battery Protection changes require an interactive terminal." >&2
      return 1
    }
  if command -v gum >/dev/null 2>&1; then
    gum confirm "$prompt" && return 0
  else
    read -r -p "$prompt [y/N] " answer
    [[ $answer == "y" || $answer == "Y" ]] && return 0
  fi
  echo "Battery Protection change canceled."
  return 130
}

choose_preset() {
  local requested="${1:-}"
  local choice

  if [[ $CAPABILITY_SHAPE == "firmware" ]]; then
    [[ -z $requested || $requested == "plugged-in" ]] || return 2
    printf 'plugged-in\n'
    return
  fi
  if [[ -n $requested ]]; then
    [[ $requested == "balanced" || $requested == "plugged-in" ]] || return 2
    printf '%s\n' "$requested"
    return
  fi
  if [[ ${QVOS_POWER_TESTING:-} == "1" ]]; then
    return 2
  fi
  choice=$(
    gum choose \
      --header "Choose a Battery Protection preset" \
      "balanced - charge at 75%, stop at 80%" \
      "plugged-in - charge at 55%, stop at 60%"
  ) || return 130
  printf '%s\n' "${choice%% *}"
}

preflight_mutation() {
  local manager

  if ! discover_batteries || ! analyze_capability; then
    echo "Battery Protection is unavailable: $DISCOVERY_REASON" >&2
    return 3
  fi
  if manager=$(conflicting_manager); then
    echo "Battery Protection is unavailable while $manager is active." >&2
    return 1
  fi
  if [[ $(hwdb_state) == "conflict" ]]; then
    echo "Battery Protection found a foreign or unsafe hwdb override." >&2
    return 1
  fi
  if ! read_intent || ! read_override; then
    echo "Battery Protection state is malformed or has unsafe permissions." >&2
    return 1
  fi
}

safe_disable() {
  local shape="$1"

  set_mode_all false || true
  if ! verify_mode disabled "" "$shape"; then
    echo "Battery Protection could not verify unlimited charging." >&2
    return 1
  fi
}

enable_command() {
  local requested="${1:-}"
  local preset
  local old_intent=""
  local had_intent=false
  local override_active=false
  local helper_transaction=false
  local configuration_state
  local start
  local end
  local preset_status=0

  preflight_mutation || return $?
  preset=$(choose_preset "$requested") || preset_status=$?
  if ((preset_status != 0)); then
    if ((preset_status == 130)); then
      echo "Battery Protection change canceled."
      return 130
    fi
    echo "That preset is unavailable for this hardware." >&2
    return 2
  fi

  echo "Battery Protection will use $(preset_label "$preset")."
  if [[ $CAPABILITY_SHAPE == "firmware" ]]; then
    echo "The firmware controls an approximately 50-60% Long Life range."
  elif [[ $CAPABILITY_SHAPE == "end-only" ]]; then
    echo "Charging will stop at the preset maximum; restart remains firmware-controlled."
  else
    read -r start end < <(preset_values "$preset")
    echo "Charging will start at $start% and stop at $end%."
  fi
  echo "qvOS will not discharge, cycle, or calibrate the battery."
  confirm_action "Enable Battery Protection?" || return $?

  lock_mutation
  preflight_mutation || return $?
  if [[ $CAPABILITY_SHAPE == "firmware" && $preset != "plugged-in" ]] ||
    [[ $CAPABILITY_SHAPE != "firmware" &&
      $preset != "balanced" && $preset != "plugged-in" ]]; then
    echo "Battery Protection capabilities changed before confirmation." >&2
    return 1
  fi
  ensure_state_dir
  if [[ -n $INTENT_STATE ]]; then
    had_intent=true
    old_intent=$(<"$POWER_STATE_ROOT/intent")
  fi
  if [[ -n $OVERRIDE_PRESET ]]; then
    override_active=true
    service_stop || true
  fi

  if [[ $CAPABILITY_SHAPE == "firmware" ]]; then
    configuration_state=$(hwdb_state)
    if [[ $configuration_state == "qvos" ]]; then
      safe_disable "$CAPABILITY_SHAPE" || return 1
      if ! run_root_helper recover || ! run_root_helper remove; then
        [[ $override_active == "false" ]] || service_start || true
        echo "Battery Protection could not remove its stale threshold configuration." >&2
        return 1
      fi
    fi
    if ! set_mode_all true ||
      ! verify_mode enabled "$preset" "$CAPABILITY_SHAPE"; then
      safe_disable "$CAPABILITY_SHAPE" || true
      [[ $override_active == "false" ]] || service_start || true
      echo "Battery Protection enablement did not pass kernel readback." >&2
      return 1
    fi
  else
    safe_disable "$CAPABILITY_SHAPE" || return 1
    run_root_helper recover
    if ! run_root_helper apply "$CAPABILITY_SHAPE" "$preset"; then
      safe_disable "$CAPABILITY_SHAPE" || true
      [[ $override_active == "false" ]] || service_start || true
      echo "Battery Protection could not apply its threshold configuration." >&2
      return 1
    fi
    helper_transaction=true
    if ! verify_configured_thresholds "$preset" "$CAPABILITY_SHAPE" ||
      ! set_mode_all true ||
      ! verify_mode enabled "$preset" "$CAPABILITY_SHAPE"; then
      safe_disable "$CAPABILITY_SHAPE" || true
      run_root_helper rollback || true
      [[ $override_active == "false" ]] || service_start || true
      echo "Battery Protection enablement did not pass UPower and kernel readback." >&2
      return 1
    fi
  fi

  if ! write_intent enabled "$preset" "$CAPABILITY_SHAPE"; then
    safe_disable "$CAPABILITY_SHAPE" || true
    [[ $helper_transaction == "false" ]] || run_root_helper rollback || true
    if [[ $had_intent == "true" ]]; then
      atomic_state_write intent "$old_intent" || true
    else
      rm -f "$POWER_STATE_ROOT/intent"
    fi
    [[ $override_active == "false" ]] || service_start || true
    return 1
  fi
  if [[ $helper_transaction == "true" ]] && ! run_root_helper commit; then
    safe_disable "$CAPABILITY_SHAPE" || true
    run_root_helper rollback || true
    if [[ $had_intent == "true" ]]; then
      atomic_state_write intent "$old_intent" || true
    else
      rm -f "$POWER_STATE_ROOT/intent"
    fi
    [[ $override_active == "false" ]] || service_start || true
    return 1
  fi

  if [[ $override_active == "true" ]]; then
    service_disable || true
    remove_override
  fi
  printf 'Battery Protection enabled: %s.\n' "$(preset_label "$preset")"
}

disable_command() {
  local configuration_state
  local shape

  preflight_mutation || return $?
  echo "Battery Protection will return every battery to Standard or unlimited charging."
  echo "Only a verified qvOS-owned threshold override will be removed."
  confirm_action "Disable Battery Protection?" || return $?

  lock_mutation
  preflight_mutation || return $?
  shape=$CAPABILITY_SHAPE
  configuration_state=$(hwdb_state)
  ensure_state_dir
  service_stop || true
  safe_disable "$shape" || return 1
  if [[ $shape != "firmware" || $configuration_state == "qvos" ]]; then
    if ! run_root_helper recover || ! run_root_helper remove; then
      echo "Battery Protection is disabled, but qvOS could not safely clean its hwdb override." >&2
      return 1
    fi
  fi
  verify_mode disabled "" "$shape" ||
    {
      echo "Battery Protection cleanup did not preserve unlimited charging." >&2
      return 1
    }
  write_intent disabled
  remove_override
  service_disable || true
  echo "Battery Protection disabled."
}

full_charge_once_command() {
  local deadline

  preflight_mutation || return $?
  if ! read_intent || ! read_override; then
    echo "Battery Protection state is malformed." >&2
    return 1
  fi
  [[ $INTENT_STATE == "enabled" && -z $OVERRIDE_PRESET ]] ||
    {
      echo "Full Charge Once requires qvOS-managed Battery Protection." >&2
      return 1
    }
  verify_mode enabled "$INTENT_PRESET" "$INTENT_SHAPE" ||
    {
      echo "Battery Protection is not in its requested verified state." >&2
      return 1
    }
  ac_online ||
    {
      echo "Full Charge Once requires connected AC power." >&2
      return 1
    }
  echo "Full Charge Once temporarily allows charging to 100%."
  echo "Protection restores on AC disconnect, full batteries, or after 24 hours."
  confirm_action "Temporarily disable Battery Protection?" || return $?

  lock_mutation
  preflight_mutation || return $?
  read_intent && read_override || return 1
  [[ $INTENT_STATE == "enabled" && -z $OVERRIDE_PRESET ]] || return 1
  verify_mode enabled "$INTENT_PRESET" "$INTENT_SHAPE" || return 1
  ac_online || return 1
  ensure_state_dir
  deadline=$(($(date +%s) + 86400))
  write_override "$INTENT_PRESET" "$INTENT_SHAPE" "$deadline"
  if ! service_enable; then
    remove_override
    return 1
  fi
  if ! safe_disable "$INTENT_SHAPE"; then
    restore_protection_from_override || true
    if verify_mode enabled "$INTENT_PRESET" "$INTENT_SHAPE"; then
      remove_override
      service_disable || true
    fi
    return 1
  fi
  if ! service_start; then
    if restore_protection_from_override; then
      remove_override
      service_disable || true
    fi
    echo "Full Charge Once could not start its recovery service." >&2
    return 1
  fi
  echo "Full Charge Once active. Battery Protection will restore automatically."
}

override_watch() {
  local now

  [[ ${QVOS_POWER_SERVICE:-} == "1" ]] || return 2
  while true; do
    if lock_mutation; then
      if ! read_intent || ! read_override; then
        return 1
      fi
      if [[ $INTENT_STATE != "enabled" || -z $OVERRIDE_PRESET ]]; then
        service_disable || true
        return 0
      fi
      if discover_batteries && analyze_capability; then
        observe_mode
        if [[ $OBSERVED_MODE == "enabled" ]] &&
          verify_mode enabled "$OVERRIDE_PRESET" "$OVERRIDE_SHAPE"; then
          remove_override
          service_disable || true
          return 0
        fi
      fi
      now=$(date +%s)
      if ! ac_online || all_batteries_full || ((now >= OVERRIDE_DEADLINE)); then
        if restore_protection_from_override; then
          remove_override
          service_disable || true
          return 0
        fi
        return 1
      fi
      flock -u 9
      exec 9>&-
    fi
    sleep 60
  done
}

case ${1:-status} in
status)
  (($# <= 1)) || {
    usage
    exit 2
  }
  status_command
  ;;
report)
  (($# == 1)) || {
    usage
    exit 2
  }
  report_command
  ;;
enable)
  (($# <= 2)) || {
    usage
    exit 2
  }
  enable_command "${2:-}"
  ;;
disable)
  (($# == 1)) || {
    usage
    exit 2
  }
  disable_command
  ;;
full-charge-once)
  (($# == 1)) || {
    usage
    exit 2
  }
  full_charge_once_command
  ;;
override-watch)
  (($# == 1)) || exit 2
  override_watch
  ;;
*)
  usage
  exit 2
  ;;
esac
