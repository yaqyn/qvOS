[Unit]
Description=qvOS Battery Protection Full Charge Once
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=QVOS_POWER_SERVICE=1
ExecStart=%h/.local/share/qvos/power/battery-protection override-watch
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
