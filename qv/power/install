#!/bin/bash
set -euo pipefail

source_dir="$OMARCHY_PATH/qv/power"
runtime_dir="$HOME/.local/share/qvos/power"
qvos_bin="$HOME/.local/share/qvos/bin"
local_bin="$HOME/.local/bin"
user_unit_dir="$HOME/.config/systemd/user"
system_root=${QVOS_POWER_SYSTEM_ROOT:-}
system_helper="${system_root}/usr/lib/qvos/battery-protection-hwdb"

if [[ -n $system_root && ${QVOS_POWER_TESTING:-} != "1" ]]; then
  echo "A custom Battery Protection system root is only valid in tests." >&2
  exit 2
fi

runtime_files=(
  battery-protection
  battery-protection-backend
  battery-protection-lib
)

rm -rf "$runtime_dir"
install -d "$runtime_dir" "$qvos_bin" "$local_bin" "$user_unit_dir"
for runtime_file in "${runtime_files[@]}"; do
  mode=0644
  [[ $runtime_file != "battery-protection-lib" ]] && mode=0755
  install -m "$mode" "$source_dir/$runtime_file" "$runtime_dir/$runtime_file"
done

for command_name in omarchy-system-inhibit-sleep omarchy-system-suspend-if-safe; do
  power_owner=${command_name#omarchy-system-}
  install -m 0755 "$source_dir/$power_owner" "$qvos_bin/$command_name"
done

install -m 0644 \
  "$source_dir/qvos-battery-full-charge-once.service" \
  "$user_unit_dir/qvos-battery-full-charge-once.service"

if [[ -n $system_root ]] || ((EUID == 0)); then
  install -D -o "$(id -u)" -g "$(id -g)" -m 0755 \
    "$source_dir/battery-protection-hwdb" "$system_helper"
  if ((EUID == 0)); then
    chown root:root "$system_helper"
  fi
else
  /usr/bin/sudo /usr/bin/install -D -o root -g root -m 0755 \
    "$source_dir/battery-protection-hwdb" "$system_helper"
fi

if [[ -z $system_root ]]; then
  /usr/bin/systemctl --user daemon-reload
fi
