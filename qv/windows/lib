# shellcheck shell=bash

qvos_windows_require_safe_path() {
  local path=$1
  local kind=$2

  if [[ -L $path ]]; then
    echo "Refusing symlinked Windows $kind: $path" >&2
    return 1
  fi
  if [[ -e $path ]]; then
    case $kind in
    directory)
      [[ -d $path ]] || {
        echo "Windows path is not a directory: $path" >&2
        return 1
      }
      ;;
    file)
      [[ -f $path ]] || {
        echo "Windows path is not a regular file: $path" >&2
        return 1
      }
      ;;
    *)
      echo "Unknown Windows path kind: $kind" >&2
      return 2
      ;;
    esac
  fi
}

qvos_windows_valid_username() {
  [[ $1 =~ ^[A-Za-z][A-Za-z0-9._-]{0,31}$ ]]
}

qvos_windows_valid_password() {
  local password=$1

  (( ${#password} >= 8 && ${#password} <= 64 )) &&
    [[ $password =~ ^[A-Za-z0-9@%+=:,.!?_-]+$ ]]
}

qvos_windows_valid_timezone() {
  [[ $1 =~ ^[A-Za-z0-9_+.-]+(/[A-Za-z0-9_+.-]+)*$ && $1 != *..* ]]
}
