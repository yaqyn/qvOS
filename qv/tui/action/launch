#!/bin/bash
set -euo pipefail

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
catalog="$OMARCHY_PATH/qv/menu/software-actions.psv"
installer_catalog="$OMARCHY_PATH/qv/menu/software-installers.psv"
concepts="$HOME/.local/share/qvos/menu/concepts.psv"
state_owner="$OMARCHY_PATH/qv/menu/software-state"
tui_launch="$OMARCHY_PATH/qv/tui/launch"
mode=stateful

if [[ ${1:-} == "--installer" ]]; then
  mode=installer
  shift
fi
slug=${1:-}

usage() {
  echo "Usage: qv/tui/action/launch [--installer] <software-slug>" >&2
}

action_record() {
  awk -F '|' -v wanted="$slug" '
    $1 !~ /^#/ && NF == 9 && $1 == wanted {
      print
      found = 1
      exit
    }
    END { exit !found }
  ' "$catalog"
}

installer_record() {
  awk -F '|' -v wanted="$slug" '
    $1 !~ /^#/ && NF == 11 && $1 == wanted {
      print
      found = 1
      exit
    }
    END { exit !found }
  ' "$installer_catalog"
}

concept_name() {
  awk -F '|' -v wanted="$slug" '
    $1 !~ /^#/ && $1 == wanted && NF >= 5 {
      print $3
      found = 1
      exit
    }
    END { exit !found }
  ' "$concepts"
}

owner_metadata() {
  local key=$1
  local owner_path
  local owner_route=${owner_args[0]}

  if [[ $owner_route == qv/* ]]; then
    owner_route="$OMARCHY_PATH/$owner_route"
  fi
  if [[ -x $owner_route ]]; then
    owner_path=$owner_route
  else
    owner_path=$(command -v "$owner_route") || return 1
  fi
  sed -n "s/^# omarchy:${key}=//p" "$owner_path" | head -n 1
}

[[ -n $slug && $# == 1 ]] || {
  usage
  exit 2
}
[[ -x $tui_launch ]] || {
  echo "The qvOS TUI launch surface is incomplete." >&2
  exit 1
}

if [[ $mode == "installer" ]]; then
  [[ -f $installer_catalog ]] || {
    echo "Missing qvOS software installer catalog: $installer_catalog" >&2
    exit 1
  }
  record=$(installer_record) || {
    echo "Unknown qvOS software installer: $slug" >&2
    exit 2
  }
  IFS='|' read -r \
    _ \
    _ \
    title \
    _ \
    _ \
    presentation \
    requires_sudo \
    _ \
    _ \
    summary \
    owner_command <<<"$record"
  operation=install
else
  [[ -f $catalog && -f $concepts && -x $state_owner ]] || {
    echo "The qvOS state-aware software action surface is incomplete." >&2
    exit 1
  }
  record=$(action_record) || {
    echo "Unknown qvOS software action: $slug" >&2
    exit 2
  }
  IFS='|' read -r \
    _ \
    _ \
    _ \
    install_presentation \
    install_sudo \
    uninstall_presentation \
    uninstall_sudo \
    install_owner \
    uninstall_owner <<<"$record"

  title=$(concept_name) || {
    echo "Missing qvOS software concept: $slug" >&2
    exit 1
  }
  operation=$("$state_owner" "$slug")
  case $operation in
  install)
    owner_command=$install_owner
    presentation=$install_presentation
    requires_sudo=$install_sudo
    ;;
  uninstall)
    owner_command=$uninstall_owner
    presentation=$uninstall_presentation
    requires_sudo=$uninstall_sudo
    ;;
  *)
    echo "Invalid qvOS software action state: $operation" >&2
    exit 1
    ;;
  esac
fi
read -r -a owner_args <<<"$owner_command"
((${#owner_args[@]} > 0)) || {
  echo "Missing qvOS software owner for $slug." >&2
  exit 1
}
[[ -n ${summary:-} ]] || summary=$(owner_metadata summary || true)
[[ -n $summary ]] || summary="${operation^} $title through its existing owner"
[[ $requires_sudo == "true" || $requires_sudo == "false" ]] || {
  echo "Invalid qvOS software sudo contract: $requires_sudo" >&2
  exit 1
}

if [[ $presentation == "native" ]]; then
  exec omarchy-launch-floating-terminal-with-presentation "$owner_command"
fi

[[ $presentation == "tui" ]] || {
  echo "Unsupported qvOS action presentation: $presentation" >&2
  exit 1
}

export QVOS_ACTION_SLUG="$slug"
export QVOS_ACTION_OPERATION="$operation"
export QVOS_ACTION_TITLE="$title"
export QVOS_ACTION_SUMMARY="$summary"
if [[ $mode == "installer" ]]; then
  export QVOS_ACTION_SCRIPT="$OMARCHY_PATH/qv/tui/action/run-installer"
fi
if [[ $requires_sudo == "true" ]]; then
  export QVOS_ACTION_REQUIRES_SUDO=1
else
  export QVOS_ACTION_REQUIRES_SUDO=0
fi

exec "$tui_launch" "$title" qvos-tui --action
