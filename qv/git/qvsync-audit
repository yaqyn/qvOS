#!/bin/bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
base_ref=${1:-HEAD}
target_ref=${2:-upstream/master}
qvos_ref=${3:-HEAD}

cd "$repo_root"

resolve_commit() {
  local label=$1
  local ref=$2

  if ! git rev-parse --verify --quiet "$ref^{commit}"; then
    printf "Refusing: %s is not a commit: %s\n" "$label" "$ref" >&2
    exit 1
  fi
}

term_is_useful() {
  local term=$1

  ((${#term} >= 4)) || return 1
  case $term in
    agents | common | config | default | install | json | jsonc | launch | \
      main | omarchy | readme | refresh | remove | restart | scripts | setup | \
      system | test | tests | update)
      return 1
      ;;
  esac
}

collect_overlap_hints() {
  local path
  local component
  local term
  local match
  local owner
  local uses
  local source_contracts
  local source_contract
  local source
  local extra
  local -A terms=()
  local -A hints=()

  for path in "${changed_paths[@]}"; do
    if ! git diff --quiet "$base_sha" "$qvos_sha" -- "$path"; then
      hints["$path"]="same inherited path changed by qvOS"
    fi

    while IFS= read -r component; do
      component=${component%.*}
      component=${component,,}
      term_is_useful "$component" && terms["$component"]=1
    done < <(tr '/._-' '\n' <<<"$path")
  done

  for term in "${!terms[@]}"; do
    while IFS= read -r match; do
      [[ -n $match ]] || continue
      match=${match#*:}
      [[ -n ${hints[$match]:-} ]] ||
        hints["$match"]="references upstream capability term: $term"
    done < <(
      git grep -l -F -e "$term" "$qvos_sha" -- qv test/qvos 2>/dev/null || true
    )
  done

  if git cat-file -e "$qvos_sha:qv/tui/owner-contracts.psv" 2>/dev/null; then
    while IFS='|' read -r owner uses source_contracts extra; do
      [[ $owner == \#* || -z $owner ]] && continue
      [[ -n $uses && -n $source_contracts && -z ${extra:-} ]] || continue

      while IFS= read -r source_contract; do
        source=${source_contract%@*}
        [[ $source != "external" ]] || continue
        if ! git diff --quiet "$base_sha" "$target_sha" -- "$source"; then
          hints["$source"]="contracted TUI owner changed upstream; review qv/tui/owner-contracts.psv before refreshing it"
        fi
      done < <(tr ',' '\n' <<<"$source_contracts")
    done < <(git show "$qvos_sha:qv/tui/owner-contracts.psv")
  fi

  if ((${#hints[@]} == 0)); then
    printf "  (none found mechanically; semantic review is still required)\n"
    return
  fi

  for path in "${!hints[@]}"; do
    printf "  %s — %s\n" "$path" "${hints[$path]}"
  done | sort
}

github_upstream_repo() {
  local url
  local repo

  url=$(git remote get-url upstream 2>/dev/null) || return 1
  case $url in
    https://github.com/*)
      repo=${url#https://github.com/}
      ;;
    git@github.com:*)
      repo=${url#git@github.com:}
      ;;
    ssh://git@github.com/*)
      repo=${url#ssh://git@github.com/}
      ;;
    *)
      return 1
      ;;
  esac

  repo=${repo%.git}
  [[ $repo == */* ]] || return 1
  printf "%s\n" "$repo"
}

print_roadmap_signals() {
  local repo
  local output
  local index
  local -a signals=()

  if ! command -v gh >/dev/null || ! repo=$(github_upstream_repo); then
    printf "  (unavailable for this upstream; inspect maintainer plans manually)\n"
    return
  fi

  if ! output=$(
    gh api \
      "repos/$repo/pulls?state=open&sort=updated&direction=desc&per_page=100" \
      --jq '.[] |
        select(
          .author_association == "OWNER" or
          .author_association == "MEMBER" or
          .author_association == "COLLABORATOR"
        ) |
        "  #\(.number) [\(.head.ref)] \(.title) — \(.html_url)"' \
      2>/dev/null
  ); then
    printf "  (GitHub roadmap lookup unavailable; review current upstream plans manually)\n"
    return
  fi

  if [[ -z $output ]]; then
    printf "  (no open maintainer-owned pull requests found)\n"
    return
  fi

  mapfile -t signals <<<"$output"
  for ((index = 0; index < ${#signals[@]} && index < 20; index++)); do
    printf "%s\n" "${signals[$index]}"
  done
  if ((${#signals[@]} > 20)); then
    printf "  ... %d more maintainer-owned pull requests\n" "$(( ${#signals[@]} - 20 ))"
  fi
}

resolve_commit "base ref" "$base_ref" >/dev/null
resolve_commit "upstream target" "$target_ref" >/dev/null
resolve_commit "qvOS ref" "$qvos_ref" >/dev/null

base_sha=$(git rev-parse "$base_ref^{commit}")
target_sha=$(git rev-parse "$target_ref^{commit}")
qvos_sha=$(git rev-parse "$qvos_ref^{commit}")

if ! git merge-base --is-ancestor "$base_sha" "$target_sha"; then
  printf "Refusing: audit base is not an ancestor of the upstream target.\n" >&2
  printf "Base: %s\nTarget: %s\n" "$base_sha" "$target_sha" >&2
  exit 1
fi

mapfile -d '' changed_paths < <(
  git diff --name-only -z --find-renames "$base_sha" "$target_sha"
)
commit_count=$(git rev-list --count "$base_sha..$target_sha")

printf "qvOS upstream capability audit\n"
printf "Base: %s\n" "$base_sha"
printf "Upstream target: %s\n" "$target_sha"
printf "qvOS head: %s\n" "$qvos_sha"
printf "\nUpstream commits (%d):\n" "$commit_count"
if ((commit_count == 0)); then
  printf "  (none)\n"
else
  git log \
    --reverse \
    --format='  %H %s' \
    "$base_sha..$target_sha"
fi

printf "\nChanged upstream paths (%d):\n" "${#changed_paths[@]}"
if ((${#changed_paths[@]} == 0)); then
  printf "  (none)\n"
else
  git diff \
    --name-status \
    --find-renames \
    "$base_sha" \
    "$target_sha" |
    sed 's/^/  /'
fi

printf "\nMechanical qvOS overlap hints:\n"
collect_overlap_hints

printf "\nUpstream roadmap signals (advisory only; never merged by qvsync):\n"
print_roadmap_signals

printf "\nRequired Codex review:\n"
printf "  1. Read every upstream commit and its complete diff.\n"
printf "  2. Search current qvOS owners, installed payloads, tests, and qvOS history.\n"
printf "  3. Inspect relevant roadmap signals for impending replacement architecture.\n"
printf "  4. Classify each capability: adopt, combine, retire-qvos, preserve, or no-impact.\n"
printf "  5. Port qvOS differentiators onto the best upstream seam and remove superseded code.\n"
printf "  6. Verify fresh install, update, removal, live runtime, and cleanup paths that changed.\n"
printf "\nFull patch: git diff --find-renames %s %s\n" "$base_sha" "$target_sha"
