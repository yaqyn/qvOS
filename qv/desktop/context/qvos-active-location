#!/bin/bash
set -euo pipefail

# Resolve the active desktop context to a canonical directory.

decode_file_uri() {
  local uri="$1"
  local decoded=""
  local byte

  case "$uri" in
  file:///*) uri="${uri#file://}" ;;
  file://localhost/*) uri="/${uri#file://localhost/}" ;;
  *) return 1 ;;
  esac

  while [[ $uri =~ ^([^%]*)%([[:xdigit:]]{2})(.*)$ ]]; do
    decoded+="${BASH_REMATCH[1]}"
    printf -v byte '%b' "\\x${BASH_REMATCH[2]}"
    decoded+="$byte"
    uri="${BASH_REMATCH[3]}"
  done

  printf '%s%s\n' "$decoded" "$uri"
}

normalize_location() {
  local path="${1:-}"
  local tilde="~"

  [[ -n $path ]] || return 1
  case "$path" in
  "$tilde") path="$HOME" ;;
  "$tilde/"*) path="$HOME/${path#"$tilde/"}" ;;
  file://*) path="$(decode_file_uri "$path")" ;;
  esac

  if [[ -f $path ]]; then
    path="$(dirname -- "$path")"
  fi
  [[ -d $path ]] || return 1
  readlink -f -- "$path"
}

process_tree() {
  local roots="$1"
  local next pid child

  [[ -n $roots ]] || return 1
  while [[ -n $roots ]]; do
    next=""
    for pid in $roots; do
      printf '%s\n' "$pid"
      while IFS= read -r child; do
        [[ -n $child ]] || continue
        next="${next:+$next }$child"
      done < <(pgrep -P "$pid" 2>/dev/null || true)
    done
    roots="$next"
  done
}

process_cwd() {
  local pid="$1"
  local process cwd location=""

  while IFS= read -r process; do
    cwd="$(readlink -f "/proc/$process/cwd" 2>/dev/null || true)"
    [[ -d $cwd ]] && location="$cwd"
  done < <(process_tree "$pid")

  normalize_location "$location"
}

code_location_from_process() {
  local pid="$1"
  local process arg previous path process_dir
  local best=""

  while IFS= read -r process; do
    [[ -r /proc/$process/cmdline ]] || continue
    process_dir="$(readlink -f "/proc/$process/cwd" 2>/dev/null || true)"
    previous=""
    best=""

    while IFS= read -r -d '' arg; do
      case "$previous" in
      --folder-uri | --file-uri)
        path="$(normalize_location "$arg" 2>/dev/null || true)"
        [[ -n $path ]] && best="$path"
        previous=""
        continue
        ;;
      --user-data-dir | --extensions-dir)
        previous=""
        continue
        ;;
      esac

      case "$arg" in
      --folder-uri | --file-uri | --user-data-dir | --extensions-dir)
        previous="$arg"
        ;;
      --folder-uri=* | --file-uri=*)
        path="$(normalize_location "${arg#*=}" 2>/dev/null || true)"
        [[ -n $path ]] && best="$path"
        ;;
      file://*)
        path="$(normalize_location "$arg" 2>/dev/null || true)"
        [[ -n $path ]] && best="$path"
        ;;
      -* | /*.js | /*.mjs)
        ;;
      /*)
        path=""
        [[ -d $arg ]] && path="$(normalize_location "$arg" 2>/dev/null || true)"
        [[ -n $path ]] && best="$path"
        ;;
      . | ./* | .. | ../*)
        path=""
        [[ -d $process_dir/$arg ]] && path="$(normalize_location "$process_dir/$arg" 2>/dev/null || true)"
        [[ -n $path ]] && best="$path"
        ;;
      esac
    done < "/proc/$process/cmdline"

    [[ -n $best ]] && printf '%s\n' "$best" && return 0
  done < <(process_tree "$pid")

  return 1
}

code_location_from_storage() {
  local name="$1"
  local config_dir workspace uri path mtime
  local best=""
  local best_mtime=0

  [[ -n $name ]] || return 1
  for config_dir in \
    "$HOME/.config/Code - OSS" \
    "$HOME/.config/Code" \
    "$HOME/.config/VSCodium" \
    "$HOME/.config/Codium"; do
    [[ -d $config_dir/User/workspaceStorage ]] || continue
    while IFS= read -r workspace; do
      uri="$(jq -r '.folder // empty' "$workspace" 2>/dev/null || true)"
      path="$(normalize_location "$uri" 2>/dev/null || true)"
      [[ -n $path && ${path##*/} == "$name" ]] || continue
      mtime="$(stat -c %Y "$workspace" 2>/dev/null || printf 0)"
      if ((mtime >= best_mtime)); then
        best="$path"
        best_mtime="$mtime"
      fi
    done < <(find "$config_dir/User/workspaceStorage" -mindepth 2 -maxdepth 2 -name workspace.json 2>/dev/null)
  done

  [[ -n $best ]] || return 1
  printf '%s\n' "$best"
}

code_location_from_title() {
  local title="$1"
  local name path

  path="${title% - Code - OSS}"
  path="${path% - Visual Studio Code}"
  path="${path% - VSCodium}"
  path="${path% - Codium}"
  path="${path% - Code}"
  normalize_location "$path" 2>/dev/null && return 0

  name="${path##* - }"
  name="${name#● }"
  name="${name# }"
  name="${name% }"
  case "$name" in
  "" | "Code" | "Code - OSS" | "Visual Studio Code" | "VSCodium" | "Codium") return 1 ;;
  esac

  code_location_from_storage "$name"
}

thunar_location_from_title() {
  local title="$1"
  local path

  path="${title% - Thunar}"
  case "$path" in
  "" | "Home" | "$(basename "$HOME")") path="$HOME" ;;
  "File System") path="/" ;;
  esac
  normalize_location "$path"
}

active_location() {
  local window class title pid location=""

  window="$(hyprctl activewindow -j 2>/dev/null || printf '{}\n')"
  class="$(jq -r '.class // empty' <<< "$window" 2>/dev/null || true)"
  title="$(jq -r '.title // empty' <<< "$window" 2>/dev/null || true)"
  pid="$(jq -r '.pid // empty' <<< "$window" 2>/dev/null || true)"

  case "${class,,}" in
  *thunar*)
    location="$(thunar_location_from_title "$title" 2>/dev/null || process_cwd "$pid" 2>/dev/null || true)"
    ;;
  *code* | *codium*)
    location="$(code_location_from_title "$title" 2>/dev/null || code_location_from_process "$pid" 2>/dev/null || process_cwd "$pid" 2>/dev/null || true)"
    ;;
  *alacritty* | *foot* | *ghostty* | *kitty* | *konsole* | *ptyxis* | *terminal* | *wezterm* | *xterm*)
    location="$(process_cwd "$pid" 2>/dev/null || true)"
    ;;
  esac

  normalize_location "${location:-$HOME}" 2>/dev/null || normalize_location "$HOME"
}

if (($# > 1)); then
  printf 'Usage: qvos-active-location [path]\n' >&2
  exit 2
fi

if (($# == 1)); then
  if ! normalize_location "$1"; then
    printf 'qvos-active-location: not a file or directory: %s\n' "$1" >&2
    exit 1
  fi
else
  active_location
fi
