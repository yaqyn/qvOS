#!/bin/bash
set -euo pipefail

operation=${1:-}
manifest="$OMARCHY_PATH/qv/gaming/xbox-files.psv"
[[ $operation == "check" || $operation == "write" || $operation == "remove" ]] || {
  echo "Usage: qv/gaming/xbox-files <check|write|remove>" >&2
  exit 2
}
(( $# == 1 )) || exit 2

verify_file() {
  local path=$1
  local expected=$2

  [[ ! -e $path && ! -L $path ]] && return 0
  [[ -f $path && ! -L $path && $(<"$path") == "$expected" ]] || {
    echo "Refusing to replace foreign Xbox driver configuration: $path" >&2
    return 1
  }
}

while IFS='|' read -r path expected extra; do
  [[ -n $path && $path != \#* ]] || continue
  [[ $path == /etc/* && -n $expected && -z ${extra:-} ]] || {
    echo "Invalid Xbox driver file manifest entry: $path" >&2
    exit 1
  }
  verify_file "$path" "$expected"
done <"$manifest"

[[ $operation != "check" ]] || exit 0
while IFS='|' read -r path expected extra; do
  [[ -n $path && $path != \#* ]] || continue
  if [[ $operation == "write" ]]; then
    printf '%s\n' "$expected" | sudo tee "$path" >/dev/null
  else
    sudo rm -f -- "$path"
  fi
done <"$manifest"
