#!/bin/bash
set -euo pipefail

# qvos:contract=qv/gaming/xbox-files.psv
defer_reboot=false
case $# in
0) ;;
1)
  [[ $1 == "--defer-reboot" ]] || {
    echo "Usage: omarchy-remove-gaming-xbox-controllers [--defer-reboot]" >&2
    exit 2
  }
  defer_reboot=true
  ;;
*) exit 2 ;;
esac

files_owner="$OMARCHY_PATH/qv/gaming/xbox-files"
"$files_owner" check
omarchy-pkg-drop xpadneo-dkms
"$files_owner" remove

needs_reboot=false
if lsmod | grep -q '^hid_xpadneo '; then
  if sudo modprobe -r hid_xpadneo 2>/dev/null; then
    sudo modprobe xpad 2>/dev/null || needs_reboot=true
  else
    needs_reboot=true
  fi
fi

if [[ $needs_reboot == "true" ]]; then
  if [[ $defer_reboot == "true" ]]; then
    echo "qvOS action: reboot required: Xbox controller driver removal needs a reboot"
  elif gum confirm "Reboot needed to finish removing Xbox controller support. Reboot now?"; then
    omarchy-system-reboot
  fi
fi

echo
echo "qvOS Xbox controller driver support was removed."
