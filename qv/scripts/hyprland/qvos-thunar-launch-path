#!/bin/bash
set -euo pipefail

if (($# != 2)); then
  printf 'Usage: qvos-thunar-launch-path <terminal|editor> <path>\n' >&2
  exit 2
fi

mode="$1"
path="$2"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

case "$mode" in
terminal)
  exec "$script_dir/qvos-launch-terminal-here" terminal "$path"
  ;;
editor)
  exec "$script_dir/qvos-launch-editor-here" "$path"
  ;;
*)
  printf 'Usage: qvos-thunar-launch-path <terminal|editor> <path>\n' >&2
  exit 2
  ;;
esac
