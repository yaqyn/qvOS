#!/bin/bash
set -euo pipefail

if (($# != 1)); then
  printf 'Usage: qvos-thunar-or-here <terminal|editor>\n' >&2
  exit 2
fi

mode="$1"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

case "$mode" in
terminal)
  exec "$script_dir/qvos-launch-terminal-here" terminal
  ;;
editor)
  exec "$script_dir/qvos-launch-editor-here"
  ;;
*)
  printf 'Usage: qvos-thunar-or-here <terminal|editor>\n' >&2
  exit 2
  ;;
esac
