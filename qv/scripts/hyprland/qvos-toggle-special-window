#!/bin/bash
set -euo pipefail

special_workspace="special:scratchpad"
active_window="$(hyprctl activewindow -j)"
window_address="$(jq -r '.address // empty' <<<"$active_window")"
window_workspace="$(jq -r '.workspace.name // empty' <<<"$active_window")"

if [[ -z $window_address || $window_address == "0x0" ]]; then
  notify-send -u low "qvOS" "No focused window to move" >/dev/null 2>&1 || true
  exit 1
fi

if [[ $window_workspace == "special:scratchpad" ]]; then
  target_workspace="$(hyprctl monitors -j | jq -r 'first(.[] | select(.focused == true) | .activeWorkspace.name) // empty')"
  if [[ -z $target_workspace || $target_workspace == special:* ]]; then
    notify-send -u critical "qvOS" "Could not resolve the active workspace" >/dev/null 2>&1 || true
    exit 1
  fi
  hyprctl dispatch movetoworkspace "$target_workspace"
else
  hyprctl dispatch movetoworkspacesilent "$special_workspace"
fi
