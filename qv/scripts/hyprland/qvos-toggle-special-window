#!/bin/bash
set -euo pipefail

special_workspace="special:scratchpad"
special_workspace_name="scratchpad"
active_window="$(hyprctl activewindow -j)"
window_address="$(jq -r '.address // empty' <<<"$active_window")"
window_workspace="$(jq -r '.workspace.name // empty' <<<"$active_window")"

if [[ -z $window_address || $window_address == "0x0" ]]; then
  notify-send -u low "qvOS" "No focused window to move" >/dev/null 2>&1 || true
  exit 1
fi

monitors="$(hyprctl monitors -j)"
special_workspace_visible="$(jq -r --arg workspace "$special_workspace" 'any(.[]; .specialWorkspace.name == $workspace)' <<<"$monitors")"

focus_window() {
  hyprctl dispatch focuswindow "address:$window_address"
}

if [[ $window_workspace == "$special_workspace" ]]; then
  target_workspace="$(jq -r 'first(.[] | select(.focused == true) | .activeWorkspace.name) // empty' <<<"$monitors")"
  if [[ -z $target_workspace || $target_workspace == special:* ]]; then
    notify-send -u critical "qvOS" "Could not resolve the active workspace" >/dev/null 2>&1 || true
    exit 1
  fi

  hyprctl dispatch movetoworkspacesilent "$target_workspace,address:$window_address"
  if [[ $special_workspace_visible == "true" ]]; then
    hyprctl dispatch togglespecialworkspace "$special_workspace_name"
  fi
  focus_window
else
  hyprctl dispatch movetoworkspacesilent "$special_workspace,address:$window_address"
  if [[ $special_workspace_visible == "false" ]]; then
    hyprctl dispatch togglespecialworkspace "$special_workspace_name"
  fi
  focus_window
fi
