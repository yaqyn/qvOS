#!/bin/bash
set -euo pipefail

qvcore_warp_state="$HOME/.local/state/qvos/qvcore/warp"

reload_dns() {
  # Reload matching network files without tearing down every connection.
  sudo networkctl reload
  sudo systemctl restart systemd-resolved
}

lock_dns_to_resolved() {
  for file in /etc/systemd/network/*.network; do
    [[ -f $file ]] || continue
    if ! grep -q "^\[DHCPv4\]" "$file"; then continue; fi

    if ! sed -n '/^\[DHCPv4\]/,/^\[/p' "$file" | grep -q "^UseDNS="; then
      sudo sed -i '/^\[DHCPv4\]/a UseDNS=no' "$file"
    fi

    if grep -q "^\[IPv6AcceptRA\]" "$file" &&
      ! sed -n '/^\[IPv6AcceptRA\]/,/^\[/p' "$file" |
      grep -q "^UseDNS="; then
      sudo sed -i '/^\[IPv6AcceptRA\]/a UseDNS=no' "$file"
    fi
  done
}

unlock_dns_to_dhcp() {
  for file in /etc/systemd/network/*.network; do
    [[ -f $file ]] || continue
    sudo sed -i '/^\[DHCPv4\]/{n;/^UseDNS=no$/d}' "$file"
    sudo sed -i '/^\[IPv6AcceptRA\]/{n;/^UseDNS=no$/d}' "$file"
  done
}

set_dns_to_dhcp() {
  sudo tee /etc/systemd/resolved.conf >/dev/null <<'EOF'
[Resolve]
FallbackDNS=
EOF
  unlock_dns_to_dhcp
}

deactivate_warp() {
  if omarchy-cmd-missing warp-cli; then
    rm -f "$qvcore_warp_state"
    return
  fi

  if systemctl is-active --quiet warp-svc.service; then
    warp-cli disconnect || true
  fi

  sudo systemctl disable --now warp-svc.service
  rm -f "$qvcore_warp_state"
}

ensure_warp_registration() {
  if warp-cli --json registration show </dev/null &>/dev/null; then
    return
  fi

  echo "Cloudflare WARP requires accepting its Terms of Service and Privacy Policy:"
  echo "- https://www.cloudflare.com/application/terms/"
  echo "- https://www.cloudflare.com/application/privacypolicy/"
  gum confirm "Accept Cloudflare WARP terms and register this device?" ||
    return 1

  if warp-cli --accept-tos --json registration show </dev/null &>/dev/null; then
    return
  fi

  echo "Registering this device with Cloudflare WARP..."
  warp-cli --accept-tos registration new >/dev/null
}

activate_warp() {
  if omarchy-cmd-missing warp-cli; then
    echo "Installing Cloudflare WARP..."
    omarchy-pkg-aur-add cloudflare-warp-nox-bin || return 1
  fi

  sudo systemctl enable --now warp-svc.service || return 1

  if ! ensure_warp_registration; then
    sudo systemctl disable --now warp-svc.service
    return 1
  fi

  warp-cli mode warp || return 1
  set_dns_to_dhcp
  reload_dns
  warp-cli connect || return 1
  warp-cli status
  install -D -m 0644 /dev/null "$qvcore_warp_state"
}

if [[ -z ${1:-} ]]; then
  dns=$(
    gum choose --height 7 --header "Select WARP or DNS provider" \
      WARP Cloudflare Quad9 None Custom
  )
else
  dns=$1
fi

case $dns in
WARP | Cloudflare | Quad9 | None | DHCP | Custom) ;;
*)
  echo "Error: Unknown DNS provider '$dns'." >&2
  exit 2
  ;;
esac

if [[ $dns == "Custom" ]]; then
  echo "Enter your DNS servers (space-separated, e.g. '192.168.1.1 1.1.1.1'):"
  read -r dns_servers

  if [[ -z $dns_servers ]]; then
    echo "Error: No DNS servers provided."
    exit 1
  fi
fi

if [[ $dns == "WARP" ]]; then
  activate_warp
  exit $?
fi

deactivate_warp

case $dns in
Cloudflare)
  sudo tee /etc/systemd/resolved.conf >/dev/null <<'EOF'
[Resolve]
DNS=1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com 2606:4700:4700::1111#cloudflare-dns.com 2606:4700:4700::1001#cloudflare-dns.com
FallbackDNS=9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net
DNSOverTLS=opportunistic
EOF
  lock_dns_to_resolved
  ;;
Quad9)
  sudo tee /etc/systemd/resolved.conf >/dev/null <<'EOF'
[Resolve]
DNS=9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net
FallbackDNS=9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net
DNSOverTLS=opportunistic
EOF
  lock_dns_to_resolved
  ;;
None | DHCP)
  set_dns_to_dhcp
  ;;
Custom)
  sudo tee /etc/systemd/resolved.conf >/dev/null <<EOF
[Resolve]
DNS=$dns_servers
FallbackDNS=9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net 2620:fe::fe#dns.quad9.net 2620:fe::9#dns.quad9.net
EOF
  lock_dns_to_resolved
  ;;
esac

reload_dns
