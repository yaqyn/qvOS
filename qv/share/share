#!/bin/bash
set -euo pipefail

clipboard_temp=""

cleanup() {
  if [[ -n $clipboard_temp && -f $clipboard_temp ]]; then
    rm -f "$clipboard_temp"
  fi
}
trap cleanup EXIT

if omarchy-cmd-missing localsend; then
  echo "LocalSend is not installed"
  exit 1
fi

if (($# == 0)); then
  echo "Usage: omarchy-qvos-share [clipboard|file|folder]"
  exit 1
fi

mode=$1
shift
files=()

case $mode in
--send-clipboard-temp)
  (($# >= 1)) || exit 2
  clipboard_candidate=$1
  shift
  expected_prefix="${TMPDIR:-/tmp}/qvos-share-clipboard."

  if [[ $clipboard_candidate != "$expected_prefix"* ]] ||
    [[ ! -f $clipboard_candidate ]] ||
    [[ ! -O $clipboard_candidate ]] ||
    [[ $(stat -c '%a' "$clipboard_candidate") != "600" ]]; then
    echo "Refusing unsafe LocalSend clipboard cleanup path." >&2
    exit 1
  fi

  clipboard_temp=$clipboard_candidate
  localsend --headless send "$clipboard_temp"
  exit
  ;;
clipboard)
  clipboard_temp=$(mktemp "${TMPDIR:-/tmp}/qvos-share-clipboard.XXXXXX.txt")
  wl-paste >"$clipboard_temp"
  files=("$clipboard_temp")
  ;;
file | folder)
  if (($# > 0)); then
    files=("$@")
  elif [[ $mode == "folder" ]]; then
    selection=$(find "$HOME" -type d 2>/dev/null | fzf) || exit $?
    [[ -n $selection ]] || exit 0
    files=("$selection")
  else
    mapfile -t files < <(find "$HOME" -type f 2>/dev/null | fzf --multi)
    ((${#files[@]} > 0)) || exit 0
  fi
  ;;
*)
  echo "Usage: omarchy-qvos-share [clipboard|file|folder]" >&2
  exit 1
  ;;
esac

if [[ $mode == "clipboard" ]]; then
  systemd-run --user --quiet --collect \
    "$0" --send-clipboard-temp "$clipboard_temp"
  clipboard_temp=""
else
  systemd-run --user --quiet --collect \
    localsend --headless send "${files[@]}"
fi
