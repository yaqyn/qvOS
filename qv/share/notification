#!/bin/bash
set -euo pipefail

mode=${1:-}
path=${2:-}

if [[ -z $mode || -z $path || ! -f $path ]]; then
  echo "Usage: notification <screenshot|recording|transcode> <file> [detail...]" >&2
  exit 2
fi

add_share_action() {
  omarchy-cmd-present localsend && printf '%s\n' -A "share=Share"
}

share_file() {
  omarchy-menu-share file "$path"
}

case $mode in
screenshot)
  editor=${3:-satty}
  notification_args=(
    "Screenshot saved to clipboard and file"
    "Edit with Super + Alt + , (or choose an action)"
    -t 10000
    -i "$path"
    -A "default=Edit"
  )
  mapfile -t share_action < <(add_share_action)
  notification_args+=("${share_action[@]}")
  action=$(notify-send "${notification_args[@]}")
  case $action in
  default)
    if [[ $editor == "satty" ]]; then
      satty --filename "$path" \
        --output-filename "$path" \
        --actions-on-enter save-to-clipboard \
        --save-after-copy \
        --copy-command wl-copy
    else
      "$editor" "$path"
    fi
    ;;
  share) share_file ;;
  esac
  ;;
recording)
  preview=${3:-$path}
  notification_args=(
    "Screen recording saved"
    "Open with Super + Alt + , (or choose an action)"
    -t 10000
    -i "$preview"
    -A "default=Open"
  )
  mapfile -t share_action < <(add_share_action)
  notification_args+=("${share_action[@]}")
  action=$(notify-send "${notification_args[@]}")
  case $action in
  default) mpv "$path" ;;
  share) share_file ;;
  esac
  [[ $preview == "$path" ]] || rm -f -- "$preview"
  ;;
transcode)
  glyph=${3:-""}
  headline=${4:-"Transcode complete"}
  notification_args=("$glyph" "$headline" "Saved and copied to clipboard.")
  mapfile -t share_action < <(add_share_action)
  notification_args+=("${share_action[@]}")
  action=$(omarchy-notification-send "${notification_args[@]}")
  [[ $action == "share" ]] && share_file
  ;;
*)
  echo "Unknown qvOS share notification mode: $mode" >&2
  exit 2
  ;;
esac
