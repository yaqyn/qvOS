#!/bin/bash
set -euo pipefail

theme_name="qv-Papirus-Dark"
theme_dir="$HOME/.local/share/icons/$theme_name"
theme_parent=${theme_dir%/*}
source_theme="/usr/share/icons/Papirus"
sizes=(16 22 24 32 48 64)
staging_dir=""
backup_dir=""

cleanup() {
  [[ -z $staging_dir ]] || rm -rf -- "$staging_dir"
  [[ -z $backup_dir ]] || rm -rf -- "$backup_dir"
}
trap cleanup EXIT

if [[ ! -d $source_theme ]]; then
  echo "Papirus icon theme not found; skipping qv icon overlay"
  exit 0
fi

install -d "$theme_parent"
staging_dir=$(mktemp -d "$theme_parent/.qv-papirus.XXXXXX")

directories=""
for size in "${sizes[@]}"; do
  directory="${size}x${size}/places"
  mkdir -p "$staging_dir/$directory"

  if [[ -n $directories ]]; then
    directories="$directories,$directory"
  else
    directories="$directory"
  fi
done

{
  echo "[Icon Theme]"
  echo "Name=$theme_name"
  echo "Comment=qvOS Papirus-Dark with black folders"
  echo "Inherits=Papirus-Dark,hicolor"
  echo "Example=folder"
  echo "Directories=$directories"
  echo

  for size in "${sizes[@]}"; do
    directory="${size}x${size}/places"
    echo "[$directory]"
    echo "Context=Places"
    echo "Size=$size"
    echo "Type=Fixed"
    echo
  done
} >"$staging_dir/index.theme"

for size in "${sizes[@]}"; do
  source_dir="$source_theme/${size}x${size}/places"
  target_dir="$staging_dir/${size}x${size}/places"

  [[ -d $source_dir ]] || continue

  while IFS= read -r -d '' source_icon; do
    icon_file=$(basename "$source_icon")
    target_icon="folder${icon_file#folder-black}"

    ln -snf "$source_icon" "$target_dir/$target_icon"
  done < <(find "$source_dir" -maxdepth 1 -type f -name "folder-black*.svg" -print0)
done

gtk-update-icon-cache "$staging_dir" >/dev/null 2>&1 || true

if [[ -e $theme_dir || -L $theme_dir ]]; then
  backup_dir=$(mktemp -d "$theme_parent/.qv-papirus-backup.XXXXXX")
  rmdir "$backup_dir"
  mv -- "$theme_dir" "$backup_dir"
fi
if ! mv -- "$staging_dir" "$theme_dir"; then
  [[ -z $backup_dir ]] || mv -- "$backup_dir" "$theme_dir"
  exit 1
fi
staging_dir=""
[[ -z $backup_dir ]] || rm -rf -- "$backup_dir"
backup_dir=""

gsettings set org.gnome.desktop.interface icon-theme "$theme_name"
