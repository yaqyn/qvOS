# shellcheck shell=bash

# Install qvOS-owned desktop helpers after Omarchy config.
(
  set -euo pipefail

  desktop_mode=${QVOS_DESKTOP_MODE:-install}
  case $desktop_mode in
  install | repair | reset) ;;
  *)
    echo "Unknown qvOS desktop install mode: $desktop_mode" >&2
    exit 2
    ;;
  esac

  mkdir -p "$HOME/.local/share/qvos"

  for feature in desktop maintenance power screensaver shell thunar tmux waybar; do
    feature_source="$OMARCHY_PATH/qv/$feature"
    if [[ ! -d $feature_source ]]; then
      echo "Missing qvOS desktop feature source: $feature_source" >&2
      exit 1
    fi
  done

  required_sources=(
    qv/desktop/context/qvos-active-location
    qv/desktop/context/qvos-launch-editor-here
    qv/desktop/context/qvos-launch-terminal-here
    qv/desktop/hyprland/qvos-toggle-special-window
    qv/desktop/open
    qv/desktop/web/qvos-localhost-open
    qv/desktop/web/qvos-website-open
    qv/core/post-update-hook
    qv/core/software-removal-groups
    qv/install/desktop-status
    qv/install/post-update-hook
    qv/launcher/install
    qv/launcher/elephant/omarchy_background_selector.lua
    qv/launcher/elephant/omarchy_themes.lua
    qv/launcher/elephant/omarchy_unlocks.lua
    qv/maintenance/essential-packages
    qv/maintenance/personal-software
    qv/maintenance/personal-software-baseline
    qv/maintenance/protected-user-bin
    qv/maintenance/qv
    qv/maintenance/qvos-repair
    qv/maintenance/qvos-system
    qv/menu/concepts.psv
    qv/menu/elephant/qvos_omarchy_menu.lua
    qv/menu/extension.sh
    qv/menu/install
    qv/menu/wait-for-elephant
    qv/menu/walker-elephant-ready.conf
    qv/menu/walker-provider-set.toml
    qv/menu/walker-subtext.css
    qv/power/inhibit-sleep
    qv/power/suspend-if-safe
    qv/screensaver/alacritty.toml
    qv/screensaver/omarchy-launch-screensaver
    qv/screensaver/qvos-launch-screensaver
    qv/screensaver/qvos-screensaver
    qv/shell/aliases
    qv/shell/install
    qv/shell/status
    qv/thunar/actions.sh
    qv/thunar/codex
    qv/thunar/launch
    qv/thunar/open-here
    qv/thunar/proton-drive-upload
    qv/thunar/reconcile-default-actions
    qv/thunar/set-background
    qv/thunar/share
    qv/thunar/transcode
    qv/tmux/qvos-tmux
    qv/waybar/clock.sh
    qv/waybar/overrides.jsonc
    qv/waybar/post-update-hook
    qv/waybar/prayer-data.sh
    qv/waybar/prayerbar.sh
    qv/waybar/refresh
  )
  for source_path in "${required_sources[@]}"; do
    if [[ ! -f $OMARCHY_PATH/$source_path ]]; then
      echo "Missing qvOS desktop feature file: $OMARCHY_PATH/$source_path" >&2
      exit 1
    fi
  done

  for feature in desktop tmux waybar; do
    feature_source="$OMARCHY_PATH/qv/$feature"
    feature_runtime="$HOME/.local/share/qvos/$feature"

    rm -rf -- "$feature_runtime"
    cp -a "$feature_source" "$feature_runtime"
  done

  thunar_source="$OMARCHY_PATH/qv/thunar"
  thunar_runtime="$HOME/.local/share/qvos/thunar"
  rm -rf -- "$thunar_runtime"
  install -d "$thunar_runtime"
  for feature in \
    actions.sh \
    launch \
    open-here \
    reconcile-default-actions \
    set-background \
    transcode; do
    cp -a "$thunar_source/$feature" "$thunar_runtime/$feature"
  done

  declare -A optional_thunar_helpers=(
    [codex]=codex
    [proton]=proton-drive-upload
    [share]=share
  )
  qvcore_state="$HOME/.local/state/qvos/qvcore"
  for component in "${!optional_thunar_helpers[@]}"; do
    [[ -f $qvcore_state/$component ]] || continue
    feature=${optional_thunar_helpers[$component]}
    install -m 0755 "$thunar_source/$feature" "$thunar_runtime/$feature"
  done

  "$OMARCHY_PATH/qv/launcher/install"
  "$OMARCHY_PATH/qv/menu/install" --repair

  install -D -m 0644 \
    "$OMARCHY_PATH/qv/install/post-update-hook" \
    "$HOME/.config/omarchy/hooks/post-update.d/qvos-base"
  install -D -m 0644 \
    "$OMARCHY_PATH/qv/core/post-update-hook" \
    "$HOME/.config/omarchy/hooks/post-update.d/qvos-qvcore"
  install -D -m 0644 \
    "$OMARCHY_PATH/qv/waybar/post-update-hook" \
    "$HOME/.config/omarchy/hooks/post-update.d/qvos-waybar-overrides"
  if [[ $desktop_mode == "repair" || $desktop_mode == "reset" ]]; then
    "$OMARCHY_PATH/qv/waybar/refresh" "--$desktop_mode"
  else
    QVOS_WAYBAR_SKIP_RESTART=1 \
      "$OMARCHY_PATH/qv/waybar/refresh" --reset
  fi

  if ! "$HOME/.local/share/qvos/thunar/reconcile-default-actions"; then
    echo "qvOS preserved the current Thunar actions because they could not be reconciled." >&2
  fi

  screensaver_source="$OMARCHY_PATH/qv/screensaver"
  qvos_bin="$HOME/.local/share/qvos/bin"
  qvos_maintenance="$HOME/.local/share/qvos/maintenance"
  qvos_screensaver="$HOME/.local/share/qvos/screensaver"
  local_bin="$HOME/.local/bin"

  rm -rf -- "$qvos_screensaver"
  install -d "$qvos_bin" "$qvos_maintenance" "$qvos_screensaver" "$local_bin"
  install -m 0644 \
    "$OMARCHY_PATH/qv/maintenance/essential-packages" \
    "$qvos_maintenance/essential-packages.tmp.$$"
  mv -f -- \
    "$qvos_maintenance/essential-packages.tmp.$$" \
    "$qvos_maintenance/essential-packages"
  install -m 0755 \
    "$OMARCHY_PATH/qv/maintenance/qvos-repair" \
    "$qvos_maintenance/qvos-repair.tmp.$$"
  mv -f -- \
    "$qvos_maintenance/qvos-repair.tmp.$$" \
    "$qvos_maintenance/qvos-repair"
  install -m 0755 \
    "$OMARCHY_PATH/qv/maintenance/qvos-system" \
    "$qvos_maintenance/qvos-system.tmp.$$"
  mv -f -- \
    "$qvos_maintenance/qvos-system.tmp.$$" \
    "$qvos_maintenance/qvos-system"
  install -m 0755 \
    "$OMARCHY_PATH/qv/maintenance/qv" \
    "$local_bin/qv.tmp.$$"
  mv -f -- "$local_bin/qv.tmp.$$" "$local_bin/qv"
  "$OMARCHY_PATH/qv/shell/install"
  for command_name in omarchy-system-inhibit-sleep omarchy-system-suspend-if-safe; do
    power_owner=${command_name#omarchy-system-}
    install -m 0755 "$OMARCHY_PATH/qv/power/$power_owner" "$qvos_bin/$command_name"
  done
  install -m 0644 "$screensaver_source/alacritty.toml" "$qvos_screensaver/alacritty.toml"
  for command_name in omarchy-launch-screensaver qvos-launch-screensaver qvos-screensaver; do
    install -m 0755 "$screensaver_source/$command_name" "$qvos_bin/$command_name"
    ln -sfn "$qvos_bin/$command_name" "$local_bin/$command_name"
  done
)
