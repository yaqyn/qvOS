# shellcheck shell=bash

# Install qvOS-owned desktop helpers after Omarchy config.
(
  set -euo pipefail

  mkdir -p "$HOME/.local/share/qvos"

  for feature in desktop direct power screensaver security shell thunar tmux tui waybar windows; do
    feature_source="$OMARCHY_PATH/qv/$feature"
    if [[ ! -d $feature_source ]]; then
      echo "Missing qvOS desktop feature source: $feature_source" >&2
      exit 1
    fi
  done

  required_sources=(
    qv/desktop/context/qvos-active-location
    qv/desktop/context/qvos-launch-editor-here
    qv/desktop/context/qvos-launch-terminal-here
    qv/desktop/hyprland/qvos-toggle-special-window
    qv/desktop/open
    qv/desktop/web/qvos-localhost-open
    qv/desktop/web/qvos-website-open
    qv/direct/manifest.tsv
    qv/direct/post-update-hook
    qv/direct/tool
    qv/direct/update
    qv/install/cleanup-obsolete
    qv/install/post-update-hook
    qv/menu/concepts.psv
    qv/menu/elephant/omarchy_unlocks.lua
    qv/menu/elephant/qvos_omarchy_menu.lua
    qv/menu/extension.sh
    qv/menu/font-install
    qv/menu/install
    qv/menu/search-intents.psv
    qv/menu/software-actions.psv
    qv/menu/software-install
    qv/menu/software-installer-state
    qv/menu/software-installers.psv
    qv/menu/software-state
    qv/menu/steam-remove
    qv/menu/terminal-action
    qv/menu/wait-for-elephant
    qv/menu/walker-elephant-ready.conf
    qv/menu/walker-provider-set.toml
    qv/menu/walker-subtext.css
    qv/power/inhibit-sleep
    qv/power/battery-protection
    qv/power/battery-protection-backend
    qv/power/battery-protection-hwdb
    qv/power/battery-protection-lib
    qv/power/install
    qv/power/qvos-battery-full-charge-once.service
    qv/power/suspend-if-safe
    qv/screensaver/alacritty.toml
    qv/screensaver/install
    qv/screensaver/omarchy-launch-screensaver
    qv/screensaver/qvos-launch-screensaver
    qv/screensaver/qvos-screensaver
    qv/security/60-qvos-security.conf
    qv/security/boot-mount
    qv/security/dev-share
    qv/security/dev-share-firewall
    qv/security/install
    qv/shell/aliases
    qv/shell/install
    qv/thunar/actions.sh
    qv/thunar/codex
    qv/thunar/launch
    qv/thunar/open-here
    qv/thunar/proton-drive-upload
    qv/thunar/reconcile-default-actions
    qv/thunar/set-background
    qv/thunar/share
    qv/thunar/transcode
    qv/tui/install
    qv/tui/launch
    qv/tui/owner-resolver
    qv/tui/selection-owner
    qv/tui/action/choices.psv
    qv/tui/action/forms.psv
    qv/tui/action/font-launch
    qv/tui/action/font-run
    qv/tui/action/launch
    qv/tui/action/post-actions.psv
    qv/tui/action/post-run
    qv/tui/action/run
    qv/tui/action/run-installer
    qv/tui/action/rollback-owner
    qv/tui/action/terminal-launch
    qv/tui/action/terminal-run
    qv/tui/success-guidance.psv
    qv/tui/task/actions.psv
    qv/tui/task/launch
    qv/tui/task/run
    qv/tui/task/selectable-owner
    qv/tui/task/selections.psv
    qv/tui/update/launch
    qv/tui/update/run
    qv/update/reboot-request
    qv/windows/manage
    qv/windows/launch
    qv/tmux/qvos-tmux
    qv/waybar/clock.sh
    qv/waybar/overrides.jsonc
    qv/waybar/post-update-hook
    qv/waybar/prayer-data.sh
    qv/waybar/prayerbar.sh
    qv/waybar/refresh
  )
  for source_path in "${required_sources[@]}"; do
    if [[ ! -f $OMARCHY_PATH/$source_path ]]; then
      echo "Missing qvOS desktop feature file: $OMARCHY_PATH/$source_path" >&2
      exit 1
    fi
  done

  "$OMARCHY_PATH/qv/install/cleanup-obsolete"

  for feature in desktop direct tmux waybar windows; do
    feature_source="$OMARCHY_PATH/qv/$feature"
    feature_runtime="$HOME/.local/share/qvos/$feature"

    rm -rf -- "$feature_runtime"
    cp -a "$feature_source" "$feature_runtime"
  done

  thunar_source="$OMARCHY_PATH/qv/thunar"
  thunar_runtime="$HOME/.local/share/qvos/thunar"
  preserved_thunar=$(mktemp -d)
  for feature in codex proton-drive-upload; do
    [[ -e $thunar_runtime/$feature ]] || continue
    cp -a "$thunar_runtime/$feature" "$preserved_thunar/$feature"
  done
  rm -rf -- "$thunar_runtime"
  install -d "$thunar_runtime"
  for feature in \
    actions.sh \
    launch \
    open-here \
    reconcile-default-actions \
    set-background \
    share \
    transcode; do
    cp -a "$thunar_source/$feature" "$thunar_runtime/$feature"
  done
  cp -a "$preserved_thunar/." "$thunar_runtime/"
  rm -rf -- "$preserved_thunar"

  "$OMARCHY_PATH/qv/menu/install" --install

  install -D -m 0644 \
    "$OMARCHY_PATH/qv/install/post-update-hook" \
    "$HOME/.config/omarchy/hooks/post-update.d/qvos-base"
  install -D -m 0644 \
    "$OMARCHY_PATH/qv/direct/post-update-hook" \
    "$HOME/.config/omarchy/hooks/post-update.d/qvos-direct-tools"
  install -D -m 0644 \
    "$OMARCHY_PATH/qv/waybar/post-update-hook" \
    "$HOME/.config/omarchy/hooks/post-update.d/qvos-waybar-overrides"
  QVOS_WAYBAR_SKIP_RESTART=1 \
    "$OMARCHY_PATH/qv/waybar/refresh" --reset

  if ! "$HOME/.local/share/qvos/thunar/reconcile-default-actions"; then
    echo "qvOS preserved the current Thunar actions because they could not be reconciled." >&2
  fi

  "$OMARCHY_PATH/qv/tui/install" --build-if-available
  "$OMARCHY_PATH/qv/shell/install"
  "$OMARCHY_PATH/qv/screensaver/install"
  "$OMARCHY_PATH/qv/power/install"
  "$OMARCHY_PATH/qv/security/install"
)
