# shellcheck shell=bash

(
  set -euo pipefail

  config_source="$OMARCHY_PATH/qv/config/files"
  monitor_owner="$OMARCHY_PATH/qv/config/monitor-autodetect"
  yaqyn_source="$OMARCHY_PATH/qv/theme/yaqyn"

  for source_path in \
    "$config_source" \
    "$monitor_owner" \
    "$yaqyn_source" \
    "$OMARCHY_PATH/qv/shell/install"; do
    if [[ ! -e $source_path ]]; then
      echo "Missing qvOS configuration source: $source_path" >&2
      exit 1
    fi
  done

  mkdir -p "$HOME/.config"
  cp -a "$config_source/." "$HOME/.config/"
  install -D -m 0644 \
    "$OMARCHY_PATH/qv/branding/icon.txt" \
    "$HOME/.config/omarchy/branding/about.txt"
  install -D -m 0644 \
    "$OMARCHY_PATH/qv/branding/logo.txt" \
    "$HOME/.config/omarchy/branding/screensaver.txt"

  "$OMARCHY_PATH/qv/theme/install"

  # shellcheck source=qv/install/config/mimetypes
  source "$OMARCHY_PATH/qv/install/config/mimetypes"
  # shellcheck source=qv/install/config/theme
  source "$OMARCHY_PATH/qv/install/config/theme"
  # shellcheck source=qv/install/desktop
  source "$OMARCHY_PATH/qv/install/desktop"
)
