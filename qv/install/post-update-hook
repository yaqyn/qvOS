#!/bin/bash
set -euo pipefail

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
yaqyn_target="$HOME/.config/omarchy/themes/yaqyn"
config_source="$OMARCHY_PATH/qv/config/files"

# shellcheck source=qv/install/desktop
source "$OMARCHY_PATH/qv/install/desktop"

while IFS= read -r -d '' source_file; do
  config_path=${source_file#"$config_source/"}
  target_file="$HOME/.config/$config_path"
  if [[ ! -e $target_file && ! -L $target_file ]]; then
    install -D -m "$(stat -c '%a' "$source_file")" \
      "$source_file" "$target_file"
  fi
done < <(find "$config_source" -type f -print0 | sort -z)

declare -A branding_sources=(
  ["$HOME/.config/omarchy/branding/about.txt"]="$OMARCHY_PATH/qv/branding/icon.txt"
  ["$HOME/.config/omarchy/branding/screensaver.txt"]="$OMARCHY_PATH/qv/branding/logo.txt"
)
for target_file in "${!branding_sources[@]}"; do
  if [[ ! -e $target_file ]]; then
    install -D -m 0644 "${branding_sources[$target_file]}" "$target_file"
  fi
done

if [[ ! -e $yaqyn_target || -L $yaqyn_target ]]; then
  "$OMARCHY_PATH/qv/theme/install"
fi

hyprland_config="$HOME/.config/hypr/hyprland.conf"
qv_source='source = ~/.config/hypr/qv.conf'
if [[ -f $hyprland_config ]] &&
  ! grep -Fqx "$qv_source" "$hyprland_config"; then
  cp -a "$hyprland_config" "$hyprland_config.bak.$(date +%s)"
  printf '\n%s\n' "$qv_source" >>"$hyprland_config"
fi
