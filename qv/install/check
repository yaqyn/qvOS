#!/bin/bash
set -euo pipefail

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)"
manifest="$root/qv/install/native-paths"
retired_manifest="$root/qv/install/retired-paths"

fail() {
  printf 'not ok - %s\n' "$1" >&2
  exit 1
}

[[ -x $root/qv/install/reinstall-source ]] || fail "source reinstall owner mode"
[[ -x $root/qv/install/cleanup-obsolete ]] || fail "obsolete-state cleanup owner mode"
[[ -x $root/qv/install/post-install/finished ]] ||
  fail "post-install presentation owner mode"
for first_run_owner in prepare root run gnome-theme icons; do
  [[ -x $root/qv/install/first-run/$first_run_owner ]] ||
    fail "first-run owner mode: $first_run_owner"
done
for packaging_owner in npx webapps; do
  [[ -x $root/qv/install/packaging/$packaging_owner ]] ||
    fail "packaging owner mode: $packaging_owner"
done
[[ ! -e $root/qv/install/first-run/apply ]] ||
  fail "first-run overlay remains"
[[ ! -e $root/qv/install/helpers/logging ]] || fail "duplicate install logger remains"
[[ ! -e $root/qv/install/helpers/presentation ]] ||
  fail "duplicate install presentation remains"
[[ -f $root/qv/install/helpers/run && ! -x $root/qv/install/helpers/run ]] ||
  fail "native install helper stage mode"
[[ -f $root/qv/install/helpers/errors && ! -x $root/qv/install/helpers/errors ]] ||
  fail "native installer error owner mode"
[[ ! -e $root/qv/install/helpers/error-title ]] ||
  fail "duplicate installer error title remains"
[[ ! -e $root/install/helpers/all.sh && ! -e $root/install/helpers/errors.sh ]] ||
  fail "inherited install helper orchestration remains"
expected_helper_stage=$'# shellcheck shell=bash\n# shellcheck disable=SC1091\n\nsource "$OMARCHY_INSTALL/helpers/chroot.sh"\nsource "$OMARCHY_INSTALL/helpers/presentation.sh"\nsource "$OMARCHY_PATH/qv/install/helpers/errors"\nsource "$OMARCHY_INSTALL/helpers/logging.sh"'
[[ $(<"$root/qv/install/helpers/run") == "$expected_helper_stage" ]] ||
  fail "native install helper stage order"
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest") == $(
  sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$manifest" | sort -u
) ]] || fail "native install paths are not sorted and unique"
[[ $(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest") == $(
  sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$retired_manifest" | sort -u
) ]] || fail "retired install paths are not sorted and unique"
# shellcheck disable=SC2016
grep -Fqx 'exec "$OMARCHY_PATH/qv/install/reinstall-source" "$@"' \
  "$root/bin/omarchy-reinstall-git" || fail "source reinstall adapter"
if rg -n 'basecamp/omarchy|branch master|rm -rf .*local/share/omarchy' \
  "$root/bin/omarchy-reinstall-git" "$root/qv/install/reinstall-source" "$root/boot.sh"; then
  fail "destructive or inherited qvOS source installation remains"
fi
grep -Fq 'https://github.com/Yaqyn-qvOS/qvOS.git' \
  "$root/qv/install/reinstall-source" || fail "official reinstall source"
grep -Fq 'qv/install/packaging/resolve' "$root/bin/omarchy-reinstall-pkgs" ||
  fail "native package resolver"
grep -Fq 'omarchy-refresh-hyprland' "$root/bin/omarchy-reinstall-configs" ||
  fail "config reset reconciliation"
# shellcheck disable=SC2016
grep -Fqx 'source "$OMARCHY_PATH/qv/install/post-install/run"' \
  "$root/install.sh" || fail "native post-install owner wiring"
# shellcheck disable=SC2016
grep -Fqx 'source "$OMARCHY_PATH/qv/install/helpers/run"' \
  "$root/install.sh" || fail "native install helper owner wiring"
# shellcheck disable=SC2016
grep -Fqx 'source "$OMARCHY_PATH/qv/install/config/run"' \
  "$root/install.sh" || fail "native install configuration owner wiring"
# shellcheck disable=SC2016
grep -Fqx 'source "$OMARCHY_PATH/qv/boot/install"' \
  "$root/install.sh" || fail "native boot install owner wiring"
[[ -f $root/qv/install/config/run && ! -x $root/qv/install/config/run ]] ||
  fail "native install configuration owner mode"
[[ ! -e $root/install/config/all.sh ]] ||
  fail "inherited install configuration orchestration remains"
# shellcheck disable=SC2016
grep -Fqx 'run_logged "$OMARCHY_PATH/qv/install/configure"' \
  "$root/qv/install/config/run" ||
  fail "native install configuration stage omits qvOS configuration"
[[ ! -e $root/install/post-install/all.sh ]] ||
  fail "inherited post-install orchestration remains"
[[ ! -e $root/install/post-install/finished.sh ]] ||
  fail "inherited post-install presentation remains"
# shellcheck disable=SC2016
grep -Fqx 'exec "$OMARCHY_PATH/qv/install/first-run/run" "$@"' \
  "$root/bin/omarchy-first-run" || fail "native first-run adapter"
# shellcheck disable=SC2016
grep -Fqx 'run_logged "$OMARCHY_PATH/qv/install/first-run/prepare"' \
  "$root/install/preflight/all.sh" || fail "native first-run preparation"
if rg -n 'NOPASSWD: /(usr/)?bin/(systemctl|ufw|ufw-docker|gtk-update-icon-cache|rm)' \
  "$root/qv/install" "$root/install/preflight"; then
  fail "broad passwordless first-run command remains"
fi
# shellcheck disable=SC2016
grep -Fqx 'run_logged "$OMARCHY_PATH/qv/install/packaging/webapps"' \
  "$root/install/packaging/all.sh" || fail "native webapps stage wiring"
# shellcheck disable=SC2016
grep -Fqx 'run_logged "$OMARCHY_PATH/qv/install/packaging/npx"' \
  "$root/install/packaging/all.sh" || fail "native npx stage wiring"
# shellcheck disable=SC2016
grep -Fqx '"$OMARCHY_PATH/qv/install/packaging/webapps"' \
  "$root/bin/omarchy-refresh-applications" ||
  fail "native webapps refresh wiring"
# shellcheck disable=SC2016
grep -Fqx '"$OMARCHY_PATH/qv/install/packaging/npx"' \
  "$root/bin/omarchy-refresh-applications" || fail "native npx refresh wiring"
[[ ! -e $root/install/packaging/npx.sh &&
  ! -e $root/install/packaging/webapps.sh ]] ||
  fail "inherited npx or webapps packaging remains"

printf 'ok - qvOS install and reinstall lifecycles preserve source safely\n'
