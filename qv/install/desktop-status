#!/bin/bash
set -euo pipefail

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
runtime_root="$HOME/.local/share/qvos"
issue_count=0

report_drift() {
  printf '%s\n' "$1"
  issue_count=$((issue_count + 1))
}

check_file() {
  local source=$1
  local target=$2
  local label=$3

  if [[ ! -f $target || -L $target ]] ||
    ! cmp -s "$source" "$target" ||
    [[ $(stat -c '%a' "$source") != "$(stat -c '%a' "$target")" ]]; then
    report_drift "$label"
  fi
}

check_tree() {
  local source=$1
  local target=$2
  local label=$3
  local source_inventory
  local target_inventory
  local source_file
  local path

  if [[ ! -d $target || -L $target ]]; then
    report_drift "$label"
    return
  fi

  source_inventory=$(
    find "$source" -mindepth 1 \
      -printf '%y\t%m\t%P\t%l\n' | sort
  )
  target_inventory=$(
    find "$target" -mindepth 1 \
      -printf '%y\t%m\t%P\t%l\n' | sort
  )
  if [[ $source_inventory != "$target_inventory" ]]; then
    report_drift "$label"
    return
  fi

  while IFS= read -r -d '' source_file; do
    path=${source_file#"$source/"}
    if ! cmp -s "$source_file" "$target/$path"; then
      report_drift "$label"
      return
    fi
  done < <(find "$source" -type f -print0)
}

check_link() {
  local target=$1
  local expected=$2
  local label=$3

  if [[ ! -L $target ]] || [[ $(readlink "$target") != "$expected" ]]; then
    report_drift "$label"
  fi
}

for feature in desktop direct tmux waybar; do
  check_tree \
    "$OMARCHY_PATH/qv/$feature" \
    "$runtime_root/$feature" \
    "$feature runtime differs from tracked qvOS source"
done

check_file \
  "$OMARCHY_PATH/qv/codex/capabilities.tsv" \
  "$runtime_root/codex/capabilities.tsv" \
  "Codex capability contract differs from tracked source"
check_file \
  "$OMARCHY_PATH/qv/codex/doctor" \
  "$runtime_root/codex/doctor" \
  "Codex doctor differs from tracked source"
check_file \
  "$OMARCHY_PATH/qv/maintenance/essential-packages" \
  "$runtime_root/maintenance/essential-packages" \
  "recovery essential-package policy differs from tracked source"
check_file \
  "$OMARCHY_PATH/qv/maintenance/qvos-repair" \
  "$runtime_root/maintenance/qvos-repair" \
  "recovery engine differs from tracked source"
check_file \
  "$OMARCHY_PATH/qv/maintenance/qvos-system" \
  "$runtime_root/maintenance/qvos-system" \
  "qvOS system hub differs from tracked source"
check_file \
  "$OMARCHY_PATH/qv/maintenance/qv" \
  "$HOME/.local/bin/qv" \
  "qv recovery front door differs from tracked source"
if ! "$OMARCHY_PATH/qv/shell/status"; then
  report_drift "qvOS runtime shell overlay or Bash source line differs"
fi
if ! "$OMARCHY_PATH/qv/tui/install" --status; then
  report_drift "qvOS TUI binary differs from tracked source"
fi

thunar_features=(
  actions.sh
  launch
  open-here
  reconcile-default-actions
  set-background
  share
  transcode
)
checked_thunar_features=("${thunar_features[@]}")
optional_thunar_features=(
  codex
  proton-drive-upload
)
for feature in "${optional_thunar_features[@]}"; do
  [[ -e $runtime_root/thunar/$feature ]] || continue
  thunar_features+=("$feature")
done

expected_thunar_inventory=$(printf '%s\n' "${thunar_features[@]}" | sort)
if [[ -d $runtime_root/thunar ]]; then
  installed_thunar_inventory=$(
    find "$runtime_root/thunar" -maxdepth 1 -type f -printf '%f\n' | sort
  )
else
  installed_thunar_inventory=""
fi
if [[ $installed_thunar_inventory != "$expected_thunar_inventory" ]]; then
  report_drift "Thunar runtime inventory contains unknown qvOS features"
else
  for feature in "${checked_thunar_features[@]}"; do
    check_file \
      "$OMARCHY_PATH/qv/thunar/$feature" \
      "$runtime_root/thunar/$feature" \
      "Thunar runtime differs: $feature"
  done
fi

if ! "$OMARCHY_PATH/qv/menu/install" --status; then
  report_drift "qvOS menu integration differs from tracked source"
fi

launcher_runtime="$runtime_root/launcher/elephant"
launcher_menu="$HOME/.config/elephant/menus"
for provider in \
  omarchy_background_selector.lua \
  omarchy_themes.lua \
  omarchy_unlocks.lua; do
  check_file \
    "$OMARCHY_PATH/qv/launcher/elephant/$provider" \
    "$launcher_runtime/$provider" \
    "launcher provider differs: $provider"
  check_link \
    "$launcher_menu/$provider" \
    "$launcher_runtime/$provider" \
    "launcher provider link differs: $provider"
done

declare -A hook_source=(
  [qvos-base]="$OMARCHY_PATH/qv/install/post-update-hook"
  [qvos-direct-tools]="$OMARCHY_PATH/qv/direct/post-update-hook"
  [qvos-waybar-overrides]="$OMARCHY_PATH/qv/waybar/post-update-hook"
)
for hook in qvos-base qvos-direct-tools qvos-waybar-overrides; do
  check_file \
    "${hook_source[$hook]}" \
    "$HOME/.config/omarchy/hooks/post-update.d/$hook" \
    "post-update hook differs: $hook"
done
if [[ -e $HOME/.config/omarchy/hooks/post-update.d/qvos-qvcore ]]; then
  report_drift "obsolete qvCORE post-update hook remains installed"
fi

for command_name in omarchy-system-inhibit-sleep omarchy-system-suspend-if-safe; do
  owner=${command_name#omarchy-system-}
  check_file \
    "$OMARCHY_PATH/qv/power/$owner" \
    "$runtime_root/bin/$command_name" \
    "power runtime differs: $command_name"
done

check_file \
  "$OMARCHY_PATH/qv/screensaver/alacritty.toml" \
  "$runtime_root/screensaver/alacritty.toml" \
  "screensaver configuration differs"
for command_name in \
  omarchy-launch-screensaver \
  qvos-launch-screensaver \
  qvos-screensaver; do
  check_file \
    "$OMARCHY_PATH/qv/screensaver/$command_name" \
    "$runtime_root/bin/$command_name" \
    "screensaver runtime differs: $command_name"
  check_link \
    "$HOME/.local/bin/$command_name" \
    "$runtime_root/bin/$command_name" \
    "screensaver command link differs: $command_name"
done

if ! "$OMARCHY_PATH/qv/waybar/refresh" --status; then
  report_drift "Waybar qvOS integration needs repair"
fi

((issue_count == 0))
