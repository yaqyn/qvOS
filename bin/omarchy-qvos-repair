#!/bin/bash

# omarchy:summary=Inspect or repair qvOS, with an explicit reset for tracked defaults
# omarchy:args=[--status [--check]|--reset] [--yes]
# omarchy:group=qvos
# omarchy:name=repair
# omarchy:requires-sudo=true

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
runtime_repair="$HOME/.local/share/qvos/maintenance/qvos-repair"
if [[ -x $runtime_repair ]]; then
  exec "$runtime_repair" "$@"
fi
exec "$OMARCHY_PATH/qv/maintenance/qvos-repair" "$@"
