#!/bin/bash

# omarchy:summary=Share clipboard, files, or folders through LocalSend
# omarchy:args=<clipboard|file|folder> [path...]
# omarchy:group=qvos
# omarchy:name=share
# omarchy:examples=omarchy qvos share clipboard | omarchy qvos share file ~/Downloads/example.txt

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
exec "$OMARCHY_PATH/qv/share/share" "$@"
