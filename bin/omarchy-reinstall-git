#!/bin/bash

# omarchy:summary=Unavailable on qvOS: replace the live source with upstream Omarchy
# omarchy:hidden=true

set -e

qvos_root="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
qvos_guard="$qvos_root/qv/maintenance/qvos-block-upstream-maintenance"
if [[ -d $qvos_root/qv && ! -x $qvos_guard ]]; then
  echo "Blocked on qvOS: the maintenance safety guard is unavailable" >&2
  exit 1
elif [[ -x $qvos_guard ]]; then
  exec "$qvos_guard" "omarchy reinstall git"
fi

# Reinstall the Omarchy configuration directory from the git source.

git clone --depth=1 --branch master "https://github.com/basecamp/omarchy.git" ~/.local/share/omarchy-new >/dev/null
mv $OMARCHY_PATH ~/.local/share/omarchy-old
mv ~/.local/share/omarchy-new $OMARCHY_PATH
