#!/bin/bash

# omarchy:summary=Reset all qvOS user configs to the defaults
# omarchy:requires-sudo=true

set -euo pipefail

# Overwrite all user configs with the qvOS defaults.

if (( EUID == 0 )); then
  echo "Error: This script should not be run as root"
  exit 1
fi

echo "Resetting all qvOS configs"
mkdir -p "$HOME/.config"
cp -a "$OMARCHY_PATH/config/." "$HOME/.config/"
cp "$OMARCHY_PATH/default/bashrc" "$HOME/.bashrc"
printf '%s\n' '[[ -f ~/.bashrc ]] && . ~/.bashrc' >"$HOME/.bash_profile"

bash "$OMARCHY_PATH/install/config/theme.sh"

omarchy-refresh-hyprland
omarchy-refresh-limine
omarchy-refresh-plymouth
omarchy-nvim-setup
