#!/bin/bash

# omarchy:summary=Creates a new qvOS migration named after the unix timestamp of the last commit.

set -euo pipefail

cd "$OMARCHY_PATH"
migration_file="$OMARCHY_PATH/migrations/$(git log -1 --format=%cd --date=unix).sh"
touch "$migration_file"

if [[ ${1:-} != "--no-edit" ]]; then
  nvim "$migration_file"
fi

printf '%s\n' "$migration_file"
