#!/bin/bash

# omarchy:summary=Set the Plymouth boot theme from a qvOS theme
# omarchy:args=<theme-name>
# omarchy:requires-sudo=true

# Resolve a theme by name and apply its unlock.png + colors.toml as the
# Plymouth boot screen via omarchy-plymouth-set.

set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: omarchy-plymouth-set-by-theme <theme-name>" >&2
  exit 1
fi

themes_dir="$HOME/.config/omarchy/themes"
theme=$("$OMARCHY_PATH/qvcore/theme/name" --resolve "$themes_dir" "$1")
theme_dir="$themes_dir/$theme"

if [[ ! -d $theme_dir ]]; then
  echo "Theme '$theme' does not exist in $HOME/.config/omarchy/themes" >&2
  exit 1
fi
if [[ ! -f $theme_dir/colors.toml || ! -f $theme_dir/unlock.png ]]; then
  echo "Theme '$theme' does not provide colors.toml and unlock.png." >&2
  exit 1
fi

bg=$(awk -F'"' '/^background/{print $2}' "$theme_dir/colors.toml")
text=$(awk -F'"' '/^foreground/{print $2}' "$theme_dir/colors.toml")

exec omarchy-plymouth-set "$bg" "$text" "$theme_dir/unlock.png"
