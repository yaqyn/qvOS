#!/bin/bash

# omarchy:summary=Share clipboard, files, or folders with LocalSend
# omarchy:group=share
# omarchy:name=
# omarchy:args=<clipboard|file|folder> [path...]
# omarchy:examples=omarchy share clipboard | omarchy share file ~/Downloads/example.txt

set -euo pipefail

if omarchy-cmd-missing localsend; then
  echo "LocalSend is not installed"
  exit 1
fi

if (($# == 0)); then
  echo "Usage: omarchy-menu-share [clipboard|file|folder]"
  exit 1
fi

mode=$1
shift
files=()

case $mode in
clipboard)
  temp_file=$(mktemp --suffix=.txt)
  wl-paste >"$temp_file"
  files=("$temp_file")
  ;;
file | folder)
  if (($# > 0)); then
    files=("$@")
  elif [[ $mode == "folder" ]]; then
    selection=$(find "$HOME" -type d 2>/dev/null | fzf) || exit $?
    [[ -n $selection ]] || exit 0
    files=("$selection")
  else
    mapfile -t files < <(find "$HOME" -type f 2>/dev/null | fzf --multi)
    ((${#files[@]} > 0)) || exit 0
  fi
  ;;
*)
  echo "Usage: omarchy-menu-share [clipboard|file|folder]" >&2
  exit 1
  ;;
esac

# Run LocalSend on demand, detached from the terminal.
systemd-run --user --quiet --collect \
  localsend --headless send "${files[@]}"

# Clipboard content stays in its temporary file until system cleanup so the
# detached LocalSend process can read it.

exit 0
