#!/bin/bash

# qv:summary=Start, stop, or recover a private screen recording
# qv:args=[--with-desktop-audio] [--with-microphone-audio] [--with-webcam] [--webcam-device=/dev/videoN] [--resolution=WIDTHxHEIGHT] [--stop-recording|--status]
# qv:examples=qv screenrecord | qv capture screenrecording --with-desktop-audio | qv capture screenrecording --status
