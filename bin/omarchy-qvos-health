#!/bin/bash

# omarchy:summary=Inspect qvOS base health without changing the system
# omarchy:group=qvos
# omarchy:name=health
# omarchy:args=[--check]

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
runtime_repair="$HOME/.local/share/qvos/maintenance/qvos-repair"
if [[ -x $runtime_repair ]]; then
  exec "$runtime_repair" --status "$@"
fi
exec "$OMARCHY_PATH/qv/maintenance/qvos-repair" --status "$@"
