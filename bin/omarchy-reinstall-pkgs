#!/bin/bash

# omarchy:summary=Unavailable on qvOS: upstream package reinstall and downgrade
# omarchy:hidden=true
# omarchy:requires-sudo=true

set -e

qvos_root="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
qvos_guard="$qvos_root/qv/maintenance/qvos-block-upstream-maintenance"
if [[ -d $qvos_root/qv && ! -x $qvos_guard ]]; then
  echo "Blocked on qvOS: the maintenance safety guard is unavailable" >&2
  exit 1
elif [[ -x $qvos_guard ]]; then
  exec "$qvos_guard" "omarchy reinstall pkgs"
fi

# Reinstall all default Omarchy packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
omarchy-refresh-pacman

# Downgrade any packages to the stable setup
sudo pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$OMARCHY_PATH/install/omarchy-base.packages" | grep -v '^$')
sudo pacman -Syu --noconfirm --needed "${packages[@]}"
