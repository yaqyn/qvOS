#!/bin/bash

# omarchy:summary=Reinstall all default qvOS packages from the stable channel
# omarchy:requires-sudo=true

set -e

# Reinstall all default qvOS packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
omarchy-refresh-pacman

# Downgrade any packages to the stable setup
sudo pacman -Suu --noconfirm

# Ensure all packages are installed
resolved_packages=$("$OMARCHY_PATH/qv/install/packaging/resolve" base)
mapfile -t packages <<<"$resolved_packages"
sudo pacman -Syu --noconfirm --needed "${packages[@]}"
