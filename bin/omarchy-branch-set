#!/bin/bash

# omarchy:summary=Unavailable on qvOS: switch the live checkout to an upstream branch
# omarchy:hidden=true
# omarchy:args=<master|rc|dev>

qvos_root="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
qvos_guard="$qvos_root/qv/maintenance/qvos-block-upstream-maintenance"
if [[ -d $qvos_root/qv && ! -x $qvos_guard ]]; then
  echo "Blocked on qvOS: the maintenance safety guard is unavailable" >&2
  exit 1
elif [[ -x $qvos_guard ]]; then
  exec "$qvos_guard" "omarchy branch set"
fi

if (($# == 0)); then
  echo "Usage: omarchy-branch-set [master|rc|dev]"
  exit 1
else
  branch="$1"
fi

if [[ $branch != "master" && $branch != "rc" && $branch != "dev" ]]; then
  echo "Error: Invalid branch '$branch'. Must be one of: master, rc, dev"
  exit 1
fi

git -C $OMARCHY_PATH switch $branch
