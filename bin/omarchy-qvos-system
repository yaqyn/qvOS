#!/bin/bash

# omarchy:summary=Open qvOS system health and recovery
# omarchy:group=qvos
# omarchy:name=system
# omarchy:args=[--status|--repair|--software]
# omarchy:examples=omarchy qvos system | omarchy qvos system --status

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
runtime_system="$HOME/.local/share/qvos/maintenance/qvos-system"
if [[ -x $runtime_system ]]; then
  exec "$runtime_system" "$@"
fi
exec "$OMARCHY_PATH/qv/maintenance/qvos-system" "$@"
