#!/bin/bash

# qv:summary=Transcode an image into terminal art
# qv:args=<input-image> <output-path> [options]
# qv:examples=qv transcode ascii ~/logo.svg /tmp/logo.txt | qv transcode ascii ~/logo.png ~/.config/qvos/branding/screensaver.txt --width 80

QVOS_PATH=${QVOS_PATH:-$HOME/.local/share/qvos}
exec "$QVOS_PATH/qvcore/transcode/ascii" "$@"
