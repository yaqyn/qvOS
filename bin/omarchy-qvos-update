#!/bin/bash

# omarchy:summary=Safely update qvOS through its native update engine
# omarchy:args=[-y|--check]
# omarchy:group=qvos
# omarchy:name=update
# omarchy:examples=omarchy qvos update | omarchy qvos update --check
# omarchy:requires-sudo=true

OMARCHY_PATH=${QVOS_PATH:-${OMARCHY_PATH:-$HOME/.local/share/qvos}}
exec "$OMARCHY_PATH/qvcore/update/qvos-update" "$@"
