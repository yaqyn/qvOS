#!/bin/bash

# omarchy:summary=Safely update qvOS through the original Omarchy updater
# omarchy:args=[-y]
# omarchy:group=qvos
# omarchy:name=update
# omarchy:examples=omarchy qvos update | omarchy qvos update -y
# omarchy:requires-sudo=true

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
exec "$OMARCHY_PATH/qv/update/qvos-update" "$@"
