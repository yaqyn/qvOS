#!/bin/bash

# omarchy:summary=Compatibility route for removing a former qvCORE integration
# omarchy:args=<proton|qvdev|devel> [--yes]
# omarchy:hidden=true
# omarchy:requires-sudo=true

OMARCHY_PATH=${OMARCHY_PATH:-$HOME/.local/share/omarchy}

if (($# < 1 || $# > 2)); then
  echo "Usage: omarchy-qvcore-remove <proton|qvdev|devel> [--yes]" >&2
  exit 2
fi
if (($# == 2)) && [[ $2 != "--yes" ]]; then
  echo "Usage: omarchy-qvcore-remove <proton|qvdev|devel> [--yes]" >&2
  exit 2
fi

case $1 in
proton)
  if (($# == 2)); then
    exec "$OMARCHY_PATH/services/proton/manage" remove "$2"
  else
    exec "$OMARCHY_PATH/services/proton/manage" remove
  fi
  ;;
qvdev | devel)
  if (($# == 2)); then
    exec "$OMARCHY_PATH/development/devel/manage" remove "$2"
  else
    exec "$OMARCHY_PATH/development/devel/manage" remove
  fi
  ;;
*)
  echo "Usage: omarchy-qvcore-remove <proton|qvdev|devel> [--yes]" >&2
  exit 2
  ;;
esac
