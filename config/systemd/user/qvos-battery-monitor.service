[Unit]
Description=qvOS Battery Monitor Check
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/share/qvos/qvcore/config/battery-monitor
Environment=DISPLAY=:0
LogLevelMax=warning
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=full
RestrictSUIDSGID=yes
SystemCallArchitectures=native
