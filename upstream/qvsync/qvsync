#!/bin/bash
set -euo pipefail

os_branch="OS"
upstream_ref="refs/remotes/upstream/master"
mode="audit"
recorded_target=""
git_fetch_timeout="${QVSYNC_GIT_FETCH_TIMEOUT:-30}"

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root" || exit 1

audit_command="$repo_root/upstream/qvsync/qvsync-audit"
reviewed_state="$repo_root/upstream/qvsync/reviewed-upstream"
provider_paths="$repo_root/upstream/qvsync/package-provider-paths"
lock_dir=$(git rev-parse --git-path qvsync.lock)
lock_acquired=0
state_tmp=""

usage() {
  printf "Usage: git qvsync [--audit|--record-reviewed-upstream <full-sha>]\n" >&2
  exit 2
}

case $# in
  0) ;;
  1)
    [[ $1 == "--audit" ]] || usage
    ;;
  2)
    case $1 in
      --record-reviewed-upstream)
        [[ $2 =~ ^[0-9a-f]{40}$ ]] || usage
        mode="record"
        recorded_target=$2
        ;;
      --reviewed-upstream)
        printf "Refusing: --reviewed-upstream merge mode has been retired.\n" >&2
        printf "qvsync now audits upstream without merging or publishing.\n" >&2
        printf "After porting and verifying the reviewed capabilities, use:\n" >&2
        printf "  git qvsync --record-reviewed-upstream %s\n" "$2" >&2
        exit 2
        ;;
      *) usage ;;
    esac
    ;;
  *) usage ;;
esac

for required_path in "$audit_command" "$reviewed_state" "$provider_paths"; do
  if [[ ! -f $required_path ]]; then
    printf "Refusing: required qvsync source is missing: %s\n" "$required_path" >&2
    exit 1
  fi
done
[[ -x $audit_command ]] || {
  printf "Refusing: qvsync audit helper is not executable: %s\n" "$audit_command" >&2
  exit 1
}

cleanup() {
  [[ -z $state_tmp || ! -e $state_tmp ]] || rm -f "$state_tmp"
  ((lock_acquired == 0)) || rm -rf "$lock_dir"
}
trap cleanup EXIT

acquire_lock() {
  local lock_pid=""

  if mkdir "$lock_dir" 2>/dev/null; then
    printf "%s\n" "$$" >"$lock_dir/pid"
    lock_acquired=1
    return
  fi

  if [[ -r $lock_dir/pid ]]; then
    read -r lock_pid <"$lock_dir/pid"
  fi

  if [[ $lock_pid =~ ^[0-9]+$ ]] && ! kill -0 "$lock_pid" 2>/dev/null; then
    printf "Removing stale qvsync lock from pid %s.\n" "$lock_pid" >&2
    rm -rf "$lock_dir"
    if mkdir "$lock_dir" 2>/dev/null; then
      printf "%s\n" "$$" >"$lock_dir/pid"
      lock_acquired=1
      return
    fi
  fi

  printf "Refusing: another qvsync appears to be running.\n" >&2
  printf "Lock directory: %s\n" "$lock_dir" >&2
  if [[ -n $lock_pid ]]; then
    printf "Lock pid: %s\n" "$lock_pid" >&2
  fi
  exit 1
}

github_upstream_repo() {
  local url
  local repo

  url=$(git remote get-url upstream 2>/dev/null) || return 1
  case $url in
    https://github.com/*)
      repo=${url#https://github.com/}
      ;;
    git@github.com:*)
      repo=${url#git@github.com:}
      ;;
    ssh://git@github.com/*)
      repo=${url#ssh://git@github.com/}
      ;;
    *) return 1 ;;
  esac

  repo=${repo%.git}
  [[ $repo == */* ]] || return 1
  printf "%s\n" "$repo"
}

github_upstream_sha() {
  local repo

  command -v gh >/dev/null || return 1
  repo=$(github_upstream_repo) || return 1
  gh api "repos/$repo/git/ref/heads/master" --jq .object.sha 2>/dev/null
}

refresh_upstream_ref() {
  local sha

  if timeout "$git_fetch_timeout" \
    git \
    -c http.version=HTTP/1.1 \
    -c http.lowSpeedLimit=1 \
    -c http.lowSpeedTime=30 \
    fetch --prune upstream \
    "+refs/heads/master:$upstream_ref"; then
    return
  fi

  printf "upstream/master fetch failed; trying a read-only GitHub ref refresh.\n" >&2
  sha=$(github_upstream_sha) || return 1
  if ! git cat-file -e "$sha^{commit}" 2>/dev/null; then
    printf "GitHub reports upstream/master at %s, but that commit is not present locally.\n" \
      "$sha" >&2
    return 1
  fi
  git update-ref "$upstream_ref" "$sha"
}

read_reviewed_state() {
  local state

  state=$(<"$reviewed_state")
  if [[ ! $state =~ ^[0-9a-f]{40}$ ]]; then
    printf "Refusing: invalid reviewed upstream state in %s\n" "$reviewed_state" >&2
    exit 1
  fi
  printf "%s\n" "$state"
}

require_upstream_policy_parity() {
  local upstream_lines

  if ! git cat-file -e "$upstream_ref:AGENTS.md" 2>/dev/null; then
    [[ ! -e $repo_root/AGENTS.md ]] || {
      printf "Refusing: upstream has no AGENTS.md but qvOS does. Review the policy boundary.\n" >&2
      exit 1
    }
    return
  fi

  [[ -f $repo_root/AGENTS.md ]] || {
    printf "Refusing: qvOS AGENTS.md is missing.\n" >&2
    exit 1
  }
  upstream_lines=$(git show "$upstream_ref:AGENTS.md" | wc -l)
  cmp -s \
    <(git show "$upstream_ref:AGENTS.md") \
    <(head -n "$upstream_lines" "$repo_root/AGENTS.md") || {
    printf "Refusing: the inherited AGENTS.md policy block does not match the reviewed upstream target.\n" >&2
    exit 1
  }
}

validate_review_ledger() {
  local base_sha=$1
  local target_sha=$2
  local ledger="$repo_root/upstream/qvsync/upstream-reviews/$target_sha.psv"
  local line
  local line_number=0
  local field_count
  local commit
  local decision
  local owner
  local summary
  local verification
  local -A expected=()
  local -A reviewed=()

  [[ -f $ledger && ! -L $ledger ]] || {
    printf "Refusing: missing upstream review ledger: %s\n" "$ledger" >&2
    exit 1
  }
  grep -Fqx "# base=$base_sha" "$ledger" || {
    printf "Refusing: review ledger does not name the current base: %s\n" "$base_sha" >&2
    exit 1
  }
  grep -Fqx "# target=$target_sha" "$ledger" || {
    printf "Refusing: review ledger does not name the fetched target: %s\n" "$target_sha" >&2
    exit 1
  }

  while IFS= read -r commit; do
    expected[$commit]=1
  done < <(git rev-list --reverse "$base_sha..$target_sha")

  while IFS= read -r line || [[ -n $line ]]; do
    ((line_number += 1))
    [[ -z $line || $line == "#"* ]] && continue

    field_count=$(awk -F'|' '{print NF}' <<<"$line")
    ((field_count == 5)) || {
      printf "Refusing: malformed review ledger row %d in %s\n" \
        "$line_number" "$ledger" >&2
      exit 1
    }
    IFS='|' read -r commit decision owner summary verification <<<"$line"

    [[ $commit =~ ^[0-9a-f]{40}$ && -n ${expected[$commit]:-} ]] || {
      printf "Refusing: ledger row %d names a commit outside the review range: %s\n" \
        "$line_number" "$commit" >&2
      exit 1
    }
    [[ -z ${reviewed[$commit]:-} ]] || {
      printf "Refusing: duplicate upstream commit in review ledger: %s\n" "$commit" >&2
      exit 1
    }
    case $decision in
      adopt | combine | retire-qvos | preserve | no-impact) ;;
      *)
        printf "Refusing: invalid decision for %s: %s\n" "$commit" "$decision" >&2
        exit 1
        ;;
    esac
    [[ -n $owner && -n $summary && -n $verification ]] || {
      printf "Refusing: incomplete review ledger row for %s\n" "$commit" >&2
      exit 1
    }
    reviewed[$commit]=1
  done <"$ledger"

  for commit in "${!expected[@]}"; do
    [[ -n ${reviewed[$commit]:-} ]] || {
      printf "Refusing: upstream commit is missing from the review ledger: %s\n" \
        "$commit" >&2
      exit 1
    }
  done
}

acquire_lock

branch=$(git symbolic-ref --quiet --short HEAD) || {
  printf "Refusing: detached HEAD. Switch to %s first.\n" "$os_branch" >&2
  exit 1
}
[[ $branch == "$os_branch" ]] || {
  printf "Refusing: qvsync must run from %s. Current branch is %s.\n" \
    "$os_branch" "$branch" >&2
  exit 1
}

upstream_push=$(git remote get-url --push upstream 2>/dev/null || true)
[[ $upstream_push == "DISABLED" ]] || {
  printf "Refusing: upstream push URL is not disabled.\n" >&2
  printf "Expected upstream push URL: DISABLED\n" >&2
  printf "Fix with: git remote set-url --push upstream DISABLED\n" >&2
  exit 1
}

refresh_upstream_ref || {
  printf "Refusing: failed to fetch upstream/master.\n" >&2
  exit 1
}

base_sha=$(read_reviewed_state)
target_sha=$(git rev-parse "$upstream_ref^{commit}")
git cat-file -e "$base_sha^{commit}" 2>/dev/null || {
  printf "Refusing: reviewed upstream base is not available locally: %s\n" "$base_sha" >&2
  exit 1
}
git merge-base --is-ancestor "$base_sha" "$target_sha" || {
  printf "Refusing: reviewed upstream base is not an ancestor of upstream/master.\n" >&2
  printf "Base:   %s\nTarget: %s\n" "$base_sha" "$target_sha" >&2
  exit 1
}

if [[ $mode == "audit" ]]; then
  "$audit_command" "$base_sha" "$upstream_ref" HEAD
  exit 0
fi

[[ $recorded_target == "$target_sha" ]] || {
  "$audit_command" "$base_sha" "$upstream_ref" HEAD >&2
  printf "\nRefusing: reviewed upstream SHA does not match the fetched target.\n" >&2
  printf "Reviewed: %s\nFetched:  %s\n" "$recorded_target" "$target_sha" >&2
  exit 1
}

if [[ $base_sha == "$target_sha" ]]; then
  printf "Reviewed upstream state already matches upstream/master at %s.\n" \
    "$target_sha"
  printf "No merge, publication, or state change was performed.\n"
  exit 0
fi

validate_review_ledger "$base_sha" "$target_sha"
require_upstream_policy_parity

state_tmp=$(mktemp "$reviewed_state.tmp.XXXXXX")
printf "%s\n" "$target_sha" >"$state_tmp"
chmod 0644 "$state_tmp"
mv "$state_tmp" "$reviewed_state"
state_tmp=""

printf "Recorded reviewed upstream target %s.\n" "$target_sha"
printf "No upstream commit was merged or cherry-picked, and no ref was published.\n"
printf "Commit the review ledger, reviewed state, and verified qvOS adaptations together.\n"
