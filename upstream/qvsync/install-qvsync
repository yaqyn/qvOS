#!/bin/bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
qvsync_path=$(git rev-parse --git-path qvsync)
qvsync_source="$repo_root/upstream/qvsync/qvsync"
qvsync_audit_source="$repo_root/upstream/qvsync/qvsync-audit"

for source_path in "$qvsync_source" "$qvsync_audit_source"; do
  if [[ ! -x $source_path ]]; then
    printf "Refusing: qvsync source is missing or not executable: %s\n" "$source_path" >&2
    exit 1
  fi
done

mkdir -p "$(dirname "$qvsync_path")"
cat >"$qvsync_path" <<'SCRIPT'
#!/bin/bash
repo_root=$(git rev-parse --show-toplevel) || exit 1
exec "$repo_root/upstream/qvsync/qvsync" "$@"
SCRIPT
chmod 0755 "$qvsync_path"

# shellcheck disable=SC2016
git config alias.qvsync '!bash "$(git rev-parse --git-path qvsync)"'

if ! git remote get-url upstream-iso >/dev/null 2>&1; then
  git remote add upstream-iso https://github.com/omacom-io/omarchy-iso.git
fi
git remote set-url --push upstream-iso DISABLED

if git show-ref --verify --quiet refs/remotes/origin/OS; then
  git remote set-head origin OS >/dev/null 2>&1 || true
fi

printf "Installed git qvsync from %s\n" "$qvsync_source"
