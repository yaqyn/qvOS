#!/bin/bash
set -euo pipefail

source_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(git -C "$source_dir" rev-parse --show-toplevel)
qvsync_path=$(git -C "$repo_root" rev-parse --path-format=absolute --git-path qvsync)
qvsync_source="$repo_root/upstream/qvsync/qvsync"
qvsync_audit_source="$repo_root/upstream/qvsync/qvsync-audit"

for source_path in "$qvsync_source" "$qvsync_audit_source"; do
  if [[ ! -x $source_path ]]; then
    printf "Refusing: qvsync source is missing or not executable: %s\n" "$source_path" >&2
    exit 1
  fi
done

mkdir -p "$(dirname "$qvsync_path")"
cat >"$qvsync_path" <<'SCRIPT'
#!/bin/bash
repo_root=$(git rev-parse --show-toplevel) || exit 1
exec "$repo_root/upstream/qvsync/qvsync" "$@"
SCRIPT
chmod 0755 "$qvsync_path"

# shellcheck disable=SC2016
git -C "$repo_root" config alias.qvsync '!bash "$(git rev-parse --git-path qvsync)"'

configure_upstream() {
  local name=$1
  local url=$2

  if git -C "$repo_root" remote get-url "$name" >/dev/null 2>&1; then
    git -C "$repo_root" remote set-url "$name" "$url"
  else
    git -C "$repo_root" remote add "$name" "$url"
  fi
  git -C "$repo_root" remote set-url --push "$name" DISABLED
}

configure_upstream upstream https://github.com/basecamp/omarchy.git
configure_upstream upstream-iso https://github.com/omacom-io/omarchy-iso.git

if git -C "$repo_root" show-ref --verify --quiet refs/remotes/origin/OS; then
  git -C "$repo_root" remote set-head origin OS >/dev/null 2>&1 || true
fi

printf "Installed git qvsync from %s\n" "$qvsync_source"
