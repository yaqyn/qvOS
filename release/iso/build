#!/bin/bash

set -eEuo pipefail

allow_downloads=false
no_cache=false
pre_public=false
prepare_only=false
retain_failed_stage=false
provider_channel="${QVOS_PROVIDER_CHANNEL:-stable}"

usage() {
  echo "Usage: qvos-build [--allow-downloads] [--no-cache] [--prepare-only] [--pre-public] [--retain-failed-stage] [--dev|--rc]"
  echo
  echo "Environment:"
  echo "  QVOS_SOURCE_REPO       qvOS git repository or local git path"
  echo "  QVOS_SOURCE_REF        qvOS branch, tag, or commit"
  echo "  QVOS_UPDATE_REPO       public HTTPS origin embedded for installed updates"
  echo "  QVOS_PROVIDER_CHANNEL  package-provider channel (stable, edge, or rc)"
  echo "  QVOS_ISO_RELEASE_DIR   artifact directory and private build-stage filesystem"
  echo "  QVOS_ARCH_MIRROR       optional HTTPS Arch mirror root"
  echo "  QVOS_DOCKER_NETWORK     optional Docker network, such as host"
}

env_enabled() {
  local name="$1"
  local value="${!name:-}"

  case $value in
  1 | true | TRUE | yes | YES | on | ON)
    return 0
    ;;
  *)
    return 1
    ;;
  esac
}

while (( $# > 0 )); do
  case $1 in
  --allow-downloads)
    allow_downloads=true
    ;;
  --no-cache)
    no_cache=true
    ;;
  --prepare-only)
    prepare_only=true
    ;;
  --pre-public)
    pre_public=true
    ;;
  --retain-failed-stage)
    retain_failed_stage=true
    ;;
  --dev)
    provider_channel=edge
    ;;
  --rc)
    provider_channel=rc
    ;;
  --help | -h)
    usage
    exit 0
    ;;
  *)
    echo "Unknown option: $1" >&2
    usage >&2
    exit 1
    ;;
  esac
  shift
done

if env_enabled QVOS_BUILD_PREPARE_ONLY; then
  prepare_only=true
fi

case $provider_channel in
stable | edge | rc) ;;
*)
  echo "QVOS_PROVIDER_CHANNEL must be stable, edge, or rc." >&2
  exit 2
  ;;
esac

if [[ $allow_downloads == "false" && $prepare_only == "false" ]]; then
  echo "qvos-build downloads packages and runs the native qvOS Archiso builder." >&2
  echo "Re-run with --allow-downloads when you are ready." >&2
  exit 1
fi

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
source_checkout=$(cd -- "$script_dir/../.." && pwd)
space_check="$script_dir/space-check"
release_dir="${QVOS_ISO_RELEASE_DIR:-$HOME/qvISO}"
docker_image="${QVOS_ISO_DOCKER_IMAGE:-archlinux/archlinux:latest}"
docker_network="${QVOS_DOCKER_NETWORK:-}"
arch_mirror="${QVOS_ARCH_MIRROR:-}"

if [[ -n $arch_mirror ]]; then
  if [[ $arch_mirror != https://* ]]; then
    echo "QVOS_ARCH_MIRROR must use HTTPS" >&2
    exit 2
  fi
  arch_mirror=${arch_mirror%/}
fi

mkdir -p "$release_dir"
[[ -x $space_check && -f $space_check && ! -L $space_check ]] || {
  echo "qvos-build free-space owner is unavailable." >&2
  exit 1
}
minimum_free_gib=1
if [[ $prepare_only == "false" ]]; then
  minimum_free_gib=40
  [[ $no_cache == "false" ]] || minimum_free_gib=50
fi
"$space_check" "$release_dir" "$minimum_free_gib"
stage_root=$(mktemp -d "$release_dir/.qvos-stage.XXXXXX")
preserve_stage=false
stage_cache=
stage_cache_needs_release=false

release_staged_cache() {
  local cache_root=$1

  [[ -n $cache_root && -d $cache_root && ! -L $cache_root ]] || {
    echo "qvos-build cannot release an unsafe staged build cache." >&2
    return 1
  }
  echo "qvOS ISO progress: releasing staged build cache"
  docker run \
    --rm \
    --pull=never \
    -v "$cache_root:/cache" \
    "$docker_image" \
    sh -c 'chown -R "$1:$2" /cache && chmod -R u+rwX /cache' \
    qvos-cache-release "$(id -u)" "$(id -g)" || return
  stage_cache_needs_release=false
}

cleanup() {
  local status=$?

  trap - EXIT
  if [[ $stage_cache_needs_release == "true" ]] &&
    ! release_staged_cache "$stage_cache"; then
    preserve_stage=true
    echo "qvos-build could not release the interrupted build cache." >&2
  fi
  if (( status != 0 )) && [[ $retain_failed_stage == "true" ]]; then
    preserve_stage=true
  fi
  if [[ $preserve_stage == "true" ]]; then
    echo "qvOS ISO failed stage retained: $stage_root" >&2
  else
    rm -rf -- "$stage_root"
  fi
  exit "$status"
}
trap cleanup EXIT

require_command() {
  local name="$1"

  if ! command -v "$name" >/dev/null 2>&1; then
    echo "qvos-build requires $name" >&2
    exit 1
  fi
}

detect_context_git_root() {
  local context_root

  context_root=$(git -C "$source_checkout" rev-parse --show-toplevel \
    2>/dev/null) || return 1
  [[ $context_root == "$source_checkout" ]] || return 1
  printf '%s\n' "$context_root"
}

default_qvos_source_repo() {
  local context_root="$1"
  local remote_url=""

  if [[ -n $context_root ]]; then
    remote_url=$(git -C "$context_root" remote get-url origin 2>/dev/null || true)
  fi

  if [[ -n $remote_url ]]; then
    echo "$remote_url"
  else
    echo "https://github.com/Yaqyn-qvOS/qvOS.git"
  fi
}

default_qvos_source_ref() {
  local context_root="$1"
  local branch=""

  if [[ -n $context_root ]]; then
    branch=$(git -C "$context_root" branch --show-current 2>/dev/null || true)
  fi

  if [[ -n $branch ]]; then
    echo "$branch"
  else
    echo "OS"
  fi
}

default_qvos_update_repo() {
  local context_root="$1"
  local source_repo="$2"
  local remote_url=""

  if [[ -d $source_repo ]] && git -C "$source_repo" rev-parse --git-dir >/dev/null 2>&1; then
    remote_url=$(git -C "$source_repo" remote get-url origin 2>/dev/null || true)
  elif [[ $source_repo == https://* ]]; then
    remote_url="$source_repo"
  fi
  if [[ -z $remote_url && -n $context_root ]]; then
    remote_url=$(git -C "$context_root" remote get-url origin 2>/dev/null || true)
  fi

  if [[ -n $remote_url ]]; then
    echo "$remote_url"
  else
    echo "https://github.com/Yaqyn-qvOS/qvOS.git"
  fi
}

validate_qvos_update_repo() {
  local repo="$1"
  local remote_path="${repo#https://}"

  if [[ $repo != https://* || $repo == *[[:space:]]* || $repo == https://*@* ||
    $repo == *\?* || $repo == *\#* || $remote_path != */* ||
    -z ${remote_path%%/*} || -z ${remote_path#*/} ]]; then
    echo "QVOS_UPDATE_REPO must be a public HTTPS Git URL without credentials." >&2
    return 2
  fi
}

checkout_git_ref() {
  local target="$1"
  local ref="$2"

  if [[ $ref == "HEAD" ]]; then
    retry_git_transfer -C "$target" checkout -q HEAD
  elif git -C "$target" show-ref --verify --quiet "refs/remotes/origin/$ref"; then
    retry_git_transfer -C "$target" checkout -q -B "$ref" "origin/$ref"
  elif git -C "$target" show-ref --verify --quiet "refs/tags/$ref"; then
    retry_git_transfer -C "$target" checkout -q "tags/$ref"
  else
    retry_git_transfer -C "$target" fetch --depth 1 origin "$ref"
    retry_git_transfer -C "$target" checkout -q FETCH_HEAD
  fi
}

retry_git_transfer() {
  local attempt

  for attempt in 1 2 3; do
    if git -c http.version=HTTP/1.1 "$@"; then
      return 0
    fi
    ((attempt == 3)) && return 1
    echo "qvOS ISO progress: retrying Git transfer ($((attempt + 1))/3)" >&2
    sleep "$((attempt * 2))"
  done
}

clone_git_source() {
  local repo="$1"
  local ref="$2"
  local target="$3"
  local attempt

  if [[ -d $repo ]]; then
    git clone --no-local --depth 1 --single-branch --branch OS --no-tags \
      --no-checkout "$repo" "$target"
  else
    for attempt in 1 2 3; do
      if git -c http.version=HTTP/1.1 clone \
        --filter=blob:none --depth 1 --single-branch --branch OS --no-tags \
        --no-checkout "$repo" "$target"; then
        break
      fi
      ((attempt == 3)) && return 1
      [[ -n $target && $target != "/" && $target != "." ]] || return 2
      rm -rf -- "$target"
      echo "qvOS ISO progress: retrying Git clone ($((attempt + 1))/3)" >&2
      sleep "$((attempt * 2))"
    done
  fi
  checkout_git_ref "$target" "$ref"
}

sanitize_qvos_checkout() {
  local target="$1"

  git -C "$target" remote set-url origin "$qvos_update_repo"
  git -C "$target" config --local core.logAllRefUpdates false
  rm -f -- \
    "$target/.git/COMMIT_EDITMSG" \
    "$target/.git/FETCH_HEAD" \
    "$target/.git/ORIG_HEAD" \
    "$target/.git/description" \
    "$target/.git/info/exclude"
  rm -rf -- "$target/.git/hooks" "$target/.git/logs"
  install -d -m 0755 "$target/.git/hooks"
}

checkout_qvos_update_branch() {
  local target="$1"
  local selected_commit
  local update_commit

  selected_commit=$(git -C "$target" rev-parse HEAD)
  if ! git -C "$target" show-ref --verify --quiet refs/remotes/origin/OS; then
    echo "qvos-build requires the qvOS source repository to expose origin/OS." >&2
    return 1
  fi

  update_commit=$(git -C "$target" rev-parse refs/remotes/origin/OS)
  if [[ $selected_commit != "$update_commit" ]]; then
    echo "qvos-build requires the pinned qvOS source commit to equal origin/OS." >&2
    echo "Selected: $selected_commit" >&2
    echo "origin/OS: $update_commit" >&2
    return 1
  fi

  git -C "$target" checkout -q -B OS origin/OS
  git -C "$target" branch --set-upstream-to=origin/OS OS >/dev/null
}

validate_public_update_commit() {
  local target="$1"
  local public_commit
  local public_line
  local public_ref
  local selected_commit
  local extra

  selected_commit=$(git -C "$target" rev-parse HEAD)
  if [[ $pre_public == "true" ]]; then
    echo "qvos-build: --pre-public skips the public OS commit gate." >&2
    echo "qvos-build: this artifact is development-only and its updater may refuse the source." >&2
    return 0
  fi

  if ! public_line=$(retry_git_transfer \
    ls-remote --heads "$qvos_update_repo" refs/heads/OS); then
    echo "qvos-build could not read the public qvOS OS branch." >&2
    return 1
  fi
  read -r public_commit public_ref extra <<<"$public_line"
  if [[ ! $public_commit =~ ^[0-9a-f]{40}$ ||
    $public_ref != "refs/heads/OS" || -n ${extra:-} ]]; then
    echo "qvos-build received an invalid public qvOS OS branch." >&2
    return 1
  fi
  if [[ $selected_commit != "$public_commit" ]]; then
    echo "qvos-build requires the pinned qvOS commit to equal the public OS branch." >&2
    echo "Selected: $selected_commit" >&2
    echo "Public OS: $public_commit" >&2
    echo "Use --pre-public only for a non-releasable development image." >&2
    return 1
  fi
}

stage_qvos_source() {
  local target="$1"

  echo "qvOS ISO progress: fresh-cloning qvOS source $qvos_source_ref"
  clone_git_source "$qvos_source_repo" "$qvos_source_ref" "$target" || return
  checkout_qvos_update_branch "$target" || return
  validate_public_update_commit "$target" || return
  sanitize_qvos_checkout "$target" || return
}

validate_qvos_source() {
  local target="$1"
  local missing=false
  local source_branch
  local source_fetch
  local source_remote
  local source_shallow
  local source_tag_option
  local source_tags
  local source_upstream

  echo "qvOS ISO progress: validating qvOS payload"

  if [[ ! -d $target/.git ]]; then
    echo "qvos-build staged qvOS source is missing .git metadata" >&2
    missing=true
  fi
  if [[ ! -d $target/qvcore/tui ]]; then
    echo "qvos-build staged qvOS source is missing qvcore/tui" >&2
    missing=true
  fi
  if [[ ! -d $target/qvcore/install ]]; then
    echo "qvos-build staged qvOS source is missing qvcore/install/" >&2
    missing=true
  fi
  if [[ ! -d $target/qvcore/boot/login ]]; then
    echo "qvos-build staged qvOS source is missing qvcore/boot/login/" >&2
    missing=true
  fi
  if [[ ! -f $target/qvcore/boot/install || -L $target/qvcore/boot/install ]]; then
    echo "qvos-build staged qvOS source is missing its native boot installer" >&2
    missing=true
  fi
  if [[ ! -x $target/release/iso/builder/build-iso.sh ]]; then
    echo "qvos-build staged qvOS source is missing its native image builder" >&2
    missing=true
  fi
  if [[ ! -f $target/release/iso/profile/profiledef.sh ]]; then
    echo "qvos-build staged qvOS source is missing its native Archiso profile" >&2
    missing=true
  fi

  source_branch=$(git -C "$target" branch --show-current 2>/dev/null || true)
  source_fetch=$(git -C "$target" config --get-all remote.origin.fetch 2>/dev/null || true)
  source_remote=$(git -C "$target" remote get-url origin 2>/dev/null || true)
  source_shallow=$(git -C "$target" rev-parse --is-shallow-repository 2>/dev/null || true)
  source_tag_option=$(git -C "$target" config --get remote.origin.tagOpt 2>/dev/null || true)
  source_tags=$(git -C "$target" for-each-ref --format='%(refname)' refs/tags)
  source_upstream=$(
    git -C "$target" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' \
      2>/dev/null || true
  )
  if [[ $source_branch != "OS" || $source_upstream != "origin/OS" ]]; then
    echo "qvos-build staged qvOS source must be on OS tracking origin/OS." >&2
    missing=true
  fi
  if [[ $source_remote != "$qvos_update_repo" ]]; then
    echo "qvos-build staged qvOS source has an unexpected update origin." >&2
    missing=true
  fi
  if [[ $source_shallow != "true" ||
    $source_fetch != "+refs/heads/OS:refs/remotes/origin/OS" ]]; then
    echo "qvos-build staged qvOS source is not a shallow OS-only checkout." >&2
    missing=true
  fi
  if [[ $source_tag_option != "--no-tags" || -n $source_tags ||
    $(git -C "$target" rev-list --count --all 2>/dev/null || true) != "1" ]]; then
    echo "qvos-build staged qvOS source retains unrelated history or tags." >&2
    missing=true
  fi
  if [[ -e $target/.git/FETCH_HEAD || -e $target/.git/logs ]]; then
    echo "qvos-build staged qvOS source retains transient Git state." >&2
    missing=true
  fi
  if find "$target/.git/hooks" -mindepth 1 -print -quit | grep -q .; then
    echo "qvos-build staged qvOS source retains ambient Git hooks." >&2
    missing=true
  fi

  if [[ $missing == "true" ]]; then
    return 1
  fi
}

validate_native_iso() {
  local iso_root="$1"
  local boot_config
  local builder="$iso_root/builder/build-iso.sh"
  local cache_recovery="$iso_root/builder/cache-recovery"
  local staged_space_check="$iso_root/space-check"
  local profile="$iso_root/profile"
  local installer="$profile/airootfs/root/.automated_script.sh"

  echo "qvOS ISO progress: validating staged package trust and kernel policy"
  if [[ ! -f $builder || -L $builder || ! -x $builder ||
    ! -f $cache_recovery || -L $cache_recovery ||
    ! -f $staged_space_check || -L $staged_space_check || ! -x $staged_space_check ||
    ! -d $profile || -L $profile ]]; then
    echo "qvos-build staged an invalid native builder or profile owner." >&2
    return 1
  fi
  if find "$iso_root/builder" "$profile" \
    \( -type l -o \( ! -type d ! -type f \) \) -print -quit |
    grep -q .; then
    echo "qvos-build staged a linked or special ISO source payload." >&2
    return 1
  fi
  if rg -n \
    'SigLevel[[:space:]]*=[[:space:]]*Never|TrustAll|arch-mact2|linux-(ptl|t2)|apple-t2|t2fanrd|tiny-dfr|vulkan-asahi' \
    "$builder" "$profile"; then
    echo "qvos-build staged weak package trust or an unsupported kernel stack." >&2
    return 1
  fi

  grep -Fq '/qvcore/packages/provider-files' "$builder" || {
    echo "qvos-build staged a builder that bypasses qvOS package-provider validation." >&2
    return 1
  }
  grep -Fqx 'qvos_source=/qvos' "$builder" || {
    echo "qvos-build staged a builder without the pinned qvOS source mount." >&2
    return 1
  }
  if rg -n '/root/omarchy|/var/cache/omarchy' "$builder" "$profile"; then
    echo "qvos-build staged a retired internal source or cache path." >&2
    return 1
  fi
  if rg -n \
    '/themes/omarchy|Theme=omarchy|Current=omarchy|Session=omarchy(\.desktop)?|99-omarchy-(login|installer)|hostname="omarchy"|install Omarchy' \
    "$builder" \
    "$profile/airootfs/etc/plymouth/plymouthd.conf" \
    "$installer"; then
    echo "qvos-build staged a retired internal boot or installer identity." >&2
    return 1
  fi
  if rg -n 'export OMARCHY_(PATH|INSTALL)=' "$installer"; then
    echo "qvos-build staged a retired installer source environment." >&2
    return 1
  fi
  grep -Fq '/usr/share/plymouth/themes/qvos' "$builder" || {
    echo "qvos-build staged Plymouth outside the native qvOS theme path." >&2
    return 1
  }
  grep -Fqx 'Theme=qvos' \
    "$profile/airootfs/etc/plymouth/plymouthd.conf" || {
    echo "qvos-build staged a non-native Plymouth theme selection." >&2
    return 1
  }
  grep -Fqx 'qvos' "$profile/airootfs/etc/hostname" || {
    echo "qvos-build staged a non-native live hostname." >&2
    return 1
  }
  grep -Fq '/etc/sudoers.d/99-qvos-installer' "$installer" || {
    echo "qvos-build staged a non-native temporary installer policy." >&2
    return 1
  }
  if rg -n \
    '/etc/sddm\.conf\.d|/var/lib/sddm/state\.conf|^[[:space:]]*(Current|Session)=qvos(\.desktop)?$' \
    "$installer"; then
    echo "qvos-build staged duplicate SDDM ownership in the ISO layer." >&2
    return 1
  fi
  grep -Fq 'package_file.sig' "$builder" || {
    echo "qvos-build staged an offline mirror that does not retain package signatures." >&2
    return 1
  }
  grep -Fqx 'repository_databases=(core extra multilib omarchy)' "$builder" || {
    echo "qvos-build staged an incomplete repository database snapshot." >&2
    return 1
  }
  # shellcheck disable=SC2016
  grep -Fq \
    'install -m 0644 -- "$database" "$repository_sync_dir/$repository.db"' \
    "$builder" || {
    echo "qvos-build staged a builder that does not retain repository databases." >&2
    return 1
  }
  grep -Fq '["/var/cache/qvos/mirror/sync"]="0:0:755"' \
    "$profile/profiledef.sh" || {
    echo "qvos-build staged unsafe repository database directory permissions." >&2
    return 1
  }
  grep -Fqx 'SigLevel = Required DatabaseOptional' \
    "$profile/pacman-offline.conf" || {
    echo "qvos-build staged an offline repository without required package signatures." >&2
    return 1
  }
  grep -Fqx 'LocalFileSigLevel = Required' \
    "$profile/pacman-offline.conf" || {
    echo "qvos-build staged an offline profile that permits unsigned local packages." >&2
    return 1
  }
  grep -Fqx 'Server = file:///var/cache/qvos/mirror/offline/' \
    "$profile/pacman-offline.conf" || {
    echo "qvos-build staged an unexpected offline repository path." >&2
    return 1
  }
  # shellcheck disable=SC2016
  grep -Fqx '  export QVOS_INSTALL="$QVOS_PATH/qvcore/install"' "$installer" || {
    echo "qvos-build staged an installer without the native qvOS install owner." >&2
    return 1
  }
  grep -Fq '/var/tmp/qvos-install-completed' "$installer" || {
    echo "qvos-build staged an installer with an unexpected completion marker." >&2
    return 1
  }
  grep -Fq 'seed_qvos_target_databases' "$installer" || {
    echo "qvos-build staged an installer that omits repository databases." >&2
    return 1
  }
  grep -Fq 'validate_qvos_target_databases' "$installer" || {
    echo "qvos-build staged an installer that accepts unreadable repositories." >&2
    return 1
  }
  grep -Fq 'finalize_qvos_target' "$installer" || {
    echo "qvos-build staged an installer without a durable target handoff." >&2
    return 1
  }
  grep -Fq '/usr/bin/sync -f /mnt' "$installer" || {
    echo "qvos-build staged an installer that may reboot an unsynchronized target." >&2
    return 1
  }
  grep -Fq 'qvcore/install/post-install/verify' "$installer" || {
    echo "qvos-build staged an installer that bypasses installed-state verification." >&2
    return 1
  }
  grep -Fq 'QVOS_INSTALL_VERIFY_TARGET=1' "$installer" || {
    echo "qvos-build staged an installer without privileged target verification." >&2
    return 1
  }
  # The search must match the literal target-variable reference in the staged
  # installer; expansion here would inspect the builder's unrelated state.
  # shellcheck disable=SC2016
  if grep -Fq 'chroot_bash "$target_verifier"' "$installer"; then
    echo "qvos-build staged an installer that root-executes target-owned source." >&2
    return 1
  fi
  grep -Fqx '  retire_qvos_target_offline_database' "$installer" || {
    echo "qvos-build staged an installer that retains its temporary database." >&2
    return 1
  }
  if grep -Fq 'arch-chroot /mnt pacman -Sy --noconfirm' "$installer"; then
    echo "qvos-build staged an unsafe partial target database synchronization." >&2
    return 1
  fi
  # shellcheck disable=SC2016
  if rg -n 'helpers/all\.sh' "$installer"; then
    echo "qvos-build staged the retired installer helper tree." >&2
    return 1
  fi
  grep -Fqx "ALL_kver='/boot/vmlinuz-linux'" \
    "$profile/airootfs/etc/mkinitcpio.d/linux.preset" || {
    echo "qvos-build staged an unexpected live-media kernel preset." >&2
    return 1
  }
  grep -Fq 'qvos-tui --iso-installer' "$installer" || {
    echo "qvos-build staged an installer that bypasses the mandatory qvOS TUI." >&2
    return 1
  }
  if [[ -e $profile/airootfs/root/configurator ||
    -L $profile/airootfs/root/configurator ]]; then
    echo "qvos-build staged a duplicate fallback configurator." >&2
    return 1
  fi

  for boot_config in \
    "$profile/efiboot/loader/entries/01-archiso-x86_64-linux.conf" \
    "$profile/grub/grub.cfg" \
    "$profile/grub/loopback.cfg" \
    "$profile/syslinux/archiso_pxe-linux.cfg" \
    "$profile/syslinux/archiso_sys-linux.cfg"; do
    rg -q 'vmlinuz-linux([^[:alnum:]_-]|$)' "$boot_config" || {
      echo "qvos-build staged a boot path without the standard Arch kernel: $boot_config" >&2
      return 1
    }
    rg -q 'initramfs-linux\.img' "$boot_config" || {
      echo "qvos-build staged a boot path without the standard Arch initramfs: $boot_config" >&2
      return 1
    }
  done
}

run_iso_builder() {
  local iso_root="$1"
  local staged_qvos="$2"
  local out_dir="$3"
  local cache_root="$4"
  local build_status=0
  local ownership_status=0
  local docker_args=(
    --rm
    --pull=always
    --privileged
    -e "QVOS_PROVIDER_CHANNEL=$provider_channel"
    -e "HOST_UID=$(id -u)"
    -e "HOST_GID=$(id -g)"
    -v "$out_dir:/out/"
    -v "$iso_root/builder:/builder:ro"
    -v "$iso_root/profile:/profile:ro"
    -v "$staged_qvos:/qvos:ro"
    -v "$cache_root:/var/cache"
  )

  if [[ -n $docker_network ]]; then
    docker_args+=(--network "$docker_network")
  fi
  if [[ -n $arch_mirror ]]; then
    docker_args+=(-e "QVOS_ARCH_MIRROR=$arch_mirror")
  fi

  if [[ $no_cache == "false" ]]; then
    echo "qvOS ISO progress: preparing build cache"
    docker_args+=(
      -v qvos-iso-pacman-cache:/var/cache/pacman/pkg
      -v qvos-iso-tool-cache:/var/cache/qvos
    )
  else
    echo "qvOS ISO progress: using an empty one-shot build cache"
  fi

  echo "qvOS ISO progress: starting build container"
  stage_cache_needs_release=true
  docker run "${docker_args[@]}" "$docker_image" /builder/build-iso.sh ||
    build_status=$?

  # Docker creates the staged Archiso workspace as root, including package
  # directories that are intentionally not owner-writable. Restore ownership
  # and owner access through the same container boundary so the host can either
  # inspect the exact failed stage or remove a successful one. Named download
  # caches are nested mounts during the build and are not visible to this pass.
  release_staged_cache "$cache_root" || ownership_status=$?

  if (( ownership_status != 0 )); then
    echo "qvos-build could not release the staged build cache." >&2
    (( build_status == 0 )) || return "$build_status"
    return "$ownership_status"
  fi

  return "$build_status"
}

publish_release_artifact() {
  local out_dir="$1"
  local latest_iso
  local partial_iso
  local target_iso

  latest_iso=""
  if [[ -d $out_dir ]]; then
    latest_iso=$(
      find "$out_dir" -maxdepth 1 -type f -name "*.iso" -printf "%T@ %p\n" |
        sort -nr |
        awk 'NR == 1 { $1 = ""; sub(/^ /, ""); print }'
    )
  fi
  if [[ -z $latest_iso ]]; then
    echo "qvos-build did not find an ISO artifact" >&2
    return 1
  fi

  mkdir -p "$release_dir"
  target_iso="$release_dir/$(basename "$latest_iso")"
  if [[ -e $target_iso || -L $target_iso ]]; then
    preserve_stage=true
    echo "qvos-build will not overwrite an existing release artifact" >&2
    echo "Existing ISO: $target_iso" >&2
    echo "Built ISO retained at: $latest_iso" >&2
    return 1
  fi
  if ! partial_iso=$(mktemp "$release_dir/.qvos-iso.partial.XXXXXX"); then
    preserve_stage=true
    echo "qvos-build could not prepare an atomic release artifact" >&2
    echo "Built ISO retained at: $latest_iso" >&2
    return 1
  fi
  if ! cp --reflink=auto -- "$latest_iso" "$partial_iso"; then
    rm -f -- "$partial_iso"
    preserve_stage=true
    echo "qvos-build could not copy the ISO into the release directory" >&2
    echo "Built ISO retained at: $latest_iso" >&2
    return 1
  fi
  chmod 0644 "$partial_iso"
  if ! ln -- "$partial_iso" "$target_iso"; then
    rm -f -- "$partial_iso"
    preserve_stage=true
    echo "qvos-build could not publish the ISO atomically" >&2
    echo "Built ISO retained at: $latest_iso" >&2
    return 1
  fi
  rm -f -- "$partial_iso"

  echo "qvOS ISO release dir: $release_dir"
  echo "qvOS ISO artifact: $target_iso"
}

require_command git
require_command rg
require_command tar
if [[ $prepare_only == "false" ]]; then
  require_command docker
fi

qvos_context_root=$(detect_context_git_root || true)
qvos_source_repo="${QVOS_SOURCE_REPO:-$(default_qvos_source_repo "$qvos_context_root")}"
qvos_source_ref="${QVOS_SOURCE_REF:-$(default_qvos_source_ref "$qvos_context_root")}"
qvos_update_repo="${QVOS_UPDATE_REPO:-$(
  default_qvos_update_repo "$qvos_context_root" "$qvos_source_repo"
)}"
validate_qvos_update_repo "$qvos_update_repo"

echo "qvOS ISO preflight: stage $stage_root"

staged_qvos="$stage_root/qvOS"
stage_out="$stage_root/out"
stage_cache="$stage_root/cache"
install -d -m 0700 "$stage_out"
# The random stage root remains private. Its bind-mounted cache root must be
# searchable by Pacman's unprivileged DownloadUser inside the container.
install -d -m 0755 "$stage_cache"

echo "qvOS ISO progress: stage ready"
stage_qvos_source "$staged_qvos"
validate_qvos_source "$staged_qvos"
native_iso="$staged_qvos/release/iso"
validate_native_iso "$native_iso"

if [[ $prepare_only == "true" ]]; then
  echo "qvOS ISO prepare-only complete"
  exit 0
fi

if ! run_iso_builder "$native_iso" "$staged_qvos" "$stage_out" "$stage_cache"; then
  if [[ $retain_failed_stage == "false" ]]; then
    echo "qvOS ISO failed scratch will be removed; reusable download caches are preserved." >&2
  fi
  exit 1
fi
publish_release_artifact "$stage_out"
echo "qvOS ISO build complete"
